---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Layout from "@/layouts/Layout.astro";

const endpoint =
  import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || "/api/newsletter";
const breadcrumbs = [
  { name: "Início", url: "/" },
  { name: "Newsletter", url: "/newsletter" },
  { name: "Confirmar cadastro", url: "/newsletter/confirmar" },
];
---

<Layout
  title="Confirmar cadastro na newsletter"
  description="Confirme o retorno aos envios editoriais do olhossecos.com.br."
  noindex
  breadcrumbs={breadcrumbs}
  datePublished="2026-08-08"
  dateModified="2026-08-08"
>
  <section class="confirmation-section">
    <div class="page-shell confirmation-shell">
      <Breadcrumbs items={breadcrumbs} />
      <div class="confirmation-card">
        <p class="eyebrow">Preferências da newsletter</p>
        <h1>Confirmar retorno aos envios</h1>
        <p>
          Use o botão abaixo para confirmar que você deseja voltar a receber as
          comunicações editoriais do olhossecos.com.br.
        </p>

        <form data-confirmation-form data-endpoint={endpoint} novalidate>
          <input type="hidden" name="token" />
          <button type="submit">Confirmar cadastro</button>
          <p data-confirmation-status role="status" aria-live="polite"></p>
        </form>

        <a class="back-link" href="/newsletter">Voltar para a newsletter</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>(
    "[data-confirmation-form]",
  );
  const status = document.querySelector<HTMLElement>(
    "[data-confirmation-status]",
  );
  const submit = form?.querySelector<HTMLButtonElement>(
    "button[type='submit']",
  );
  const tokenInput = form?.elements.namedItem(
    "token",
  ) as HTMLInputElement | null;
  const token = new URLSearchParams(window.location.search).get("token") ?? "";

  if (tokenInput) tokenInput.value = token;
  if (!token) {
    if (status) status.textContent = "Este link de confirmação é inválido.";
    if (submit) submit.disabled = true;
  } else {
    window.history.replaceState({}, "", "/newsletter/confirmar");
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const endpoint = form.dataset.endpoint;
    const token = tokenInput?.value ?? "";
    if (!endpoint || !token) return;

    form.setAttribute("aria-busy", "true");
    if (submit) submit.disabled = true;
    if (status) status.textContent = "Processando…";

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ stage: "confirm", confirmationToken: token }),
      });
      const result = (await response.json().catch(() => null)) as {
        message?: string;
      } | null;
      if (!response.ok) {
        throw new Error(result?.message ?? "confirmation_request_failed");
      }
      if (status) {
        status.textContent =
          result?.message ?? "Cadastro confirmado com sucesso.";
      }
      if (tokenInput) tokenInput.value = "";
    } catch (error) {
      if (status) {
        status.textContent =
          error instanceof Error &&
          error.message !== "confirmation_request_failed"
            ? error.message
            : "Não foi possível concluir agora. Tente novamente.";
      }
      if (submit) submit.disabled = false;
    } finally {
      form.removeAttribute("aria-busy");
    }
  });
</script>

<style>
  .confirmation-section {
    min-height: calc(100svh - var(--header-height));
    padding-block: clamp(2rem, 6vw, 5rem);
    background: var(--mist);
  }

  .confirmation-shell {
    max-width: 820px;
  }

  .confirmation-card {
    margin-top: 2rem;
    padding: clamp(2rem, 6vw, 4rem);
    border: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    background: var(--paper);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--teal-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .confirmation-card > p:not(.eyebrow) {
    max-width: 60ch;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
  }

  form {
    margin-top: 2rem;
  }

  button {
    min-height: 50px;
    padding: 0.85rem 1.25rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: white;
    cursor: pointer;
    font-weight: 750;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  [data-confirmation-status] {
    min-height: 1.6rem;
    margin: 1rem 0 0;
    color: var(--teal-dark);
    font-weight: 700;
  }

  .back-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--teal-dark);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
