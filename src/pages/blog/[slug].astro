---
import { resolveLegacyRedirect } from "@/lib/legacy-redirects";

const target = resolveLegacyRedirect(Astro.url.pathname) ?? "/guias";

// SSR: o adapter Node serve HTML estático sem passar no middleware.
// Sem isto, /blog/* vira 404 ou meta-refresh 200 em vez de 301.
export const prerender = false;

return Astro.redirect(target, 301);
---
