---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { client, urlFor } from '../../lib/sanity';
import { PortableText } from "astro-portabletext";
import groq from 'groq';
import '../../styles/article.css';

const { slug } = Astro.params;

let post = null;

try {
  if (import.meta.env.PUBLIC_SANITY_PROJECT_ID && slug) {
    post = await client.fetch(groq`*[_type == "post" && slug.current == $slug][0] {
      title,
      excerpt,
      publishedAt,
      mainImage,
      body,
      author->{name, image},
      categories[]->{title}
    }`, { slug });
  }
} catch (e) {
  console.error("Erro ao carregar post:", e);
}

if (!post) {
  return Astro.redirect('/404');
}

const postImage = post?.mainImage
  ? urlFor(post.mainImage)!.width(1200).height(630).url()
  : undefined;

const lcpImage = post?.mainImage
  ? { src: urlFor(post.mainImage)!.width(1200).height(600).url(), type: "image/webp" }
  : undefined;

const authorName: string = post.author?.name || 'Dr. Philipe Saraiva Cruz';
const byline = authorName.includes('Philipe Saraiva')
  ? `${authorName} · CRM-MG 69.870`
  : authorName;
---

<Layout
    title={`${post.title} | Blog Olhos Secos`}
    description={post.excerpt || post.title}
    image={postImage}
    imageAlt={post.title}
    imageWidth={1200}
    imageHeight={630}
    preloadImage={lcpImage}
>
  <article class="pt-24 pb-16 bg-white min-h-screen">
    <div class="container mx-auto px-6 max-w-4xl">

        <!-- Breadcrumb -->
        <nav class="mb-10 text-sm">
          <ol class="flex items-center gap-2 text-gray-500">
            <li><a href="/" class="hover:text-brand-light">Início</a></li>
            <li>/</li>
            <li><a href="/blog" class="hover:text-brand-light">Blog</a></li>
          </ol>
        </nav>

        <!-- Cabeçalho editorial -->
        <header class="text-center mb-12">
            {post.categories && post.categories.length > 0 && (
                <span class="eyebrow mb-4">{post.categories[0].title}</span>
            )}
            <h1 class="text-3xl md:text-5xl font-bold text-brand mt-4 mb-6 leading-tight">
                {post.title}
            </h1>
            <div class="flex items-center justify-center gap-4 text-gray-500 text-sm flex-wrap">
                <span class="font-medium text-brand">{byline}</span>
                <span>•</span>
                <span>{new Date(post.publishedAt).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </div>
        </header>

        <!-- Imagem de capa -->
        {post.mainImage && (
            <figure class="mb-12 rounded-xl overflow-hidden border border-[#E7E5E0] shadow-sm">
                <img
                    src={urlFor(post.mainImage!)!.width(1200).height(600).url()}
                    alt={post.title}
                    width="1200"
                    height="600"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    class="w-full h-auto"
                />
            </figure>
        )}

        <!-- Conteúdo -->
        <div class="article-body mx-auto text-slate-700">
            <PortableText value={post.body} />
        </div>

        <!-- Rodapé do artigo -->
        <div class="max-w-[70ch] mx-auto mt-14 pt-8 border-t border-[#E7E5E0] flex flex-col sm:flex-row gap-4 justify-between items-center">
            <a href="/blog" class="text-slate-500 hover:text-brand font-semibold flex items-center gap-2 transition-colors">
                ← Voltar para o Blog
            </a>
            <a href="/contato" class="btn-premium btn-premium-primary text-sm px-6 py-2">
                Agendar Avaliação
            </a>
        </div>
    </div>
  </article>
</Layout>
