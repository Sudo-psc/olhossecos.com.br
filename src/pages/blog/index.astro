---
import Layout from '../../layouts/Layout.astro';
import OfficialBlogCTA from '../../components/OfficialBlogCTA.astro';
import { client, urlFor, type SanityPost } from '../../lib/sanity';
import groq from 'groq';

let posts: SanityPost[] = [];
let usingSanity = false;

// Fallback content (Static) if Sanity is not connected
const staticPosts = [
  {
    title: "Olho Seco e Rosácea Ocular: Tratamento com IRPL E-Eye",
    slug: { current: "olho-seco-rosacea-ocular-tratamento-irpl-e-eye-caratinga-mg" },
    publishedAt: "2026-02-16",
    excerpt: "Descubra como o tratamento com IRPL E-Eye pode ajudar no olho seco e rosácea ocular. Tecnologia avançada aprovada pela ANVISA.",
    mainImage: null,
    staticImage: "/Capas/irpl-e-eye-tratamento.png",
    isStatic: true
  },
  {
    title: "Meibografia no olho seco: por que esse exame faz diferença no diagnóstico",
    slug: { current: "meibografia-olho-seco-caratinga-mg" },
    publishedAt: "2026-02-02",
    excerpt: "Entenda o que é meibografia, como ela ajuda no diagnóstico do olho seco e quando procurar oftalmologista.",
    mainImage: null,
    staticImage: "/Capas/meibografia.png",
    isStatic: true
  },
  {
    title: "A importância do seguimento no olho seco crônico",
    slug: { current: "importancia-seguimento-olho-seco-cronico" },
    publishedAt: "2026-01-29",
    excerpt: "Por que o acompanhamento regular é decisivo no olho seco crônico: ajuste terapêutico, prevenção de recaídas e estabilidade do filme lacrimal.",
    mainImage: null,
    staticImage: "/Capas/tratamento-olho-seco.png",
    isStatic: true
  },
  {
    title: "Olho Seco Evaporativo vs. Inflamatório: Por Que o Tratamento Muda",
    slug: { current: "olho-seco-evaporativo-vs-inflamatorio" },
    publishedAt: "2026-01-29",
    excerpt: "Entenda as diferenças entre olho seco evaporativo e inflamatório e por que cada tipo exige tratamento específico. Diagnóstico disponível.",
    mainImage: null,
    staticImage: "/Capas/tratamento-olho-seco.png",
    isStatic: true
  },
  {
    title: "IRPL com E-EYE no olho seco: vale a pena? Comparativo de custo-benefício",
    slug: { current: "caratinga-olho-seco-irpl-e-eye-custo-beneficio" },
    publishedAt: "2025-02-24",
    excerpt: "Entenda o custo-benefício do IRPL com E-EYE no olho seco e compare com alternativas. Guia prático.",
    mainImage: null,
    staticImage: "/Capas/irpl-e-eye-tratamento.png",
    isStatic: true
  },
  {
    title: "Luz Pulsada para Olho Seco: E-Eye IRPL",
    slug: { current: "luz-pulsada-olho-seco-caratinga" },
    publishedAt: "2025-02-20",
    excerpt: "Descubra como o tratamento com luz pulsada (E-Eye IRPL) está revolucionando o tratamento de olho seco. Tecnologia de ponta disponível na região.",
    mainImage: null,
    staticImage: "/Capas/tratamento-olho-seco-irpl.png",
    isStatic: true
  },
  {
    title: "Meibografia: Diagnóstico Avançado",
    slug: { current: "meibografia-caratinga" },
    publishedAt: "2025-02-18",
    excerpt: "Conheça a Meibografia, exame que visualiza as glândulas de Meibomius e revoluciona o diagnóstico de olho seco.",
    mainImage: null,
    staticImage: "/Capas/meibografia.png",
    isStatic: true
  },
  {
    title: "Tratamento de Olho Seco: Guia Completo",
    slug: { current: "olho-seco-tratamento-caratinga" },
    publishedAt: "2025-02-15",
    excerpt: "Guia completo sobre tratamento de olho seco. Luz pulsada, plugs lacrimais, meibografia e mais opções disponíveis.",
    mainImage: null,
    staticImage: "/Capas/tratamento-olho-seco.png",
    isStatic: true
  },
  {
    title: "Mitos e Verdades sobre o Olho Seco",
    slug: { current: "mitos-e-verdades" },
    publishedAt: "2025-02-10",
    excerpt: "Você sabia que olhos lacrimejando podem ser sinal de olho seco? Desvendamos os principais mitos com base na ciência.",
    mainImage: null,
    staticImage: "/Capas/capa-mitos.png",
    isStatic: true
  },
  {
    title: "Sintomas de Olho Seco: Quando Procurar Ajuda",
    slug: { current: "sintomas-olho-seco-caratinga" },
    publishedAt: "2025-02-05",
    excerpt: "Reconheça os sintomas de olho seco e saiba quando procurar um oftalmologista. Guia completo sobre causas e sinais de alerta.",
    mainImage: null,
    staticImage: "/Capas/tratamento-olho-seco.png",
    isStatic: true
  },
  {
    title: "DGM: A Causa de 85% dos Casos de Olho Seco",
    slug: { current: "disfuncao-glandulas-meibomius-dgm" },
    publishedAt: "2025-02-01",
    excerpt: "Entenda a Disfunção das Glândulas de Meibomius (DGM), responsável pela maioria dos casos de olho seco. Diagnóstico e tratamento.",
    mainImage: null,
    staticImage: "/Capas/dgm-85-causas.png",
    isStatic: true
  },
  {
    title: "Telas e Seus Olhos: Uma Relação Perigosa?",
    slug: { current: "telas-e-olho-seco" },
    publishedAt: "2025-01-25",
    excerpt: "O uso excessivo de celulares e computadores está criando uma epidemia de olho seco. Entenda o porquê e como se proteger.",
    mainImage: null,
    staticImage: "/Capas/tela-e-seus-olhos.png",
    isStatic: true
  }
];

try {
  if (import.meta.env.PUBLIC_SANITY_PROJECT_ID) {
    posts = await client.fetch(groq`*[_type == "post" && defined(slug.current)] | order(publishedAt desc) {
      _id,
      title,
      slug,
      mainImage,
      publishedAt,
      excerpt,
      categories[]->{title}
    }`);
    usingSanity = true;
  }
} catch (e) {
  console.warn("Sanity connection failed or not configured. Using static content.");
}

const displayPosts = usingSanity && posts.length > 0 ? posts : staticPosts;
---

<Layout title="Blog | Olhos Secos" description="Artigos e novidades sobre saúde ocular e tratamentos.">
  <main class="min-h-screen">

    <!-- Editorial Hero -->
    <section class="pt-24 pb-14 border-b border-[#E7E5E0]">
      <div class="container mx-auto px-6 text-center">
        <span class="eyebrow mb-4">Conteúdo Especializado</span>
        <h1 class="text-4xl md:text-6xl font-bold text-brand mt-4 mb-6 tracking-tight">Blog</h1>
        <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
          Medicina baseada em evidências, traduzida para o seu dia a dia — por
          <span class="font-medium text-brand">Dr. Philipe Saraiva Cruz · CRM-MG 69.870</span>.
        </p>
         {!usingSanity && (
            <div class="mt-6 badge-soft text-xs">
                Modo Demonstrativo (Sanity Offline)
            </div>
        )}
      </div>
    </section>

    <section class="py-16">
      <div class="container mx-auto px-6">
        
        {displayPosts.length > 0 && (
          <>
            <!-- Featured Post (First Item) -->
            <div class="mb-20">
                {(() => {
                    const featured: any = displayPosts[0];
                    const featuredSanityUrl = !featured.isStatic && featured.mainImage
                      ? urlFor(featured.mainImage)?.width(1000).url()
                      : null;
                    const featuredFallback = "/optimized/heroeye-800.webp";
                    const featuredSrc = featured.isStatic
                      ? featured.staticImage
                      : (featuredSanityUrl || featuredFallback);
                    const featuredSrcset = !featured.isStatic && !featuredSanityUrl
                      ? "/optimized/heroeye-637.webp 637w, /optimized/heroeye-800.webp 800w"
                      : undefined;
                    const featuredSizes = featuredSrcset
                      ? "(min-width: 1024px) 50vw, 100vw"
                      : undefined;
                    return (
                        <div class="group card-premium relative overflow-hidden grid md:grid-cols-2 min-h-[440px]">
                             <div class="relative overflow-hidden h-full min-h-[300px]">
                                <img
                                    src={featuredSrc}
                                    srcset={featuredSrcset}
                                    sizes={featuredSizes}
                                    alt={featured.title}
                                    loading="eager"
                                    decoding="async"
                                    fetchpriority="high"
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                            </div>
                            <div class="bg-white p-10 md:p-14 flex flex-col justify-center">
                                <span class="eyebrow mb-5">Em destaque</span>
                                <h2 class="text-2xl md:text-4xl font-bold text-brand mb-5 leading-tight">
                                    <a href={`/blog/${featured.slug.current}`} class="hover:text-brand-light transition-colors">
                                        {featured.title}
                                    </a>
                                </h2>
                                <p class="text-slate-600 text-lg mb-8 leading-relaxed line-clamp-3">
                                    {featured.excerpt}
                                </p>
                                <div class="flex items-center justify-between mt-auto pt-6 border-t border-[#E7E5E0]">
                                    <span class="text-slate-500 text-sm font-medium">
                                        {featured.publishedAt ? new Date(featured.publishedAt).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Data indefinida'}
                                    </span>
                                    <a href={`/blog/${featured.slug.current}`} class="text-brand-light font-semibold hover:text-brand transition-colors">
                                        Ler artigo completo →
                                    </a>
                                </div>
                            </div>
                        </div>
                    );
                })()}
            </div>

            <!-- Recent Articles Grid -->
            <div class="mb-12 flex items-center gap-4">
                <h3 class="text-2xl font-bold text-brand">Mais Artigos</h3>
                <div class="h-px bg-[#E7E5E0] flex-1"></div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
                {displayPosts.slice(1).map((post: any) => {
                  const postSanityUrl = !post.isStatic && post.mainImage
                    ? urlFor(post.mainImage)?.width(600).url()
                    : null;
                  const postFallback = "/optimized/heroeye-637.webp";
                  const postSrc = post.isStatic
                    ? post.staticImage
                    : (postSanityUrl || postFallback);
                  const postSrcset = !post.isStatic && !postSanityUrl
                    ? "/optimized/heroeye-637.webp 637w, /optimized/heroeye-800.webp 800w"
                    : undefined;
                  const postSizes = postSrcset
                    ? "(min-width: 1024px) 33vw, 100vw"
                    : undefined;
                  return (
                    <article class="group card-premium flex flex-col h-full overflow-hidden">
                        <a href={`/blog/${post.slug.current}`} class="block overflow-hidden aspect-[4/3] relative border-b border-[#E7E5E0]">
                            <img
                                src={postSrc}
                                srcset={postSrcset}
                                sizes={postSizes}
                                alt={post.title}
                                loading="lazy"
                                decoding="async"
                                class="w-full h-full object-cover"
                            />
                        </a>

                        <div class="flex-1 flex flex-col p-6">
                            <div class="flex items-center gap-3 mb-3">
                                <span class="eyebrow">{post.categories?.[0]?.title ?? 'Artigo'}</span>
                                <span class="w-1 h-1 rounded-full bg-[#D6D3CC]"></span>
                                <span class="text-xs font-medium text-slate-500 uppercase tracking-wider">
                                    {post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }) : ''}
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-brand mb-3 leading-snug">
                                <a href={`/blog/${post.slug.current}`} class="hover:text-brand-light transition-colors">
                                    {post.title}
                                </a>
                            </h3>

                            <p class="text-slate-600 text-sm leading-relaxed line-clamp-3 mb-4 flex-1">
                                {post.excerpt}
                            </p>

                            <a href={`/blog/${post.slug.current}`} class="text-sm font-semibold text-brand-light hover:text-brand transition-colors inline-flex items-center gap-1 group/link">
                                Ler mais
                                <span class="transform group-hover/link:translate-x-1 transition-transform">→</span>
                            </a>
                        </div>
                    </article>
                  );
                })}
            </div>
          </>
        )}
      </div>
      
      <div class="mt-20">
         <OfficialBlogCTA />
      </div>
    </section>
  </main>
</Layout>
