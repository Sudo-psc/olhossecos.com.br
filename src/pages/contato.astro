---
import Layout from '../layouts/Layout.astro';

const contact = {
    phone: "(33) 99860-1427",
    whatsapp: "5533998601427",
    email: "contato@saraivavision.com.br",
    hours: [
        { day: "Segunda a Sexta", time: "08:00 - 18:00" },
        { day: "Sábado", time: "08:00 - 12:00" },
        { day: "Domingo", time: "Fechado" }
    ]
};
---

<Layout
    title="Contato | Olhos Secos"
    description="Entre em contato com a Clínica Oftalmológica. Agende sua consulta por telefone, WhatsApp ou e-mail."
>
        <!-- Hero Section -->
        <section class="bg-gradient-to-br from-blue-900 to-blue-700 text-white py-20">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto text-center">
                    <h1 class="text-4xl md:text-5xl font-bold mb-6">Entre em Contato</h1>
                    <p class="text-xl text-blue-100">
                        Estamos prontos para atender você. Agende sua consulta ou tire suas dúvidas.
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="py-20 bg-white">
            <div class="container mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12">
                    <!-- Contact Form -->
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900 mb-6">Envie uma Mensagem</h2>
                        <form id="contato-form" class="space-y-6">
                            <div>
                                <label for="nome" class="block text-sm font-medium text-gray-700 mb-2">
                                    Nome Completo *
                                </label>
                                <input
                                    type="text"
                                    id="nome"
                                    name="nome"
                                    required
                                    minlength="2"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                                    placeholder="Seu nome completo"
                                />
                            </div>

                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                                        E-mail
                                    </label>
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                                        placeholder="seu@email.com"
                                    />
                                </div>
                                <div>
                                    <label for="telefone" class="block text-sm font-medium text-gray-700 mb-2">
                                        WhatsApp *
                                    </label>
                                    <input
                                        type="tel"
                                        id="telefone"
                                        name="telefone"
                                        required
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors"
                                        placeholder="(33) 99999-9999"
                                    />
                                </div>
                            </div>

                            <div>
                                <label for="mensagem" class="block text-sm font-medium text-gray-700 mb-2">
                                    Mensagem *
                                </label>
                                <textarea
                                    id="mensagem"
                                    name="mensagem"
                                    rows="5"
                                    required
                                    minlength="5"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-colors resize-none"
                                    placeholder="Descreva como podemos ajudá-lo..."
                                ></textarea>
                            </div>

                            <div id="contato-error" class="hidden p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm"></div>
                            <div id="contato-success" class="hidden p-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm"></div>

                            <button
                                type="submit"
                                id="contato-submit"
                                class="w-full px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-colors focus:ring-4 focus:ring-blue-200 disabled:opacity-50 disabled:cursor-not-allowed"
                            >
                                Enviar Mensagem
                            </button>

                            <p class="text-center text-xs text-gray-500 leading-relaxed">
                                Ao enviar, você concorda com nossa <a href="/privacidade" class="underline">Política de Privacidade</a>.
                            </p>
                        </form>
                    </div>

                    <!-- Contact Info -->
                    <div>
                        <h2 class="text-2xl font-bold text-gray-900 mb-6">Informações de Contato</h2>

                        <div class="space-y-6">
                            <!-- WhatsApp -->
                            <a
                                href={`https://wa.me/${contact.whatsapp}?text=Olá! Gostaria de agendar uma consulta.`}
                                target="_blank"
                                rel="noopener"
                                class="flex items-center gap-4 p-4 bg-green-50 rounded-xl hover:bg-green-100 transition-colors group"
                            >
                                <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900">WhatsApp</p>
                                    <p class="text-green-600">{contact.phone}</p>
                                </div>
                            </a>

                            <!-- Phone -->
                            <a
                                href={`tel:${contact.phone.replace(/\D/g, '')}`}
                                class="flex items-center gap-4 p-4 bg-blue-50 rounded-xl hover:bg-blue-100 transition-colors group"
                            >
                                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900">Telefone</p>
                                    <p class="text-blue-600">{contact.phone}</p>
                                </div>
                            </a>

                            <!-- Email -->
                            <a
                                href={`mailto:${contact.email}`}
                                class="flex items-center gap-4 p-4 bg-purple-50 rounded-xl hover:bg-purple-100 transition-colors group"
                            >
                                <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-900">E-mail</p>
                                    <p class="text-purple-600">{contact.email}</p>
                                </div>
                            </a>
                        </div>

                        <!-- Hours -->
                        <div class="mt-8">
                            <h3 class="text-xl font-bold text-gray-900 mb-4">Horário de Funcionamento</h3>
                            <div class="space-y-3">
                                {contact.hours.map(item => (
                                    <div class="flex justify-between items-center py-2 border-b border-gray-100">
                                        <span class="text-gray-700">{item.day}</span>
                                        <span class={`font-medium ${item.time === 'Fechado' ? 'text-red-500' : 'text-gray-900'}`}>
                                            {item.time}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
</Layout>

<script>
    const form = document.getElementById('contato-form') as HTMLFormElement | null;
    const errorBox = document.getElementById('contato-error');
    const successBox = document.getElementById('contato-success');
    const submitBtn = document.getElementById('contato-submit') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox?.classList.add('hidden');
        successBox?.classList.add('hidden');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Enviando...';
        }

        const data = new FormData(form);
        try {
            const response = await fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    nome: data.get('nome'),
                    telefone: data.get('telefone'),
                    email: data.get('email') || undefined,
                    mensagem: data.get('mensagem'),
                    origem: 'Página de Contato',
                    consentimento: true,
                }),
            });
            const result = await response.json();

            if (response.ok && result.success) {
                if (successBox) {
                    successBox.textContent = result.message || 'Mensagem enviada com sucesso! Entraremos em contato em breve.';
                    successBox.classList.remove('hidden');
                }
                form.reset();
            } else if (errorBox) {
                const detail = result.errors?.map((e: { message: string }) => e.message).join(' ');
                errorBox.innerHTML = detail || result.error || 'Não foi possível enviar sua mensagem.';
                if (result.fallbackUrl) {
                    errorBox.innerHTML += ` <a href="${result.fallbackUrl}" target="_blank" rel="noopener" class="underline font-semibold">Fale conosco pelo WhatsApp</a>.`;
                }
                errorBox.classList.remove('hidden');
            }
        } catch {
            if (errorBox) {
                errorBox.innerHTML = 'Erro de conexão. Tente novamente ou <a href="https://wa.me/5533998601427" target="_blank" rel="noopener" class="underline font-semibold">fale conosco pelo WhatsApp</a>.';
                errorBox.classList.remove('hidden');
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Enviar Mensagem';
            }
        }
    });
</script>
