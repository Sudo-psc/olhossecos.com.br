---
import { clinicUnavailableNotice } from "@/lib/clinic";

// Mantém a rota retirada mesmo sem o bloqueio adicional do Nginx.
export const prerender = false;
Astro.response.status = 410;
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noarchive");
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Atendimento indisponível</title>
  </head>
  <body><p>{clinicUnavailableNotice}</p></body>
</html>
