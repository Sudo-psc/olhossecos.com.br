---
import MagazineArticlePage from "@/components/superficie/MagazineArticlePage.astro";
import SuperficieLayout from "@/layouts/SuperficieLayout.astro";
import {
  getMagazineArticlePath,
  publishedArticles,
  validateMagazineArticle,
  type MagazineArticle,
} from "@/lib/superficie";
import { selectRelatedContent } from "@/lib/related-content";
import { articleTemplatePreview } from "@/lib/superficie-preview";
import { isResponsibleDoctorName, responsibleDoctor } from "@/lib/doctor";
import { highwireTagsForArticle } from "@/lib/highwire";
import { physician, physicianCredentials } from "@/lib/seo";

export function getStaticPaths() {
  const invalid = publishedArticles.flatMap((article) =>
    validateMagazineArticle(article).map(
      (message) => `${article.slug}: ${message}`,
    ),
  );

  if (invalid.length > 0) {
    throw new Error(`Artigos inválidos:\n${invalid.join("\n")}`);
  }

  const routableArticles = import.meta.env.PROD
    ? publishedArticles
    : [...publishedArticles, articleTemplatePreview];

  return routableArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: MagazineArticle;
}

const { article } = Astro.props;
const isPublished = article.status === "published";
const related = selectRelatedContent(article);
const canonicalPath = getMagazineArticlePath(article);
const articleUrl = new URL(canonicalPath, Astro.site).href;
const authorUrl = article.author.slug
  ? new URL(`/autor/${article.author.slug}`, Astro.site).href
  : undefined;
const personId = article.author.slug
  ? new URL(`/autor/${article.author.slug}#person`, Astro.site).href
  : undefined;
const ogImage = article.ogImage;
// Sem capa própria, cada artigo usa o card gerado por
// scripts/build-og-cards.mjs. O genérico da revista dizia apenas que o link
// vinha da SUPERFÍCIE, nunca qual texto estava sendo compartilhado.
const articleImage =
  ogImage?.src ?? `/images/og/superficie/${article.slug}.png`;
const articleImageType =
  ogImage?.type ?? (ogImage ? "image/jpeg" : "image/png");

const articleSchema = isPublished
  ? {
      "@type": "MedicalScholarlyArticle",
      "@id": `${articleUrl}#article`,
      headline: article.title,
      description: article.excerpt,
      datePublished: article.publishedAt,
      dateModified: article.modifiedAt ?? article.publishedAt,
      dateCreated: article.publishedAt,
      inLanguage: "pt-BR",
      isAccessibleForFree: true,
      articleSection: article.category,
      keywords: article.tags.join(", "),
      image: new URL(articleImage, Astro.site).href,
      identifier: article.doi ? `https://doi.org/${article.doi}` : undefined,
      author: {
        "@type": "Person",
        name: article.author.name,
        ...(personId ? { "@id": personId } : {}),
        ...(authorUrl ? { url: authorUrl } : {}),
        // Registro no schema pelo mesmo motivo que ele está no rodapé: em
        // conteúdo médico, quem assina precisa ser verificável.
        ...(isResponsibleDoctorName(article.author.name)
          ? {
              identifier: responsibleDoctor.registration,
              sameAs: [...physician.sameAs],
              hasCredential: [...physicianCredentials],
            }
          : {}),
      },
      publisher: {
        "@id": new URL("/superficie#organization", Astro.site).href,
      },
      isPartOf: { "@id": new URL("/superficie#periodical", Astro.site).href },
      mainEntityOfPage: { "@id": `${articleUrl}#webpage` },
      citation: article.references.map((reference) => {
        const doi = reference.doi?.replace(
          /^https?:\/\/(?:dx\.)?doi\.org\//u,
          "",
        );
        return {
          "@type": "ScholarlyArticle",
          name: reference.label,
          url: reference.url,
          ...(doi ? { identifier: `https://doi.org/${doi}` } : {}),
        };
      }),
      ...(article.sponsored && article.sponsor
        ? {
            sponsor: {
              "@type": "Organization",
              name: article.sponsor.name,
            },
          }
        : {}),
    }
  : undefined;
---

<SuperficieLayout
  title={article.seo.title}
  description={article.seo.description}
  image={articleImage}
  imageAlt={ogImage?.alt ?? `${article.title} — SUPERFÍCIE`}
  imageType={articleImageType}
  imageWidth={ogImage?.width ?? 1200}
  imageHeight={ogImage?.height ?? 630}
  datePublished={article.publishedAt}
  dateModified={article.modifiedAt ?? article.publishedAt}
  robots={isPublished ? undefined : "noindex,nofollow,noarchive"}
  ogType={isPublished ? "article" : "website"}
  authorName={article.author.name}
  compactHeader
  breadcrumbs={[
    { name: "SUPERFÍCIE", url: "/superficie" },
    { name: "Artigos", url: "/superficie/artigos" },
    { name: article.title, url: canonicalPath },
  ]}
  extraSchema={articleSchema}
  highwire={isPublished ? highwireTagsForArticle(article) : []}
>
  <MagazineArticlePage {article} {related} />

  {
    article.sponsored && (
      <script
        is:inline
        set:html={`window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:"sponsored_content_view",article_slug:${JSON.stringify(article.slug)}});`}
      />
    )
  }
</SuperficieLayout>
