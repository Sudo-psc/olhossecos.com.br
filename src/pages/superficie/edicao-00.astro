---
import ArticleCard from "@/components/superficie/ArticleCard.astro";
import IssueCover from "@/components/superficie/IssueCover.astro";
import SuperficieLayout from "@/layouts/SuperficieLayout.astro";
import {
  founderIssue,
  getIssuePublicStatus,
  sortPublishedArticlesByDate,
} from "@/lib/superficie";

const title = founderIssue.seo.title;
const description = founderIssue.seo.description;
const orderedArticles = sortPublishedArticlesByDate(founderIssue.articles);
const issueStatus = getIssuePublicStatus(founderIssue);

const issueSchema = {
  "@type": "PublicationIssue",
  "@id": new URL("/superficie/edicao-00#issue", Astro.site).href,
  name: founderIssue.title,
  issueNumber: founderIssue.number,
  description,
  inLanguage: "pt-BR",
  isPartOf: {
    "@id": new URL("/superficie#periodical", Astro.site).href,
  },
  url: new URL("/superficie/edicao-00", Astro.site).href,
};
---

<SuperficieLayout
  {title}
  {description}
  ogType="article"
  image={founderIssue.cover.fallback}
  imageAlt={founderIssue.cover.alt}
  imageType="image/png"
  imageWidth={founderIssue.cover.width}
  imageHeight={founderIssue.cover.height}
  breadcrumbs={[
    { name: "SUPERFÍCIE", url: "/superficie" },
    { name: "Edições", url: "/superficie/edicoes" },
    { name: "Edição 00", url: "/superficie/edicao-00" },
  ]}
  extraSchema={issueSchema}
>
  <section class="issue-hero" aria-labelledby="issue-title">
    <div class="surface-shell breadcrumb" aria-label="Navegação estrutural">
      <a href="/superficie">SUPERFÍCIE</a>
      <span aria-hidden="true">/</span>
      <span>Edição 00</span>
    </div>

    <div class="surface-shell issue-hero-grid">
      <div class="issue-cover-wrap">
        <IssueCover
          issue={founderIssue}
          eager
          sizes="(max-width: 820px) min(76vw, 330px), 460px"
        />
      </div>
      <div class="issue-hero-copy">
        <p class="eyebrow gold">Edição Fundadora • Nº {founderIssue.number}</p>
        <h1 id="issue-title">{founderIssue.title}</h1>
        <p class="description">
          Uma edição dedicada às transformações que estão redefinindo o
          entendimento da doença do olho seco, da fenotipagem clínica ao
          diagnóstico multimodal, novas tecnologias e estratégias terapêuticas
          personalizadas.
        </p>
        <div class="status">
          <span aria-hidden="true"></span>
          <div>
            <strong>{issueStatus.label}</strong>
            <small>{issueStatus.detail}</small>
          </div>
        </div>
        <a class="button button-primary" href="/superficie#newsletter"
          >{issueStatus.newsletterCta}</a
        >
      </div>
    </div>
  </section>

  <nav class="issue-nav" aria-label="Seções da edição">
    <div class="surface-shell">
      <a href="#editorial">Editorial</a>
      <a href="#sumario">Sumário</a>
      <a href="#artigos">Artigos</a>
      <a href="#autores">Autores</a>
      <a href="#parceiros">Parceiros</a>
      <a href="#download">Download</a>
    </div>
  </nav>

  <section
    id="editorial"
    class="section editorial-section"
    aria-labelledby="editorial-title"
  >
    <div class="surface-shell split-grid">
      <div>
        <p class="eyebrow ink">Editorial</p>
        <h2 id="editorial-title">As matérias saem antes do editorial.</h2>
      </div>
      <div class="editorial-copy">
        <p class="lead">
          {
            `As ${orderedArticles.length} matérias da Edição Fundadora já estão no ar — cada uma publicada assim que ficou pronta, com referências e disclosures. O editorial de abertura sai com o fechamento da edição impressa, em ${founderIssue.plannedPublication}.`
          }
        </p>
        <p>
          A proposta editorial parte de uma pergunta central: como transformar a
          ampliação do diagnóstico e das opções terapêuticas em decisões mais
          precisas, transparentes e aplicáveis à prática clínica?
        </p>
        <p class="state-note">
          Esta seção descreve a proposta da edição. Não é o editorial
          definitivo, que ainda não foi escrito.
        </p>
      </div>
    </div>
  </section>

  <section
    id="sumario"
    class="section summary-section"
    aria-labelledby="summary-title"
  >
    <div class="surface-shell">
      <header class="section-heading">
        <div>
          <p class="eyebrow gold">Eixos da edição</p>
          <h2 id="summary-title">O que esta edição cobre</h2>
        </div>
        <p>
          Os artigos no ar percorrem estes eixos. A edição impressa fecha em{
            " "
          }
          {founderIssue.plannedPublication}.
        </p>
      </header>

      <ol class="summary-list">
        {
          founderIssue.topics.map((topic, index) => (
            <li>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{topic}</strong>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    id="artigos"
    class="section articles-section"
    aria-labelledby="articles-title"
  >
    <div class="surface-shell">
      {
        founderIssue.articles.length > 0 ? (
          <>
            <header class="articles-heading">
              <p class="eyebrow ink">Artigos da edição</p>
              <h2 id="articles-title">Leituras da Edição 00</h2>
            </header>
            <div class="articles-grid">
              {orderedArticles.map((article) => (
                <ArticleCard {article} />
              ))}
            </div>
          </>
        ) : (
          <div class="empty-grid">
            <div class="empty-number" aria-hidden="true">
              00
            </div>
            <div>
              <p class="eyebrow ink">Artigos</p>
              <h2 id="articles-title">
                As matérias serão liberadas no lançamento.
              </h2>
              <p>
                Cada artigo terá página HTML própria, referências, autoria,
                datas de publicação e modificação, revisão quando aplicável e
                campo de conflitos de interesse.
              </p>
              <a class="text-link" href="/superficie#newsletter">
                Acompanhar as publicações
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section
    id="autores"
    class="section authors-section"
    aria-labelledby="authors-title"
  >
    <div class="surface-shell split-grid">
      <div>
        <p class="eyebrow ink">Autores e colaboradores</p>
        <h2 id="authors-title">
          Participações serão anunciadas após confirmação.
        </h2>
      </div>
      <div class="quiet-card">
        <p>
          A revista foi preparada para reunir diferentes autores e perspectivas.
          Nenhum colaborador ou conselho editorial será publicado antes da
          confirmação formal de participação.
        </p>
        <div class="editor-row">
          <div>
            <small>Fundador e editor responsável</small>
            <strong>Philipe Saraiva Cruz</strong>
            <span>Médico Oftalmologista</span>
          </div>
          <a
            class="text-link"
            href="/autor/philipe-saraiva-cruz"
            data-analytics-event="author_click"
            data-analytics-label="edicao_00">Conheça o autor</a
          >
        </div>
      </div>
    </div>
  </section>

  <section
    id="parceiros"
    class="section partners-section"
    aria-labelledby="partners-title"
  >
    <div class="surface-shell split-grid">
      <div>
        <p class="eyebrow gold">Parceiros</p>
        <h2 id="partners-title">Independência antes da visibilidade.</h2>
      </div>
      <div>
        <p>
          Eventuais parceiros da edição serão identificados com clareza e só
          aparecerão após relação formal e autorização apropriada. Não há logos
          ou organizações anunciados neste momento.
        </p>
        <p class="state-note light">
          Conteúdo editorial, publicidade e projetos patrocinados terão
          apresentação visual e rótulos distintos.
        </p>
      </div>
    </div>
  </section>

  <section
    id="download"
    class="section download-section"
    aria-labelledby="download-title"
  >
    <div class="surface-shell download-grid">
      <div>
        <p class="eyebrow ink">PDF da edição</p>
        <h2 id="download-title">Download disponível após a publicação.</h2>
        <p>
          A edição ainda está em produção. O botão de download será habilitado
          somente quando o arquivo final estiver publicado.
        </p>
      </div>
      <div class="download-action">
        <button type="button" disabled aria-describedby="download-state">
          Baixar PDF
        </button>
        <small id="download-state">Ainda indisponível</small>
      </div>
    </div>
  </section>

  <section class="section next-section" aria-labelledby="next-title">
    <div class="surface-shell next-grid">
      <div>
        <p class="eyebrow gold">Próxima edição</p>
        <h2 id="next-title">Edição 01</h2>
      </div>
      <div>
        <p>
          Tema, calendário e pauta serão apresentados somente após aprovação
          editorial.
        </p>
        <a class="button button-quiet" href="/superficie#newsletter"
          >Receber próximas edições</a
        >
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      window.dataLayer = window.dataLayer || [];
      document.querySelectorAll("[data-analytics-event]").forEach((element) => {
        element.addEventListener("click", () => {
          const detail = {
            event: element.dataset.analyticsEvent,
            label: element.dataset.analyticsLabel || "",
            page_path: window.location.pathname,
          };
          window.dataLayer.push(detail);
          window.dispatchEvent(
            new CustomEvent("olhossecos:analytics", { detail }),
          );
        });
      });
    })();
  </script>
</SuperficieLayout>

<style>
  .section {
    padding-block: clamp(4.75rem, 9vw, 8.5rem);
  }

  .eyebrow {
    margin: 0 0 0.9rem;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.18em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .eyebrow.ink {
    color: var(--surface-teal-dark);
  }

  .eyebrow.gold {
    color: var(--surface-gold-light);
  }

  h1,
  h2 {
    margin-top: 0;
    font-family: var(--surface-serif);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  h2 {
    margin-bottom: 1.35rem;
    font-size: var(--text-headline);
  }

  p {
    margin-top: 0;
  }

  .issue-hero {
    padding-block: 1.15rem clamp(4.5rem, 9vw, 8rem);
    background: var(--surface-navy);
    color: var(--surface-paper);
  }

  .breadcrumb {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--surface-muted-on-dark);
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .breadcrumb a:hover,
  .breadcrumb a:focus-visible {
    color: var(--surface-paper);
  }

  .issue-hero-grid {
    display: grid;
    grid-template-columns: minmax(260px, 440px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 9vw, 10rem);
    padding-top: clamp(2rem, 5vw, 5rem);
  }

  .issue-cover-wrap {
    transform: rotate(-1deg);
  }

  .issue-hero-copy h1 {
    max-width: 820px;
    margin-bottom: 1.3rem;
    font-size: var(--text-wordmark);
  }

  .description {
    max-width: 700px;
    color: var(--surface-muted-on-dark);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-block: 2rem;
  }

  .status > span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface-teal);
  }

  .status div {
    display: grid;
  }

  .status small {
    color: var(--surface-muted-on-dark);
  }

  .issue-nav {
    position: sticky;
    z-index: 20;
    top: 0;
    overflow-x: auto;
    background: var(--surface-paper);
    border-bottom: 1px solid var(--surface-line);
  }

  .issue-nav .surface-shell {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 4vw, 3.8rem);
  }

  .issue-nav a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 24px;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .split-grid,
  .download-grid,
  .next-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(360px, 1fr);
    gap: clamp(3rem, 8vw, 9rem);
  }

  .editorial-section,
  .authors-section,
  .download-section {
    background: var(--surface-white);
  }

  .editorial-copy .lead {
    color: var(--surface-teal-dark);
    font-family: var(--surface-serif);
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .editorial-copy > p:not(.lead, .state-note),
  .empty-grid p:not(.eyebrow),
  .download-grid p:not(.eyebrow) {
    color: var(--surface-copy);
  }

  .state-note {
    margin-top: 2rem;
    padding-left: 1rem;
    border-left: 2px solid var(--surface-gold);
    color: var(--surface-muted);
    font-size: var(--text-meta);
  }

  .state-note.light {
    color: var(--surface-gold-light);
  }

  .summary-section,
  .partners-section,
  .next-section {
    background: var(--surface-navy);
    color: var(--surface-paper);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 440px);
    align-items: end;
    gap: 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 18%);
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading > p {
    margin-bottom: 0;
    color: var(--surface-muted-on-dark);
  }

  .summary-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .summary-list li {
    min-height: 74px;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  .summary-list span {
    color: var(--surface-gold-light);
    font-family: var(--surface-serif);
  }

  .summary-list small {
    color: var(--surface-muted-on-dark);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .empty-grid {
    display: grid;
    grid-template-columns: minmax(170px, 0.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
    align-items: center;
  }

  .articles-heading {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--surface-line);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--surface-line);
    border-radius: var(--surface-radius-lg);
    background: var(--surface-line);
  }

  .empty-number {
    color: #a87927;
    font-family: var(--surface-serif);
    font-size: var(--text-numeral);
    line-height: 1;
  }

  .text-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-bottom: 1px solid currentColor;
    color: var(--surface-teal-dark);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .quiet-card {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border-top: 4px solid var(--surface-teal);
    border-radius: var(--surface-radius-md);
    background: var(--surface-paper);
  }

  .quiet-card > p {
    color: var(--surface-copy);
  }

  .editor-row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--surface-line);
  }

  .editor-row > div {
    display: grid;
  }

  .editor-row small,
  .editor-row span {
    color: var(--surface-muted);
  }

  .partners-section p:not(.eyebrow, .state-note),
  .next-section p:not(.eyebrow) {
    color: var(--surface-muted-on-dark);
  }

  .download-grid {
    align-items: center;
  }

  .download-action {
    min-height: 220px;
    display: grid;
    place-content: center;
    gap: 0.8rem;
    text-align: center;
    border: 1px solid var(--surface-line);
    border-radius: var(--surface-radius-md);
    background: var(--surface-paper);
  }

  .download-action button {
    min-width: 220px;
    min-height: 50px;
    border: 1px solid #8b949d;
    background: #8b949d;
    color: white;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .download-action button:disabled {
    cursor: not-allowed;
    opacity: 0.75;
  }

  .download-action small {
    color: var(--surface-muted);
  }

  .next-grid {
    align-items: end;
  }

  .next-grid h2 {
    margin-bottom: 0;
  }

  .next-grid .button {
    margin-top: 1.2rem;
  }

  @media (max-width: 820px) {
    .section {
      padding-block: 4.5rem;
    }

    .issue-hero-grid,
    .split-grid,
    .download-grid,
    .next-grid,
    .section-heading,
    .empty-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .issue-cover-wrap {
      width: min(76vw, 330px);
      justify-self: center;
    }

    .issue-hero-copy h1 {
      font-size: var(--text-headline);
    }

    .summary-list {
      grid-template-columns: 1fr;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .empty-number {
      font-size: var(--text-wordmark);
    }
  }

  @media (max-width: 520px) {
    .issue-nav .surface-shell {
      width: max-content;
      min-width: 100%;
      padding-inline: 1rem;
    }

    .summary-list li {
      grid-template-columns: 2.2rem 1fr;
      padding-block: 0.85rem;
    }

    .summary-list small {
      grid-column: 2;
    }

    .editor-row {
      flex-direction: column;
    }
  }
</style>
