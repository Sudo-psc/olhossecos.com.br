---
import IssueCover from "@/components/superficie/IssueCover.astro";
import SuperficieLayout from "@/layouts/SuperficieLayout.astro";
import {
  founderIssue,
  getIssuePublicStatus,
  getMagazineIssuePath,
  publishedIssues,
} from "@/lib/superficie";

// Título na forma que o Google já exibe para esta rota — por isso os 63
// caracteres, que o verify-release-routes libera aqui e em /superficie/artigos.
// A description continua lendo founderIssue.number: número escrito à mão foi
// justamente o que fez três páginas da revista discordarem da home.
const title = "Edições | SUPERFÍCIE — Revista de Olho Seco e Superfície Ocular";
const description = `Edição Fundadora nº ${founderIssue.number} da SUPERFÍCIE: A nova era da superfície ocular — do sintoma ao fenótipo, diagnóstico multimodal e terapias dirigidas por mecanismo.`;

const issueStatus = getIssuePublicStatus(founderIssue);

const collectionSchema = {
  "@type": "ItemList",
  "@id": new URL("/superficie/edicoes#issues", Astro.site).href,
  name: "Edições",
  itemListElement: publishedIssues.map((issue, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: issue.title,
    url: new URL(getMagazineIssuePath(issue), Astro.site).href,
  })),
};
---

<SuperficieLayout
  {title}
  {description}
  compactHeader
  schemaType="CollectionPage"
  breadcrumbs={[
    { name: "SUPERFÍCIE", url: "/superficie" },
    { name: "Edições", url: "/superficie/edicoes" },
  ]}
  extraSchema={collectionSchema}
>
  <section class="archive-hero" aria-labelledby="edicoes-title">
    <div class="surface-shell">
      <p class="eyebrow gold">Edição Fundadora • Nº {founderIssue.number}</p>
      <h1 id="edicoes-title">Edições</h1>
    </div>
  </section>

  <section class="section issue-section" aria-labelledby="issue-title">
    <div class="surface-shell issue-grid">
      <div class="issue-cover-wrap">
        <IssueCover
          issue={founderIssue}
          sizes="(max-width: 800px) 72vw, 280px"
        />
      </div>
      <div class="issue-intro">
        <p class="eyebrow ink">Edição Fundadora • Nº {founderIssue.number}</p>
        <h2 id="issue-title">{founderIssue.title}</h2>
        <p class="issue-subtitle">{founderIssue.subtitle}</p>
        <p>
          Uma edição dedicada às transformações que estão redefinindo o
          entendimento da doença do olho seco, da fenotipagem clínica ao
          diagnóstico multimodal, novas tecnologias e estratégias terapêuticas
          personalizadas.
        </p>
        <div class="status-line">
          <span class="status-dot" aria-hidden="true"></span>
          <strong>{issueStatus.label}</strong>
          <span>{issueStatus.detail}</span>
        </div>
        <a
          class="text-link"
          href={getMagazineIssuePath(founderIssue)}
          data-analytics-event="issue_click"
          data-analytics-label="archive_edicao_00"
          >Conhecer a Edição Fundadora</a
        >
      </div>
    </div>
  </section>
</SuperficieLayout>

<style>
  .archive-hero {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
    background: var(--surface-navy);
    color: var(--surface-paper);
  }

  .eyebrow {
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .eyebrow.gold {
    color: var(--surface-gold-light);
  }

  .eyebrow.ink {
    color: var(--surface-teal-dark);
  }

  .archive-hero h1 {
    margin: 0;
    font-family: var(--surface-serif);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .section {
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .issue-grid {
    display: grid;
    grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .issue-intro h2 {
    margin: 0 0 0.6rem;
    font-family: var(--surface-serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .issue-subtitle {
    margin: 0 0 1rem;
    color: var(--surface-copy);
    font-family: var(--surface-serif);
    font-size: 1.15rem;
  }

  .issue-intro p {
    max-width: 40rem;
    color: var(--surface-copy);
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.8rem;
    margin: 1.4rem 0 1.6rem;
    color: var(--surface-muted);
    font-size: 0.92rem;
  }

  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--surface-gold);
  }

  .text-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--surface-teal-dark);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }

  .text-link:hover,
  .text-link:focus-visible {
    color: var(--surface-navy);
  }

  @media (max-width: 720px) {
    .issue-grid {
      grid-template-columns: 1fr;
    }

    .issue-cover-wrap {
      max-width: 240px;
    }
  }
</style>
