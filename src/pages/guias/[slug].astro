---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import EducationalFigure from "@/components/EducationalFigure.astro";
import { guides, type Guide } from "@/lib/guides";

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const relatedGuides = guides
  .filter((candidate) => candidate.slug !== guide.slug)
  .slice(0, 3);
const breadcrumbs = [
  { name: "Início", url: "/" },
  { name: "Guias", url: "/guias" },
  { name: guide.title, url: `/guias/${guide.slug}` },
];
---

<Layout
  title={guide.title}
  description={guide.description}
  schemaType="Article"
  datePublished={guide.datePublished ?? "2026-07-25"}
  dateModified={guide.dateModified ?? "2026-07-25"}
  breadcrumbs={breadcrumbs}
>
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Progresso de leitura"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span></span>
  </div>

  <article>
    <header class="article-header">
      <div class="page-shell article-header-grid">
        <div>
          <Breadcrumbs items={breadcrumbs} />
          <p>{guide.category}</p>
          <h1 class="article-title">{guide.title}</h1>
          <div class="article-meta">
            <span>{guide.readingTime} de leitura</span>
            <span>Revisado em {guide.updated}</span>
          </div>
        </div>
        <aside>
          <p>{guide.description}</p>
        </aside>
      </div>
    </header>

    <div class="page-shell article-layout">
      <nav class="desktop-guide-toc" aria-label="Conteúdo do guia">
        <p>Neste guia</p>
        {
          guide.sections.map((section, index) => (
            <a href={`#secao-${index + 1}`} data-guide-toc-link>
              {String(index + 1).padStart(2, "0")} {section.heading}
            </a>
          ))
        }
      </nav>

      <details class="mobile-guide-toc">
        <summary>
          <span>Neste guia</span>
          <span class="mobile-guide-toc-current">Começar</span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="m5 8 5 5 5-5"></path>
          </svg>
        </summary>
        <div>
          {
            guide.sections.map((section, index) => (
              <a href={`#secao-${index + 1}`} data-guide-toc-link>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {section.heading}
              </a>
            ))
          }
        </div>
      </details>

      <div class="prose article-prose">
        {
          guide.sections.map((section, index) => (
            <section id={`secao-${index + 1}`}>
              <h2 tabindex="-1">{section.heading}</h2>
              {section.paragraphs?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.figure && <EducationalFigure figure={section.figure} />}
              {section.bullets && (
                <ul>
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {section.note && <div class="info-note">{section.note}</div>}
              {section.alert && <div class="alert-note">{section.alert}</div>}
            </section>
          ))
        }

        <section class="guide-sources">
          <h2>Fontes deste guia</h2>
          <p>
            As fontes abaixo ajudam a sustentar e contextualizar o conteúdo. Os
            links abrem os materiais originais.
          </p>
          <ul>
            {
              guide.sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <small>
            Links verificados em {
              guide.sourcesVerified ?? "25 de julho de 2026"
            }.
          </small>
        </section>

        <section class="related-guides" aria-labelledby="related-guides-title">
          <h2 id="related-guides-title">Continue aprendendo</h2>
          <ul>
            {
              relatedGuides.map((relatedGuide) => (
                <li>
                  <a href={`/guias/${relatedGuide.slug}`}>
                    <span>{relatedGuide.category}</span>
                    <strong>{relatedGuide.title}</strong>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <footer class="guide-footer">
          <p>
            Conteúdo educativo e geral. Não substitui diagnóstico, avaliação ou
            orientação profissional individualizada.
          </p>
          <a class="text-link" href="/guias">
            Continuar explorando
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </footer>
      </div>
    </div>
  </article>

  <script>
    const progress = document.querySelector<HTMLElement>(".reading-progress");
    const progressFill = progress?.querySelector<HTMLElement>("span");
    const article = document.querySelector<HTMLElement>(".article-prose");
    const sections = [
      ...document.querySelectorAll<HTMLElement>(".article-prose > section[id]"),
    ];
    const tocLinks = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-guide-toc-link]"),
    ];
    const mobileToc =
      document.querySelector<HTMLDetailsElement>(".mobile-guide-toc");
    const currentLabel = document.querySelector<HTMLElement>(
      ".mobile-guide-toc-current",
    );

    let frame = 0;

    const setCurrentSection = (section: HTMLElement) => {
      const target = `#${section.id}`;
      const heading = section.querySelector("h2")?.textContent?.trim() ?? "";

      tocLinks.forEach((link) => {
        const current = link.hash === target;
        if (current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      if (currentLabel && heading) currentLabel.textContent = heading;
    };

    const updateProgress = () => {
      frame = 0;
      if (!article || !progress || !progressFill) return;

      const start = article.offsetTop - window.innerHeight * 0.2;
      const end =
        article.offsetTop + article.offsetHeight - window.innerHeight * 0.65;
      const value = Math.min(
        100,
        Math.max(
          0,
          ((window.scrollY - start) / Math.max(1, end - start)) * 100,
        ),
      );
      progressFill.style.transform = `scaleX(${value / 100})`;
      progress.setAttribute("aria-valuenow", String(Math.round(value)));
    };

    const requestProgressUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(updateProgress);
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        const section = visible[0]?.target;
        if (section instanceof HTMLElement) setCurrentSection(section);
      },
      { rootMargin: "-24% 0px -62% 0px", threshold: [0, 0.01] },
    );

    sections.forEach((section) => observer.observe(section));
    if (sections[0]) setCurrentSection(sections[0]);

    tocLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const target = document.getElementById(link.hash.slice(1));
        if (mobileToc && window.matchMedia("(max-width: 850px)").matches) {
          mobileToc.open = false;
        }
        window.setTimeout(() => {
          target
            ?.querySelector<HTMLElement>("h2")
            ?.focus({ preventScroll: true });
        }, 100);
      });
    });

    window.addEventListener("scroll", requestProgressUpdate, { passive: true });
    window.addEventListener("resize", requestProgressUpdate);
    updateProgress();
  </script>
</Layout>

<style>
  .reading-progress {
    position: sticky;
    z-index: 49;
    top: var(--header-height);
    height: 4px;
    overflow: hidden;
    background: #e8f0f4;
  }

  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--teal);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 100ms linear;
  }

  .article-header {
    padding-block: clamp(2.25rem, 4vw, 3.75rem);
    border-bottom: 1px solid var(--line);
  }

  .article-header-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .article-header-grid > div > p {
    margin: 0 0 0.65rem;
    color: var(--teal-dark);
    font-size: 0.77rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-title {
    max-width: 900px;
    font-size: clamp(2.7rem, 4.8vw, 4.8rem);
    line-height: 0.98;
  }

  .article-meta {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 0.85rem;
    color: #5a6b80;
    font-size: 0.74rem;
  }

  .article-header aside {
    padding: 0.9rem 0 0.9rem 1.2rem;
    border-left: 2px solid var(--teal);
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .article-header aside p {
    margin: 0;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 740px);
    justify-content: center;
    gap: clamp(3rem, 7vw, 7rem);
    padding-block: clamp(2.6rem, 5vw, 5rem);
  }

  .desktop-guide-toc {
    position: sticky;
    top: calc(var(--header-height) + 2rem);
    display: grid;
    align-self: start;
    border-top: 1px solid var(--line);
  }

  .desktop-guide-toc p {
    margin: 0;
    padding: 0.8rem 0;
    color: var(--teal-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .desktop-guide-toc a {
    padding: 0.7rem 0.6rem;
    border-top: 1px solid var(--line);
    border-left: 3px solid transparent;
    color: var(--ink-soft);
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .desktop-guide-toc a:hover,
  .desktop-guide-toc a[aria-current] {
    border-left-color: var(--teal);
    background: linear-gradient(90deg, var(--mist), transparent);
    color: var(--teal-dark);
    font-weight: 750;
  }

  .mobile-guide-toc {
    display: none;
  }

  .article-prose > section[id] {
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }

  .article-prose > section:first-child h2 {
    margin-top: 0;
  }

  .guide-sources {
    margin-top: 5rem;
    padding: 2rem;
    background: var(--mist);
  }

  .guide-sources h2 {
    margin-top: 0;
  }

  .guide-sources li {
    font-size: 0.85rem;
  }

  .guide-sources small {
    color: #5a6b80;
    font-size: 0.72rem;
  }

  .guide-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .related-guides {
    margin-top: 4rem;
  }

  .related-guides ul {
    display: grid;
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .related-guides li {
    border-bottom: 1px solid var(--line);
  }

  .related-guides a {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
  }

  .related-guides span {
    color: var(--teal-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-guides strong {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.25;
  }

  .guide-footer p {
    color: #5a6b80;
    font-size: 0.78rem;
  }

  @media (max-width: 850px) {
    .reading-progress {
      top: var(--header-height);
    }

    .article-header {
      padding-block: 1.15rem 1rem;
    }

    .article-header-grid {
      display: block;
    }

    .article-header :global(.breadcrumbs) {
      margin-bottom: 0.35rem;
      overflow: hidden;
    }

    .article-header :global(.breadcrumbs ol) {
      flex-wrap: nowrap;
      overflow: hidden;
    }

    .article-header :global(.breadcrumbs li:last-child) {
      min-width: 0;
    }

    .article-header :global(.breadcrumbs li:last-child span) {
      display: block;
      max-width: 19ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .article-header-grid > div > p {
      margin-bottom: 0.4rem;
      font-size: 0.66rem;
    }

    .article-title {
      font-size: clamp(2.35rem, 10.8vw, 3rem);
      line-height: 0.96;
    }

    .article-meta {
      margin-top: 0.55rem;
      font-size: 0.65rem;
    }

    .article-header aside {
      max-width: none;
      margin-top: 0.75rem;
      padding-block: 0.55rem;
      font-size: 0.78rem;
      line-height: 1.45;
    }

    .article-layout {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-block: 0.8rem 4rem;
    }

    .desktop-guide-toc {
      display: none;
    }

    .mobile-guide-toc {
      display: block;
      order: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--control-radius);
      background: var(--paper);
    }

    .mobile-guide-toc summary {
      min-height: 48px;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) 20px;
      align-items: center;
      gap: 0.65rem;
      padding: 0.65rem 0.75rem;
      color: var(--teal-dark);
      font-size: 0.68rem;
      font-weight: 850;
      letter-spacing: 0.08em;
      list-style: none;
      text-transform: uppercase;
    }

    .mobile-guide-toc summary::-webkit-details-marker {
      display: none;
    }

    .mobile-guide-toc-current {
      overflow: hidden;
      color: var(--ink-soft);
      font-weight: 700;
      letter-spacing: 0;
      text-align: right;
      text-overflow: ellipsis;
      text-transform: none;
      white-space: nowrap;
    }

    .mobile-guide-toc summary svg {
      width: 20px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.8;
      transition: transform 180ms ease;
    }

    .mobile-guide-toc[open] summary svg {
      transform: rotate(180deg);
    }

    .mobile-guide-toc > div {
      padding-inline: 0.75rem;
      border-top: 1px solid var(--line);
    }

    .mobile-guide-toc a {
      display: grid;
      grid-template-columns: 2rem 1fr;
      gap: 0.4rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--line);
      color: var(--ink-soft);
      font-size: 0.76rem;
      line-height: 1.35;
    }

    .mobile-guide-toc a:last-child {
      border-bottom: 0;
    }

    .mobile-guide-toc a[aria-current] {
      color: var(--teal-dark);
      font-weight: 800;
    }

    .article-prose {
      order: 1;
    }

    .article-prose > section:first-child h2 {
      font-size: 2rem;
    }
  }
</style>
