---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { guides } from "@/lib/guides";
import { portalPages } from "@/lib/search";

const categories = ["Todos", ...new Set(guides.map((guide) => guide.category))];
---

<Layout
  title="Guias para entender e viver com olho seco"
  description="Biblioteca independente de guias sobre sintomas, rotina, tratamentos e decisões de cuidado no olho seco."
  schemaType="CollectionPage"
  dateModified="2026-07-25"
  breadcrumbs={[
    { name: "Início", url: "/" },
    { name: "Guias", url: "/guias" },
  ]}
>
  <header class="page-intro library-intro">
    <div class="page-shell">
      <Breadcrumbs
        items={[
          { name: "Início", url: "/" },
          { name: "Guias", url: "/guias" },
        ]}
      />
      <h1 class="page-title">Guias para entender e viver com olho seco</h1>
      <p>
        Conteúdo organizado por perguntas reais, escrito em linguagem clara e
        ligado às fontes usadas.
      </p>
      <div class="guide-search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.8" cy="10.8" r="6.7"></circle>
          <path d="m16 16 4.5 4.5"></path>
        </svg>
        <label class="sr-only" for="guide-search">Buscar guias</label>
        <input
          id="guide-search"
          type="search"
          placeholder="Buscar em todo o portal"
          autocomplete="off"
        />
        <button id="clear-search" type="button" aria-label="Limpar busca" hidden>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="m7 7 10 10M17 7 7 17"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <section class="guide-library">
    <div class="page-shell">
      <div class="library-toolbar">
        <div class="category-filters" aria-label="Filtrar guias por categoria">
          {
            categories.map((category, index) => (
              <button
                type="button"
                data-category={category}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                {category}
              </button>
            ))
          }
        </div>
        <p id="search-status" role="status" aria-live="polite">
          {guides.length} guias disponíveis.
        </p>
      </div>

      <section id="portal-results" class="portal-results" hidden>
        <h2>Páginas do portal</h2>
        <div>
          {
            portalPages.map((page) => (
              <a
                href={page.href}
                data-page-result
                data-search={`${page.title} ${page.description} ${page.category} ${page.tags.join(" ")}`.toLowerCase()}
                hidden
              >
                <span>{page.category}</span>
                <strong>{page.title}</strong>
                <small>{page.description}</small>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5"></path>
                </svg>
              </a>
            ))
          }
        </div>
      </section>

      <div class="guide-list" id="guide-list">
        {
          guides.map((guide, index) => (
            <article
              data-guide
              data-category={guide.category}
              data-search={`${guide.title} ${guide.description} ${guide.tags.join(" ")}`.toLowerCase()}
            >
              <a href={`/guias/${guide.slug}`}>
                <span class="guide-number">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <p>{guide.category}</p>
                  <h2>{guide.title}</h2>
                  <span>{guide.description}</span>
                </div>
                <small>{guide.readingTime} de leitura</small>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5"></path>
                </svg>
              </a>
            </article>
          ))
        }
      </div>
      <p id="empty-state" hidden>
        Nenhum guia corresponde a essa busca. Tente uma palavra mais ampla.
      </p>
    </div>
  </section>

  <script>
    const search = document.querySelector<HTMLInputElement>("#guide-search");
    const guides = [
      ...document.querySelectorAll<HTMLElement>("[data-guide]"),
    ];
    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-category]"),
    ];
    const empty = document.querySelector<HTMLElement>("#empty-state");
    const clear = document.querySelector<HTMLButtonElement>("#clear-search");
    const status = document.querySelector<HTMLElement>("#search-status");
    const portalResults =
      document.querySelector<HTMLElement>("#portal-results");
    const pages = [
      ...document.querySelectorAll<HTMLElement>("[data-page-result]"),
    ];
    const params = new URLSearchParams(window.location.search);
    let activeCategory = "Todos";

    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();

    const filter = () => {
      const term = normalize(search?.value ?? "");
      let visibleGuides = 0;
      let visiblePages = 0;

      guides.forEach((guide) => {
        const categoryMatch =
          activeCategory === "Todos" ||
          guide.dataset.category === activeCategory;
        const searchMatch = normalize(guide.dataset.search ?? "").includes(term);
        guide.hidden = !(categoryMatch && searchMatch);
        if (!guide.hidden) visibleGuides += 1;
      });

      pages.forEach((page) => {
        const matches =
          term.length > 0 &&
          normalize(page.dataset.search ?? "").includes(term);
        page.hidden = !matches;
        if (matches) visiblePages += 1;
      });

      const total = visibleGuides + visiblePages;
      const filtered = term.length > 0 || activeCategory !== "Todos";

      if (portalResults) portalResults.hidden = visiblePages === 0;
      if (clear) clear.hidden = term.length === 0;
      if (empty) empty.hidden = total !== 0;
      if (status) {
        status.textContent = filtered
          ? `${total} ${total === 1 ? "resultado encontrado" : "resultados encontrados"}.`
          : `${guides.length} guias disponíveis.`;
      }
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.category ?? "Todos";
        buttons.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === button)),
        );
        filter();
      });
    });

    search?.addEventListener("input", filter);
    clear?.addEventListener("click", () => {
      if (!search) return;
      search.value = "";
      activeCategory = "Todos";
      buttons.forEach((item, index) =>
        item.setAttribute("aria-pressed", String(index === 0)),
      );
      filter();
      search.focus();
    });

    const initialQuery = params.get("q");
    if (initialQuery && search) {
      search.value = initialQuery;
      filter();
    }
  </script>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .guide-search {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    max-width: 680px;
    min-height: 62px;
    margin-top: 2.8rem;
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
  }

  .guide-search svg {
    width: 27px;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .guide-search input {
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--ink);
    font-size: 1rem;
  }

  .guide-search button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--teal-dark);
    cursor: pointer;
  }

  .guide-search button:hover {
    background: var(--mist);
  }

  .guide-search button svg {
    width: 22px;
  }

  .guide-search button[hidden] {
    display: none;
  }

  .guide-library {
    padding-block: clamp(2rem, 5vw, 4.5rem) clamp(4rem, 9vw, 8rem);
  }

  .library-toolbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .category-filters button {
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: white;
    color: var(--ink-soft);
    font-size: 0.76rem;
    font-weight: 700;
    cursor: pointer;
  }

  .category-filters button[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: white;
  }

  #search-status {
    min-width: max-content;
    margin: 0.55rem 0 0;
    color: #64748a;
    font-size: 0.76rem;
  }

  .portal-results {
    margin: 0 0 3rem;
    padding: 1.5rem 1.7rem;
    background: var(--mist);
  }

  .portal-results[hidden] {
    display: none;
  }

  .portal-results > h2 {
    margin: 0 0 0.8rem;
    color: var(--teal-dark);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portal-results > div {
    display: grid;
  }

  .portal-results a {
    display: grid;
    grid-template-columns: 130px minmax(180px, 0.75fr) 1fr 24px;
    align-items: center;
    gap: 1.2rem;
    padding-block: 1rem;
    border-top: 1px solid #b9d6df;
  }

  .portal-results a[hidden] {
    display: none;
  }

  .portal-results a > span {
    color: var(--teal-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portal-results a > strong {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.35rem;
    line-height: 1.1;
  }

  .portal-results a > small {
    color: var(--ink-soft);
    font-size: 0.78rem;
  }

  .portal-results a > svg {
    width: 22px;
    fill: none;
    stroke: var(--teal-dark);
    stroke-width: 1.7;
  }

  .guide-list {
    border-top: 1px solid var(--line);
  }

  .guide-list article {
    border-bottom: 1px solid var(--line);
  }

  .guide-list article[hidden] {
    display: none;
  }

  .guide-list a {
    display: grid;
    grid-template-columns: 90px 1fr auto 32px;
    align-items: center;
    gap: clamp(1.2rem, 4vw, 4rem);
    min-height: 210px;
    padding-block: 2rem;
  }

  .guide-list a:hover h2 {
    color: var(--teal-dark);
  }

  .guide-number {
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: 4.2rem;
    line-height: 1;
  }

  .guide-list p {
    margin: 0 0 0.7rem;
    color: var(--teal-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guide-list h2 {
    max-width: 760px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    transition: color 180ms ease;
  }

  .guide-list div > span {
    display: block;
    max-width: 760px;
    margin-top: 0.8rem;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .guide-list small {
    color: #66778e;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .guide-list a > svg {
    width: 28px;
    fill: none;
    stroke: var(--teal-dark);
    stroke-width: 1.7;
    transition: transform 180ms ease;
  }

  .guide-list a:hover > svg {
    transform: translateX(5px);
  }

  #empty-state {
    padding: 3rem;
    background: var(--mist);
    color: var(--ink-soft);
    text-align: center;
  }

  @media (max-width: 760px) {
    .library-toolbar {
      display: block;
    }

    #search-status {
      margin: 0 0 1.4rem;
    }

    .portal-results a {
      grid-template-columns: 1fr 24px;
    }

    .portal-results a > span,
    .portal-results a > small {
      grid-column: 1;
    }

    .portal-results a > svg {
      grid-column: 2;
      grid-row: 1 / 4;
    }

    .guide-list a {
      grid-template-columns: 58px 1fr 24px;
      gap: 1rem;
      min-height: 180px;
    }

    .guide-number {
      font-size: 3rem;
    }

    .guide-list small {
      display: none;
    }
  }
</style>
