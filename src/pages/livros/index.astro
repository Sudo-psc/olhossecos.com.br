---
import AuthorLogo from "@/components/AuthorLogo.astro";
import BookCover from "@/components/BookCover.astro";
import BookFeature from "@/components/BookFeature.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import IssueCover from "@/components/superficie/IssueCover.astro";
import BookStoreClickGtag from "@/components/BookStoreClickGtag.astro";
import Layout from "@/layouts/Layout.astro";
import { author, books } from "@/lib/books";
import { founderIssue } from "@/lib/superficie";

const title = "Livros sobre Olho Seco e Superfície Ocular";
const description =
  "Conheça livros de Philipe Saraiva Cruz sobre olho seco, conjuntivocálase, superfície ocular, diagnóstico, tratamento e saúde visual.";
const breadcrumbs = [
  { name: "Início", url: "/" },
  { name: "Livros", url: "/livros" },
];
const newsletterEndpoint =
  import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT || "/api/newsletter";
const siteUrl = new URL("/", Astro.site);
const personId = new URL("/autor/philipe-saraiva-cruz#person", siteUrl).href;
const editorialSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: author.name,
      jobTitle: author.role,
      description: author.description,
      url: new URL(`/autor/${author.slug}`, siteUrl).href,
    },
    ...books.map((book) => ({
      "@type": "Book",
      "@id": new URL(`/livros/${book.slug}#book`, siteUrl).href,
      name: book.title,
      alternateName: book.subtitle,
      description: book.description,
      url: new URL(`/livros/${book.slug}`, siteUrl).href,
      image: new URL(book.cover.webp800, siteUrl).href,
      inLanguage: "pt-BR",
      author: { "@id": personId },
      keywords: book.topics.join(", "),
      isbn: book.isbn,
      numberOfPages: book.numberOfPages,
      bookEdition: book.edition,
      datePublished: book.year?.toString(),
      offers: book.purchaseLinks.map((purchase) => ({
        "@type": "Offer",
        url: purchase.url,
        availability: "https://schema.org/InStock",
        seller: { "@type": "Organization", name: purchase.store },
      })),
    })),
  ],
};
---

<Layout
  title={title}
  description={description}
  image="/images/livros/og-livros.png"
  imageAlt="Biblioteca editorial de Philipe Saraiva Cruz sobre olho seco e superfície ocular"
  schemaType="CollectionPage"
  datePublished="2026-08-07"
  dateModified="2026-08-07"
  breadcrumbs={breadcrumbs}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(editorialSchema)}
  />
  <BookStoreClickGtag />

  <header class="books-hero">
    <div class="page-shell">
      <Breadcrumbs items={breadcrumbs} />
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-kicker">Biblioteca Científica & Monográfica</span>
          <h1>Livros sobre Olho Seco e Superfície Ocular</h1>
          <p class="hero-subtitle">
            Ciência, clínica e inovação em olho seco e superfície ocular.
          </p>
          <p class="hero-intro">
            Uma biblioteca dedicada à compreensão aprofundada da superfície
            ocular, reunindo obras clínicas, científicas e estratégicas
            desenvolvidas para médicos, pesquisadores, gestores e profissionais
            interessados na evolução do cuidado ocular.
          </p>
          <div class="hero-signature">
            <AuthorLogo size="sm" variant="seal" class="hero-signature-logo" />
            <div class="hero-signature-text">
              <span class="author-name">{author.name}</span>
              <small class="author-role"
                >{author.role} · {author.registration}</small
              >
            </div>
          </div>
        </div>

        <div
          class="hero-library"
          aria-label="Obras apresentadas nesta biblioteca"
        >
          <div class="hero-showcase">
            <div class="hero-book-wrap book-left">
              <span class="book-badge-tag">1ª Obra</span>
              <BookCover
                book={books[0]}
                eager
                decorative
                class="hero-cover-one"
              />
            </div>
            <div class="hero-book-wrap book-right">
              <span class="book-badge-tag">2ª Obra</span>
              <BookCover
                book={books[1]}
                eager
                decorative
                class="hero-cover-two"
              />
            </div>
          </div>
          <div class="hero-plinth" aria-hidden="true">
            <span class="plinth-surface"></span>
            <span class="plinth-accent"></span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="featured-books" aria-labelledby="featured-title">
    <div class="page-shell">
      <div class="section-intro">
        <p class="section-label">Biblioteca editorial</p>
        <h2 id="featured-title">Obras em destaque</h2>
        <span
          >Publicações para leitura aprofundada, referência clínica e reflexão.</span
        >
      </div>
      {books.map((book, index) => <BookFeature book={book} index={index} />)}
    </div>
  </section>

  <section class="expansion" aria-labelledby="expansion-title">
    <div class="page-shell expansion-grid">
      <span class="expansion-mark" aria-hidden="true">∞</span>
      <div>
        <h2 id="expansion-title">Uma biblioteca em expansão</h2>
        <p>
          O projeto editorial do olhossecos.com.br reúne publicações dedicadas à
          prática clínica, ciência, tecnologia e às transformações
          contemporâneas da saúde ocular. Novas obras e edições serão
          progressivamente incorporadas a esta biblioteca.
        </p>
      </div>
    </div>
  </section>

  <!-- Ecossistema Editorial: Revista SUPERFÍCIE com Capa Real e Acesso Aberto -->
  <section class="ecosystem page-shell" aria-labelledby="superficie-title">
    <div class="superficie-cover-card">
      <div class="superficie-cover-frame">
        <IssueCover
          issue={founderIssue}
          sizes="(max-width: 720px) 78vw, 360px"
          class="superficie-real-cover"
        />
        <span class="superficie-cover-glow" aria-hidden="true"></span>
      </div>
    </div>
    <div class="ecosystem-copy">
      <div class="superficie-header-row">
        <p class="superficie-name">SUPERFÍCIE</p>
        <span class="superficie-status-badge">Publicação Ativa · Edição 00</span
        >
      </div>
      <h2 id="superficie-title">Revista de Olho Seco e Superfície Ocular</h2>
      <p class="superficie-tagline">Evidência que chega à prática.</p>
      <p>
        Além dos livros de aprofundamento monográfico, o ecossistema editorial
        publica a revista <strong>SUPERFÍCIE</strong>: uma publicação periódica
        com curadoria científica rigorosa dedicada à atualização diagnóstica,
        terapêutica e tecnológica da superfície ocular.
      </p>
      <div class="superficie-actions">
        <a class="btn-superficie-reader" href="/superficie/edicao-00">
          Abrir Edição 00 no Reader
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 12h16m-5-5 5 5-5 5"></path>
          </svg>
        </a>
        <a class="btn-superficie-hub" href="/superficie">
          Conhecer a Revista
        </a>
      </div>
    </div>
  </section>

  <!-- Seção do Autor com Monograma & Símbolo Oficial PSC -->
  <section id="sobre-o-autor" class="author-section">
    <div class="page-shell author-grid">
      <div class="author-logo-card">
        <AuthorLogo size="xl" variant="seal" class="author-main-logo" />
        <span class="author-logo-label">Símbolo Oficial · PSC</span>
      </div>
      <div>
        <p class="section-label">Autoria e curadoria</p>
        <h2>{author.name}</h2>
        <p class="author-role-detail">{author.role} · {author.registration}</p>
        <p class="author-bio">{author.description}</p>
        <div class="author-links-group">
          <a class="editorial-link" href={`/autor/${author.slug}`}>
            Perfil do autor
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </a>
          <a
            class="editorial-link amazon-author-link"
            href="https://www.amazon.com/author/drphilipesaraiva"
            target="_blank"
            rel="noopener noreferrer author"
          >
            Página na Amazon
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    id="newsletter"
    class="newsletter-section"
    aria-labelledby="newsletter-title"
  >
    <div class="page-shell newsletter-grid">
      <div>
        <p class="section-label">Correspondência editorial</p>
        <h2 id="newsletter-title">Acompanhe novas publicações</h2>
        <p>
          Receba atualizações sobre novos livros, edições da SUPERFÍCIE e
          conteúdos selecionados sobre olho seco e superfície ocular.
        </p>
      </div>

      <form
        id="newsletter-form"
        method="post"
        action={newsletterEndpoint}
        data-endpoint={newsletterEndpoint}
        novalidate
      >
        <div class="field-grid">
          <div class="field">
            <label for="newsletter-name">Nome</label>
            <input
              id="newsletter-name"
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </div>
          <div class="field">
            <label for="newsletter-email">E-mail</label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
            />
          </div>
          <div class="field">
            <label for="newsletter-profession">
              Profissão <span>(opcional)</span>
            </label>
            <input
              id="newsletter-profession"
              name="profession"
              type="text"
              autocomplete="organization-title"
            />
          </div>
        </div>

        <div class="honeypot" aria-hidden="true">
          <label for="newsletter-company">Empresa</label>
          <input
            id="newsletter-company"
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <label class="consent" for="newsletter-consent">
          <input
            id="newsletter-consent"
            name="consent"
            type="checkbox"
            value="accepted"
            required
          />
          <span>
            Concordo com o tratamento dos meus dados para receber comunicações
            editoriais, conforme a <a href="/privacidade"
              >Política de Privacidade</a
            >.
          </span>
        </label>

        <div class="form-footer">
          <button type="submit">Quero receber as atualizações</button>
          <p id="newsletter-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    type EventName =
      | "view_book"
      | "click_book"
      | "click_purchase"
      | "newsletter_signup"
      | "click_superficie";

    const analyticsWindow = window as Window & {
      dataLayer?: Array<Record<string, unknown>>;
    };

    const track = (
      event: EventName,
      properties: Record<string, string> = {},
    ) => {
      analyticsWindow.dataLayer = analyticsWindow.dataLayer ?? [];
      analyticsWindow.dataLayer.push({ event, ...properties });
      window.dispatchEvent(
        new CustomEvent("olhossecos:analytics", {
          detail: { event, ...properties },
        }),
      );
    };

    document
      .querySelectorAll<HTMLElement>("[data-event]")
      .forEach((element) => {
        element.addEventListener("click", () => {
          const event = element.dataset.event as EventName;
          if (!event) return;
          track(event, {
            ...(element.dataset.book ? { book: element.dataset.book } : {}),
            ...(element.dataset.store ? { store: element.dataset.store } : {}),
          });
        });
      });

    const observedBooks =
      document.querySelectorAll<HTMLElement>("[data-book-slug]");
    const viewed = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const slug = (entry.target as HTMLElement).dataset.bookSlug;
          if (!slug || viewed.has(slug)) return;
          viewed.add(slug);
          track("view_book", { book: slug });
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.35 },
    );
    observedBooks.forEach((book) => observer.observe(book));

    const form = document.querySelector<HTMLFormElement>("#newsletter-form");
    const status = document.querySelector<HTMLElement>("#newsletter-status");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const endpoint = form.dataset.endpoint;
      if (!endpoint) return;

      const submit = form.querySelector<HTMLButtonElement>(
        "button[type='submit']",
      );
      form.setAttribute("aria-busy", "true");
      if (submit) submit.disabled = true;
      if (status) status.textContent = "Enviando…";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const result = (await response.json().catch(() => null)) as {
          message?: string;
        } | null;
        if (!response.ok) {
          throw new Error(result?.message ?? "newsletter_request_failed");
        }
        form.reset();
        if (status) {
          status.textContent =
            result?.message ?? "Cadastro realizado. Obrigado.";
        }
        track("newsletter_signup");
      } catch (error) {
        if (status) {
          status.textContent =
            error instanceof Error &&
            error.message !== "newsletter_request_failed"
              ? error.message
              : "Não foi possível concluir agora. Tente novamente mais tarde.";
        }
      } finally {
        form.removeAttribute("aria-busy");
        if (submit) submit.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .books-hero {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(100% 100% at 85% 20%, #f0f6f7 0%, transparent 60%),
      linear-gradient(180deg, #ffffff 0%, #f7f9f9 100%);
  }

  .books-hero :global(.breadcrumbs) {
    padding-top: 1.2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(420px, 0.95fr);
    min-height: 640px;
    align-items: center;
    gap: clamp(3rem, 6vw, 7rem);
    padding-block: 2.5rem 4.5rem;
  }

  .hero-kicker {
    display: inline-block;
    color: #7b5a1f;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 0.9rem;
  }

  .hero-copy h1 {
    max-width: 760px;
    margin: 0;
    font-family: var(--serif);
    font-size: var(--text-headline);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.96;
    color: var(--navy-900);
  }

  .hero-subtitle {
    max-width: 620px;
    margin: 1.4rem 0 0;
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: var(--text-lead);
    line-height: 1.35;
  }

  .hero-intro {
    max-width: 690px;
    margin: 1.2rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-ui);
    line-height: 1.65;
  }

  .hero-signature {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-md);
    background: #ffffff;
    border: 1px solid var(--line);
    box-shadow: 0 4px 14px rgb(4 20 47 / 4%);
  }

  .hero-signature-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .hero-signature-text .author-name {
    font-family: var(--serif);
    font-size: var(--text-ui);
    font-weight: 700;
    color: var(--navy-900);
  }

  .hero-signature-text .author-role {
    color: var(--ink-soft);
    font-size: var(--text-meta);
  }

  /* Vitrine Visual 3D do Hero */
  .hero-library {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem 0;
  }

  .hero-showcase {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 2.2rem);
    width: 100%;
    z-index: 2;
  }

  .hero-book-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(46%, 245px);
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .hero-book-wrap:hover {
    transform: translateY(-8px) scale(1.02);
  }

  .book-badge-tag {
    position: absolute;
    top: -0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--navy-900);
    color: #d4af37;
    border: 1px solid #b28a42;
    font-size: var(--text-meta);
    font-weight: 700;
    letter-spacing: 0.05em;
    z-index: 3;
    box-shadow: 0 2px 8px rgb(0 0 0 / 20%);
  }

  .book-left {
    transform: translateY(-1.2rem) rotate(-1.5deg);
  }

  .book-right {
    transform: translateY(0.4rem) rotate(1.8deg);
  }

  .hero-book-wrap :global(.book-cover) {
    width: 100%;
    border-radius: var(--radius-sm);
    box-shadow:
      0 24px 44px rgb(4 20 47 / 18%),
      0 6px 16px rgb(4 20 47 / 10%),
      inset 0 0 0 1px rgb(255 255 255 / 15%);
  }

  .hero-plinth {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 24px;
    margin-top: -12px;
    z-index: 1;
  }

  .plinth-surface {
    display: block;
    width: 100%;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgb(4 20 47 / 20%) 0%,
      transparent 72%
    );
  }

  .plinth-accent {
    display: block;
    width: 60%;
    height: 2px;
    margin: 4px auto 0;
    background: linear-gradient(90deg, transparent, #b28a42, transparent);
  }

  .featured-books {
    background: white;
  }

  .section-intro {
    display: grid;
    grid-template-columns: 0.7fr 1.25fr 1fr;
    gap: 2rem;
    align-items: end;
    padding-block: clamp(4rem, 7vw, 6.5rem) 2.4rem;
  }

  .section-intro p,
  .section-label {
    margin: 0;
    color: #7b5a1f;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-intro h2,
  .expansion h2,
  .author-section h2,
  .newsletter-section h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--text-h1);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--navy-900);
  }

  .section-intro > span {
    max-width: 380px;
    color: var(--ink-soft);
    font-size: var(--text-meta);
  }

  .expansion {
    overflow: hidden;
    border-block: 1px solid var(--line);
    background: #f4f7f7;
  }

  .expansion-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: clamp(2rem, 8vw, 9rem);
    align-items: center;
    min-height: 350px;
    padding-block: 4rem;
  }

  .expansion-mark {
    color: #0a6b7c;
    font-family: var(--serif);
    font-size: var(--text-numeral);
    font-weight: 400;
    line-height: 0.5;
    opacity: 0.1;
  }

  .expansion p {
    max-width: 760px;
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-ui);
    line-height: 1.6;
  }

  /* Seção SUPERFÍCIE com Capa Real */
  .ecosystem {
    display: grid;
    grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
    gap: clamp(3rem, 7vw, 8rem);
    align-items: center;
    padding-block: clamp(5rem, 8vw, 8rem);
    border-bottom: 1px solid var(--line);
  }

  .superficie-cover-card {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .superficie-cover-frame {
    position: relative;
    width: min(100%, 300px);
    border-radius: var(--radius-sm);
    box-shadow:
      0 28px 60px rgb(4 20 47 / 22%),
      0 8px 20px rgb(4 20 47 / 12%);
    transition: transform var(--duration-standard) var(--ease-standard);
  }

  .superficie-cover-frame:hover {
    transform: translateY(-6px) scale(1.02);
  }

  .superficie-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.6rem;
  }

  .superficie-name {
    margin: 0;
    font-family: var(--serif);
    font-size: var(--text-h1);
    letter-spacing: 0.03em;
    line-height: 1;
    color: var(--navy-900);
  }

  .superficie-status-badge {
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--paper-100);
    border: 1px solid #b28a42;
    color: #7b5a1f;
    font-size: var(--text-meta);
    font-weight: 750;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .ecosystem h2 {
    max-width: 720px;
    margin: 0.5rem 0 0;
    font-family: var(--serif);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: 1.2;
    color: var(--navy-800);
  }

  .superficie-tagline {
    margin: 0.85rem 0 0;
    color: var(--teal-dark);
    font-size: var(--text-ui);
    font-weight: 750;
  }

  .ecosystem-copy > p:not(.superficie-name, .superficie-tagline) {
    max-width: 760px;
    margin: 1.2rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .superficie-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-superficie-reader {
    display: inline-flex;
    align-items: center;
