---
import Layout from "@/layouts/Layout.astro";
import { primarySources } from "@/lib/sources";
---

<Layout
  title="Fontes e revisão"
  description="Conheça as instituições, consensos e materiais de pacientes usados como base para o conteúdo do portal."
>
  <header class="page-intro">
    <div class="page-shell">
      <h1 class="page-title">Fontes e revisão</h1>
      <p>
        O portal prioriza consensos científicos, instituições públicas,
        organizações sem fins lucrativos e materiais produzidos para pacientes.
        Referências específicas também aparecem ao final de cada guia.
      </p>
    </div>
  </header>

  <section class="sources-section">
    <div class="page-shell sources-layout">
      <aside>
        <h2>Como escolhemos</h2>
        <p>
          Procuramos autoria institucional clara, revisão identificável,
          atualização recente, linguagem responsável e separação entre educação e
          interesse comercial.
        </p>
        <a class="text-link" href="/politica-editorial">
          Ler a política editorial
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h16m-5-5 5 5-5 5"></path>
          </svg>
        </a>
      </aside>
      <div class="source-list">
        {
          primarySources.map((source, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p>{source.type}</p>
                <h2>{source.name}</h2>
                <p>{source.description}</p>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  Acessar fonte original ↗
                </a>
                <small>Link verificado em {source.verified}.</small>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .sources-section {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .sources-layout {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: clamp(4rem, 9vw, 9rem);
  }

  .sources-layout > aside {
    position: sticky;
    top: 130px;
    align-self: start;
  }

  .sources-layout > aside h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
  }

  .sources-layout > aside p {
    margin: 1.5rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .source-list {
    border-top: 1px solid var(--line);
  }

  .source-list article {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .source-list article > span {
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: 2.5rem;
  }

  .source-list article div > p:first-child {
    margin: 0 0 0.5rem;
    color: var(--teal-dark);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .source-list h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .source-list h2 + p {
    margin: 0.8rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .source-list a {
    color: var(--teal-dark);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .source-list small {
    display: block;
    margin-top: 0.7rem;
    color: #64748a;
    font-size: 0.7rem;
  }

  @media (max-width: 850px) {
    .sources-layout {
      grid-template-columns: 1fr;
    }

    .sources-layout > aside {
      position: static;
    }
  }
</style>
