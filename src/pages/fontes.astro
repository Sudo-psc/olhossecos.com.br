---
import Layout from "@/layouts/Layout.astro";
import { openImageCredits } from "@/lib/figures";
import { primarySources } from "@/lib/sources";
---

<Layout
  title="Fontes e revisão"
  description="Conheça as instituições, consensos e materiais de pacientes usados como base para o conteúdo do portal."
  dateModified="2026-08-05"
>
  <header class="page-intro">
    <div class="page-shell">
      <h1 class="page-title">Fontes e revisão</h1>
      <p>
        O portal prioriza consensos científicos, instituições públicas,
        organizações sem fins lucrativos e materiais produzidos para pacientes.
        Referências específicas também aparecem ao final de cada guia.
      </p>
    </div>
  </header>

  <section class="sources-section">
    <div class="page-shell sources-layout">
      <aside>
        <h2>Como escolhemos</h2>
        <p>
          Procuramos autoria institucional clara, revisão identificável,
          atualização recente, linguagem responsável e separação entre educação
          e interesse comercial.
        </p>
        <a class="text-link" href="/politica-editorial">
          Ler a política editorial
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h16m-5-5 5 5-5 5"></path>
          </svg>
        </a>
      </aside>
      <div class="source-list">
        {
          primarySources.map((source, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <div>
                <p>{source.type}</p>
                <h2>{source.name}</h2>
                <p>{source.description}</p>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  Acessar fonte original ↗
                </a>
                <small>Link verificado em {source.verified}.</small>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="image-credits-section" aria-labelledby="image-credits-title">
    <div class="page-shell image-credits-layout">
      <div>
        <p class="eyebrow">Transparência visual</p>
        <h2 id="image-credits-title">Créditos das figuras abertas</h2>
        <p>
          Figuras externas só são usadas quando autoria, arquivo e licença podem
          ser conferidos. As adaptações técnicas são informadas, e o crédito
          também aparece junto da imagem.
        </p>
      </div>
      <div class="image-credit-list">
        {
          openImageCredits.map((image) => (
            <article>
              <h3>{image.title}</h3>
              <p>
                Autor: {image.author}. {image.modification}
              </p>
              <div>
                <a
                  href={image.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver arquivo original ↗
                </a>
                <a
                  href={image.licenseUrl}
                  target="_blank"
                  rel="noopener noreferrer license"
                >
                  {image.licenseLabel} ↗
                </a>
              </div>
            </article>
          ))
        }
        <p class="ai-disclosure">
          As ilustrações originais geradas com IA são identificadas nas próprias
          legendas. Algumas usam estilo visual realista, mas não são
          fotografias, exames, protocolos ou resultados clínicos reais.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .sources-section {
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .image-credits-section {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--line);
    background: var(--mist);
  }

  .image-credits-layout {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: clamp(4rem, 9vw, 9rem);
  }

  .image-credits-layout > div:first-child h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1;
  }

  .image-credits-layout > div:first-child > p:last-child {
    max-width: 440px;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: var(--teal-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .image-credit-list {
    border-top: 1px solid var(--line);
  }

  .image-credit-list article {
    padding-block: 1.8rem;
    border-bottom: 1px solid var(--line);
  }

  .image-credit-list h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.7rem;
  }

  .image-credit-list article p,
  .ai-disclosure {
    color: var(--ink-soft);
    font-size: 0.84rem;
  }

  .image-credit-list article div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.2rem;
  }

  .image-credit-list a {
    color: var(--teal-dark);
    font-size: 0.76rem;
    font-weight: 750;
  }

  .ai-disclosure {
    margin: 1.5rem 0 0;
  }

  .sources-layout {
    display: grid;
    grid-template-columns: 0.65fr 1.35fr;
    gap: clamp(4rem, 9vw, 9rem);
  }

  .sources-layout > aside {
    position: sticky;
    top: 130px;
    align-self: start;
  }

  .sources-layout > aside h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 2.6rem;
    line-height: 1;
  }

  .sources-layout > aside p {
    margin: 1.5rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .source-list {
    border-top: 1px solid var(--line);
  }

  .source-list article {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 1.5rem;
    padding-block: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  .source-list article > span {
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: 2.5rem;
  }

  .source-list article div > p:first-child {
    margin: 0 0 0.5rem;
    color: var(--teal-dark);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .source-list h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.05;
  }

  .source-list h2 + p {
    margin: 0.8rem 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .source-list a {
    color: var(--teal-dark);
    font-size: 0.78rem;
    font-weight: 750;
  }

  .source-list small {
    display: block;
    margin-top: 0.7rem;
    color: #64748a;
    font-size: 0.7rem;
  }

  @media (max-width: 850px) {
    .sources-layout,
    .image-credits-layout {
      grid-template-columns: 1fr;
    }

    .sources-layout > aside {
      position: static;
    }
  }
</style>
