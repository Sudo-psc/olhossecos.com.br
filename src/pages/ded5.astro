---
import Layout from '../layouts/Layout.astro';

// DEQ-5 (Dry Eye Questionnaire 5) page
---

<Layout
  title="Questionário de Olho Seco DEQ-5 | Avaliação Online"
  description="Realize o questionário DEQ-5 validado cientificamente para avaliar o nível de desconforto e ressecamento dos seus olhos em menos de 1 minuto."
>
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8 bg-white p-8 md:p-12 rounded-xl shadow-sm border border-stone-200 relative overflow-hidden">

      <!-- Progress Bar -->
      <div id="progress-container" class="absolute top-0 left-0 w-full h-1.5 bg-stone-100 hidden">
        <div id="progress-bar" class="h-full bg-teal-700 transition-all duration-500 ease-out" style="width: 0%"></div>
      </div>

      <!-- Intro Step -->
      <div id="step-intro" class="text-center space-y-6">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-[#EEF2F1] border border-stone-200 rounded-full mb-4">
          <svg class="w-10 h-10 text-teal-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-semibold text-brand leading-tight">
          Teste de Olho Seco <span class="text-gradient">DEQ-5</span>
        </h1>
        <p class="text-slate-600 text-lg max-w-lg mx-auto">
          O DEQ-5 é um questionário validado cientificamente para medir a gravidade dos sintomas de olho seco. Responda 5 perguntas rápidas e descubra seu índice.
        </p>
        <div class="pt-4">
          <button id="btn-start" class="btn-premium btn-premium-primary text-lg w-full sm:w-auto">
            Começar Avaliação
          </button>
        </div>
        <p class="text-xs text-slate-400">
          *Este questionário é uma ferramenta de triagem e não substitui o diagnóstico médico especializado.
        </p>
      </div>

      <!-- Quiz Step (Dynamic) -->
      <div id="step-quiz" class="hidden space-y-8">
        <div id="question-container" class="space-y-6">
          <span id="question-number" class="eyebrow block">Pergunta 1 de 5</span>
          <h2 id="question-text" class="text-2xl font-semibold text-brand">Texto da Pergunta</h2>
          <div id="options-container" class="grid gap-4">
            <!-- Options will be injected here -->
          </div>
        </div>
      </div>

      <!-- Lead Capture Step -->
      <div id="step-lead" class="hidden space-y-8">
        <div class="text-center">
          <h2 class="text-3xl font-semibold text-brand mb-4">Quase lá!</h2>
          <p class="text-slate-600">
            Preencha seus dados para calcular seu score DEQ-5 e receber a recomendação personalizada:
          </p>
        </div>

        <form id="lead-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-slate-700 mb-1 font-ui">Nome Completo</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-[10px] border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-700/20 focus:border-teal-700" placeholder="Seu nome">
          </div>
          <div>
            <label for="whatsapp" class="block text-sm font-medium text-slate-700 mb-1 font-ui">WhatsApp</label>
            <input type="tel" id="whatsapp" name="whatsapp" required class="w-full px-4 py-3 rounded-[10px] border border-stone-200 focus:outline-none focus:ring-2 focus:ring-teal-700/20 focus:border-teal-700" placeholder="(00) 00000-0000">
          </div>
          <button type="submit" class="btn-premium btn-premium-primary w-full text-lg mt-4">
            Ver Resultado do Score
          </button>
        </form>
      </div>

      <!-- Result Step -->
      <div id="step-result" class="hidden space-y-8 text-center">
        <div id="result-icon-container" class="inline-flex items-center justify-center w-20 h-20 bg-[#EEF2F1] rounded-full mb-4 transition-colors duration-500">
          <span id="result-emoji" class="text-4xl">📊</span>
        </div>
        <div class="space-y-2">
          <h2 id="result-title" class="text-3xl font-bold text-brand">Seu Score DEQ-5: 12</h2>
          <p id="result-classification" class="text-xl font-semibold text-teal-700 uppercase tracking-wide font-ui">Olho Seco Grave</p>
        </div>
        
        <div id="result-description" class="text-slate-600 text-lg space-y-4 text-left bg-[#F7F6F3] p-6 rounded-2xl border border-stone-200">
          <!-- Description will be injected here -->
        </div>

        <div class="bg-alt p-6 rounded-2xl border border-stone-200 text-center">
          <h3 class="text-xl font-semibold text-brand mb-2">Agende uma Avaliação Precisa</h3>
          <p class="text-slate-600 mb-6">
            O tratamento precoce evita danos crônicos à visão. Fale com nossa equipe agora mesmo.
          </p>
          <a id="whatsapp-link" href="#" target="_blank" class="btn-premium btn-premium-primary w-full sm:w-auto flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Enviar Resultado via WhatsApp
          </a>
        </div>
        
        <button id="btn-restart" class="text-sm text-slate-400 underline hover:text-teal-700">
          Refazer o questionário
        </button>
      </div>

    </div>
  </div>

  <script is:inline>
    const questions = [
      {
        question: "Com que frequência seus olhos sentem desconforto?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      },
      {
        question: "Quão intenso é o desconforto ocular no final do dia?",
        options: [
          { text: "Não sinto desconforto", score: 0 },
          { text: "Muito leve", score: 1 },
          { text: "Leve", score: 2 },
          { text: "Moderado", score: 3 },
          { text: "Intenso", score: 4 },
          { text: "Muito intenso", score: 5 }
        ]
      },
      {
        question: "Com que frequência seus olhos parecem secos?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      },
      {
        question: "Quão intenso é o ressecamento ocular no final do dia?",
        options: [
          { text: "Não sinto ressecamento", score: 0 },
          { text: "Muito leve", score: 1 },
          { text: "Leve", score: 2 },
          { text: "Moderado", score: 3 },
          { text: "Intenso", score: 4 },
          { text: "Muito intenso", score: 5 }
        ]
      },
      {
        question: "Com que frequência sua visão fica embaçada?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Raramente", score: 1 },
          { text: "Às vezes", score: 2 },
          { text: "Frequentemente", score: 3 },
          { text: "Constantemente", score: 4 }
        ]
      }
    ];

    let currentStep = 'intro';
    let currentQuestionIndex = 0;
    let totalScore = 0;
    let userAnswers = [];

    const steps = {
      intro: document.getElementById('step-intro'),
      quiz: document.getElementById('step-quiz'),
      lead: document.getElementById('step-lead'),
      result: document.getElementById('step-result')
    };

    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');

    function showStep(stepName) {
      Object.keys(steps).forEach(key => {
        steps[key].classList.add('hidden');
      });
      steps[stepName].classList.remove('hidden');
      currentStep = stepName;

      if (stepName === 'quiz' || stepName === 'lead') {
        progressContainer.classList.remove('hidden');
      } else {
        progressContainer.classList.add('hidden');
      }
    }

    function updateProgress() {
      const progress = ((currentQuestionIndex) / questions.length) * 100;
      progressBar.style.width = `${progress}%`;
    }

    function renderQuestion() {
      const q = questions[currentQuestionIndex];
      document.getElementById('question-number').textContent = `Pergunta ${currentQuestionIndex + 1} de ${questions.length}`;
      document.getElementById('question-text').textContent = q.question;
      
      const optionsContainer = document.getElementById('options-container');
      optionsContainer.innerHTML = '';
      
      q.options.forEach((opt, idx) => {
        const button = document.createElement('button');
        button.className = "text-left px-6 py-4 rounded-[10px] border border-stone-200 hover:border-teal-700 hover:bg-[#EEF2F1] transition-all font-medium text-slate-700";
        button.textContent = opt.text;
        button.onclick = () => handleAnswer(opt.score);
        optionsContainer.appendChild(button);
      });
      
      updateProgress();
    }

    function handleAnswer(score) {
      totalScore += score;
      userAnswers.push(score);
      
      if (currentQuestionIndex < questions.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        progressBar.style.width = '100%';
        setTimeout(() => {
          showStep('lead');
        }, 300);
      }
    }

    function calculateResult() {
      let classification = "";
      let description = "";
      let emoji = "📊";
      let colorClass = "bg-[#EEF2F1]";
      
      if (totalScore < 6) {
        classification = "Normal / Sintomas Leves";
        emoji = "✨";
        colorClass = "bg-green-50";
        description = "<p>Seu score DEQ-5 indica que seus sintomas estão dentro da normalidade ou são muito leves.</p><p><strong>Dica:</strong> Continue cuidando da sua lubrificação ocular, especialmente se você passa muito tempo em frente a telas.</p>";
      } else if (totalScore < 12) {
        classification = "Olho Seco Sugestivo (Leve a Moderado)";
        emoji = "⚠️";
        colorClass = "bg-yellow-50";
        description = "<p>Seu score indica a presença de sintomas sugestivos de Olho Seco de intensidade moderada.</p><p><strong>Recomendação:</strong> Você pode estar sofrendo de instabilidade lacrimal. Uma avaliação clínica é recomendada para identificar a causa e evitar a progressão.</p>";
      } else {
        classification = "Olho Seco Grave";
        emoji = "💧";
        colorClass = "bg-red-50";
        description = "<p>Seu score atingiu um nível crítico, o que é fortemente sugestivo de <strong>Olho Seco Grave</strong> ou disfunção severa do filme lacrimal.</p><p><strong>Urgência:</strong> É fundamental realizar uma Meibografia e uma avaliação especializada para iniciar o tratamento adequado (como a Luz Pulsada IRPL) e restaurar seu conforto ocular.</p>";
      }
      
      document.getElementById('result-title').textContent = `Seu Score DEQ-5: ${totalScore}`;
      document.getElementById('result-classification').textContent = classification;
      document.getElementById('result-emoji').textContent = emoji;
      document.getElementById('result-description').innerHTML = description;
      document.getElementById('result-icon-container').className = `inline-flex items-center justify-center w-20 h-20 rounded-full mb-4 transition-colors duration-500 ${colorClass}`;
      
      // Update WhatsApp Link
      const name = document.getElementById('name').value;
      const whatsappMsg = encodeURIComponent(`Olá! Meu nome é ${name}. Fiz o questionário DEQ-5 no site e meu score foi ${totalScore} (${classification}). Gostaria de agendar uma avaliação para tratar meus sintomas.`);
      document.getElementById('whatsapp-link').href = `https://wa.me/5533998601427?text=${whatsappMsg}`;
    }

    // Event Listeners
    document.getElementById('btn-start').onclick = () => {
      showStep('quiz');
      renderQuestion();
    };

    document.getElementById('lead-form').onsubmit = (e) => {
      e.preventDefault();
      
      // Collect lead data
      const name = document.getElementById('name').value;
      const whatsapp = document.getElementById('whatsapp').value;
      
      // Logic for sending to API if needed
      console.log('Lead:', { name, whatsapp, score: totalScore });
      
      calculateResult();
      showStep('result');
    };

    document.getElementById('btn-restart').onclick = () => {
      currentQuestionIndex = 0;
      totalScore = 0;
      userAnswers = [];
      showStep('intro');
    };
  </script>
</Layout>
