---
import Layout from "@/layouts/Layout.astro";
import { portals } from "@/lib/portals";

const homeTitle =
  "Olho seco: sintomas, tratamento e ciência da superfície ocular";
const homeDescription =
  "Portal sobre olho seco e superfície ocular. Escolha entre o conteúdo explicativo para pacientes e o material técnico para profissionais de saúde.";

/**
 * A raiz virou porta, não vitrine: ela só separa os dois públicos e sai da
 * frente. O que mantém a página indexável é o texto de abertura e os links
 * reais dos dois lados — um par de botões sozinho não diria ao buscador nem
 * ao leitor do que o site trata.
 */
const paths = [
  {
    id: "paciente",
    index: "01",
    audience: "Para quem sente",
    title: "Entender o que acontece nos meus olhos",
    text: "Ardência, sensação de areia, visão que oscila, olho que lacrimeja justamente por estar ressecado. O que cada sintoma sugere, como a investigação é feita e o que o tratamento pretende — sem promessa de cura.",
    highlights: [
      "Sintomas, causas e sinais de alerta",
      "Como o diagnóstico é construído",
      "Tratamentos e autocuidado no dia a dia",
      "Guias de leitura curta, com fontes",
    ],
    cta: "Entrar no portal do paciente",
    href: portals.paciente.home,
    event: "patient_path_click",
  },
  {
    id: "profissional",
    index: "02",
    audience: "Para quem trata",
    title: "Acompanhar a evolução da superfície ocular",
    text: "Diagnóstico multimodal, fenotipagem, imagem, terapias dirigidas por mecanismo e leitura crítica da evidência — com o grau e a limitação de cada achado declarados ao lado do número.",
    highlights: [
      "SUPERFÍCIE, a revista da superfície ocular",
      "RADAR Científico, curadoria de evidência",
      "Artigos com desenho, amostra e ressalva",
      "Livros do autor e área de parceiros",
    ],
    cta: "Entrar no portal profissional",
    href: portals.profissional.home,
    event: "professional_path_click",
  },
];
---

<Layout
  image="/images/og/og-home.png"
  title={homeTitle}
  description={homeDescription}
  imageAlt="Olhos Secos — ciência e informação sobre superfície ocular"
  dateModified="2026-08-24"
>
  <section class="gateway" aria-labelledby="gateway-title">
    <div class="page-shell">
      <p class="eyebrow">Olho seco • Superfície ocular</p>
      <h1 id="gateway-title">Duas leituras da mesma doença. Escolha a sua.</h1>
      <p class="gateway-lead">
        O olho seco é explicado de um jeito para quem convive com os sintomas e
        de outro para quem investiga e trata. Em vez de misturar os dois num
        único site, aqui eles são portais separados — com o mesmo rigor e as
        mesmas fontes.
      </p>

      <p class="gateway-resume" data-resume hidden>
        <span>Na última visita você escolheu</span>
        <a data-resume-link href={portals.paciente.home}>o portal do paciente</a
        >
      </p>

      <div class="gateway-grid">
        {
          paths.map((path) => (
            <article class="gateway-card" data-path={path.id}>
              <p class="gateway-kicker">
                <span class="gateway-index">{path.index}</span>
                {path.audience}
              </p>
              <h2>{path.title}</h2>
              <p class="gateway-text">{path.text}</p>
              <ul class="gateway-highlights">
                {path.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a
                class="gateway-cta"
                href={path.href}
                data-portal-choice={path.id}
                data-analytics-event={path.event}
              >
                {path.cta}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>

      <div class="gateway-shortcuts">
        <p>Sabe o que procura?</p>
        <ul>
          <li><a href="/olho-seco">O que é olho seco</a></li>
          <li><a href="/sinais-de-alerta">Sinais de alerta</a></li>
          <li><a href="/superficie">Revista SUPERFÍCIE</a></li>
          <li><a href="/glossario">Glossário</a></li>
          <li><a href="/fontes">Fontes</a></li>
          <li><a href="/newsletter">Newsletter</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<script>
  declare global {
    interface Window {
      dataLayer?: Record<string, unknown>[];
    }
  }

  const STORAGE_KEY = "olhossecos:portal";

  const labels: Record<string, { label: string; href: string }> = {
    paciente: { label: "o portal do paciente", href: "/paciente" },
    profissional: { label: "o portal profissional", href: "/profissional" },
  };

  const emit = (event: string, details: Record<string, string> = {}) => {
    const payload = { event, ...details };
    window.dataLayer = window.dataLayer ?? [];
    window.dataLayer.push(payload);
    window.dispatchEvent(
      new CustomEvent("olhossecos:analytics", { detail: payload }),
    );
  };

  // A escolha é lembrada, nunca aplicada sozinha: um redirect automático
  // roubaria da pessoa a única decisão que esta página existe para oferecer,
  // e quebraria quem chega por link compartilhado querendo o outro lado.
  const readChoice = () => {
    try {
      return window.localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  };

  const previous = readChoice();
  const known = previous ? labels[previous] : undefined;
  const resume = document.querySelector<HTMLElement>("[data-resume]");
  const resumeLink =
    document.querySelector<HTMLAnchorElement>("[data-resume-link]");

  if (known && resume && resumeLink) {
    resumeLink.textContent = known.label;
    resumeLink.href = known.href;
    resume.hidden = false;
    document
      .querySelector(`[data-path="${previous}"]`)
      ?.setAttribute("data-remembered", "true");
  }

  document
    .querySelectorAll<HTMLAnchorElement>("[data-portal-choice]")
    .forEach((link) => {
      link.addEventListener("click", () => {
        const choice = link.dataset.portalChoice;
        if (!choice) return;
        try {
          window.localStorage.setItem(STORAGE_KEY, choice);
        } catch {
          // Navegação privada e armazenamento bloqueado: a escolha só não é
          // lembrada. Nada mais na página depende disso.
        }
        emit(link.dataset.analyticsEvent ?? "patient_path_click", {
          placement: "gateway",
          link_url: link.getAttribute("href") ?? "",
        });
      });
    });
</script>

<style>
  .gateway {
    padding: clamp(3rem, 2rem + 5vw, 6rem) 0 var(--space-section);
  }

  .gateway h1 {
    margin: 0.6rem 0 0;
    max-width: 20ch;
    font-family: var(--serif);
    font-size: var(--text-h1);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .gateway-lead {
    margin: 1.1rem 0 0;
    max-width: var(--measure-narrow);
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }

  .gateway-resume {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--mist);
    font-size: var(--text-small);
  }

  .gateway-resume span {
    color: var(--ink-soft);
  }

  .gateway-resume a {
    color: var(--teal-dark);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gateway-resume a:hover {
    color: var(--ink);
  }

  .gateway-grid {
    display: grid;
    gap: clamp(1rem, 0.6rem + 1.6vw, 1.75rem);
    margin-top: clamp(2rem, 1.4rem + 2vw, 3.25rem);
  }

  @media (min-width: 900px) {
    .gateway-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gateway-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--paper);
    box-shadow: var(--shadow-card);
    /* A elevação usa filter porque o anel de foco de dois tons já ocupa o
       box-shadow — na mesma propriedade uma esconderia a outra. */
    transition:
      filter var(--duration-base) var(--ease-out-soft),
      border-color var(--duration-base) var(--ease-out-soft),
      transform var(--duration-base) var(--ease-out-soft);
  }

  .gateway-card:hover,
  .gateway-card:focus-within {
    filter: var(--lift-hover);
    border-color: var(--teal);
    transform: translateY(-2px);
  }

  .gateway-card[data-remembered] {
    border-color: var(--teal);
    background: linear-gradient(180deg, var(--mist), var(--paper) 46%);
  }

  .gateway-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-meta);
    font-weight: 750;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }

  .gateway-index {
    color: var(--teal-dark);
    font-family: var(--mono);
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .gateway-card h2 {
    margin: 0.9rem 0 0;
    font-family: var(--serif);
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .gateway-text {
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
  }

  .gateway-highlights {
    margin: 1.25rem 0 0;
    padding: 1.15rem 0 0;
    border-top: 1px solid var(--line-soft);
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  .gateway-highlights li {
    position: relative;
    padding-left: 1.4rem;
    font-size: var(--text-small);
  }

  .gateway-highlights li::before {
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    content: "";
  }

  .gateway-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    margin-top: auto;
    padding: 0.85rem 1.4rem;
    border-radius: var(--control-radius);
    background: var(--ink);
    color: white;
    font-weight: 700;
    /* margin-top:auto encosta o botão no rodapé do cartão; este afastamento
       garante o respiro quando os dois textos têm alturas diferentes. */
    margin-block-start: 1.75rem;
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .gateway-cta svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gateway-cta:hover {
    background: var(--teal-dark);
  }

  .gateway-cta:active {
    background: var(--navy-900);
  }

  .gateway-shortcuts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    margin-top: clamp(2rem, 1.4rem + 2vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-soft);
  }

  .gateway-shortcuts p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-small);
    font-weight: 700;
  }

  .gateway-shortcuts ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gateway-shortcuts a {
    color: var(--teal-dark);
    font-size: var(--text-small);
    font-weight: 650;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .gateway-shortcuts a:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .gateway-card {
      transition: none;
    }

    .gateway-card:hover,
    .gateway-card:focus-within {
      transform: none;
    }
  }
</style>
