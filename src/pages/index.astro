---
import Layout from "@/layouts/Layout.astro";
import { essentialContents, homeJourneys, superficieTopics } from "@/lib/home";

const homeTitle = "Olho Seco e Superfície Ocular | Conteúdo, Livros e Ciência";
const homeDescription =
  "Informação sobre sintomas, diagnóstico e tratamento do olho seco, além de conteúdo profissional, livros, tecnologia e a revista SUPERFÍCIE.";
---

<Layout
  title={homeTitle}
  description={homeDescription}
  imageAlt="Olhos Secos — ciência e informação sobre superfície ocular"
  dateModified="2026-08-07"
>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">Olho seco • Superfície ocular • Ciência</p>
        <h1 id="home-title">
          Entenda o olho seco. Acompanhe a evolução da superfície ocular.
        </h1>
        <p class="hero-lead">
          Informação baseada em evidências para quem convive com sintomas de
          olho seco e para profissionais que acompanham a evolução do
          diagnóstico, da tecnologia e do tratamento da superfície ocular.
        </p>
        <div class="hero-actions">
          <a
            class="hero-button hero-button-primary"
            href="/olho-seco"
            data-home-event="patient_path_click"
          >
            Tenho sintomas de olho seco
          </a>
          <a
            class="hero-button hero-button-secondary"
            href="/profissionais"
            data-home-event="professional_path_click"
          >
            Sou profissional de saúde
          </a>
        </div>
        <p class="ecosystem-line">
          <span>Livros</span><span>Revista</span><span>Evidências</span><span
            >Tecnologia</span
          >
        </p>
      </div>

      <div class="hero-visual">
        <p class="visual-label">Superfície ocular • Filme lacrimal</p>
        <picture>
          <source
            type="image/avif"
            srcset="/images/hero-tear-film-720.avif 720w, /images/hero-tear-film-1448.avif 1448w"
            sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 640px"
          />
          <source
            type="image/webp"
            srcset="/images/hero-tear-film-720.webp 720w, /images/hero-tear-film-1448.webp 1448w"
            sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 640px"
          />
          <img
            src="/images/hero-tear-film.png"
            alt="Composição editorial da superfície ocular e das camadas do filme lacrimal"
            width="1448"
            height="1086"
            fetchpriority="high"
          />
        </picture>
        <aside class="science-index" aria-label="Índice científico">
          <span>03</span>
          <p>
            Camadas interdependentes contribuem para estabilidade, proteção e
            qualidade óptica da superfície ocular.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <nav class="audience-rail" aria-label="Escolha sua jornada">
    <a
      href="/olho-seco"
      data-home-event="patient_path_click"
      data-home-placement="audience_rail"
    >
      <span class="audience-index">01</span>
      <span class="audience-label">Para pacientes</span>
      <strong>Entender sintomas, causas e possibilidades de cuidado</strong>
      <small>Explorar olho seco →</small>
    </a>
    <a
      href="/profissionais"
      data-home-event="professional_path_click"
      data-home-placement="audience_rail"
    >
      <span class="audience-index">02</span>
      <span class="audience-label">Para profissionais</span>
      <strong>Diagnóstico, imagem, tecnologia e evidência clínica</strong>
      <small>Acessar área profissional →</small>
    </a>
  </nav>

  <section class="journeys" aria-labelledby="journeys-title">
    <div class="page-shell">
      <header class="section-intro">
        <p class="section-kicker">Duas jornadas, um mesmo rigor editorial</p>
        <h2 id="journeys-title">Informação certa para cada momento</h2>
        <p>
          Olho seco pode representar desde sintomas ocasionais associados ao
          ambiente e às telas até uma doença complexa da superfície ocular.
          Escolha o caminho mais adequado ao que você procura.
        </p>
      </header>

      <div class="journey-grid">
        {
          homeJourneys.map((journey, index) => (
            <article class:list={["journey", `journey-${journey.audience}`]}>
              <header>
                <span class="journey-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p>{journey.eyebrow}</p>
                <h3>{journey.title}</h3>
              </header>
              <p class="journey-description">{journey.description}</p>
              <nav aria-label={`Tópicos: ${journey.title}`}>
                {journey.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    <span>↗</span>
                  </a>
                ))}
              </nav>
              <a
                class="journey-cta"
                href={journey.cta.href}
                data-home-event={
                  journey.audience === "patient"
                    ? "patient_path_click"
                    : "professional_path_click"
                }
                data-home-placement="journey"
              >
                {journey.cta.label} <span>→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="essentials" aria-labelledby="essentials-title">
    <div class="page-shell">
      <header class="essentials-heading">
        <div>
          <p class="section-kicker">Conteúdos essenciais</p>
          <h2 id="essentials-title">Comece por aqui</h2>
        </div>
        <p>Guias fundamentais para compreender a doença do olho seco.</p>
      </header>

      <div class="essential-grid">
        {
          essentialContents.map((content, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>
                <a href={content.href}>{content.label}</a>
              </h3>
              <p>{content.description}</p>
              <a
                class="essential-link"
                href={content.href}
                data-home-event="article_click"
                data-home-content={content.label}
              >
                Ler conteúdo →
              </a>
            </article>
          ))
        }
      </div>

      <a class="all-content-link" href="/guias">Ver todos os conteúdos →</a>
    </div>
  </section>

  <section class="surface-feature" aria-labelledby="surface-title">
    <div class="page-shell surface-grid">
      <div class="surface-copy">
        <p class="surface-signature">Olho Seco • Córnea • Tecnologia</p>
        <h2 id="surface-title">SUPERFÍCIE</h2>
        <p class="surface-descriptor">
          Revista de Olho Seco e Superfície Ocular
        </p>
        <h3>Evidência que chega à prática.</h3>
        <p class="surface-intro">
          Uma publicação periódica dedicada à atualização clínica, científica e
          tecnológica da superfície ocular, reunindo análise, evidências,
          especialistas, diagnóstico, terapias e inovação.
        </p>
        <div class="surface-actions">
          <a
            class="surface-button surface-button-primary"
            href="/superficie"
            data-home-event="superficie_click"
          >
            Conheça a SUPERFÍCIE
          </a>
          <a
            class="surface-button surface-button-secondary"
            href="/livros#newsletter"
            data-home-event="superficie_issue_click"
          >
            Receba a próxima edição
          </a>
        </div>
      </div>

      <article class="founding-issue">
        <p class="issue-status">Edição Fundadora • Em desenvolvimento</p>
        <div class="issue-art" aria-hidden="true">
          <span class="issue-orbit"></span>
          <span class="issue-line"></span>
          <span class="issue-dot issue-dot-one"></span>
          <span class="issue-dot issue-dot-two"></span>
        </div>
        <div class="issue-content">
          <p>Edição Fundadora</p>
          <h3>A nova era da superfície ocular</h3>
          <span>
            Do sintoma ao fenótipo: diagnóstico multimodal e tratamento
            personalizado.
          </span>
          <ul aria-label="Temas previstos">
            {superficieTopics.slice(0, 4).map((topic) => <li>{topic}</li>)}
          </ul>
          <a href="/livros#newsletter" data-home-event="superficie_issue_click">
            Acompanhar o lançamento →
          </a>
        </div>
      </article>
    </div>
  </section>
</Layout>

<script>
  declare global {
    interface Window {
      dataLayer?: Record<string, unknown>[];
    }
  }

  const emitHomeEvent = (
    eventName: string,
    details: Record<string, string> = {},
  ) => {
    const payload = { event: eventName, ...details };
    window.dataLayer = window.dataLayer ?? [];
    window.dataLayer.push(payload);
    window.dispatchEvent(
      new CustomEvent("olhossecos:analytics", { detail: payload }),
    );
  };

  emitHomeEvent("home_view", { page_path: window.location.pathname });

  document
    .querySelectorAll<HTMLElement>("[data-home-event]")
    .forEach((item) => {
      item.addEventListener("click", () => {
        const eventName = item.dataset.homeEvent;
        if (!eventName) return;

        emitHomeEvent(eventName, {
          link_url: item.getAttribute("href") ?? "",
          link_text: item.textContent?.trim() ?? "",
          placement: item.dataset.homePlacement ?? "",
          content_title: item.dataset.homeContent ?? "",
        });
      });
    });
</script>

<style>
  .home-hero {
    min-height: min(790px, calc(100svh - var(--header-height)));
    display: grid;
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid #d8d7d1;
    background: #f7f6f1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.03fr 0.97fr;
    align-items: center;
    gap: clamp(3rem, 6vw, 7rem);
    padding-block: clamp(4.5rem, 7vw, 7.5rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow,
  .section-kicker {
    margin: 0;
    color: var(--teal-dark);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    max-width: 790px;
    margin: 1.2rem 0 0;
    font-family: var(--serif);
    font-size: clamp(3.6rem, 5.6vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .hero-lead {
    max-width: 680px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.04rem, 1.35vw, 1.2rem);
    line-height: 1.65;
  }

  .hero-actions,
  .surface-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2.25rem;
  }

  .hero-button,
  .surface-button {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.35rem;
    border: 1px solid var(--ink);
    border-radius: var(--control-radius);
    font-size: 0.91rem;
    font-weight: 800;
    line-height: 1.2;
    transition:
      background 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .hero-button:hover,
  .surface-button:hover {
    transform: translateY(-2px);
  }

  .hero-button-primary {
    border-color: var(--teal-dark);
    background: var(--teal-dark);
    color: white;
  }

  .hero-button-primary:hover {
    background: var(--teal-dark);
  }

  .hero-button-secondary:hover {
    background: white;
  }

  .ecosystem-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.8rem;
    margin: 2rem 0 0;
    color: #586477;
    font-size: 0.74rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ecosystem-line span {
    position: relative;
  }

  .ecosystem-line span + span::before {
    position: absolute;
    top: 50%;
    left: -1rem;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #b69a64;
    content: "";
  }

  .hero-visual {
    position: relative;
    padding-top: 3.35rem;
    background: white;
  }

  .hero-visual::before {
    position: absolute;
    z-index: 0;
    inset: 8% -12% -8% 15%;
    border: 1px solid #d8d7d1;
    content: "";
  }

  .hero-visual picture {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
  }

  .visual-label {
    position: absolute;
    z-index: 2;
    top: 1.25rem;
    left: 2rem;
    margin: 0;
    color: #88691f;
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-visual img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.04);
  }

  .science-index {
    position: absolute;
    z-index: 2;
    right: -1.5rem;
    bottom: -2rem;
    width: min(82%, 410px);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    padding: 1.2rem 1.35rem;
    border-top: 2px solid #b69a64;
    background: var(--ink);
    color: white;
  }

  .science-index > span {
    color: #d9c59c;
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
  }

  .science-index p {
    margin: 0;
    color: rgb(255 255 255 / 66%);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .audience-rail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  .audience-rail a {
    min-height: 152px;
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr);
    align-content: center;
    gap: 0.35rem;
    padding: 2rem max(2rem, calc((100vw - 1340px) / 2));
    transition: background 180ms ease;
  }

  .audience-rail a:first-child {
    padding-left: max(2rem, calc((100vw - 1340px) / 2));
    border-right: 1px solid var(--line);
  }

  .audience-rail a:last-child {
    padding-right: max(2rem, calc((100vw - 1340px) / 2));
  }

  .audience-rail a:hover {
    background: #f3f8f9;
  }

  .audience-rail .audience-index {
    grid-row: 1 / 4;
    align-self: start;
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .audience-rail .audience-label {
    color: var(--teal-dark);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .audience-rail strong {
    grid-column: 2;
    max-width: 560px;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 550;
    line-height: 1.15;
  }

  .audience-rail small {
    grid-column: 2;
    margin-top: 0.3rem;
    color: var(--ink-soft);
    font-weight: 750;
  }

  .journeys,
  .essentials {
    padding-block: clamp(5.5rem, 9vw, 9rem);
  }

  .section-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    column-gap: clamp(3rem, 8vw, 9rem);
  }

  .section-intro .section-kicker {
    grid-column: 1 / -1;
    margin-bottom: 1.2rem;
  }

  .section-intro h2,
  .essentials-heading h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 5.4vw, 5.8rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .section-intro > p:last-child {
    align-self: end;
    margin: 0;
    color: var(--ink-soft);
  }

  .journey-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .journey {
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 4vw, 4rem);
  }

  .journey + .journey {
    border-left: 1px solid var(--line);
  }

  .journey header {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
  }

  .journey-number {
    grid-row: 1 / 3;
    color: #a18a60;
    font-family: var(--serif);
    font-size: 1.7rem;
  }

  .journey header p {
    margin: 0 0 0.7rem;
    color: var(--teal-dark);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .journey h3 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.3rem, 3.8vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .journey-description {
    max-width: 650px;
    margin: 1.8rem 0 2.3rem;
    color: var(--ink-soft);
  }

  .journey nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-bottom: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .journey nav a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .journey nav a:nth-child(odd) {
    padding-right: 1.1rem;
  }

  .journey nav a:nth-child(even) {
    padding-left: 1.1rem;
    border-left: 1px solid var(--line);
  }

  .journey nav a:hover {
    color: var(--teal-dark);
  }

  .journey-cta {
    width: fit-content;
    display: inline-flex;
    gap: 0.8rem;
    margin-top: auto;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-weight: 800;
  }

  .essentials {
    border-top: 1px solid #e4e8eb;
    background: #fbfbf9;
  }

  .essentials-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .essentials-heading .section-kicker {
    margin-bottom: 1rem;
  }

  .essentials-heading > p {
    max-width: 390px;
    margin: 0 0 0.45rem;
    color: var(--ink-soft);
  }

  .essential-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .essential-grid article {
    min-height: 300px;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: white;
  }

  .essential-grid article > span {
    color: #745e36;
    font-family: var(--serif);
    font-size: 1.45rem;
  }

  .essential-grid h3 {
    margin: 2.5rem 0 0;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 2.2vw, 2.25rem);
    font-weight: 550;
    line-height: 1.08;
  }

  .essential-grid h3 a:hover {
    color: var(--teal-dark);
  }

  .essential-grid p {
    margin: 1rem 0 1.7rem;
    color: var(--ink-soft);
    font-size: 0.91rem;
  }

  .essential-link {
    width: fit-content;
    margin-top: auto;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .all-content-link {
    display: block;
    width: fit-content;
    margin: 2.2rem 0 0 auto;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-weight: 800;
  }

  .surface-feature {
    overflow: hidden;
    padding-block: clamp(5.5rem, 9vw, 9rem);
    background: var(--ink);
    color: white;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    align-items: center;
    gap: clamp(4rem, 8vw, 9rem);
  }

  .surface-signature {
    margin: 0 0 1.2rem;
    color: #d9c59c;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .surface-copy h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(4.5rem, 8vw, 8.5rem);
    font-weight: 500;
    letter-spacing: -0.07em;
    line-height: 0.82;
  }

  .surface-descriptor {
    margin: 1.2rem 0 3rem;
    color: rgb(255 255 255 / 65%);
    font-size: 0.9rem;
  }

  .surface-copy h3 {
    max-width: 670px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(2.7rem, 4.6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .surface-intro {
    max-width: 680px;
    margin: 1.8rem 0 0;
    color: rgb(255 255 255 / 72%);
  }

  .surface-button {
    border-color: white;
  }

  .surface-button-primary {
    background: white;
    color: var(--ink);
  }

  .surface-button-secondary {
    color: white;
  }

  .surface-button-secondary:hover {
    background: white;
    color: var(--ink);
  }

  .founding-issue {
    position: relative;
    min-height: 650px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(1.5rem, 3vw, 3rem);
    border: 1px solid rgb(217 197 156 / 55%);
    background: #0b2448;
  }

  .issue-status {
    position: relative;
    z-index: 2;
    margin: 0;
    color: #d9c59c;
    font-size: 0.68rem;
    font-weight: 850;
