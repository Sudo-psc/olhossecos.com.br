---

import Layout from '../layouts/Layout.astro';

const symptoms = [
  { iconBase: "/optimized/icons/symptom-ardencia", title: "Ardência", desc: "Sensação de queimação constante nos olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-prurido", title: "Coceira", desc: "Desejo frequente de esfregar os olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-visao-turva", title: "Visão Turva", desc: "Embaçamento que melhora ao piscar.", isSpecial: true, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-vermelhidao", title: "Vermelhidão", desc: "Olhos irritados e avermelhados no final do dia.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-corpo-estranho", title: "Corpo Estranho", desc: "Sensação de areia ou cisco nos olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-lacrimejamento", title: "Lacrimejamento", desc: "Olhos que lacrimejam como resposta à irritação.", isSpecial: false, width: 256, height: 140 }
];

const diagnostics = [
  { 
    id: "meibografia",
    title: "Meibografia", 
    desc: "Exame avançado que avalia a estrutura das glândulas de Meibomius.", 
    iconBase: "/optimized/icons/diagnostic-meibografia",
    width: 256,
    height: 256
  },
  { 
    id: "meniscometria",
    title: "Meniscometria a BUT", 
    desc: "Mede o volume e a estabilidade da camada lacrimal.", 
    iconBase: "/optimized/icons/diagnostic-meniscometria",
    width: 256,
    height: 256
  }
];



const faqs = [
  { q: "O que é olho seco?", a: "Olho seco é uma alteração da película de lágrimas que recobre a superfície dos olhos, podendo causar ardência, sensação de areia, visão embaçada e cansaço visual. Ele pode ter várias causas, como envelhecimento, uso de telas, ambiente seco, uso de lentes de contato, alguns colírios e doenças sistêmicas." },
  { q: "Qual o melhor tratamento para ardor nos olhos?", a: "O ardor nos olhos é um dos principais sintomas do olho seco evaporativo. O tratamento mais moderno disponível na clínica é a Luz Pulsada (IRPL), que trata a causa raiz do problema ao estimular as glândulas de Meibômio, reduzindo a dependência de colírios." },
  { q: "Sentir ardor nos olhos ao usar o computador é normal?", a: "Não é normal. O ardor nos olhos durante o uso de telas (celular, computador) geralmente indica que a lágrima está evaporando muito rápido. Isso requer uma avaliação especializada para identificar se há Disfunção das Glândulas de Meibômio." },
  { q: "Se um teste indicar que meu risco de olho seco é alto, isso significa que eu realmente tenho a doença?", a: "Um questionário ou teste de triagem sinaliza que há maior chance de você ter olho seco, mas não substitui o exame completo com o oftalmologista. Além disso, outros problemas oculares podem causar sintomas parecidos, por isso o diagnóstico definitivo depende de avaliação em consultório." }
];

const heroPreload = {
    src: "/optimized/heroeye-800.avif",
    srcset: "/optimized/heroeye-637.avif 637w, /optimized/heroeye-800.avif 800w",
    sizes: "(min-width: 1024px) 50vw, 100vw",
    type: "image/avif"
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout 
    title="Tratamento para Ardor nos Olhos e Olho Seco | Saraiva Vision"
    preloadImage={heroPreload}
    schema={faqSchema}
>
  
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-white to-[#f0f7ff] min-h-[90vh] flex items-center">
    <div class="absolute top-0 right-0 w-1/2 h-full hidden lg:block opacity-100">
        <div class="w-full h-full relative">
            <div class="absolute inset-0 bg-gradient-to-r from-[#f0f7ff] via-[#f0f7ff]/50 to-transparent z-10"></div>
            <picture>
                <source
                    type="image/avif"
                    srcset="/optimized/heroeye-637.avif 637w, /optimized/heroeye-800.avif 800w"
                    sizes="(min-width: 1024px) 50vw, 100vw"
                />
                <source
                    type="image/webp"
                    srcset="/optimized/heroeye-637.webp 637w, /optimized/heroeye-800.webp 800w"
                    sizes="(min-width: 1024px) 50vw, 100vw"
                />
                <img
                    src="/optimized/heroeye-800.webp"
                    alt="Cuidado Oftalmológico Humanizado"
                    width="800"
                    height="446"
                    class="w-full h-full object-cover object-left-top"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                />
            </picture>
        </div>
    </div>

    <div class="container relative z-20 py-20">
        <div class="max-w-3xl">
            <div class="badge-soft mb-6">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
                </span>
                Clínica Especializada em Olho Seco
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-[#003D7A] mb-6">
                Tratamento para <span class="text-gradient">Ardor nos Olhos</span> e Olho Seco
            </h1>

            <p class="text-lg md:text-xl text-gray-600 mb-10 leading-relaxed max-w-xl font-medium">
                Sabemos o quanto a ardência e o desconforto atrapalham seu dia a dia. Vá além do alívio momentâneo dos colírios: conheça tratamentos que atuam na causa do olho seco e recupere sua qualidade de vida.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
                <a href="https://wa.me/5533998601427" onclick="return gtag_report_conversion('https://wa.me/5533998601427')" class="btn-premium btn-premium-primary w-full sm:w-auto text-lg flex items-center justify-center gap-3">
                    <svg class="w-6 h-6 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.411-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    <span>Agendar Minha Avaliação</span>
                </a>
                <a href="/tratamentos/luz-pulsada-irpl" class="btn-premium btn-premium-secondary w-full sm:w-auto text-lg">
                    Conhecer IRPL
                </a>
            </div>

            <div class="flex flex-wrap gap-3">
                <a href="/quiz" class="badge-soft hover:bg-cyan-100 transition-colors !text-sm">📝 Quiz Olho Seco</a>
                <a href="/calculadora-olho-seco" class="badge-soft hover:bg-cyan-100 transition-colors !text-sm">💰 Calcular custos</a>
                <a href="/testerapido" class="badge-soft hover:bg-cyan-100 transition-colors !text-sm">⏱️ Teste dos 10s</a>
                <a href="/widget" class="badge-soft hover:bg-cyan-100 transition-colors !text-sm">🖥️ App 20-20-20 grátis</a>
            </div>
        </div>
    </div>
  </section>

  <!-- CTA Calculadora -->
  <section class="section-padding bg-alt">
    <div class="container">
      <div class="bg-white rounded-[2rem] p-8 md:p-12 shadow-xl border border-gray-100 flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-[#003D7A] mb-3">Calcule o preço estimado do seu tratamento</h2>
          <p class="text-gray-600">Selecione os itens e veja o custo mensal e anual em tempo real.</p>
        </div>
        <a href="/calculadora-olho-seco" class="btn-premium btn-premium-primary text-lg shadow-lg">
          Abrir calculadora
        </a>
      </div>
    </div>
  </section>

  <!-- 2. O que é Olho Seco -->
  <section id="olho-seco" class="section-padding bg-white">
    <div class="container">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div class="relative">
                <div class="aspect-square rounded-full border-[10px] border-blue-50 overflow-hidden shadow-2xl">
                    <picture>
                        <source
                            type="image/avif"
                            srcset="/optimized/hero-premium-512.avif 512w, /optimized/hero-premium-768.avif 768w"
                            sizes="(min-width: 768px) 40vw, 80vw"
                        />
                        <source
                            type="image/webp"
                            srcset="/optimized/hero-premium-512.webp 512w, /optimized/hero-premium-768.webp 768w"
                            sizes="(min-width: 768px) 40vw, 80vw"
                        />
                        <img
                            src="/optimized/hero-premium-512.webp"
                            alt="O que é olho seco"
                            width="512"
                            height="512"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
                        />
                    </picture>
                </div>
                <!-- Floating Card -->
                <div class="absolute bottom-10 -right-6 bg-white p-6 rounded-2xl shadow-xl border-l-4 border-cyan-500 max-w-xs animate-float hidden md:block">
                    <p class="text-cyan-900 font-bold text-lg mb-1">“Não é normal sentir dor.”</p>
                    <p class="text-gray-500 text-sm">O olho seco é uma doença crônica que exige tratamento, não apenas alívio momentâneo.</p>
                </div>
            </div>
            <div>
                <span class="text-cyan-500 font-bold tracking-widest text-sm uppercase mb-2 block"> Entenda a Doença </span>
                <h2 class="text-3xl md:text-5xl font-bold text-[#003D7A] mb-6">Tratamento de Olho Seco: por que seus olhos incomodam tanto?</h2>
                <p class="text-gray-600 text-lg mb-6 leading-relaxed">
                    Muitos pacientes chegam ao consultório acreditando que a sensação de <strong>areia, ardor e visão embaçada</strong> é "normal" devido ao uso de telas ou idade. NÃO É.
                </p>
                <p class="text-gray-600 text-lg mb-8 leading-relaxed">
                    A Síndrome do Olho Seco é uma falha na lubrificação que deixa seus olhos desprotegidos contra o ambiente. Sem a lágrima adequada, a superfície ocular inflama, causando as "pontadas" e o desconforto que você sente.
                </p>
                
                <div class="space-y-5">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                            <span class="text-2xl">🛡️</span>
                        </div>
                        <div>
                            <h4 class="font-bold text-[#003D7A] text-lg">Inflamação Crônica</h4>
                            <p class="text-gray-500">Se não tratada, a inflamação pode causar danos permanentes à superfície dos seus olhos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- 3. Sintomas -->
  <section class="section-padding bg-alt">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <h2 class="text-3xl md:text-5xl font-bold text-[#003D7A] mb-4 uppercase tracking-tight">Você se identifica?</h2>
            <p class="text-gray-600 text-lg">Se você sente algum destes sintomas com frequência, seus olhos estão pedindo ajuda.</p>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {symptoms.map(s => (
                <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-gray-100 text-center group cursor-default h-full">
                    <div class="h-52 mb-6 transform group-hover:scale-110 transition-transform flex items-center justify-center">
                        <picture>
                            <source
                                type="image/avif"
                                srcset={`${s.iconBase}-256.avif 256w, ${s.iconBase}-384.avif 384w`}
                                sizes={s.isSpecial ? "(min-width: 768px) 240px, 200px" : "(min-width: 768px) 160px, 140px"}
                            />
                            <source
                                type="image/webp"
                                srcset={`${s.iconBase}-256.webp 256w, ${s.iconBase}-384.webp 384w`}
                                sizes={s.isSpecial ? "(min-width: 768px) 240px, 200px" : "(min-width: 768px) 160px, 140px"}
                            />
                            <img
                                src={`${s.iconBase}-256.webp`}
                                alt={s.title}
                                width={s.width}
                                height={s.height}
                                loading="lazy"
                                decoding="async"
                                class={`h-full object-contain ${s.isSpecial ? 'w-60' : 'w-40'} drop-shadow-md`}
                            />
                        </picture>
                    </div>
                    <h3 class="font-bold text-[#003D7A] text-lg mb-2">{s.title}</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">{s.desc}</p>
                </div>
            ))}
        </div>
    </div>
  </section>

  <!-- 3.5 Causas -->
  <section class="section-padding bg-white overflow-hidden">
    <div class="container">
        <div class="grid md:grid-cols-2 gap-20 items-center">
            <div>
                <h2 class="text-3xl md:text-5xl font-bold text-[#003D7A] mb-8">O que está causando isso?</h2>
                <p class="text-gray-600 mb-8 text-lg">
                    Não é apenas "falta de água". Na maioria das vezes, o problema está nas glândulas que produzem a gordura que protege a lágrima.
                </p>
                <div class="space-y-6">
                    <div class="flex gap-4 p-4 rounded-xl hover:bg-blue-50 transition-colors">
                        <span class="text-3xl">📱</span>
                        <div>
                            <h4 class="font-bold text-[#003D7A] mb-1">Disfunção e Telas</h4>
                            <p class="text-gray-600 text-sm">Ao olhar para telas, piscamos 5x menos. Isso faz com que as glândulas de óleo "sequem" e atrofiem.</p>
                        </div>
                    </div>
                     <div class="flex gap-4 p-4 rounded-xl hover:bg-blue-50 transition-colors">
                        <span class="text-3xl">🌬️</span>
                        <div>
                            <h4 class="font-bold text-[#003D7A] mb-1">Ambiente Agressivo</h4>
                            <p class="text-gray-600 text-sm">Ar-condicionado e poluição aceleram a evaporação da lágrima, deixando o olho exposto.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="relative hidden md:block text-center">
                 <div class="relative inline-block">
                     <div class="absolute inset-0 bg-blue-200 rounded-full blur-3xl opacity-30 animate-pulse"></div>
                     <picture>
                        <source
                            type="image/avif"
                            srcset="/optimized/meibografia-640.avif 640w, /optimized/meibografia-896.avif 896w"
                            sizes="(min-width: 1024px) 448px, 0px"
                        />
                        <source
                            type="image/webp"
                            srcset="/optimized/meibografia-640.webp 640w, /optimized/meibografia-896.webp 896w"
                            sizes="(min-width: 1024px) 448px, 0px"
                        />
                        <img
                            src="/optimized/meibografia-640.webp"
                            alt="Glândulas de Meibomius"
                            width="640"
                            height="640"
                            loading="lazy"
                            decoding="async"
                            class="relative z-10 w-full max-w-md mx-auto drop-shadow-2xl hover:scale-105 transition-transform duration-500"
                        />
                     </picture>
                 </div>
                 <p class="text-center text-sm text-gray-400 mt-4">Imagem de Meibografia: visualizando a saúde das glândulas.</p>
            </div>
        </div>
    </div>
  </section>

  <!-- 3.7 Dry Eye Widget (Open Source) -->
  <section class="section-padding bg-gradient-to-br from-[#022B57] via-[#003D7A] to-[#0c4a6e] text-white relative overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl"></div>
    <div class="container relative z-10">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-400/15 border border-cyan-300/30 text-cyan-200 text-xs font-bold uppercase tracking-widest mb-6">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/></svg>
                    Open Source · Gratuito · MIT
                </div>
                <h2 class="text-3xl md:text-5xl font-bold mb-6">Dry Eye Widget: a regra <span class="text-cyan-300">20-20-20</span> na sua tela</h2>
                <p class="text-blue-100 text-lg leading-relaxed mb-8">
                    Sua tela não avisa quando seus olhos precisam de pausa — este widget avisa. Um lembrete gentil e flutuante para macOS e Windows, desenvolvido pelo Dr. Philipe Saraiva Cruz para prevenir a fadiga visual digital e o olho seco.
                </p>
                <ul class="space-y-3 mb-10 text-blue-50">
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full bg-cyan-400/20 flex items-center justify-center text-cyan-300 text-sm shrink-0">✓</span> Desenvolvido por médico oftalmologista</li>
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full bg-cyan-400/20 flex items-center justify-center text-cyan-300 text-sm shrink-0">✓</span> 100% local — nenhum dado coletado</li>
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full bg-cyan-400/20 flex items-center justify-center text-cyan-300 text-sm shrink-0">✓</span> Gratuito e de código aberto (licença MIT)</li>
                </ul>
                <div class="flex flex-wrap gap-4">
                    <a href="/widget" class="btn-premium btn-premium-primary text-lg">
                        Conhecer o app
                    </a>
                    <a href="https://github.com/Sudo-psc/dry-eye-widget" target="_blank" rel="noopener" class="btn-premium bg-white/10 text-white border border-white/25 hover:bg-white/20 text-lg backdrop-blur-sm">
                        Ver no GitHub
                    </a>
                </div>
            </div>
            <div class="hidden lg:flex justify-center">
                <!-- Mockup do widget -->
                <div class="relative">
                    <div class="absolute inset-0 bg-cyan-400/20 rounded-full blur-3xl"></div>
                    <div class="relative bg-slate-900/80 backdrop-blur-xl rounded-[2rem] border border-white/15 p-8 w-80 shadow-2xl animate-float">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-2">
                                <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                                <span class="w-3 h-3 rounded-full bg-amber-400/80"></span>
                                <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                            </div>
                            <span class="text-[10px] uppercase tracking-widest text-slate-400">Dry Eye Widget</span>
                        </div>
                        <div class="text-center mb-6">
                            <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center mb-4 shadow-lg shadow-cyan-500/40">
                                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                            </div>
                            <p class="text-white font-bold text-lg mb-1">Hora de descansar os olhos</p>
                            <p class="text-slate-400 text-sm">Olhe para algo a 6 metros de distância</p>
                        </div>
                        <div class="bg-slate-800/80 rounded-2xl p-4 text-center border border-white/5">
                            <p class="text-cyan-300 font-mono font-bold text-4xl tracking-wider">00:20</p>
                            <p class="text-slate-500 text-xs mt-1 uppercase tracking-wider">Pausa guiada</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- 4. Exames e Diagnóstico -->
  <section id="exames" class="section-padding bg-alt">
