---
import Layout from "@/layouts/Layout.astro";

const pathways = [
  {
    number: "01",
    title: "Estou sentindo desconforto",
    link: "Explorar sintomas",
    href: "/sintomas",
    icon: "eye",
  },
  {
    number: "02",
    title: "Recebi um diagnóstico",
    link: "Entender os tipos de olho seco",
    href: "/olho-seco#tipos",
    icon: "file",
  },
  {
    number: "03",
    title: "Quero cuidar melhor no dia a dia",
    link: "Ver práticas de autocuidado",
    href: "/autocuidado",
    icon: "drop",
  },
  {
    number: "04",
    title: "Quero entender as opções",
    link: "Conhecer tratamentos",
    href: "/tratamentos",
    icon: "paths",
  },
];

const articles = [
  {
    number: "01",
    title: "Telas, piscadas e desconforto",
    href: "/guias/telas-piscadas-desconforto",
    icon: "screen",
  },
  {
    number: "02",
    title: "Como organizar uma conversa sobre seus sintomas",
    href: "/guias/organizar-seus-sintomas",
    icon: "talk",
  },
  {
    number: "03",
    title: "Lubrificantes, géis e pomadas: perguntas úteis",
    href: "/guias/lubrificantes-perguntas-uteis",
    icon: "drop",
  },
];
---

<Layout>
  <section class="hero">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <h1>Entender o olho seco muda a forma de cuidar.</h1>
        <p>
          Informação clara, acolhedora e baseada em evidências para você
          reconhecer sintomas, conversar melhor sobre o diagnóstico e participar
          das decisões de cuidado.
        </p>
        <div class="hero-actions">
          <a class="button-primary" href="/olho-seco">Começar pelo básico</a>
          <a class="text-link" href="/sinais-de-alerta">
            Ver sinais de alerta
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>
        <form class="portal-search" action="/guias" method="get">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="10.8" cy="10.8" r="6.7"></circle>
            <path d="m16 16 4.5 4.5"></path>
          </svg>
          <label class="sr-only" for="home-search">Buscar no portal</label>
          <input
            id="home-search"
            name="q"
            type="search"
            placeholder="O que você quer entender hoje?"
          />
          <button class="search-submit" type="submit">
            <span>Buscar</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </button>
        </form>
      </div>

      <div class="hero-visual">
        <picture>
          <source
            type="image/avif"
            srcset="/images/hero-tear-film-720.avif 720w, /images/hero-tear-film-1448.avif 1448w"
            sizes="(max-width: 720px) calc(100vw - 2rem), (max-width: 1100px) 85vw, 50vw"
          />
          <source
            type="image/webp"
            srcset="/images/hero-tear-film-720.webp 720w, /images/hero-tear-film-1448.webp 1448w"
            sizes="(max-width: 720px) calc(100vw - 2rem), (max-width: 1100px) 85vw, 50vw"
          />
          <img
            src="/images/hero-tear-film.png"
            alt="Ilustração editorial de um olho e das camadas do filme lacrimal"
            width="1448"
            height="1086"
            fetchpriority="high"
          />
        </picture>
        <div class="layer-label layer-one">
          <span></span>
          <strong>Camada lipídica</strong>
          <small>Ajuda a reduzir a evaporação</small>
        </div>
        <div class="layer-label layer-two">
          <span></span>
          <strong>Camada aquosa</strong>
          <small>Hidrata e nutre a superfície</small>
        </div>
        <div class="layer-label layer-three">
          <span></span>
          <strong>Camada mucínica</strong>
          <small>Ajuda o filme a se espalhar</small>
        </div>
      </div>
    </div>
    <div class="tear-line" aria-hidden="true"></div>
  </section>

  <aside class="urgent-band" aria-labelledby="urgent-title">
    <div class="page-shell urgent-grid">
      <svg class="urgent-icon" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M17 35h14M20 39h8M14 31h20l-3-5V17a7 7 0 0 0-14 0v9z"></path>
        <path d="M24 4v4M8 12l3 2M40 12l-3 2"></path>
      </svg>
      <h2 id="urgent-title">Quando procurar ajuda sem esperar</h2>
      <ul>
        <li>Dor intensa</li>
        <li>Perda ou mudança súbita da visão</li>
        <li>Trauma ou produto químico</li>
      </ul>
      <a class="text-link urgent-link" href="/sinais-de-alerta">
        Conheça todos os sinais
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </aside>

  <section class="pathways">
    <div class="page-shell pathways-grid">
      <header class="pathways-intro">
        <h2 class="section-heading">Comece por onde você está</h2>
        <span class="heading-rule"></span>
        <p>
          Não existe uma única porta de entrada. Escolha a pergunta que mais se
          aproxima do que você precisa hoje.
        </p>
        <div class="path-curve" aria-hidden="true"><span></span></div>
      </header>

      <ol class="pathway-list">
        {
          pathways.map((item) => (
            <li>
              <span class="pathway-number">{item.number}</span>
              <div>
                <h3>{item.title}</h3>
                <a class="text-link" href={item.href}>
                  {item.link}
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 12h16m-5-5 5 5-5 5" />
                  </svg>
                </a>
              </div>
              <span class={`pathway-icon pathway-${item.icon}`} aria-hidden="true">
                {item.icon === "eye" && (
                  <svg viewBox="0 0 48 48">
                    <path d="M5 24s7-11 19-11 19 11 19 11-7 11-19 11S5 24 5 24Z" />
                    <circle cx="24" cy="24" r="6" />
                  </svg>
                )}
                {item.icon === "file" && (
                  <svg viewBox="0 0 48 48">
                    <path d="M13 9h22v32H13zM19 5h10v8H19zM18 21h12M18 27h12M18 33h8" />
                  </svg>
                )}
                {item.icon === "drop" && (
                  <svg viewBox="0 0 48 48">
                    <path d="M24 7s10 11 10 20a10 10 0 0 1-20 0C14 18 24 7 24 7Z" />
                    <path d="M7 39c8-5 14-5 22 0 5 3 9 2 13-1" />
                  </svg>
                )}
                {item.icon === "paths" && (
                  <svg viewBox="0 0 48 48">
                    <path d="M24 41V9M24 24 11 13M24 24l13-11M24 9l-5 6M24 9l5 6M11 13v8M11 13h8M37 13v8M37 13h-8" />
                  </svg>
                )}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="tear-system">
    <div class="page-shell tear-system-grid">
      <div>
        <h2 class="section-heading">
          O filme lacrimal é um sistema — não apenas água.
        </h2>
        <span class="heading-rule"></span>
        <p>
          Quando quantidade, qualidade ou estabilidade se desequilibram, a
          superfície do olho pode perder proteção.
        </p>
        <a class="text-link" href="/olho-seco#filme-lacrimal">
          Entenda o que acontece no olho seco
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h16m-5-5 5 5-5 5"></path>
          </svg>
        </a>
      </div>

      <div class="tear-diagram" aria-label="Diagrama simplificado do filme lacrimal">
        <div class="tear-layers">
          <span class="lipid"></span>
          <span class="aqueous"></span>
          <span class="mucin"></span>
          <span class="surface"></span>
        </div>
        <dl>
          <div>
            <dt>Lipídica</dt>
            <dd>Ajuda a reduzir a evaporação e estabilizar o filme lacrimal.</dd>
          </div>
          <div>
            <dt>Aquosa</dt>
            <dd>Leva água, nutrientes e proteínas protetoras à superfície.</dd>
          </div>
          <div>
            <dt>Mucínica</dt>
            <dd>Contribui para que as lágrimas se distribuam pelo olho.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="library-preview">
    <div class="page-shell">
      <h2 class="section-heading">Aprenda no seu ritmo</h2>
      <span class="heading-rule"></span>
      <div class="library-grid">
        <a class="featured-guide" href="/guias/olho-seco-guia-essencial">
          <div class="featured-illustration" aria-hidden="true">
            <span class="abstract-eye"></span>
            <span class="abstract-drop"></span>
            <span class="dot-field"></span>
          </div>
          <div>
            <p>Guia essencial</p>
            <h3>Olho seco: o que é, por que acontece e por onde começar</h3>
            <span>
              Uma visão geral para quem recebeu o diagnóstico ou ainda está
              tentando entender os sintomas.
            </span>
            <strong class="text-link">
              Ler guia
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12h16m-5-5 5 5-5 5"></path>
              </svg>
            </strong>
          </div>
        </a>

        <ol class="article-list">
          {
            articles.map((article) => (
              <li>
                <a href={article.href}>
                  <span>{article.number}</span>
                  <h3>{article.title}</h3>
                  <span class={`mini-icon mini-${article.icon}`} aria-hidden="true">
                    {article.icon === "screen" && (
                      <svg viewBox="0 0 48 48">
                        <rect x="7" y="8" width="34" height="25" rx="2" />
                        <path d="M17 40h14M24 33v7" />
                      </svg>
                    )}
                    {article.icon === "talk" && (
                      <svg viewBox="0 0 48 48">
                        <path d="M6 10h25v18H17l-7 6v-6H6zM25 19h17v15H31l-6 5v-5" />
                      </svg>
                    )}
                    {article.icon === "drop" && (
                      <svg viewBox="0 0 48 48">
                        <path d="M24 5s12 14 12 25a12 12 0 0 1-24 0C12 19 24 5 24 5Z" />
                      </svg>
                    )}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      <a class="text-link all-guides" href="/guias">
        Ver todos os guias
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>

  <section class="trust">
    <div class="page-shell trust-grid">
      <h2>Como cuidamos da informação</h2>
      <div>
        <strong>Baseada em fontes confiáveis</strong>
        <p>Usamos consensos científicos e materiais de instituições reconhecidas.</p>
      </div>
      <div>
        <strong>Escrita para pacientes</strong>
        <p>Linguagem clara, acessível e focada no que importa no dia a dia.</p>
      </div>
      <div>
        <strong>Revisada e atualizada</strong>
        <p>Indicamos referências e datas de revisão para dar contexto ao conteúdo.</p>
      </div>
      <p class="trust-note">
        Você sempre pode consultar as referências usadas e a data da última
        revisão.
      </p>
      <a class="text-link" href="/politica-editorial">
        Conheça nossos critérios editoriais
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 5vw, 5rem) 0 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(520px, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .hero h1 {
    max-width: 700px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3.6rem, 4.5vw, 4.65rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .hero-copy > p {
    max-width: 680px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.62;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 2.6rem;
    margin-top: 2.2rem;
  }

  .portal-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    max-width: 700px;
    min-height: 62px;
    margin-top: 2.5rem;
    padding: 0.4rem 0.45rem 0.4rem 1rem;
    border: 1.5px solid var(--ink);
    border-radius: 8px;
    background: white;
  }

  .portal-search svg {
    width: 27px;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .portal-search input {
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--ink);
    font-size: 1rem;
  }

  .portal-search input::placeholder {
    color: #718099;
  }

  .portal-search .search-submit {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 6px;
    background: var(--teal-dark);
    color: white;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  .portal-search .search-submit:hover {
    background: var(--ink);
  }

  .portal-search .search-submit svg {
    width: 19px;
    stroke: currentColor;
    stroke-linejoin: round;
  }

  .hero-visual {
    position: relative;
    align-self: stretch;
    min-height: 520px;
  }

  .hero-visual img {
    position: absolute;
    top: 50%;
    right: -3%;
    width: min(820px, 104%);
    height: auto;
    transform: translateY(-50%);
  }

  .layer-label {
    position: absolute;
    right: -1%;
    display: grid;
    width: 150px;
    padding-left: 1rem;
    color: var(--ink-soft);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .layer-label::before {
    position: absolute;
    top: 0.55rem;
    right: 100%;
    width: 45px;
    height: 1px;
    background: var(--ink);
    content: "";
  }

  .layer-label > span {
    position: absolute;
    top: 0.35rem;
    left: -50px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }

  .layer-label strong {
    color: var(--ink);
    font-size: 0.73rem;
  }

  .layer-label small {
    margin-top: 0.25rem;
  }

  .layer-one {
    top: 25%;
  }

  .layer-two {
    top: 48%;
  }

  .layer-three {
    top: 70%;
  }

  .tear-line {
    position: absolute;
    right: 0;
    bottom: -20px;
    left: 0;
    height: 100px;
    border-top: 2px solid #30a7c3;
    border-radius: 50%;
    transform: rotate(-1deg);
  }

  .urgent-band {
    border-top: 1px solid #f1b1a9;
    border-bottom: 1px solid #f1b1a9;
    background: var(--coral-soft);
  }

  .urgent-grid {
    display: grid;
    grid-template-columns: auto minmax(470px, 0.9fr) 1.5fr auto;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    min-height: 170px;
  }

  .urgent-icon {
    width: 58px;
    fill: none;
    stroke: var(--coral);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .urgent-grid h2 {
    max-width: 320px;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.8rem, 2.4vw, 2.2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .urgent-grid ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .urgent-grid li {
    min-height: 60px;
    display: flex;
    align-items: center;
    padding-inline: 1.4rem;
    border-left: 1px solid #efbcb5;
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.4;
  }

  .urgent-link {
    color: var(--coral-text);
    font-size: 0.88rem;
  }

  .pathways {
    padding-block: clamp(6rem, 11vw, 11rem);
  }

  .pathways-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.45fr;
    gap: clamp(4rem, 9vw, 9rem);
  }

  .pathways-grid > *,
  .pathway-list,
  .pathway-list li > * {
    min-width: 0;
  }

  .pathways-intro {
    position: sticky;
    top: 130px;
    align-self: start;
  }

  .pathways-intro p {
    max-width: 430px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: 1.05rem;
  }

  .heading-rule {
    display: block;
    width: 52px;
    height: 4px;
    margin-top: 1.8rem;
    background: var(--teal);
  }

  .path-curve {
    position: relative;
    height: 170px;
    margin-top: 3rem;
    overflow: hidden;
  }

  .path-curve::before {
    position: absolute;
    top: 20px;
    left: 5%;
    width: 110%;
    height: 100px;
    border-top: 1.5px solid #38a9c1;
    border-radius: 50%;
    content: "";
    transform: rotate(8deg);
  }

  .path-curve span {
    position: absolute;
    right: 2%;
    bottom: 10px;
    width: 28px;
    height: 42px;
    border: 1.5px solid #38a9c1;
    border-radius: 50% 50% 55% 45% / 65% 65% 35% 35%;
    transform: rotate(45deg);
  }

  .pathway-list {
    position: relative;
    margin: 0;
    padding: 0 0 0 3rem;
    list-style: none;
  }

  .pathway-list::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--teal);
    content: "";
  }

  .pathway-list li {
    position: relative;
    display: grid;
    grid-template-columns: 110px 1fr 90px;
    align-items: center;
    gap: 1.7rem;
    min-height: 185px;
    border-bottom: 1px solid var(--line);
  }

  .pathway-list li:last-child {
    border-bottom: 0;
  }

  .pathway-list li::before {
    position: absolute;
    top: 50%;
    left: -3rem;
    width: 40px;
    height: 1px;
    background: var(--teal);
    content: "";
  }

  .pathway-number {
    font-family: var(--serif);
    font-size: 5rem;
    line-height: 1;
  }

  .pathway-list h3 {
    margin: 0 0 0.75rem;
    font-family: var(--serif);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .pathway-list .text-link {
    font-size: 0.88rem;
  }

  .pathway-icon {
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .pathway-icon svg {
    width: 42px;
    fill: none;
    stroke: var(--ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.4;
  }

  .tear-system {
    padding-block: clamp(5rem, 9vw, 9rem);
    background: var(--mist);
  }

  .tear-system-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: clamp(4rem, 8vw, 8rem);
  }

  .tear-system-grid > div:first-child > p {
    max-width: 490px;
    margin: 2rem 0;
    color: var(--ink-soft);
  }

  .tear-diagram {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2.5rem;
  }

  .tear-layers {
    position: relative;
    min-height: 490px;
    overflow: hidden;
    border-bottom: 1px solid #8aa9bf;
    background: white;
  }

  .tear-layers span {
    position: absolute;
    right: -12%;
    left: -12%;
    border-radius: 50% 50% 0 0;
  }

  .tear-layers .lipid {
    z-index: 4;
    top: 5%;
    height: 18%;
    border-top: 8px double #e0a33b;
    background: #fff1c7;
  }

  .tear-layers .aqueous {
    z-index: 3;
    top: 18%;
    height: 47%;
    background-color: #bfe8f5;
    background-image: radial-gradient(#74bcd2 2px, transparent 2px);
    background-size: 48px 48px;
  }

  .tear-layers .mucin {
    z-index: 2;
    top: 57%;
    height: 22%;
    border-top: 5px dotted #67a984;
    background: #c8e8d6;
  }

  .tear-layers .surface {
    z-index: 1;
    top: 70%;
    height: 45%;
    border-top: 3px solid #5b80ac;
    background: #dce7f1;
  }

  .tear-diagram dl {
    margin: 0;
  }

  .tear-diagram dl > div {
    padding: 1.35rem 0;
    border-bottom: 1px solid #9fc0cb;
  }

  .tear-diagram dt {
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: 1.55rem;
    font-weight: 650;
  }

  .tear-diagram dd {
