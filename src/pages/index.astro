---
import Layout from "@/layouts/Layout.astro";
import { formatLongDate } from "@/lib/dates";
import IssueCover from "@/components/superficie/IssueCover.astro";
import EyeExplorer from "@/components/science/EyeExplorer.astro";
import MechanismScrolly from "@/components/science/MechanismScrolly.astro";
import NewsletterSignupForm from "@/components/NewsletterSignupForm.astro";
import { essentialContents, homeJourneys, superficieTopics } from "@/lib/home";
import {
  calculateArticleReadingTime,
  founderIssue,
  getMagazineArticlePath,
  publishedArticles,
  sortPublishedArticlesByDate,
} from "@/lib/superficie";
import { guides } from "@/lib/guides";
import { author, books } from "@/lib/books";

const homeTitle = "Olho Seco e Superfície Ocular | Conteúdo, Livros e Ciência";
const homeDescription =
  "Informação sobre sintomas, diagnóstico e tratamento do olho seco, além de conteúdo profissional, livros, tecnologia e a revista SUPERFÍCIE.";

// A grande matéria é escolhida por slug, não pela ordem do array: a capa da
// home é decisão editorial e não deve mudar sozinha quando um artigo novo
// entrar na lista.
const latestArticles = sortPublishedArticlesByDate(publishedArticles);
const leadArticle =
  latestArticles.find(({ slug }) => slug === "tfos-dews-iii-na-pratica") ??
  latestArticles[0];
const recentArticles = latestArticles
  .filter(({ slug }) => slug !== leadArticle?.slug)
  .slice(0, 6);

const featuredGuide =
  guides.find(({ slug }) => slug === "olho-seco-guia-essencial") ?? guides[0];

// "Em 5 minutos": os guias mais curtos, lidos do próprio campo de tempo de
// leitura em vez de uma lista paralela que envelheceria sozinha.
const parseMinutes = (readingTime: string) =>
  Number.parseInt(readingTime, 10) || 99;
const quickGuides = guides
  .filter((guide) => guide.slug !== featuredGuide?.slug)
  .sort((a, b) => parseMinutes(a.readingTime) - parseMinutes(b.readingTime))
  .slice(0, 4);

const editorialGuides = guides
  .filter(
    (guide) =>
      guide.slug !== featuredGuide?.slug &&
      !quickGuides.some((quick) => quick.slug === guide.slug),
  )
  .slice(0, 5);

const featuredBooks = books.slice(0, 2);
---

<Layout
  image="/images/og/og-home.png"
  title={homeTitle}
  description={homeDescription}
  imageAlt="Olhos Secos — ciência e informação sobre superfície ocular"
  dateModified="2026-08-19"
>
  <!-- ------------------------------------------------------------- hero -->
  <section class="home-hero" aria-labelledby="home-title">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="hero-eyebrow">Olho seco • Superfície ocular • Ciência</p>
        <h1 id="home-title">
          Entenda o olho seco. Acompanhe a evolução da superfície ocular.
        </h1>
        <p class="hero-lead">
          Informação baseada em evidências para quem convive com sintomas de
          olho seco e para profissionais que acompanham a evolução do
          diagnóstico, da tecnologia e do tratamento da superfície ocular.
        </p>
        <div class="hero-actions">
          <a
            class="hero-button hero-button-primary"
            href="/olho-seco"
            data-home-event="patient_path_click"
          >
            Tenho sintomas de olho seco
          </a>
          <a
            class="hero-button hero-button-secondary"
            href="/profissionais"
            data-home-event="professional_path_click"
          >
            Sou profissional de saúde
          </a>
        </div>
        <p class="ecosystem-line">
          <span>Livros</span><span>Revista</span><span>Evidências</span><span
            >Tecnologia</span
          >
        </p>
      </div>

      <figure class="hero-visual" data-parallax>
        <p class="visual-label">Superfície ocular • Filme lacrimal</p>
        <div class="hero-frame">
          <video
            class="hero-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/images/hero-filme-lacrimal-1024.webp"
            aria-label="Animação dinâmica em loop da superfície ocular e estabilidade do filme lacrimal"
          >
            <source src="/videos/hero-ocular-surface.webm" type="video/webm" />
            <source src="/videos/hero-ocular-surface.mp4" type="video/mp4" />
            <picture>
              <source
                type="image/avif"
                srcset="/images/hero-filme-lacrimal-720.avif 720w, /images/hero-filme-lacrimal-1024.avif 1024w"
                sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 640px"
              />
              <source
                type="image/webp"
                srcset="/images/hero-filme-lacrimal-720.webp 720w, /images/hero-filme-lacrimal-1024.webp 1024w"
                sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 640px"
              />
              <img
                src="/images/hero-filme-lacrimal.jpg"
                alt="Composição editorial da superfície da córnea vista de perfil, com uma película lacrimal iridescente espalhada sobre a curva"
                width="1024"
                height="768"
                fetchpriority="high"
              />
            </picture>
          </video>
          <!-- Interferência do filme lacrimal: duas faixas que derivam devagar
               sobre a imagem. É o único movimento contínuo do hero, e some
               inteiro em prefers-reduced-motion. -->
          <svg
            class="hero-interference"
            viewBox="0 0 600 450"
            aria-hidden="true"
          >
            <path d="M-40 150 q150 -46 300 0 t300 0"></path>
            <path d="M-40 250 q150 46 300 0 t300 0"></path>
            <path d="M-40 340 q150 -34 300 0 t300 0"></path>
          </svg>
        </div>
        <figcaption class="science-index">
          <span>03</span>
          <p>
            Camadas interdependentes contribuem para estabilidade, proteção e
            qualidade óptica da superfície ocular.
          </p>
          <small>
            Ilustração original do portal · Vídeo e imagem gerados com IA para
            fins editoriais; representação esquemática, sem escala anatômica e
            não é registro clínico.
          </small>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ------------------------------------------------------- duas jornadas -->
  <nav class="audience-rail" aria-label="Escolha sua jornada">
    <a
      href="/olho-seco"
      data-home-event="patient_path_click"
      data-home-placement="audience_rail"
    >
      <span class="audience-index">01</span>
      <span class="audience-label">Para pacientes</span>
      <strong>Entender sintomas, causas e possibilidades de cuidado</strong>
      <small>Explorar olho seco →</small>
    </a>
    <a
      href="/profissionais"
      data-home-event="professional_path_click"
      data-home-placement="audience_rail"
    >
      <span class="audience-index">02</span>
      <span class="audience-label">Para profissionais</span>
      <strong>Diagnóstico, imagem, tecnologia e evidência clínica</strong>
      <small>Acessar área profissional →</small>
    </a>
  </nav>

  <!-- ---------------------------------------------------- a grande matéria -->
  {
    leadArticle && (
      <section class="lead-story" aria-labelledby="lead-story-title">
        <div class="page-shell lead-grid">
          <div class="lead-copy">
            <p class="lead-kicker">
              <span>Em destaque</span>
              <span>{leadArticle.category}</span>
            </p>
            <h2 id="lead-story-title">
              <a
                href={getMagazineArticlePath(leadArticle)}
                data-home-event="article_click"
                data-home-content={leadArticle.slug}
              >
                {leadArticle.title}
              </a>
            </h2>
            {leadArticle.subtitle && (
              <p class="lead-standfirst">{leadArticle.subtitle}</p>
            )}
            <p class="lead-excerpt">{leadArticle.excerpt}</p>
            <p class="lead-meta">
              <span>Por {leadArticle.author.name}</span>
              <span>
                {calculateArticleReadingTime(leadArticle)} min de leitura
              </span>
              <span>SUPERFÍCIE</span>
            </p>
            <a
              class="text-link"
              href={getMagazineArticlePath(leadArticle)}
              data-home-event="article_click"
              data-home-content={leadArticle.slug}
            >
              Ler a matéria
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12h16m-5-5 5 5-5 5" />
              </svg>
            </a>
          </div>

          {/* Nenhum artigo da edição fundadora tem imagem de capa própria. Em vez
              de deixar a coluna vazia — ou inventar uma ilustração —, ela recebe
              a ficha da matéria, que é informação editorial de verdade. */}
          <aside class="lead-sheet" aria-label="Ficha da matéria">
            <dl>
              <div>
                <dt>Edição</dt>
                <dd>Fundadora nº {founderIssue.number}</dd>
              </div>
              <div>
                <dt>Publicado</dt>
                <dd>
                  {leadArticle.publishedAt ? (
                    <time datetime={leadArticle.publishedAt}>
                      {formatLongDate(leadArticle.publishedAt)}
                    </time>
                  ) : (
                    "Edição em produção"
                  )}
                </dd>
              </div>
              <div>
                <dt>Revisão</dt>
                <dd>{leadArticle.reviewSeal}</dd>
              </div>
            </dl>
            {leadArticle.tags.length > 0 && (
              <ul class="lead-tags">
                {leadArticle.tags.slice(0, 6).map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </aside>
        </div>
      </section>
    )
  }

  <!-- --------------------------------------------- destaques editoriais -->
  <section class="editorial" aria-labelledby="editorial-title">
    <div class="page-shell">
      <header class="section-intro">
        <p class="eyebrow">Guias do portal</p>
        <h2 id="editorial-title" class="section-heading">
          Comece por onde a dúvida está
        </h2>
      </header>

      <div class="editorial-grid">
        {
          featuredGuide && (
            <article class="editorial-feature">
              <p class="card-kicker">{featuredGuide.category}</p>
              <h3>
                <a
                  href={`/guias/${featuredGuide.slug}`}
                  data-home-event="article_click"
                  data-home-content={featuredGuide.slug}
                >
                  {featuredGuide.title}
                </a>
              </h3>
              <p>{featuredGuide.description}</p>
              <p class="card-meta">
                <span>{featuredGuide.readingTime} de leitura</span>
                <span>Revisado em {featuredGuide.updated}</span>
              </p>
            </article>
          )
        }

        <ol class="editorial-list">
          {
            editorialGuides.map((guide, index) => (
              <li>
                <span class="list-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div>
                  <p class="card-kicker">{guide.category}</p>
                  <h3>
                    <a
                      href={`/guias/${guide.slug}`}
                      data-home-event="article_click"
                      data-home-content={guide.slug}
                    >
                      {guide.title}
                    </a>
                  </h3>
                  <p class="card-meta">{guide.readingTime} de leitura</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <a class="text-link section-footer-link" href="/guias">
        Ver os doze guias
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- --------------------------------------------------------- SUPERFÍCIE -->
  <section class="surface-feature" aria-labelledby="surface-title">
    <div class="page-shell surface-grid">
      <div class="surface-copy">
        <p class="surface-signature">Olho Seco • Córnea • Tecnologia</p>
        <h2 id="surface-title">SUPERFÍCIE</h2>
        <p class="surface-descriptor">
          Revista de Olho Seco e Superfície Ocular
        </p>
        <h3>Evidência que chega à prática.</h3>
        <p class="surface-intro">
          Uma publicação periódica dedicada à atualização clínica, científica e
          tecnológica da superfície ocular, reunindo análise, evidências,
          especialistas, diagnóstico, terapias e inovação.
        </p>
        <ul class="surface-topics">
          {superficieTopics.slice(0, 6).map((topic) => <li>{topic}</li>)}
        </ul>
        <div class="surface-actions">
          <a
            class="button-primary"
            href="/superficie"
            data-home-event="superficie_click"
          >
            Conheça a SUPERFÍCIE
          </a>
          <a
            class="text-link"
            href="/superficie/edicao-00"
            data-home-event="superficie_issue_click"
          >
            Ver a Edição Fundadora
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>
      </div>

      <article class="founding-issue">
        <div class="issue-cover-thumb">
          <IssueCover
            issue={founderIssue}
            sizes="(max-width: 720px) 45vw, 240px"
          />
        </div>
        <div class="issue-content">
          <p class="issue-status">
            Edição Fundadora nº {founderIssue.number} • {
              founderIssue.articles.length
            } artigos publicados
          </p>
          <h3>{founderIssue.title}</h3>
          <p>{founderIssue.subtitle}</p>
          <a
            href="/superficie/edicao-00"
            class="text-link"
            data-home-event="superficie_issue_click"
          >
            Abrir a edição
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 12h16m-5-5 5 5-5 5"></path>
            </svg>
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- ------------------------------------------------------ em 5 minutos -->
  <section class="quick-reads" aria-labelledby="quick-reads-title">
    <div class="page-shell">
      <header class="section-intro compact">
        <p class="eyebrow">Em cinco minutos</p>
        <h2 id="quick-reads-title" class="section-heading">
          Leituras curtas, sem perder o rigor
        </h2>
      </header>

      <ul class="quick-grid">
        {
          quickGuides.map((guide) => (
            <li>
              <p class="card-kicker">{guide.readingTime}</p>
              <h3>
                <a
                  href={`/guias/${guide.slug}`}
                  data-home-event="article_click"
                  data-home-content={guide.slug}
                >
                  {guide.title}
                </a>
              </h3>
              <p>{guide.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ------------------------------------------------- artigos recentes -->
  <section class="recent-articles" aria-labelledby="recent-articles-title">
    <div class="page-shell">
      <header class="section-intro compact">
        <p class="eyebrow">Da revista</p>
        <h2 id="recent-articles-title" class="section-heading">
          Artigos recentes da SUPERFÍCIE
        </h2>
      </header>

      <ul class="recent-grid">
        {
          recentArticles.map((article) => (
            <li>
              <p class="card-meta">
                <span>{article.category}</span>
                <span>{calculateArticleReadingTime(article)} min</span>
              </p>
              <h3>
                <a
                  href={getMagazineArticlePath(article)}
                  data-home-event="article_click"
                  data-home-content={article.slug}
                >
                  {article.title}
                </a>
              </h3>
              <p>{article.excerpt}</p>
            </li>
          ))
        }
      </ul>

      <a class="text-link section-footer-link" href="/superficie/artigos">
        Ver todos os artigos
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- --------------------------------------------- dossiê visual e 3D -->
  <MechanismScrolly />
  <EyeExplorer />

  <!-- --------------------------------------------------------- essenciais -->
  <section class="essentials" aria-labelledby="essentials-title">
    <div class="page-shell">
      <header class="section-intro compact">
        <p class="eyebrow">Conteúdos essenciais</p>
        <h2 id="essentials-title" class="section-heading">
          As perguntas que abrem o assunto
        </h2>
      </header>

      <ul class="essential-grid">
        {
          essentialContents.map((content, index) => (
            <li>
              <span class="list-index">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>
                <a
                  href={content.href}
                  data-home-event="article_click"
                  data-home-content={content.label}
                >
                  {content.label}
                </a>
              </h3>
              <p>{content.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- -------------------------------------------------------- as jornadas -->
  <section class="journeys" aria-labelledby="journeys-title">
    <div class="page-shell">
      <header class="section-intro">
        <p class="eyebrow">Duas jornadas, um mesmo rigor editorial</p>
        <h2 id="journeys-title" class="section-heading">
          Informação certa para cada momento
        </h2>
        <p>
          Olho seco pode representar desde sintomas ocasionais associados ao
          ambiente e às telas até uma doença complexa da superfície ocular.
          Escolha o caminho mais adequado ao que você procura.
        </p>
      </header>

      <div class="journey-grid">
        {
          homeJourneys.map((journey, index) => (
            <article class:list={["journey", `journey-${journey.audience}`]}>
              <header>
                <span class="journey-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <p class="card-kicker">{journey.eyebrow}</p>
                <h3>{journey.title}</h3>
              </header>
              <p class="journey-description">{journey.description}</p>
              <nav aria-label={`Tópicos: ${journey.title}`}>
                {journey.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </nav>
              <a
                class="text-link"
                href={journey.cta.href}
                data-home-event={
                  journey.audience === "patient"
                    ? "patient_path_click"
                    : "professional_path_click"
                }
                data-home-placement="journeys"
              >
                {journey.cta.label}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- livros -->
  <section class="books" aria-labelledby="books-title">
    <div class="page-shell">
      <header class="section-intro compact">
        <p class="eyebrow">Obras do autor</p>
        <h2 id="books-title" class="section-heading">Livros</h2>
      </header>

      <ul class="book-grid">
        {
          featuredBooks.map((book) => (
            <li>
              <p class="card-kicker">{book.badge}</p>
              <h3>
                <a
                  href={`/livros/${book.slug}`}
                  data-home-event="book_click"
                  data-home-content={book.slug}
                >
                  {book.title}
                </a>
              </h3>
              <p>{book.subtitle}</p>
              <p class="card-meta">{book.status}</p>
            </li>
          ))
        }
      </ul>

      <a class="text-link section-footer-link" href="/livros">
        Ver o catálogo
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16m-5-5 5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>

  <!-- ------------------------------------------------ responsável editorial -->
  <section class="editorial-board" aria-labelledby="board-title">
    <div class="page-shell board-grid">
      <div>
        <p class="eyebrow">Quem assina</p>
        <h2 id="board-title" class="section-heading">
          Responsabilidade editorial
        </h2>
        <p class="board-lead">{author.description}</p>
        <p class="board-credential">
          <strong>{author.name}</strong>
          <span>{author.role}</span>
          <em>{author.registration}</em>
        </p>
        <a class="text-link" href={`/autor/${author.slug}`}>
          Sobre o autor
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h16m-5-5 5 5-5 5"></path>
          </svg>
        </a>
      </div>

      <ul class="board-principles">
        <li>
          <h3>Evidência declarada</h3>
          <p>
            Cada afirmação clínica aponta para a fonte que a sustenta, e o texto
            diz quando a evidência é curta, fraca ou de efeito transitório.
          </p>
        </li>
        <li>
          <h3>Sem promessa de resultado</h3>
          <p>
            Ao descrever um tratamento, o portal diz o que ele pretende e o que
            ainda é incerto. Não há superlativo nem comparação com outros
            serviços.
          </p>
        </li>
        <li>
          <h3>Publicidade separada do conteúdo</h3>
          <p>
            Na SUPERFÍCIE, parceria comercial não determina pauta nem conclusão
            clínica; rótulo e disclosure são obrigatórios onde houver
            patrocínio.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- --------------------------------------------------------- newsletter -->
  <section class="home-newsletter" aria-labelledby="home-newsletter-title">
    <div class="page-shell newsletter-grid">
      <div>
        <p class="eyebrow">Newsletter</p>
        <h2 id="home-newsletter-title" class="section-heading">
          Receba o que for publicado
        </h2>
        <p>
          Guias novos, edições da SUPERFÍCIE e o RADAR Científico. Sem
          frequência fixa: só quando há o que dizer.
        </p>
      </div>
      <NewsletterSignupForm source="newsletter" variant="portal" />
    </div>
  </section>
</Layout>

<script>
  declare global {
    interface Window {
      dataLayer?: Record<string, unknown>[];
    }
  }

  const emitHomeEvent = (
    eventName: string,
    details: Record<string, string> = {},
  ) => {
    const payload = { event: eventName, ...details };
    window.dataLayer = window.dataLayer ?? [];
    window.dataLayer.push(payload);
    window.dispatchEvent(
      new CustomEvent("olhossecos:analytics", { detail: payload }),
    );
  };

  emitHomeEvent("home_view", { page_path: window.location.pathname });

  document
    .querySelectorAll<HTMLElement>("[data-home-event]")
    .forEach((item) => {
      item.addEventListener("click", () => {
        const eventName = item.dataset.homeEvent;
        if (!eventName) return;

        emitHomeEvent(eventName, {
          link_url: item.getAttribute("href") ?? "",
          link_text: item.textContent?.trim() ?? "",
          placement: item.dataset.homePlacement ?? "",
          content_title: item.dataset.homeContent ?? "",
        });
      });
    });

  // O vídeo do hero é autoplay em loop e era o único movimento da página que
  // ignorava prefers-reduced-motion — o parallax abaixo e a interferência em
  // SVG já respeitavam. Pausar no primeiro quadro deixa o poster no lugar, sem
  // esconder o <video>, cujo <picture> interno é o fallback de quem não tem
  // suporte a vídeo. A media query é observada: quem muda a preferência do
  // sistema com a página aberta é atendido na hora.
  const heroVideo = document.querySelector<HTMLVideoElement>(".hero-video");
  if (heroVideo) {
    const stillness = window.matchMedia("(prefers-reduced-motion: reduce)");
    const applyStillness = () => {
      if (stillness.matches) {
        heroVideo.pause();
        heroVideo.currentTime = 0;
        heroVideo.removeAttribute("autoplay");
      } else {
        void heroVideo.play().catch(() => {
          // Autoplay bloqueado pelo navegador: o poster permanece, e é o
          // mesmo quadro que o vídeo mostraria parado.
        });
      }
    };
    applyStillness();
    stillness.addEventListener("change", applyStillness);
  }

  // Parallax do hero: deslocamento de poucos pixels, só no desktop e só quando
  // o visitante não pediu menos movimento. Nada além do hero se move.
  const parallax = document.querySelector<HTMLElement>("[data-parallax]");
  const canMove =
    window.matchMedia("(min-width: 900px)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (parallax && canMove) {
    let ticking = 0;
    const update = () => {
      ticking = 0;
      const offset = Math.min(window.scrollY, 600) * 0.06;
      parallax.style.setProperty("--parallax-shift", `${offset.toFixed(2)}px`);
    };
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }
</script>

