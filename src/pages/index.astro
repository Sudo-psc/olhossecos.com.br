---

import Layout from '../layouts/Layout.astro';

const symptoms = [
  { iconBase: "/optimized/icons/symptom-ardencia", title: "Ardência", desc: "Sensação de queimação constante nos olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-prurido", title: "Coceira", desc: "Desejo frequente de esfregar os olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-visao-turva", title: "Visão Turva", desc: "Embaçamento que melhora ao piscar.", isSpecial: true, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-vermelhidao", title: "Vermelhidão", desc: "Olhos irritados e avermelhados no final do dia.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-corpo-estranho", title: "Corpo Estranho", desc: "Sensação de areia ou cisco nos olhos.", isSpecial: false, width: 256, height: 140 },
  { iconBase: "/optimized/icons/symptom-lacrimejamento", title: "Lacrimejamento", desc: "Olhos que lacrimejam como resposta à irritação.", isSpecial: false, width: 256, height: 140 }
];

const diagnostics = [
  {
    id: "meibografia",
    title: "Meibografia",
    desc: "Exame avançado que avalia a estrutura das glândulas de Meibomius.",
    iconBase: "/optimized/icons/diagnostic-meibografia",
    width: 256,
    height: 256
  },
  {
    id: "meniscometria",
    title: "Meniscometria a BUT",
    desc: "Mede o volume e a estabilidade da camada lacrimal.",
    iconBase: "/optimized/icons/diagnostic-meniscometria",
    width: 256,
    height: 256
  }
];



const faqs = [
  { q: "O que é olho seco?", a: "Olho seco é uma alteração da película de lágrimas que recobre a superfície dos olhos, podendo causar ardência, sensação de areia, visão embaçada e cansaço visual. Ele pode ter várias causas, como envelhecimento, uso de telas, ambiente seco, uso de lentes de contato, alguns colírios e doenças sistêmicas." },
  { q: "Qual o melhor tratamento para ardor nos olhos?", a: "O ardor nos olhos é um dos principais sintomas do olho seco evaporativo. O tratamento mais moderno disponível na clínica é a Luz Pulsada (IRPL), que trata a causa raiz do problema ao estimular as glândulas de Meibômio, reduzindo a dependência de colírios." },
  { q: "Sentir ardor nos olhos ao usar o computador é normal?", a: "Não é normal. O ardor nos olhos durante o uso de telas (celular, computador) geralmente indica que a lágrima está evaporando muito rápido. Isso requer uma avaliação especializada para identificar se há Disfunção das Glândulas de Meibômio." },
  { q: "Se um teste indicar que meu risco de olho seco é alto, isso significa que eu realmente tenho a doença?", a: "Um questionário ou teste de triagem sinaliza que há maior chance de você ter olho seco, mas não substitui o exame completo com o oftalmologista. Além disso, outros problemas oculares podem causar sintomas parecidos, por isso o diagnóstico definitivo depende de avaliação em consultório." }
];

const heroPreload = {
    src: "/optimized/heroeye-800.avif",
    srcset: "/optimized/heroeye-637.avif 637w, /optimized/heroeye-800.avif 800w",
    sizes: "(min-width: 1024px) 50vw, 100vw",
    type: "image/avif"
};

const faqSchema = {
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout
    title="Tratamento para Ardor nos Olhos e Olho Seco em Caratinga | Olhos Secos"
    preloadImage={heroPreload}
    schema={faqSchema}
>

  <!-- 1. Hero Section (editorial, fundo papel) -->
  <section class="relative overflow-hidden bg-[#F7F6F3] min-h-[90vh] flex items-center">
    <div class="absolute top-0 right-0 w-1/2 h-full hidden lg:block">
        <div class="w-full h-full relative">
            <div class="absolute inset-0 bg-gradient-to-r from-[#F7F6F3] via-[#F7F6F3]/60 to-transparent z-10"></div>
            <picture>
                <source
                    type="image/avif"
                    srcset="/optimized/heroeye-637.avif 637w, /optimized/heroeye-800.avif 800w"
                    sizes="(min-width: 1024px) 50vw, 100vw"
                />
                <source
                    type="image/webp"
                    srcset="/optimized/heroeye-637.webp 637w, /optimized/heroeye-800.webp 800w"
                    sizes="(min-width: 1024px) 50vw, 100vw"
                />
                <img
                    src="/optimized/heroeye-800.webp"
                    alt="Cuidado oftalmológico humanizado no tratamento do olho seco"
                    width="800"
                    height="446"
                    class="w-full h-full object-cover object-left-top"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                />
            </picture>
        </div>
    </div>

    <div class="container relative z-20 py-20">
        <div class="max-w-3xl">
            <div class="badge-soft mb-7">
                <span class="inline-flex rounded-full h-2 w-2 bg-brand-light"></span>
                Centro Especializado em Olho Seco · Caratinga, MG
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-[4.25rem] text-brand mb-7">
                Tratamento para <span class="text-gradient">Ardor nos Olhos</span> e Olho Seco
            </h1>

            <p class="text-lg md:text-xl text-slate-600 mb-10 leading-relaxed max-w-xl">
                Sabemos o quanto a ardência e o desconforto atrapalham seu dia a dia. Vá além do alívio momentâneo dos colírios: conheça tratamentos que atuam na causa do olho seco e recupere sua qualidade de vida.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-9">
                <a href="https://wa.me/5533998601427" onclick="return gtag_report_conversion('https://wa.me/5533998601427')" class="btn-premium btn-premium-primary w-full sm:w-auto text-lg flex items-center justify-center gap-3">
                    <svg class="w-6 h-6 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.411-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
                    <span>Agendar Minha Avaliação</span>
                </a>
                <a href="/tratamentos/luz-pulsada-irpl" class="btn-premium btn-premium-secondary w-full sm:w-auto text-lg">
                    Conhecer IRPL
                </a>
            </div>

            <div class="flex flex-wrap gap-3">
                <a href="/quiz" class="badge-soft hover:border-brand-light/50 transition-colors !text-sm">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
                    Quiz Olho Seco
                </a>
                <a href="/calculadora-olho-seco" class="badge-soft hover:border-brand-light/50 transition-colors !text-sm">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Calcular custos
                </a>
                <a href="/testerapido" class="badge-soft hover:border-brand-light/50 transition-colors !text-sm">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Teste dos 10s
                </a>
                <a href="/widget" class="badge-soft hover:border-brand-light/50 transition-colors !text-sm">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    App 20-20-20 grátis
                </a>
            </div>
        </div>
    </div>
  </section>

  <!-- CTA Calculadora -->
  <section class="section-padding bg-white">
    <div class="container">
      <div class="card-premium p-8 md:p-12 flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h2 class="text-2xl md:text-3xl text-brand mb-3">Calcule o preço estimado do seu tratamento</h2>
          <p class="text-slate-600">Selecione os itens e veja o custo mensal e anual em tempo real.</p>
        </div>
        <a href="/calculadora-olho-seco" class="btn-premium btn-premium-primary text-lg shrink-0">
          Abrir calculadora
        </a>
      </div>
    </div>
  </section>

  <!-- 2. O que é Olho Seco -->
  <section id="olho-seco" class="section-padding bg-alt">
    <div class="container">
        <div class="grid md:grid-cols-2 gap-16 items-center">
            <div class="relative">
                <div class="aspect-square rounded-full border-8 border-white overflow-hidden shadow-md">
                    <picture>
                        <source
                            type="image/avif"
                            srcset="/optimized/hero-premium-512.avif 512w, /optimized/hero-premium-768.avif 768w"
                            sizes="(min-width: 768px) 40vw, 80vw"
                        />
                        <source
                            type="image/webp"
                            srcset="/optimized/hero-premium-512.webp 512w, /optimized/hero-premium-768.webp 768w"
                            sizes="(min-width: 768px) 40vw, 80vw"
                        />
                        <img
                            src="/optimized/hero-premium-512.webp"
                            alt="O que é olho seco"
                            width="512"
                            height="512"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-full object-cover"
                        />
                    </picture>
                </div>
                <!-- Floating Card -->
                <div class="absolute bottom-10 -right-6 bg-white p-6 rounded-xl shadow-md border border-[#E7E5E0] border-l-4 border-l-brand-light max-w-xs hidden md:block">
                    <p class="text-brand font-heading font-semibold text-lg mb-1">“Não é normal sentir dor.”</p>
                    <p class="text-slate-500 text-sm">O olho seco é uma doença crônica que exige tratamento, não apenas alívio momentâneo.</p>
                </div>
            </div>
            <div>
                <span class="eyebrow mb-3">Entenda a Doença</span>
                <h2 class="text-3xl md:text-4xl text-brand mb-6">Tratamento de Olho Seco: por que seus olhos incomodam tanto?</h2>
                <p class="text-slate-600 text-lg mb-6 leading-relaxed">
                    Muitos pacientes chegam ao consultório acreditando que a sensação de <strong>areia, ardor e visão embaçada</strong> é "normal" devido ao uso de telas ou idade. NÃO É.
                </p>
                <p class="text-slate-600 text-lg mb-8 leading-relaxed">
                    A Síndrome do Olho Seco é uma falha na lubrificação que deixa seus olhos desprotegidos contra o ambiente. Sem a lágrima adequada, a superfície ocular inflama, causando as "pontadas" e o desconforto que você sente.
                </p>

                <div class="space-y-5">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-full bg-[#EEF2F1] border border-[#E7E5E0] flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                        </div>
                        <div>
                            <h4 class="text-brand text-lg">Inflamação Crônica</h4>
                            <p class="text-slate-500">Se não tratada, a inflamação pode causar danos permanentes à superfície dos seus olhos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </section>

  <!-- 3. Sintomas -->
  <section class="section-padding bg-white">
    <div class="container">
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span class="eyebrow mb-3 justify-center">Sinais de Alerta</span>
            <h2 class="text-3xl md:text-4xl text-brand mb-4">Você se identifica?</h2>
            <p class="text-slate-600 text-lg">Se você sente algum destes sintomas com frequência, seus olhos estão pedindo ajuda.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {symptoms.map(s => (
                <div class="card-premium p-8 text-center cursor-default h-full">
                    <div class="h-52 mb-6 flex items-center justify-center">
                        <picture>
                            <source
                                type="image/avif"
                                srcset={`${s.iconBase}-256.avif 256w, ${s.iconBase}-384.avif 384w`}
                                sizes={s.isSpecial ? "(min-width: 768px) 240px, 200px" : "(min-width: 768px) 160px, 140px"}
                            />
                            <source
                                type="image/webp"
                                srcset={`${s.iconBase}-256.webp 256w, ${s.iconBase}-384.webp 384w`}
                                sizes={s.isSpecial ? "(min-width: 768px) 240px, 200px" : "(min-width: 768px) 160px, 140px"}
                            />
                            <img
                                src={`${s.iconBase}-256.webp`}
                                alt={s.title}
                                width={s.width}
                                height={s.height}
                                loading="lazy"
                                decoding="async"
                                class={`h-full object-contain ${s.isSpecial ? 'w-60' : 'w-40'}`}
                            />
                        </picture>
                    </div>
                    <h3 class="text-brand text-lg mb-2">{s.title}</h3>
                    <p class="text-sm text-slate-500 leading-relaxed">{s.desc}</p>
                </div>
            ))}
        </div>
    </div>
  </section>

  <!-- 3.5 Causas -->
  <section class="section-padding bg-alt overflow-hidden">
    <div class="container">
        <div class="grid md:grid-cols-2 gap-20 items-center">
            <div>
                <span class="eyebrow mb-3">Origem do Problema</span>
                <h2 class="text-3xl md:text-4xl text-brand mb-8">O que está causando isso?</h2>
                <p class="text-slate-600 mb-8 text-lg">
                    Não é apenas "falta de água". Na maioria das vezes, o problema está nas glândulas que produzem a gordura que protege a lágrima.
                </p>
                <div class="space-y-6">
                    <div class="flex gap-4 p-4 rounded-xl bg-white border border-[#E7E5E0]">
                        <span class="w-12 h-12 rounded-full bg-[#EEF2F1] border border-[#E7E5E0] flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
                        </span>
                        <div>
                            <h4 class="text-brand mb-1">Disfunção e Telas</h4>
                            <p class="text-slate-600 text-sm">Ao olhar para telas, piscamos 5x menos. Isso faz com que as glândulas de óleo "sequem" e atrofiem.</p>
                        </div>
                    </div>
                     <div class="flex gap-4 p-4 rounded-xl bg-white border border-[#E7E5E0]">
                        <span class="w-12 h-12 rounded-full bg-[#EEF2F1] border border-[#E7E5E0] flex items-center justify-center shrink-0">
                            <svg class="w-6 h-6 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" /></svg>
                        </span>
                        <div>
                            <h4 class="text-brand mb-1">Ambiente Agressivo</h4>
                            <p class="text-slate-600 text-sm">Ar-condicionado e poluição aceleram a evaporação da lágrima, deixando o olho exposto.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="relative hidden md:block text-center">
                 <div class="relative inline-block">
                     <picture>
                        <source
                            type="image/avif"
                            srcset="/optimized/meibografia-640.avif 640w, /optimized/meibografia-896.avif 896w"
                            sizes="(min-width: 1024px) 448px, 0px"
                        />
                        <source
                            type="image/webp"
                            srcset="/optimized/meibografia-640.webp 640w, /optimized/meibografia-896.webp 896w"
                            sizes="(min-width: 1024px) 448px, 0px"
                        />
                        <img
                            src="/optimized/meibografia-640.webp"
                            alt="Glândulas de Meibomius"
                            width="640"
                            height="640"
                            loading="lazy"
                            decoding="async"
                            class="relative z-10 w-full max-w-md mx-auto"
                        />
                     </picture>
                 </div>
                 <p class="text-center text-sm text-slate-400 mt-4">Imagem de Meibografia: visualizando a saúde das glândulas.</p>
            </div>
        </div>
    </div>
  </section>

  <!-- 3.7 Dry Eye Widget (Open Source) — única seção escura -->
  <section class="section-padding bg-brand-dark text-white">
    <div class="container">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <div>
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/20 text-teal-200 text-xs font-semibold uppercase tracking-[0.16em] mb-6 font-ui">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/></svg>
                    Open Source · Gratuito · MIT
                </div>
                <h2 class="text-3xl md:text-4xl text-white mb-6">Dry Eye Widget: a regra <span class="text-teal-300">20-20-20</span> na sua tela</h2>
                <p class="text-slate-300 text-lg leading-relaxed mb-8">
                    Sua tela não avisa quando seus olhos precisam de pausa — este widget avisa. Um lembrete gentil e flutuante para macOS e Windows, desenvolvido pelo Dr. Philipe Saraiva Cruz para prevenir a fadiga visual digital e o olho seco.
                </p>
                <ul class="space-y-3 mb-10 text-slate-200">
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full border border-teal-300/40 flex items-center justify-center text-teal-300 text-sm shrink-0">✓</span> Desenvolvido por médico oftalmologista</li>
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full border border-teal-300/40 flex items-center justify-center text-teal-300 text-sm shrink-0">✓</span> 100% local — nenhum dado coletado</li>
                    <li class="flex items-center gap-3"><span class="w-6 h-6 rounded-full border border-teal-300/40 flex items-center justify-center text-teal-300 text-sm shrink-0">✓</span> Gratuito e de código aberto (licença MIT)</li>
                </ul>
                <div class="flex flex-wrap gap-4">
                    <a href="/widget" class="btn-premium bg-white text-brand border border-white hover:bg-slate-100 text-lg">
                        Conhecer o app
                    </a>
                    <a href="https://github.com/Sudo-psc/dry-eye-widget" target="_blank" rel="noopener" class="btn-premium bg-transparent text-white border border-white/30 hover:border-white/60 text-lg">
                        Ver no GitHub
                    </a>
                </div>
            </div>
            <div class="hidden lg:flex justify-center">
                <!-- Mockup do widget -->
                <div class="relative bg-[#0E2A44] rounded-2xl border border-white/10 p-8 w-80 shadow-lg">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-2">
