---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Descubra o Tipo do Seu Olho Seco | Quiz Interativo"
  description="Faça nosso quiz de 2 minutos e descubra qual o tipo de olho seco está afetando sua visão e receba uma recomendação personalizada."
>
  <div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8 bg-white p-8 md:p-12 rounded-3xl shadow-xl border border-gray-100 relative overflow-hidden">
      
      <!-- Progress Bar -->
      <div id="progress-container" class="absolute top-0 left-0 w-full h-2 bg-gray-100 hidden">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-cyan-500 to-blue-600 transition-all duration-500 ease-out" style="width: 0%"></div>
      </div>

      <!-- Intro Step -->
      <div id="step-intro" class="text-center space-y-6">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-cyan-50 rounded-full mb-4">
          <svg class="w-10 h-10 text-cyan-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-brand leading-tight">
          Descubra o Tipo do Seu Olho Seco em <span class="text-cyan-600">2 Minutos</span>
        </h1>
        <p class="text-gray-600 text-lg max-w-lg mx-auto">
          Responda a 8 perguntas simples sobre seus sintomas e receba um diagnóstico preliminar e uma oferta especial para sua avaliação.
        </p>
        <div class="pt-4">
          <button id="btn-start" class="btn-premium btn-premium-primary text-lg w-full sm:w-auto">
            Começar Quiz Agora
          </button>
        </div>
        <p class="text-xs text-gray-400">
          *Este quiz é uma ferramenta informativa e não substitui uma consulta médica.
        </p>
      </div>

      <!-- Quiz Step (Dynamic) -->
      <div id="step-quiz" class="hidden space-y-8">
        <div id="question-container" class="space-y-6">
          <span id="question-number" class="text-cyan-600 font-bold uppercase tracking-widest text-sm block">Pergunta 1 de 8</span>
          <h2 id="question-text" class="text-2xl font-bold text-brand">Texto da Pergunta</h2>
          <div id="options-container" class="grid gap-4">
            <!-- Options will be injected here -->
          </div>
        </div>
      </div>

      <!-- Lead Capture Step -->
      <div id="step-lead" class="hidden space-y-8">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-brand mb-4">Quase lá!</h2>
          <p class="text-gray-600">
            Para ver seu resultado e receber seu <strong>cupom de desconto especial</strong> para consulta, preencha os dados abaixo:
          </p>
        </div>
        
        <form id="lead-form" class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nome Completo</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:ring-cyan-500 focus:border-cyan-500 border" placeholder="Seu nome">
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">E-mail</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:ring-cyan-500 focus:border-cyan-500 border" placeholder="seu@email.com">
          </div>
          <div>
            <label for="whatsapp" class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
            <input type="tel" id="whatsapp" name="whatsapp" required class="w-full px-4 py-3 rounded-xl border-gray-200 focus:ring-cyan-500 focus:border-cyan-500 border" placeholder="(00) 00000-0000">
          </div>
          <button type="submit" class="btn-premium btn-premium-primary w-full text-lg mt-4">
            Ver Meu Resultado
          </button>
        </form>
      </div>

      <!-- Result Step -->
      <div id="step-result" class="hidden space-y-8 text-center">
        <div id="result-icon-container" class="inline-flex items-center justify-center w-20 h-20 bg-green-50 rounded-full mb-4">
          <span id="result-emoji" class="text-4xl">✅</span>
        </div>
        <h2 id="result-title" class="text-3xl font-bold text-brand">Seu Perfil: Olho Seco Evaporativo</h2>
        <div id="result-description" class="text-gray-600 text-lg space-y-4 text-left">
          <!-- Description will be injected here -->
        </div>
        
        <div class="bg-cyan-50 p-6 rounded-2xl border border-cyan-100 text-center">
          <h3 class="text-xl font-bold text-cyan-800 mb-2">🎁 Bônus Exclusivo Liberado!</h3>
          <p class="text-cyan-700 mb-4">
            Você ganhou <strong>R$ 50,00 de desconto</strong> em sua primeira avaliação completa de Olho Seco com Meibografia.
          </p>
          <a id="whatsapp-link" href="#" target="_blank" class="btn-premium btn-premium-primary w-full sm:w-auto">
            Resgatar Desconto via WhatsApp
          </a>
        </div>
        
        <button id="btn-restart" class="text-sm text-gray-400 underline hover:text-cyan-600">
          Refazer o quiz
        </button>
      </div>

    </div>
  </div>

  <script is:inline>
    const questions = [
      {
        question: "Com que frequência você sente sensação de 'areia' ou corpo estranho nos olhos?",
        options: [
          { text: "Nunca", score: 0 },
          { text: "Às vezes", score: 1 },
          { text: "Frequentemente", score: 2 },
          { text: "Sempre", score: 3 }
        ]
      },
      {
        question: "Seus olhos ficam vermelhos ao final do dia ou após usar o computador?",
        options: [
          { text: "Não", score: 0 },
          { text: "Sim", score: 2 }
        ]
      },
      {
        question: "Você sente necessidade de pingar colírio lubrificante várias vezes ao dia?",
        options: [
          { text: "Não uso colírios", score: 0 },
          { text: "Uso 1 ou 2 vezes", score: 1 },
          { text: "Uso mais de 4 vezes", score: 3 }
        ]
      },
      {
        question: "Sua visão fica embaçada e melhora logo após você piscar?",
        options: [
          { text: "Não", score: 0 },
          { text: "Sim, acontece muito", score: 3 }
        ]
      },
      {
        question: "Você sente sensibilidade excessiva à luz (fotofobia)?",
        options: [
          { text: "Não", score: 0 },
          { text: "Sim", score: 2 }
        ]
      },
      {
        question: "Quanto tempo por dia você passa na frente de telas (celular, PC, TV)?",
        options: [
          { text: "Menos de 2h", score: 0 },
          { text: "2h - 5h", score: 1 },
          { text: "5h - 8h", score: 2 },
          { text: "Mais de 8h", score: 3 }
        ]
      },
      {
        question: "Você sente que seus olhos lacrimejam 'do nada', especialmente no vento?",
        options: [
          { text: "Não", score: 0 },
          { text: "Sim", score: 2 }
        ]
      },
      {
        question: "Já percebeu pequenas 'caspas' nos cílios ou acorda com os olhos grudados?",
        options: [
          { text: "Não", score: 0 },
          { text: "Sim", score: 3 }
        ]
      }
    ];

    let currentStep = 'intro';
    let currentQuestionIndex = 0;
    let totalScore = 0;
    let userAnswers = [];

    const steps = {
      intro: document.getElementById('step-intro'),
      quiz: document.getElementById('step-quiz'),
      lead: document.getElementById('step-lead'),
      result: document.getElementById('step-result')
    };

    const progressBar = document.getElementById('progress-bar');
    const progressContainer = document.getElementById('progress-container');

    function showStep(stepName) {
      Object.keys(steps).forEach(key => {
        steps[key].classList.add('hidden');
      });
      steps[stepName].classList.remove('hidden');
      currentStep = stepName;

      if (stepName === 'quiz' || stepName === 'lead') {
        progressContainer.classList.remove('hidden');
      } else {
        progressContainer.classList.add('hidden');
      }
    }

    function updateProgress() {
      const progress = ((currentQuestionIndex) / questions.length) * 100;
      progressBar.style.width = `${progress}%`;
    }

    function renderQuestion() {
      const q = questions[currentQuestionIndex];
      document.getElementById('question-number').textContent = `Pergunta ${currentQuestionIndex + 1} de ${questions.length}`;
      document.getElementById('question-text').textContent = q.question;
      
      const optionsContainer = document.getElementById('options-container');
      optionsContainer.innerHTML = '';
      
      q.options.forEach((opt, idx) => {
        const button = document.createElement('button');
        button.className = "text-left px-6 py-4 rounded-xl border border-gray-200 hover:border-cyan-500 hover:bg-cyan-50 transition-all font-medium text-gray-700";
        button.textContent = opt.text;
        button.onclick = () => handleAnswer(opt.score);
        optionsContainer.appendChild(button);
      });
      
      updateProgress();
    }

    function handleAnswer(score) {
      totalScore += score;
      userAnswers.push(score);
      
      if (currentQuestionIndex < questions.length - 1) {
        currentQuestionIndex++;
        renderQuestion();
      } else {
        progressBar.style.width = '100%';
        setTimeout(() => {
          showStep('lead');
        }, 300);
      }
    }

    function calculateResult() {
      let title = "";
      let description = "";
      let emoji = "👁️";
      
      const lastAnswer = userAnswers[userAnswers.length - 1]; // Caspas/cílios
      const screenTime = userAnswers[5]; // Screen time
      
      if (totalScore <= 4) {
        title = "Olhos Saudáveis ou Leves";
        emoji = "✨";
        description = "<p>Seus sintomas são leves, mas a prevenção é importante. O uso prolongado de telas pode estar começando a afetar sua lubrificação ocular.</p><p><strong>Recomendação:</strong> Faça pausas a cada 20 minutos (regra 20-20-20) e use colírios lubrificantes sem conservantes se o desconforto persistir.</p>";
      } else if (lastAnswer >= 2 || totalScore > 12) {
        title = "Provável Olho Seco Evaporativo / DGM";
        emoji = "💧";
        description = "<p>Seus sintomas sugerem que a camada de gordura da sua lágrima pode estar comprometida (Disfunção das Glândulas de Meibomius).</p><p><strong>Recomendação:</strong> O tratamento com <strong>Luz Pulsada (IRPL)</strong> é o mais indicado para o seu caso, pois ele estimula as glândulas a voltarem a produzir a gordura natural do olho.</p>";
      } else if (totalScore > 8) {
        title = "Olho Seco Misto";
        emoji = "⚠️";
        description = "<p>Você apresenta sinais significativos de instabilidade lacrimal. Tanto a produção quanto a qualidade da sua lágrima podem estar afetadas.</p><p><strong>Recomendação:</strong> Uma avaliação completa com Meibografia é essencial para identificar qual componente está mais deficiente e iniciar o tratamento correto.</p>";
      } else {
        title = "Olho Seco Moderado";
        emoji = "🧐";
        description = "<p>Seus olhos estão dando sinais claros de cansaço e falta de lubrificação. Isso pode afetar sua produtividade e conforto diário.</p><p><strong>Recomendação:</strong> Higiene palpebral e possivelmente o uso de plugs lacrimais ou termoterapia podem ajudar a estabilizar seu quadro.</p>";
      }
      
      document.getElementById('result-title').textContent = title;
      document.getElementById('result-emoji').textContent = emoji;
      document.getElementById('result-description').innerHTML = description;
      
      // Update WhatsApp Link
      const name = document.getElementById('name').value;
      const whatsappMsg = encodeURIComponent(`Olá! Meu nome é ${name}. Fiz o quiz do Olho Seco e meu resultado foi: ${title}. Gostaria de resgatar meu desconto de R$ 50,00 e agendar uma avaliação.`);
      document.getElementById('whatsapp-link').href = `https://wa.me/5533998601427?text=${whatsappMsg}`;
    }

    // Event Listeners
    document.getElementById('btn-start').onclick = () => {
      showStep('quiz');
      renderQuestion();
    };

    document.getElementById('lead-form').onsubmit = (e) => {
      e.preventDefault();
      
      // Here you would typically send the data to your CRM/API
      const formData = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        whatsapp: document.getElementById('whatsapp').value,
        score: totalScore,
        answers: userAnswers
      };
      
      console.log('Lead captured:', formData);
      
      // Optional: Store in localStorage or send to a webhook
      
      calculateResult();
      showStep('result');
    };

    document.getElementById('btn-restart').onclick = () => {
      currentQuestionIndex = 0;
      totalScore = 0;
      userAnswers = [];
      showStep('intro');
    };
  </script>
</Layout>
