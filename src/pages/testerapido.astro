---
// src/pages/testerapido.astro
import Layout from '../layouts/Layout.astro';

// Landing page do "Teste Rápido de Olho Seco" (desafio dos 10 segundos)
---

<Layout
    title="Teste Rápido de Olho Seco | Olhos Secos"
    description="Faça o teste interativo de 10 segundos e descubra se você pode ter Olho Seco. Dr. Philipe Saraiva Cruz - Médico pós-graduado em Oftalmologia."
    image="/heroeye.png"
    imageAlt="Teste rápido de olho seco — Olhos Secos, Centro Especializado em Olho Seco"
    imageWidth={1376}
    imageHeight={768}
    canonical="https://olhossecos.com.br/testerapido"
>
    <!-- HERO INTERATIVA -->
    <section class="relative pt-12 pb-20 overflow-hidden bg-gradient-to-br from-brand-dark to-brand text-white min-h-[600px] flex items-center">

        <div class="container mx-auto px-4 relative z-10 text-center">

            <!-- Status Badge -->
            <div id="test-status" class="inline-flex items-center gap-2 bg-white/10 border border-white/15 px-4 py-1 rounded-full text-teal-200 text-sm font-semibold tracking-wide mb-8 transition-all duration-300 font-ui">
                <span class="w-2 h-2 rounded-full bg-teal-300 animate-pulse"></span>
                TESTE INTERATIVO DE LÁGRIMA
            </div>

            <!-- SVG Character Area -->
            <div class="relative w-48 h-48 mx-auto mb-8 cursor-pointer group" id="character-container">

                <!-- Progress Ring (Hidden initially) -->
                <svg class="absolute inset-0 w-full h-full -rotate-90 opacity-0 transition-opacity duration-300" id="progress-ring">
                    <circle cx="96" cy="96" r="90" stroke="currentColor" stroke-width="4" fill="transparent" class="text-white/10" />
                    <circle cx="96" cy="96" r="90" stroke="currentColor" stroke-width="4" fill="transparent" stroke-dasharray="565.48" stroke-dashoffset="565.48" class="text-teal-300 transition-all duration-100 ease-linear" id="progress-circle" />
                </svg>

                <img src="/icons/Fundo de icon_desafio10s Removido.png" alt="Desafio 10s Olho Seco" class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105" id="doctor-img" />
            </div>

            <!-- Text Content (Dynamic) -->
            <div id="hero-content" class="max-w-xl mx-auto transition-opacity duration-300">
                <h2 id="main-title" class="text-3xl md:text-5xl font-semibold text-white mb-4 font-heading leading-tight">
                    Desafio dos <span class="text-teal-300">10 Segundos</span>
                </h2>
                <p id="sub-title" class="text-lg text-white/85 mb-8">
                    Você consegue manter os olhos abertos por 10 segundos sem piscar?
                    Seu tempo revela a saúde do seu filme lacrimal.
                </p>

                <!-- Buttons -->
                <div id="action-area">
                    <button id="start-btn" class="btn-premium bg-white text-brand hover:bg-stone-100 !py-4 !px-10 !text-lg shadow-md">
                        Iniciar Desafio
                    </button>
                </div>
            </div>

            <!-- Result Card (Hidden by default) -->
            <div id="result-card" class="hidden max-w-lg mx-auto bg-white text-slate-700 rounded-2xl border border-stone-200 p-8 shadow-lg transform transition-all duration-500 scale-95 opacity-0">
                <div id="result-icon" class="text-6xl mb-4">🎉</div>
                <h3 id="result-title" class="text-2xl font-semibold text-brand mb-3 font-heading">Resultado</h3>
                <p id="result-message" class="text-slate-600 mb-6 leading-relaxed">Mensagem de resultado aqui.</p>

                <a id="result-cta" href="#" target="_blank" class="btn-premium btn-premium-primary w-full">
                    Ação Recomendada
                </a>
                <button id="retry-btn" class="mt-4 text-sm text-slate-400 underline hover:text-teal-700">
                    Tentar Novamente
                </button>
            </div>

        </div>
    </section>

    <!-- AUTORIDADE E TRATAMENTOS -->
    <section class="bg-white section-padding">
        <div class="container mx-auto px-4">
            <div class="flex flex-col md:flex-row items-center gap-12 max-w-5xl mx-auto">

                <div class="md:w-1/2">
                    <span class="eyebrow mb-2">Por que fazer este teste?</span>
                    <h2 class="text-3xl font-semibold text-brand mb-4">O que o tempo de ruptura lacrimal diz sobre você?</h2>
                    <p class="text-slate-600 mb-6 leading-relaxed">
                        O "Break-Up Time" (BUT) é um indicador clínico fundamental. Se você sente desconforto ao manter os olhos abertos por menos de 10 segundos, suas lágrimas podem estar evaporando muito rápido.
                    </p>
                    <div class="space-y-4">
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-[#EEF2F1] border border-stone-200 flex items-center justify-center text-brand font-bold shrink-0">1</div>
                            <div>
                                <h4 class="font-semibold text-brand">Tecnologia avançada</h4>
                                <p class="text-sm text-slate-500">Dispomos de aparelhos modernos (E-Eye IRPL, Meibografia) para diagnóstico preciso.</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-[#EEF2F1] border border-stone-200 flex items-center justify-center text-brand font-bold shrink-0">2</div>
                            <div>
                                <h4 class="font-semibold text-brand">Tratamentos Avançados</h4>
                                <p class="text-sm text-slate-500">De plugs lacrimais a luz pulsada, tratamos a causa raiz do problema.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="md:w-1/2 card-premium p-8">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 bg-white rounded-full overflow-hidden border-2 border-stone-200 shadow-sm shrink-0">
                            <img src="/doctor-portrait.jpg" alt="Dr. Philipe Saraiva Cruz" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h3 class="font-semibold text-brand">Dr. Philipe Saraiva Cruz</h3>
                            <p class="text-xs text-teal-700 font-semibold uppercase tracking-wider font-ui">Olho Seco e Superfície Ocular</p>
                        </div>
                    </div>
                    <p class="italic text-slate-600 text-sm mb-2">
                        "O olho seco não tratado pode levar a danos na superfície ocular e baixa qualidade de vida. O diagnóstico precoce é o melhor caminho."
                    </p>
                    <p class="text-xs text-slate-400">CRM-MG 69.870</p>
                </div>

            </div>
        </div>
    </section>

    <!-- CONVERSÃO -->
    <section class="bg-brand-dark text-white py-14">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-2xl font-semibold text-white mb-6 font-heading">Sinta o mundo com mais conforto</h2>

            <div class="flex flex-col sm:flex-row justify-center gap-4 mb-8">
                <a href="https://wa.me/5533998601427?text=Olá! Fiz o teste rápido de olho seco no site e gostaria de agendar uma avaliação." target="_blank" rel="noopener" onclick="return gtag_report_conversion(this.href)" class="btn-premium bg-white text-brand hover:bg-stone-100">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    Falar no WhatsApp
                </a>
                <a href="/contato" class="btn-premium bg-white/10 text-white border border-white/20 hover:bg-white/15">
                    Agendar Consulta
                </a>
            </div>

            <p class="text-xs text-white/60">Este teste tem caráter meramente informativo e educacional, não substituindo a consulta médica presencial.</p>
        </div>
    </section>
</Layout>

<!-- LOGIC -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const startBtn = document.getElementById('start-btn');
        const retryBtn = document.getElementById('retry-btn');
        const mainTitle = document.getElementById('main-title');
        const subTitle = document.getElementById('sub-title');
        const actionArea = document.getElementById('action-area');
        const progressRing = document.getElementById('progress-ring');
        const progressCircle = document.getElementById('progress-circle');
        const resultCard = document.getElementById('result-card');
        const testStatus = document.getElementById('test-status');

        let startTime = 0;
        let timerInterval;
        let isRunning = false;

        const startBtnClasses = "btn-premium bg-white text-brand hover:bg-stone-100 !py-4 !px-10 !text-lg shadow-md";

        function resetTest() {
            isRunning = false;
            clearInterval(timerInterval);

            // Reset UI
            mainTitle.innerHTML = 'Desafio dos <span class="text-teal-300">10 Segundos</span>';
            subTitle.textContent = 'Mantenha os olhos abertos sem piscar.';

            actionArea.innerHTML = '';
            actionArea.appendChild(startBtn);
            startBtn.textContent = 'Iniciar Desafio';
            startBtn.classList.remove('hidden');
            startBtn.className = startBtnClasses;

            progressRing.classList.add('opacity-0');

            // Show Character
            document.getElementById('doctor-img').classList.remove('opacity-0');

            // Hide Result
            resultCard.classList.add('hidden', 'scale-95', 'opacity-0');
            resultCard.classList.remove('block');

            // Show Hero Content
            document.getElementById('hero-content').classList.remove('opacity-0', 'hidden');
        }

        function finishTest(success, timeElapsed) {
            clearInterval(timerInterval);
            isRunning = false;

            // Hide Active UI
            document.getElementById('hero-content').classList.add('hidden');
            progressRing.classList.add('opacity-0');

            // Show Character
            document.getElementById('doctor-img').classList.remove('opacity-0');

            // Show Result
            resultCard.classList.remove('hidden');

            // Trigger animation frame for transition
            setTimeout(() => {
                resultCard.classList.remove('scale-95', 'opacity-0');
            }, 10);

            const resultTitle = document.getElementById('result-title');
            const resultMessage = document.getElementById('result-message');
            const resultIcon = document.getElementById('result-icon');
            const resultCta = document.getElementById('result-cta');

            if (success) {
                resultIcon.textContent = '🌟';
                resultTitle.textContent = 'Excelente Estabilidade!';
                resultTitle.className = "text-2xl font-semibold text-teal-700 mb-3 font-heading";
                resultMessage.innerHTML = `Você aguentou os 10 segundos! Isso indica um bom filme lacrimal.<br><br>Mas lembre-se: prevenção é essencial. Agende seu check-up anual.`;
                resultCta.textContent = 'Agendar Check-up Preventivo';
                resultCta.href = "https://wa.me/5533998601427?text=Olá! Fiz o teste rápido de olho seco no site e gostaria de agendar um check-up preventivo.";
                resultCta.className = "btn-premium btn-premium-secondary w-full";
            } else {
                const seconds = (timeElapsed / 1000).toFixed(1);
                resultIcon.textContent = '💧';
                resultTitle.textContent = `Atenção: ${seconds}s`;
                resultTitle.className = "text-2xl font-semibold text-brand mb-3 font-heading";
                resultMessage.innerHTML = `Você piscou antes dos 10 segundos.<br>Um "Break-Up Time" reduzido pode indicar <strong>Olho Seco Evaporativo</strong>.<br><br>Não ignore os sinais. Temos tecnologia especializada para você.`;
                resultCta.textContent = 'Agendar Avaliação de Olho Seco';
                resultCta.href = "https://wa.me/5533998601427?text=Olá, fiz o teste do site e pisquei antes de 10 segundos. Gostaria de agendar uma avaliação.";
                resultCta.className = "btn-premium btn-premium-primary w-full";
            }
        }

        function startTest() {
            isRunning = true;
            startTime = Date.now();

            // Update UI for Active State
            startBtn.remove(); // Remove start button

            // Create Blink Button
            const blinkBtn = document.createElement('button');
            blinkBtn.textContent = 'Pisquei! (Parar)';
            blinkBtn.className = "btn-premium bg-red-700 text-white border border-red-700 hover:bg-red-800 !py-4 !px-12 !text-xl shadow-md";
            blinkBtn.onclick = () => finishTest(false, Date.now() - startTime);
            actionArea.appendChild(blinkBtn);

            mainTitle.innerHTML = 'Segure... <span id="timer-display" class="tabular-nums text-teal-300">0.0</span>s';
            subTitle.textContent = 'Olhos bem abertos! Não pisque!';

            // Hide Character for Timer visibility
            document.getElementById('doctor-img').classList.add('opacity-0');

            // Progress Ring
            progressRing.classList.remove('opacity-0');
            const circumference = 90 * 2 * Math.PI;
            progressCircle.style.strokeDasharray = `${circumference} ${circumference}`;
            progressCircle.style.strokeDashoffset = circumference;

            timerInterval = setInterval(() => {
                const elapsed = Date.now() - startTime;
                const remaining = 10000 - elapsed;

                // Update Text
                const seconds = (elapsed / 1000).toFixed(1);
                document.getElementById('timer-display').textContent = seconds;

                // Update Circle
                const offset = circumference - (elapsed / 10000) * circumference;
                progressCircle.style.strokeDashoffset = offset;

                if (elapsed >= 10000) {
                    finishTest(true, 10000);
                }
            }, 50); // High refresh rate for smooth circle
        }

        startBtn.addEventListener('click', startTest);
        retryBtn.addEventListener('click', resetTest);
    });
</script>
