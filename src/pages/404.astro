---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página Não Encontrada | Olhos Secos" description="A página que você procurou não foi encontrada." noindex={true}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-4 bg-[#F7F6F3]">
    <div class="font-heading text-brand text-9xl mb-4 opacity-10 select-none">404</div>
    <h1 class="text-4xl text-brand mb-6 relative -mt-16">Página Não Encontrada</h1>
    <p class="text-xl text-slate-600 mb-8 max-w-lg">
      Desculpe, a página que você está procurando não existe ou foi movida.
    </p>
    <a href="/" class="btn-premium btn-premium-primary text-lg">
      Voltar para o Início
    </a>
  </div>
</Layout>
