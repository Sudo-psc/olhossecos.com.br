---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página não encontrada" noindex>
  <section class="not-found">
    <div class="page-shell">
      <p>404</p>
      <h1 class="page-title">Esta página não foi encontrada.</h1>
      <span>
        O conteúdo pode ter mudado de endereço. Busque no portal ou use um dos
        caminhos abaixo.
      </span>
      <div class="not-found-actions">
        <button type="button" class="button-primary" data-open-global-search>
          Buscar no portal
        </button>
        <a class="text-link" href="/">Voltar ao início</a>
      </div>
      <nav class="not-found-paths" aria-label="Caminhos frequentes">
        <a href="/sintomas">Sintomas</a>
        <a href="/sinais-de-alerta">Sinais de alerta</a>
        <a href="/guias">Guias</a>
        <a href="/superficie">SUPERFÍCIE</a>
      </nav>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: grid;
    place-items: center;
    padding-block: 6rem;
  }

  .not-found .page-shell > p {
    margin: 0 0 1rem;
    color: var(--teal-dark);
    font-family: var(--serif);
    font-size: var(--text-display);
  }

  .not-found .page-shell > span {
    display: block;
    max-width: 620px;
    margin-top: 2rem;
    color: var(--ink-soft);
  }

  .not-found-actions {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin-top: 2.5rem;
  }

  .not-found-actions button {
    cursor: pointer;
  }

  .not-found-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    margin-top: 2.4rem;
  }

  .not-found-paths a {
    color: var(--ink-soft);
    font-size: var(--text-meta);
    font-weight: 650;
  }

  .not-found-paths a:hover {
    color: var(--teal-dark);
  }

  @media (max-width: 620px) {
    .not-found-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.5rem;
    }
  }
</style>
