---
import Layout from '../../layouts/Layout.astro';
import VideoCard from '../../components/VideoCard.astro';
import fs from 'node:fs';
import path from 'node:path';

type VideoAudience = 'pacientes' | 'profissionais';
type VideoMeta = {
  title: string;
  description: string;
  tags: string[];
  duration: string;
  audience: VideoAudience;
  transcript: string;
  theme: PosterTheme;
};

/* Paleta sóbria "Premium Editorial Clínico": duotones discretos navy/teal/ardósia.
   As chaves originais são mantidas por compatibilidade com videoData. */
const posterThemes = {
  cyan: { from: '#10314F', to: '#14425F' },
  emerald: { from: '#0F766E', to: '#115E59' },
  amber: { from: '#0B2239', to: '#10314F' },
  rose: { from: '#14425F', to: '#0B2239' },
  slate: { from: '#3F4A56', to: '#2B3440' }
} as const;

type PosterTheme = keyof typeof posterThemes;

const escapeXml = (value: string) =>
  value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');

const createPoster = (title: string, subtitle: string, theme: PosterTheme) => {
  const palette = posterThemes[theme] ?? posterThemes.cyan;
  const safeTitle = escapeXml(title);
  const safeSubtitle = escapeXml(subtitle);
  const svg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
      <defs>
        <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="${palette.from}" />
          <stop offset="100%" stop-color="${palette.to}" />
        </linearGradient>
      </defs>
      <rect width="1280" height="720" fill="url(#bg)" />
      <rect x="72" y="84" width="1136" height="552" rx="16" fill="rgba(11,34,57,0.35)" stroke="rgba(247,246,243,0.22)" />
      <text x="120" y="220" fill="#A9C3BD" font-size="17" font-weight="600" letter-spacing="5" font-family="system-ui, sans-serif">
        OLHOS SECOS
      </text>
      <text x="120" y="316" fill="#F7F6F3" font-size="52" font-weight="600" font-family="Georgia, 'Times New Roman', serif">
        ${safeTitle}
      </text>
      <text x="120" y="378" fill="rgba(247,246,243,0.72)" font-size="21" font-weight="500" font-family="system-ui, sans-serif">
        ${safeSubtitle}
      </text>
      <rect x="120" y="444" width="176" height="52" rx="26" fill="rgba(247,246,243,0.10)" stroke="rgba(247,246,243,0.30)" />
      <polygon points="208,470 208,488 228,479" fill="#F7F6F3" />
      <text x="243" y="482" fill="#F7F6F3" font-size="16" font-weight="600" font-family="system-ui, sans-serif">
        Assistir
      </text>
    </svg>
  `.trim();

  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
};

// Directory containing videos
const videosDir = path.join(process.cwd(), 'public', 'videos');
let videos: {
  filename: string;
  title: string;
  description: string;
  tags: string[];
  duration: string;
  audience: VideoAudience;
  transcript: string;
  poster: string;
}[] = [];

const videoData: Record<string, VideoMeta> = {
  "Dry Eye Causes and Treatment.mp4": {
    title: "Causas e Tratamentos do Olho Seco",
    description: "Entenda as principais causas da síndrome do olho seco e descubra as opções de tratamento mais eficazes disponíveis atualmente.",
    tags: ["Olho Seco", "Causas", "Tratamento"],
    duration: "3 min",
    audience: "pacientes",
    transcript: "O vídeo explica como a evaporação e a falta de óleo no filme lacrimal levam ao desconforto e apresenta cuidados iniciais como higiene palpebral e lubrificantes.",
    theme: "cyan"
  },
  "E-EYE IRPL® - For the Treatment of Dry Eyes due to Meibomian Gland Dysfunction (MGD).mp4": {
    title: "Tratamento E-EYE IRPL® para DGM",
    description: "Conheça a tecnologia IRPL® e como ela trata eficazmente a disfunção das glândulas de Meibomius, uma das principais causas de olho seco.",
    tags: ["IRPL", "DGM", "Tratamento"],
    duration: "4 min",
    audience: "profissionais",
    transcript: "Apresenta o mecanismo da luz pulsada regulada e os ganhos na função das glândulas de Meibomius, com foco em parâmetros clínicos e resultados.",
    theme: "amber"
  },
  "E-EYE treatment.mp4": {
    title: "Como funciona o tratamento E-Eye",
    description: "Veja passo a passo como o tratamento com E-Eye IRPL® é realizado e seus benefícios para a saúde ocular.",
    tags: ["IRPL", "Tratamento"],
    duration: "2 min",
    audience: "pacientes",
    transcript: "Mostra as etapas do procedimento, desde a proteção ocular até as aplicações de pulsos, destacando conforto e segurança.",
    theme: "emerald"
  },
  "E-Eye tratamento DGM.mp4": {
    title: "Tratamento DGM com E-Eye",
    description: "Demonstração completa do tratamento da disfunção das glândulas de Meibomius utilizando a tecnologia E-Eye IRPL®.",
    tags: ["IRPL", "DGM", "Procedimento"],
    duration: "3 min",
    audience: "profissionais",
    transcript: "Demonstra o preparo do paciente e a sequência de disparos, com observações sobre resposta das glândulas e cuidados pós-sessão.",
    theme: "rose"
  },
  "Meibomian Gland Dysfunction - Dry Eye Treatment.mp4": {
    title: "Disfunção das Glândulas de Meibomius (DGM)",
    description: "Aprenda sobre a disfunção das glândulas de Meibomius, sua relação com o olho seco e as abordagens terapêuticas modernas.",
    tags: ["DGM", "Olho Seco"],
    duration: "4 min",
    audience: "pacientes",
    transcript: "Explica o papel das glândulas de Meibomius na camada lipídica das lágrimas e como tratamentos combinados reduzem a inflamação.",
    theme: "slate"
  },
  "Meibomian Gland Dysfunction And Dry Eye (imr8ZOpU_a8).mp4": {
    title: "Entenda a Relação entre DGM e Olho Seco",
    description: "Explicação detalhada sobre como a disfunção das glândulas de Meibomius afeta a produção lacrimal e causa olho seco.",
    tags: ["DGM", "Olho Seco"],
    duration: "5 min",
    audience: "pacientes",
    transcript: "Relaciona sintomas como ardência e visão oscilante à obstrução glandular e orienta quando buscar avaliação especializada.",
    theme: "emerald"
  },
  "Meibomian Gland Expression for MGD | The Dry Eye Clinic at Peter Ivins Eye Care.mp4": {
    title: "Expressão das Glândulas de Meibomius",
    description: "Técnica de expressão das glândulas de Meibomius para desobstrução e melhora da qualidade do filme lacrimal.",
    tags: ["DGM", "Procedimento"],
    duration: "3 min",
    audience: "profissionais",
    transcript: "Apresenta a expressão mecânica das glândulas, mostrando pressão controlada e remoção de secreção espessada.",
    theme: "slate"
  },
  "Probing to Open Blocked Tear Ducts (lCj0RrBbzts).mp4": {
    title: "Sondagem das Vias Lacrimais",
    description: "Procedimento de sondagem para desobstrução das vias lacrimais, essencial para pacientes com epífora (excesso de lágrimas).",
    tags: ["Vias Lacrimais", "Procedimento"],
    duration: "2 min",
    audience: "profissionais",
    transcript: "Mostra a sondagem das vias lacrimais para liberar obstrução, com foco em técnica e delicadeza do procedimento.",
    theme: "amber"
  },
  "Punctal Plugs (878yyEfBVaM).mp4": {
    title: "Como funcionam os Plugs Lacrimais",
    description: "Entenda o funcionamento dos plugs lacrimais, pequenos dispositivos que ajudam a reter as lágrimas e aliviar os sintomas do olho seco.",
    tags: ["Plugs", "Tratamento"],
    duration: "2 min",
    audience: "pacientes",
    transcript: "Explica o que são os plugs lacrimais, para quem indicados e como ajudam a reter lágrimas sem cirurgia.",
    theme: "rose"
  },
  "e-eye-cynthia-falabella.mp4": {
    title: "Tratamento com Cynthia Falabella",
    description: "Assista Cynthia Falabella realizando o tratamento do Olho Seco com o E-EYE IRPL® tratamento para Olho Seco.",
    tags: ["IRPL", "Depoimento"],
    duration: "2 min",
    audience: "pacientes",
    transcript: "Depoimento sobre a experiência com o tratamento, ressaltando alívio de sintomas e rotina de cuidado.",
    theme: "emerald"
  },
  "e-eye-irpl-sintomas.mp4": {
    title: "Sintomas e Conheça o E-Eye",
    description: "Confira o sintomas de olho seco e conheça o e-eye.",
    tags: ["Sintomas", "IRPL"],
    duration: "2 min",
    audience: "pacientes",
    transcript: "Lista sintomas comuns de olho seco e apresenta o IRPL como opção quando há DGM.",
    theme: "cyan"
  }
};

try {
  if (fs.existsSync(videosDir)) {
    videos = fs.readdirSync(videosDir)
      .filter(file => file.endsWith('.mp4'))
      .map(file => {
        const videoInfo = videoData[file] || {
          title: file.replace(/\.mp4$/, '').replace(/\s*\([^)]+\)$/, ''),
          description: "Vídeo educativo sobre saúde ocular e tratamentos disponíveis.",
          tags: ["Educativo"],
          duration: "2 min",
          audience: "pacientes",
          transcript: "Conteúdo introdutório para orientar sintomas, tratamentos e próximos passos com o especialista.",
          theme: "cyan"
        };
        const subtitle = videoInfo.tags.slice(0, 3).join(' | ');
        const poster = createPoster(videoInfo.title, subtitle, videoInfo.theme);

        return {
          filename: file,
          title: videoInfo.title,
          description: videoInfo.description,
          tags: videoInfo.tags,
          duration: videoInfo.duration,
          audience: videoInfo.audience,
          transcript: videoInfo.transcript,
          poster
        };
      })
      .sort((a, b) => a.title.localeCompare(b.title, 'pt-BR'));
  }
} catch (e) {
  console.error("Error reading videos directory:", e);
}

const audienceLabel = (audience: VideoAudience) =>
  audience === 'pacientes' ? 'Para pacientes' : 'Para profissionais';

const allTags = Array.from(new Set(videos.flatMap((video) => video.tags)))
  .sort((a, b) => a.localeCompare(b, 'pt-BR'));

const featuredVideo = videos.find((video) => video.filename.includes("cynthia")) ?? videos[0];
const otherVideos = featuredVideo ? videos.filter((video) => video.filename !== featuredVideo.filename) : [];
const totalVideos = videos.length;

const filterButtonClass = "rounded-full border border-[#D6D3CC] bg-white px-4 py-2 text-[11px] font-semibold uppercase tracking-widest text-slate-600 transition-colors hover:border-brand-light hover:text-brand data-[active=true]:bg-[#EEF2F1] data-[active=true]:border-brand-light data-[active=true]:text-brand";
---

<Layout 
  title="Vídeos | Olhos Secos"
  description="Assista a vídeos educativos sobre tratamento de olho seco e saúde ocular."
>
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="pt-24 pb-14 border-b border-[#E7E5E0]">
      <div class="container mx-auto px-6 text-center">
          <span class="eyebrow mb-4">Videoteca</span>
          <h1 class="text-4xl md:text-6xl font-bold text-brand mt-4 mb-6 tracking-tight">
            Educação em <span class="text-gradient">vídeo</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed">
            Entenda seu diagnóstico e descubra como a tecnologia pode ajudar na sua saúde ocular.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4 text-sm text-slate-600">
            <span class="badge-soft">
              <span class="h-2 w-2 rounded-full bg-brand-light"></span>
              {totalVideos} vídeos disponíveis
            </span>
            <span class="badge-soft">Curadoria clínica · conteúdo objetivo e confiável</span>
          </div>
          <div class="mt-8">
            <a href="#lista-videos" class="btn-premium btn-premium-secondary text-sm">
              Explorar todos os vídeos
              <span aria-hidden="true">↓</span>
            </a>
          </div>
      </div>
    </section>

    <!-- Featured Video Section -->
    {videos.length > 0 && featuredVideo && (
      <section class="py-16">
        <div class="container mx-auto px-6">
            <div class="card-premium overflow-hidden max-w-5xl mx-auto">
                <!-- Container do vídeo -->
                <div class="bg-brand-dark overflow-hidden relative aspect-video group border-b border-[#E7E5E0]">
                    <video
                        controls
                        playsinline
                        class="w-full h-full object-cover"
                        poster={featuredVideo.poster}
                    >
                        <source src={`/videos/${featuredVideo.filename}`} type="video/mp4" />
                        Seu navegador não suporta vídeos.
                    </video>
                    <!-- Badge de duração no canto superior direito -->
                    <span class="absolute right-4 top-4 rounded-full bg-brand-dark/80 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white/90 border border-white/20">
                      {featuredVideo.duration}
                    </span>
                </div>

                <!-- Container de texto separado -->
                <div class="bg-white p-8">
                    <span class="eyebrow mb-3">Vídeo em destaque</span>
                    <h2 class="text-2xl md:text-3xl font-bold text-brand mb-3">{featuredVideo.title}</h2>
                    <p class="text-slate-600 max-w-2xl leading-relaxed">{featuredVideo.description}</p>
                    <div class="mt-5 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-widest text-brand-light">
                      <span class="rounded-full border border-[#E7E5E0] bg-alt px-3 py-1">
                        {audienceLabel(featuredVideo.audience)}
                      </span>
                      {featuredVideo.tags?.map((tag) => (
                        <span class="rounded-full border border-[#E7E5E0] bg-alt px-3 py-1">{tag}</span>
                      ))}
                    </div>
                </div>
                {featuredVideo.transcript && (
                  <div class="bg-alt px-8 py-6 border-t border-[#E7E5E0]">
                    <details class="text-sm text-slate-600">
                      <summary class="cursor-pointer text-[11px] font-semibold uppercase tracking-widest text-brand-light">
                        Resumo e transcrição
                      </summary>
                      <p class="mt-3 leading-relaxed">{featuredVideo.transcript}</p>
                    </details>
                  </div>
                )}
            </div>
        </div>
      </section>
    )}

    <!-- Videos Grid -->
    <section id="lista-videos" class="py-20 bg-alt border-t border-[#E7E5E0]">
      <div class="container mx-auto px-6">
        <div class="flex items-center justify-between mb-12">
            <div>
              <h2 class="text-2xl font-bold text-brand">Todos os Vídeos</h2>
              <p class="text-sm text-slate-500 mt-2">Selecione um tema e assista em sequência.</p>
            </div>
            <div class="h-px bg-[#E7E5E0] flex-1 ml-8"></div>
        </div>

        {videos.length > 0 ? (
          <>
            <div class="card-premium p-6 mb-10">
              <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
                <div>
                  <label for="video-search" class="eyebrow">
                    Buscar
                  </label>
                  <div class="mt-3 flex items-center gap-3 rounded-lg border border-[#D6D3CC] bg-white px-4 py-3">
                    <input
                      id="video-search"
                      type="search"
                      placeholder="Busque por tema, tratamento ou sintoma"
                      class="w-full bg-transparent text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none"
                      autocomplete="off"
                    />
                  </div>
                </div>
                <div>
                  <span class="eyebrow">
                    Temas
                  </span>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <button
                      type="button"
                      data-tag-filter="todos"
                      data-active="true"
                      class={filterButtonClass}
                    >
                      Todos
                    </button>
                    {allTags.map((tag) => (
                      <button
                        type="button"
                        data-tag-filter={tag}
                        data-active="false"
                        class={filterButtonClass}
                      >
                        {tag}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
              <div class="mt-6 flex flex-wrap items-center gap-3">
                <span class="eyebrow">
                  Público
                </span>
                <button
                  type="button"
                  data-audience-filter="todos"
                  data-active="true"
                  class={filterButtonClass}
                >
                  Todos
                </button>
                <button
                  type="button"
                  data-audience-filter="pacientes"
                  data-active="false"
                  class={filterButtonClass}
                >
                  Para pacientes
                </button>
                <button
                  type="button"
                  data-audience-filter="profissionais"
                  data-active="false"
                  class={filterButtonClass}
                >
                  Para profissionais
                </button>
                <span class="text-xs text-slate-500">
                  Duração estimada indicada em cada card.
                </span>
              </div>
              <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-sm text-slate-500">
                <span id="video-result-count">{otherVideos.length} resultados</span>
                <button
                  type="button"
                  id="clear-filters"
                  class={filterButtonClass}
                >
                  Limpar filtros
                </button>
              </div>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {otherVideos.map((video) => (
                <div
                  class="video-card-item"
                  data-video-card
                  data-title={video.title}
                  data-description={video.description}
                  data-tags={video.tags.join(',')}
                  data-audience={video.audience}
                >
                  <VideoCard
                    title={video.title}
                    description={video.description}
                    src={`/videos/${video.filename}`}
                    poster={video.poster}
                    tags={video.tags}
                    duration={video.duration}
                    audience={video.audience}
                    transcript={video.transcript}
                  />
                </div>
              ))}
            </div>
            <div id="no-video-results" class="hidden text-center py-16 mt-10 bg-white rounded-xl border border-dashed border-[#D6D3CC]">
              <p class="text-slate-600 text-lg">Nenhum resultado para o filtro atual.</p>
              <p class="text-slate-500 text-sm mt-2">Tente outro termo ou limpe os filtros.</p>
            </div>
          </>
        ) : (
          <div class="text-center py-24 bg-white rounded-xl border border-dashed border-[#D6D3CC]">
            <p class="text-slate-600 text-lg">Nenhum vídeo disponível no momento.</p>
            <a href="/contato" class="btn-premium btn-premium-secondary mt-6 text-sm">
              Falar com a equipe
            </a>
          </div>
        )}
      </div>
    </section>
  </main>

  <script>
    // @ts-nocheck
    const normalizeText = (value) =>
      value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

    const initVideoFilters = () => {
      const searchInput = document.querySelector('#video-search');
      const tagButtons = Array.from(document.querySelectorAll('[data-tag-filter]'));
      const audienceButtons = Array.from(document.querySelectorAll('[data-audience-filter]'));
      const clearButton = document.querySelector('#clear-filters');
      const resultCount = document.querySelector('#video-result-count');
      const noResults = document.querySelector('#no-video-results');
      const cards = Array.from(document.querySelectorAll('[data-video-card]'));

      if (!searchInput || !resultCount || cards.length === 0) {
        return;
      }

      let activeTag = 'todos';
      let activeAudience = 'todos';

      const setActiveButton = (buttons, activeValue, attribute) => {
        buttons.forEach((button) => {
          const isActive = button.getAttribute(attribute) === activeValue;
          button.dataset.active = isActive ? 'true' : 'false';
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      };

      const applyFilters = () => {
        const query = normalizeText(searchInput.value.trim());
        let visibleCount = 0;

        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const description = card.getAttribute('data-description') || '';
          const tags = card.getAttribute('data-tags') || '';
          const audience = card.getAttribute('data-audience') || '';

          const searchable = normalizeText(`${title} ${description} ${tags}`);
          const matchesQuery = query.length === 0 || searchable.includes(query);
          const tagList = tags.split(',').map((tag) => tag.trim());
          const matchesTag = activeTag === 'todos' || tagList.includes(activeTag);
          const matchesAudience = activeAudience === 'todos' || audience === activeAudience;
          const isVisible = matchesQuery && matchesTag && matchesAudience;

          card.classList.toggle('hidden', !isVisible);

          if (isVisible) {
            visibleCount += 1;
          }
        });

        resultCount.textContent = `${visibleCount} resultado${visibleCount === 1 ? '' : 's'} de ${cards.length}`;

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount !== 0);
        }
      };

      tagButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeTag = button.getAttribute('data-tag-filter') || 'todos';
          setActiveButton(tagButtons, activeTag, 'data-tag-filter');
          applyFilters();
        });
      });

      audienceButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeAudience = button.getAttribute('data-audience-filter') || 'todos';
          setActiveButton(audienceButtons, activeAudience, 'data-audience-filter');
          applyFilters();
        });
      });

      searchInput.addEventListener('input', applyFilters);
      clearButton?.addEventListener('click', () => {
        searchInput.value = '';
        activeTag = 'todos';
        activeAudience = 'todos';
        setActiveButton(tagButtons, activeTag, 'data-tag-filter');
        setActiveButton(audienceButtons, activeAudience, 'data-audience-filter');
        applyFilters();
      });

      setActiveButton(tagButtons, activeTag, 'data-tag-filter');
      setActiveButton(audienceButtons, activeAudience, 'data-audience-filter');
      applyFilters();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoFilters);
    } else {
      initVideoFilters();
    }
  </script>
</Layout>
