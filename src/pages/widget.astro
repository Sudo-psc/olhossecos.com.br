---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG, getBreadcrumbStructuredData } from '../lib/config';

const widget = SITE_CONFIG.widget;

const rule = [
    {
        value: "20 min",
        title: "A cada 20 minutos",
        desc: "O widget acompanha o ciclo em silêncio e sinaliza com suavidade quando chega a hora da micro-pausa.",
    },
    {
        value: "20 pés",
        title: "Olhe a 20 pés (6 m)",
        desc: "Focar longe relaxa o músculo ciliar e desfaz o esforço de convergência acumulado na visão de perto.",
    },
    {
        value: "20 s",
        title: "Por 20 segundos",
        desc: "Tempo suficiente para restabelecer o piscar completo e redistribuir o filme lacrimal sobre a córnea.",
    },
];

const features = [
    {
        icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
        title: "Widget sempre presente",
        desc: "Uma bolinha discreta em overlay transparente mostra o progresso do ciclo sem bloquear seu trabalho.",
    },
    {
        icon: "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z",
        title: "Ciclos personalizáveis",
        desc: "Intervalo, tamanho, cores e opacidade ajustáveis. O padrão clínico é 20 minutos — mas você decide.",
    },
    {
        icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
        title: "Pausa guiada",
        desc: "Cronômetro regressivo de 20 segundos conduz a pausa e rearma o ciclo automaticamente.",
    },
    {
        icon: "M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z",
        title: "Lembrete de colírio",
        desc: "Para quem está em tratamento: lembretes opcionais de lubrificação ocular nos horários certos.",
    },
];

const evidence = [
    { value: "~50%", desc: "dos usuários de telas apresentam Doença do Olho Seco, segundo meta-análise de prevalência global." },
    { value: "~30%", desc: "de queda de produtividade (presenteísmo) documentada em indivíduos com olho seco sintomático." },
    { value: "14%", desc: "de perda na velocidade e fluência de leitura prolongada induzida por alterações da superfície ocular." },
];

const softwareSchema = {
    "@type": "SoftwareApplication",
    name: "Dry Eye Widget",
    operatingSystem: "macOS, Windows",
    applicationCategory: "HealthApplication",
    offers: { "@type": "Offer", price: "0", priceCurrency: "BRL" },
    license: "https://opensource.org/licenses/MIT",
    url: `${SITE_CONFIG.url}/widget`,
    downloadUrl: widget.download,
    author: {
        "@type": "Physician",
        name: SITE_CONFIG.doctor.name,
        medicalSpecialty: "Ophthalmology",
        identifier: SITE_CONFIG.doctor.crm,
    },
};

const breadcrumbSchema = getBreadcrumbStructuredData([
    { name: "Início", url: "/" },
    { name: "Dry Eye Widget", url: "/widget" },
]);
---

<Layout
    title="Dry Eye Widget — App Gratuito da Regra 20-20-20 | Olhos Secos"
    description="Dry Eye Widget: aplicativo gratuito e open source (MIT) para macOS e Windows que aplica a regra 20-20-20 contra fadiga visual digital e olho seco. Desenvolvido pelo Dr. Philipe Saraiva Cruz, médico oftalmologista."
    schema={[softwareSchema, breadcrumbSchema]}
>
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-brand-dark via-brand to-sky-900 text-white">
        <div class="absolute -top-32 -right-32 w-[32rem] h-[32rem] bg-cyan-400/10 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-32 -left-32 w-[32rem] h-[32rem] bg-blue-500/10 rounded-full blur-3xl"></div>
        <div class="container relative z-10 py-24 md:py-32">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div>
                    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-400/15 border border-cyan-300/30 text-cyan-200 text-xs font-bold uppercase tracking-widest mb-6">
                        Open source · MIT · macOS & Windows
                    </div>
                    <h1 class="text-4xl md:text-6xl font-bold mb-6">
                        Sua tela não avisa quando seus olhos precisam de pausa. <span class="text-cyan-300">Este widget avisa.</span>
                    </h1>
                    <p class="text-blue-100 text-lg md:text-xl leading-relaxed mb-10 max-w-xl">
                        Um lembrete gentil e flutuante que aplica a regra oftalmológica 20-20-20 — desenvolvido pelo Dr. Philipe Saraiva Cruz, médico oftalmologista, para prevenir a fadiga visual digital e o olho seco.
                    </p>
                    <div class="flex flex-wrap gap-4 mb-8">
                        <a href={widget.landing} class="btn-premium btn-premium-primary text-lg">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                            Baixar gratuitamente
                        </a>
                        <a href={widget.github} target="_blank" rel="noopener" class="btn-premium bg-white/10 text-white border border-white/25 hover:bg-white/20 text-lg backdrop-blur-sm">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/></svg>
                            Código no GitHub
                        </a>
                    </div>
                    <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-blue-200">
                        <li class="flex items-center gap-2"><span class="text-cyan-300">✓</span> Desenvolvido por oftalmologista</li>
                        <li class="flex items-center gap-2"><span class="text-cyan-300">✓</span> 100% local — nenhum dado coletado</li>
                        <li class="flex items-center gap-2"><span class="text-cyan-300">✓</span> Gratuito e código aberto</li>
                    </ul>
                </div>
                <div class="hidden lg:flex justify-center">
                    <div class="relative">
                        <div class="absolute inset-0 bg-cyan-400/20 rounded-full blur-3xl"></div>
                        <div class="relative bg-slate-900/80 backdrop-blur-xl rounded-3xl border border-white/15 p-8 w-80 shadow-2xl animate-float">
                            <div class="flex items-center justify-between mb-6">
                                <div class="flex items-center gap-2">
                                    <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-amber-400/80"></span>
                                    <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
                                </div>
                                <span class="text-[10px] uppercase tracking-widest text-slate-400">Dry Eye Widget</span>
                            </div>
                            <div class="text-center mb-6">
                                <div class="w-24 h-24 mx-auto rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center mb-4 shadow-lg shadow-cyan-500/40">
                                    <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                </div>
                                <p class="text-white font-bold text-lg mb-1">Hora de descansar os olhos</p>
                                <p class="text-slate-400 text-sm">Olhe para algo a 6 metros de distância</p>
                            </div>
                            <div class="bg-slate-800/80 rounded-2xl p-4 text-center border border-white/5 mb-4">
                                <p class="text-cyan-300 font-mono font-bold text-4xl tracking-wider">00:20</p>
                                <p class="text-slate-500 text-xs mt-1 uppercase tracking-wider">Pausa guiada</p>
                            </div>
                            <div class="flex items-center justify-between text-xs text-slate-500">
                                <span>Próxima pausa em</span>
                                <span class="text-slate-300 font-mono font-bold">19:42</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Por que existe -->
    <section class="section-padding bg-white">
        <div class="container">
            <div class="max-w-3xl mx-auto text-center">
                <span class="eyebrow mb-3 justify-center">Por que existe</span>
                <h2 class="text-3xl md:text-5xl font-bold text-brand mb-6">Olhamos para telas o dia inteiro. Piscamos 60% menos quando o fazemos.</h2>
                <p class="text-gray-600 text-lg leading-relaxed">
                    Durante o trabalho concentrado em telas, a frequência do piscar despenca e o filme lacrimal evapora — resultando em ardência, visão turva e cansaço ao fim do dia. O Dry Eye Widget nasceu no consultório: uma resposta prática à queixa mais comum da era digital, transformada em software livre para qualquer pessoa usar.
                </p>
            </div>
        </div>
    </section>

    <!-- A regra 20-20-20 -->
    <section class="section-padding bg-alt">
        <div class="container">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="eyebrow mb-3 justify-center">A intervenção</span>
                <h2 class="text-3xl md:text-5xl font-bold text-brand mb-4">A regra 20-20-20</h2>
                <p class="text-gray-600 text-lg">Recomendada pelas sociedades internacionais de oftalmologia como primeira linha de prevenção da fadiga visual digital.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                {rule.map((r) => (
                    <div class="card-premium p-8 text-center">
                        <p class="text-gradient font-bold text-5xl mb-4 font-heading">{r.value}</p>
                        <h3 class="font-bold text-brand text-xl mb-3">{r.title}</h3>
                        <p class="text-gray-600 leading-relaxed text-sm">{r.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Evidências -->
    <section class="section-padding bg-white">
        <div class="container">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="eyebrow mb-3 justify-center">Evidências científicas</span>
                <h2 class="text-3xl md:text-5xl font-bold text-brand mb-4">O problema é real — e mensurável</h2>
                <p class="text-gray-600 text-lg">Números de meta-análises e estudos clínicos revisados por pares, com referências completas na página do aplicativo.</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                {evidence.map((e) => (
                    <div class="rounded-3xl bg-gradient-to-br from-brand to-brand-dark text-white p-8 text-center shadow-lg">
                        <p class="text-cyan-300 font-bold text-5xl mb-4 font-heading">{e.value}</p>
                        <p class="text-blue-100 leading-relaxed text-sm">{e.desc}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Recursos -->
    <section class="section-padding bg-alt">
        <div class="container">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="eyebrow mb-3 justify-center">Recursos</span>
                <h2 class="text-3xl md:text-5xl font-bold text-brand mb-4">Pequeno na tela, sério no propósito</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-8">
                {features.map((f) => (
                    <div class="card-premium p-8 flex gap-6 items-start">
                        <div class="w-14 h-14 rounded-2xl bg-cyan-50 border border-cyan-100 flex items-center justify-center text-cyan-600 shrink-0">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={f.icon} /></svg>
                        </div>
                        <div>
                            <h3 class="font-bold text-brand text-xl mb-2">{f.title}</h3>
                            <p class="text-gray-600 leading-relaxed text-sm">{f.desc}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Open Source / Downloads -->
    <section class="section-padding bg-white">
        <div class="container">
            <div class="bg-slate-900 rounded-3xl p-10 md:p-16 text-white relative overflow-hidden">
                <div class="absolute -top-20 -right-20 w-72 h-72 bg-cyan-400/10 rounded-full blur-3xl"></div>
                <div class="grid lg:grid-cols-2 gap-12 items-center relative z-10">
                    <div>
                        <span class="inline-block py-1 px-3 rounded-full bg-cyan-400/20 text-cyan-300 text-xs font-bold mb-4 uppercase tracking-wider">Código aberto</span>
                        <h2 class="text-3xl md:text-4xl font-bold mb-6">Livre para usar, auditar e contribuir</h2>
                        <p class="text-slate-300 leading-relaxed mb-8">
                            O Dry Eye Widget é distribuído sob licença MIT, com código-fonte público no GitHub. Tudo roda localmente no seu computador: nenhum dado é coletado ou enviado. Sugestões, melhorias e contribuições da comunidade são bem-vindas.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href={widget.github} target="_blank" rel="noopener" class="btn-premium bg-white text-slate-900 hover:bg-cyan-50">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2Z" clip-rule="evenodd"/></svg>
                                github.com/Sudo-psc/dry-eye-widget
                            </a>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <a href={widget.landing} class="flex items-center justify-between p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors group">
                            <div class="flex items-center gap-4">
                                <svg class="w-8 h-8 text-slate-300 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                                <div>
                                    <p class="font-bold group-hover:text-cyan-300 transition-colors">Baixar para macOS</p>
                                    <p class="text-slate-400 text-sm">Universal · Apple Silicon + Intel · .dmg</p>
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-slate-500 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </a>
                        <a href={widget.landing} class="flex items-center justify-between p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors group">
                            <div class="flex items-center gap-4">
                                <svg class="w-8 h-8 text-slate-300 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M3 5.557l7.357-1.002.004 7.097-7.354.042L3 5.557zm7.354 6.913l.006 7.103-7.354-1.011v-6.14l7.348.048zm.892-8.046L21.001 3v8.562l-9.755.077V4.424zm9.758 8.113L21 21l-9.755-1.378-.014-7.101 9.773.016z"/></svg>
                                <div>
                                    <p class="font-bold group-hover:text-cyan-300 transition-colors">Baixar para Windows</p>
                                    <p class="text-slate-400 text-sm">Instalador x64 · .exe · também em versão portátil</p>
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-slate-500 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </a>
                        <a href={widget.download} target="_blank" rel="noopener" class="flex items-center justify-between p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors group">
                            <div class="flex items-center gap-4">
                                <span class="text-3xl">📦</span>
                                <div>
                                    <p class="font-bold group-hover:text-cyan-300 transition-colors">Todas as versões</p>
                                    <p class="text-slate-400 text-sm">Releases no GitHub</p>
                                </div>
                            </div>
                            <svg class="w-5 h-5 text-slate-500 group-hover:text-cyan-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Autor -->
    <section class="section-padding bg-alt">
        <div class="container">
            <div class="max-w-4xl mx-auto card-premium p-10 md:p-14 flex flex-col md:flex-row gap-10 items-center">
                <img
                    src="/professional_portrait_doctor.JPG"
                    alt="Dr. Philipe Saraiva Cruz"
                    width="160"
                    height="160"
                    loading="lazy"
                    decoding="async"
                    class="w-40 h-40 rounded-full object-cover shadow-lg border-4 border-cyan-50 shrink-0"
                />
                <div>
                    <span class="eyebrow mb-2">Quem desenvolveu</span>
                    <h2 class="text-2xl md:text-3xl font-bold text-brand mb-3">Dr. Philipe Saraiva Cruz</h2>
                    <p class="text-blue-600 font-semibold mb-1">{SITE_CONFIG.doctor.title}</p>
                    <p class="text-gray-500 text-sm mb-5">{SITE_CONFIG.doctor.crm} | {SITE_CONFIG.doctor.rqe}</p>
                    <p class="text-gray-600 leading-relaxed">
                        Referência regional no tratamento de olho seco e responsável pela Clínica Saraiva Vision, o Dr. Philipe criou o Dry Eye Widget a partir da queixa mais frequente do consultório — o desconforto ocular causado pelo uso prolongado de telas — e o disponibilizou gratuitamente como software de código aberto.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA final -->
    <section class="section-padding bg-white">
        <div class="container">
            <div class="bg-gradient-to-br from-cyan-500 to-blue-700 rounded-3xl p-10 md:p-16 text-white text-center shadow-2xl relative overflow-hidden">
                <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
                <div class="max-w-2xl mx-auto space-y-6 relative z-10">
                    <h2 class="text-3xl md:text-4xl font-bold">Proteja seus olhos enquanto trabalha</h2>
                    <p class="text-cyan-50 text-lg opacity-90">
                        Instale o widget em menos de um minuto. E se os sintomas de olho seco persistirem, agende uma avaliação especializada — o aplicativo previne, mas não substitui a consulta médica.
                    </p>
                    <div class="flex flex-wrap justify-center gap-4 pt-2">
                        <a href={widget.landing} class="btn-premium bg-white text-blue-700 hover:bg-cyan-50 text-lg font-bold">
