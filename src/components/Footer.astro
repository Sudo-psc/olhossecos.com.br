---
import EyeMark from "./EyeMark.astro";
import { responsibleDoctor } from "@/lib/doctor";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-shell footer-main">
    <div class="footer-brand">
      <a href="/" class="brand brand-inverse">
        <EyeMark class="brand-mark" />
        <span>
          <strong>Olho Seco</strong>
          <small>Portal do paciente</small>
        </span>
      </a>
      <p>
        Conteúdo educativo. Não substitui diagnóstico, avaliação ou orientação
        profissional individualizada.
      </p>
    </div>

    <div class="footer-links">
      <div>
        <h2>Entenda</h2>
        <a href="/olho-seco">O que é olho seco</a>
        <a href="/sintomas">Sintomas</a>
        <a href="/causas">Causas</a>
        <a href="/diagnostico">Como é investigado</a>
        <a href="/livros">Livros</a>
      </div>
      <div>
        <h2>Cuide-se</h2>
        <a href="/autocuidado">Autocuidado</a>
        <a href="/tratamentos">Tratamentos</a>
        <a href="/sinais-de-alerta">Sinais de alerta</a>
        <a href="/guias">Guias</a>
        <a href="/app">Dry Eye Widget</a>
        <a href="/ferramentas">Ferramentas</a>
        <a href="/paciente">Paciente</a>
        <a
          href="https://apos-olhoseco.com.br"
          target="_blank"
          rel="noopener noreferrer"
        >
          APOS — associação de pacientes
          <span class="visually-hidden"> (abre em nova aba)</span>
        </a>
      </div>
      <div>
        <h2>Sobre o portal</h2>
        <a href="/newsletter">Newsletter</a>
        <a href="/fontes">Fontes</a>
        <a href="/politica-editorial">Política editorial</a>
        <a href="/politica-de-correcao">Correções</a>
        <a href="/glossario">Glossário</a>
        <a href="/privacidade">Privacidade</a>
      </div>
    </div>

    <div class="footer-art" aria-hidden="true">
      <span class="footer-orbit"></span>
      <span class="footer-wave"></span>
      <span class="footer-dots"></span>
    </div>
  </div>

  <div class="page-shell footer-imprint">
    <p>
      <span>Responsável técnico</span>
      <strong>Dr. {responsibleDoctor.name}</strong>
      <em>{responsibleDoctor.registration}</em>
    </p>
  </div>

  <div class="page-shell footer-bottom">
    <p>Conteúdo editorial independente, sem publicidade de terceiros.</p>
    <p>Feito com ❤️ pela equipe do Dr. {responsibleDoctor.name}.</p>
    <p>© {year} Olho Seco — Portal do paciente</p>
  </div>
</footer>
