---
import EyeMark from "./EyeMark.astro";
import { clinic } from "@/lib/clinic";
import { responsibleDoctor } from "@/lib/doctor";
import { portalFor, portals } from "@/lib/portals";

const year = new Date().getFullYear();
const portal = portalFor(Astro.url.pathname);
// Na pré-página o rodapé não repete os dois menus inteiros — seria a mesma
// escolha oferecida duas vezes na mesma tela. Fica só a coluna institucional,
// que é a última de qualquer um dos portais.
const columns =
  portal?.footerColumns ?? portals.paciente.footerColumns.slice(-1);
---

<footer class="site-footer">
  <div class="page-shell footer-main">
    <div class="footer-brand">
      <a href={portal?.home ?? "/"} class="brand brand-inverse">
        <EyeMark class="brand-mark" />
        <span>
          <strong>{portal?.brandTitle ?? "Olhos Secos"}</strong>
          <small>{portal?.brandSubtitle ?? "Ciência e informação"}</small>
        </span>
      </a>
      <p>
        Conteúdo educativo. Não substitui diagnóstico, avaliação ou orientação
        profissional individualizada.
      </p>
    </div>

    <div class="footer-links">
      {
        columns.map((column) => (
          <div>
            <h2>{column.title}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
            {column.title === "Cuide-se" && (
              <a
                href="https://apos-olhoseco.com.br"
                target="_blank"
                rel="noopener noreferrer"
              >
                APOS — associação de pacientes
                <span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            )}
          </div>
        ))
      }
    </div>

    <div class="footer-art" aria-hidden="true">
      <span class="footer-orbit"></span>
      <span class="footer-wave"></span>
      <span class="footer-dots"></span>
    </div>
  </div>

  <div class="page-shell footer-clinic">
    <p>
      <span>Atendimento presencial</span>
      <strong>{clinic.name} · {clinic.addressLocality}</strong>
    </p>
    <p>
      Dr. {responsibleDoctor.name}
      {" · "}
      {responsibleDoctor.registration}
    </p>
    <p>
      <a href={clinic.whatsappUrl} rel="noopener noreferrer">
        WhatsApp {clinic.telephoneDisplay}
      </a>
      <span aria-hidden="true"> · </span>
      <a href={clinic.url} rel="noopener noreferrer">Agendar na clínica</a>
    </p>
    <p>
      Este portal é educativo. Não faz diagnóstico online e não oferece cupom.
    </p>
  </div>

  <div class="page-shell footer-imprint">
    <p>
      <span>Responsável técnico</span>
      <strong>
        <a href={responsibleDoctor.website}>Dr. {responsibleDoctor.name}</a>
      </strong>
      <em>{responsibleDoctor.registration}</em>
    </p>
  </div>

  <div class="page-shell footer-bottom">
    <p>Conteúdo editorial independente, sem publicidade de terceiros.</p>
    <p>Feito com ❤️ pela equipe do Dr. {responsibleDoctor.name}.</p>
    <p>
      © {year} Olhos Secos{portal ? ` — ${portal.brandSubtitle}` : ""}
    </p>
  </div>
</footer>
