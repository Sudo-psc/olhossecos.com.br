---
/**
 * Blocos editoriais de leitura clínica. Cada variante tem rótulo fixo, porque
 * a diferença entre "o que a evidência mostra" e "o que ainda é incerto" é
 * justamente o que o leitor precisa distinguir de relance.
 */
type Variant =
  | "key"
  | "implication"
  | "limits"
  | "controversy"
  | "guideline"
  | "epidemiology";

interface Props {
  variant: Variant;
  title?: string;
  source?: { label: string; url?: string };
}

const labels: Record<Variant, string> = {
  key: "Mensagem-chave",
  implication: "Implicação clínica",
  limits: "Limitações",
  controversy: "Controvérsia",
  guideline: "Diretriz",
  epidemiology: "Dado epidemiológico",
};

const { variant, title, source } = Astro.props;
---

<aside class:list={["callout", `callout-${variant}`]}>
  <p class="callout-label">{labels[variant]}</p>
  {title && <p class="callout-title">{title}</p>}
  <div class="callout-body"><slot /></div>
  {
    source &&
      (source.url ? (
        <a
          class="callout-source"
          href={source.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {source.label}
        </a>
      ) : (
        <p class="callout-source">{source.label}</p>
      ))
  }
</aside>

<style>
  .callout {
    --callout-accent: var(--teal-600);
    --callout-surface: var(--teal-50);

    margin-block: var(--space-block);
    padding: 1.35rem 1.6rem;
    border-left: 3px solid var(--callout-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--callout-surface);
    color: var(--ink);
  }

  .callout-implication {
    --callout-accent: var(--navy-700);
    --callout-surface: #f1f4f9;
  }

  /* O rótulo herda a cor do acento: sobre o bege do bloco, o cobre claro fica
     em 3,3:1 e não passa no texto pequeno. O tom escuro passa. */
  .callout-limits,
  .callout-controversy {
    --callout-accent: var(--copper-700);
    --callout-surface: var(--copper-100);
  }

  .callout-guideline {
    --callout-accent: var(--navy-800);
    --callout-surface: var(--paper-100);
  }

  .callout-epidemiology {
    --callout-accent: var(--teal-700);
    --callout-surface: var(--paper-100);
  }

  .callout-label {
    margin: 0 0 0.45rem;
    color: var(--callout-accent);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }

  .callout-title {
    margin: 0 0 0.5rem;
    font-family: var(--serif);
    font-size: var(--text-h3);
    line-height: 1.2;
  }

  .callout-body {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .callout-body :global(p) {
    margin: 0 0 0.8rem;
  }

  .callout-body :global(p:last-child),
  .callout-body :global(ul:last-child) {
    margin-bottom: 0;
  }

  .callout-source {
    display: inline-block;
    margin-top: 0.8rem;
    color: var(--teal-700);
    font-size: var(--text-meta);
    font-weight: 700;
  }

  a.callout-source {
    border-bottom: 1px solid currentColor;
  }
</style>
