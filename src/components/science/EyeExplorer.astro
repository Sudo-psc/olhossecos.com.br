---
/**
 * Olho interativo com visualização anatômica de precisão da superfície ocular.
 *
 * O modelo 3D e o fallback vetorial localizam e diferenciam claramente as 5
 * estruturas-chave da homeostase ocular:
 * 1. Filme lacrimal (película externa e meniscos)
 * 2. Córnea (cúpula óptica transparente e anel limbar)
 * 3. Conjuntiva (revestimento bulbar e microvasos epiesclerais)
 * 4. Margem palpebral (borda livre de aposição e espalhamento)
 * 5. Glândulas de Meibômio (colunas glandulares tarsais e orifícios marginais)
 *
 * A seleção de uma estrutura realça o elemento anatômico correspondente em 3D,
 * gira o modelo pelo menor arco e atualiza o HUD e os detalhes editoriais.
 */
const structures = [
  {
    id: "tear-film",
    name: "Filme lacrimal",
    color: "#087f95",
    colorRgb: "8, 127, 149",
    tag: "Película & Meniscos",
    summary:
      "Película fluida de 3 a 5 micrômetros que recobre a superfície ocular e forma meniscos nas margens palpebrais. Sua estabilidade e tensão superficial garantem o conforto e a qualidade da refração óptica.",
    href: "/guias/olho-seco-guia-essencial",
    linkLabel: "Como o filme lacrimal se organiza",
  },
  {
    id: "cornea",
    name: "Córnea",
    color: "#0b827f",
    colorRgb: "11, 130, 127",
    tag: "Cúpula Transparente",
    summary:
      "Lente biológica transparente e prolata, densamente inervada pelos ramos ciliares do trigêmeo. É o principal elemento refrativo do olho e onde o sofrimento celular e a perda epitelial se manifestam.",
    href: "/diagnostico",
    linkLabel: "O que o exame investiga",
  },
  {
    id: "conjunctiva",
    name: "Conjuntiva",
    color: "#5c7395",
    colorRgb: "92, 115, 149",
    tag: "Mucosa Bulbar",
    summary:
      "Membrana mucosa vascularizada que recobre a esclera até o limbo e dobra-se nos fundos de saco. Abriga as células caliciformes produtoras de mucina e a rede vascular de defesa da superfície.",
    href: "/guias/conjuntivocalase-olho-seco-mecanico",
    linkLabel: "Quando a conjuntiva sobra e atrapalha",
  },
  {
    id: "lid-margin",
    name: "Margem palpebral",
    color: "#b07a3f",
    colorRgb: "176, 122, 63",
    tag: "Borda de Aposição",
    summary:
      "Borda livre de contato entre as pálpebras superior e inferior. A dinâmica da piscada e a integridade da linha mucocutânea distribuem o filme e renovam a película sobre a córnea.",
    href: "/guias/higiene-palpebral-com-seguranca",
    linkLabel: "Higiene palpebral com segurança",
  },
  {
    id: "meibomian",
    name: "Glândulas de Meibômio",
    color: "#d97706",
    colorRgb: "217, 119, 6",
    tag: "Colunas Lipídicas",
    summary:
      "Glândulas sebáceas dispostas verticalmente no interior das placas tarsais, com orifícios excretores na margem. Secretam o meibum, lipídio essencial que desacelera a evaporação da lágrima.",
    href: "/causas#evaporacao",
    linkLabel: "Evaporação como causa",
  },
];
---

<section class="eye-explorer" aria-labelledby="eye-explorer-title">
  <div class="page-shell eye-explorer-grid">
    <header class="eye-explorer-intro">
      <p class="eyebrow">Anatomia da superfície</p>
      <h2 id="eye-explorer-title" class="section-heading">
        Onde cada estrutura entra na história
      </h2>
      <p>
        O olho seco é uma disfunção multifatorial da unidade funcional da
        superfície. Explore o modelo 3D ou selecione cada estrutura para
        visualizar sua localização anatômica e função na homeostase.
      </p>
    </header>

    <figure class="eye-stage" data-eye-stage data-active-id="tear-film">
      <div class="eye-canvas-holder">
        <canvas data-eye-canvas aria-hidden="true"></canvas>

        <!-- HUD visual sobre o modelo -->
        <div class="eye-hud" data-eye-hud aria-hidden="true">
          <div class="eye-hud-badge">
            <span class="eye-hud-dot" data-eye-hud-dot></span>
            <span class="eye-hud-name" data-eye-hud-name>Filme lacrimal</span>
          </div>
          <span class="eye-hud-hint">
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              <path d="M21 3v6h-6"></path>
            </svg>
            Arraste para girar • Toque nos pontos
          </span>
        </div>

        <!-- Fallback vetorial anatômico de alta definição -->
        <svg
          class="eye-fallback"
          viewBox="0 0 400 400"
          role="img"
          aria-label="Esquema anatômico detalhado da superfície ocular mostrando filme lacrimal, córnea, conjuntiva, margem palpebral e glândulas de Meibômio"
          data-eye-fallback
        >
          <defs>
            <radialGradient id="fb-sclera" cx="45%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="70%" stop-color="#f2f5f8"></stop>
              <stop offset="100%" stop-color="#d4dee8"></stop>
            </radialGradient>
            <radialGradient id="fb-iris" cx="40%" cy="38%" r="68%">
              <stop offset="0%" stop-color="#147994"></stop>
              <stop offset="55%" stop-color="#0c5a6d"></stop>
              <stop offset="100%" stop-color="#042733"></stop>
            </radialGradient>
            <radialGradient id="fb-cornea" cx="35%" cy="35%" r="70%">
              <stop offset="0%" stop-color="#d8f3f8" stop-opacity="0.65"></stop>
              <stop offset="80%" stop-color="#93dbe9" stop-opacity="0.3"></stop>
              <stop offset="100%" stop-color="#0b827f" stop-opacity="0.5"
              ></stop>
            </radialGradient>
          </defs>

          <!-- Esclera do globo ocular -->
          <circle
            cx="200"
            cy="200"
            r="145"
            fill="url(#fb-sclera)"
            stroke="#b8c8d8"
            stroke-width="1.5"></circle>

          <!-- Conjuntiva bulbar com microvasos -->
          <g
            class="svg-layer svg-layer-conjunctiva"
            data-svg-layer="conjunctiva"
          >
            <path
              d="M75 130 Q 55 200 75 270 Q 130 300 200 300 Q 270 300 325 270 Q 345 200 325 130 Z"
              fill="#5c7395"
              fill-opacity="0.1"
              stroke="#5c7395"
              stroke-width="1.2"
              stroke-dasharray="3 3"></path>
            <!-- Vasos conjuntivais nasais e temporais -->
            <path
              d="M78 175 Q 110 180 135 168 M85 210 Q 115 205 138 218 M322 175 Q 290 180 265 168 M315 210 Q 285 205 262 218"
              fill="none"
              stroke="#d47068"
              stroke-width="1.4"
              opacity="0.7"></path>
          </g>

          <!-- Limbo e Íris -->
          <circle
            cx="200"
            cy="200"
            r="76"
            fill="none"
            stroke="#042733"
            stroke-width="3"
            opacity="0.85"></circle>
          <circle cx="200" cy="200" r="74" fill="url(#fb-iris)"></circle>

          <!-- Detalhe estriado da íris -->
          <g stroke="#1db0cb" stroke-width="0.8" opacity="0.35">
            <line x1="200" y1="128" x2="200" y2="162"></line>
            <line x1="200" y1="238" x2="200" y2="272"></line>
            <line x1="128" y1="200" x2="162" y2="200"></line>
            <line x1="238" y1="200" x2="272" y2="200"></line>
            <line x1="149" y1="149" x2="173" y2="173"></line>
            <line x1="227" y1="227" x2="251" y2="251"></line>
            <line x1="149" y1="251" x2="173" y2="227"></line>
            <line x1="227" y1="173" x2="251" y2="149"></line>
          </g>

          <!-- Pupila -->
          <circle cx="200" cy="200" r="28" fill="#031219"></circle>

          <!-- Córnea (cúpula óptica anterior) -->
          <g class="svg-layer svg-layer-cornea" data-svg-layer="cornea">
            <circle cx="200" cy="200" r="75" fill="url(#fb-cornea)"></circle>
            <circle
              cx="200"
              cy="200"
              r="75"
              fill="none"
              stroke="#0b827f"
              stroke-width="2.5"
              stroke-opacity="0.8"></circle>
          </g>

          <!-- Filme lacrimal (película de superfície e meniscos) -->
          <g class="svg-layer svg-layer-tear-film" data-svg-layer="tear-film">
            <circle
              cx="200"
              cy="200"
              r="82"
              fill="none"
              stroke="#2fb6c8"
              stroke-width="2.5"
              stroke-dasharray="8 4"
              opacity="0.85"></circle>
            <!-- Menisco superior e inferior -->
            <path
              d="M130 148 Q 200 128 270 148"
              fill="none"
              stroke="#2fb6c8"
              stroke-width="3.5"
              stroke-linecap="round"></path>
            <path
              d="M130 252 Q 200 272 270 252"
              fill="none"
              stroke="#2fb6c8"
              stroke-width="3.5"
              stroke-linecap="round"></path>
          </g>

          <!-- Brilho de reflexo corneano -->
          <circle cx="178" cy="176" r="9" fill="#ffffff" opacity="0.8"></circle>
          <circle cx="188" cy="186" r="3.5" fill="#ffffff" opacity="0.6"
          ></circle>

          <!-- Glândulas de Meibômio (colunas verticais tarsais) -->
          <g
            class="svg-layer svg-layer-meibomian"
            data-svg-layer="meibomian"
            stroke="#d97706"
            stroke-linecap="round"
          >
            <!-- Glândulas superiores -->
            <g stroke-width="2.8" opacity="0.8">
              <line x1="150" y1="102" x2="150" y2="128"></line>
              <line x1="162" y1="96" x2="162" y2="124"></line>
              <line x1="174" y1="92" x2="174" y2="122"></line>
              <line x1="187" y1="90" x2="187" y2="120"></line>
              <line x1="200" y1="88" x2="200" y2="120"></line>
              <line x1="213" y1="90" x2="213" y2="120"></line>
              <line x1="226" y1="92" x2="226" y2="122"></line>
              <line x1="238" y1="96" x2="238" y2="124"></line>
              <line x1="250" y1="102" x2="250" y2="128"></line>
            </g>
            <!-- Glândulas inferiores -->
            <g stroke-width="2.8" opacity="0.8">
              <line x1="150" y1="272" x2="150" y2="298"></line>
              <line x1="162" y1="276" x2="162" y2="304"></line>
              <line x1="174" y1="278" x2="174" y2="308"></line>
              <line x1="187" y1="280" x2="187" y2="310"></line>
              <line x1="200" y1="280" x2="200" y2="312"></line>
              <line x1="213" y1="280" x2="213" y2="310"></line>
              <line x1="226" y1="278" x2="226" y2="308"></line>
              <line x1="238" y1="276" x2="238" y2="304"></line>
              <line x1="250" y1="272" x2="250" y2="298"></line>
            </g>
            <!-- Orifícios excretores nas margens -->
            <g fill="#f59e0b" stroke="none">
              <circle cx="150" cy="130" r="2"></circle>
              <circle cx="174" cy="124" r="2"></circle>
              <circle cx="200" cy="122" r="2"></circle>
              <circle cx="226" cy="124" r="2"></circle>
              <circle cx="250" cy="130" r="2"></circle>
              <circle cx="150" cy="270" r="2"></circle>
              <circle cx="174" cy="276" r="2"></circle>
              <circle cx="200" cy="278" r="2"></circle>
              <circle cx="226" cy="276" r="2"></circle>
              <circle cx="250" cy="270" r="2"></circle>
            </g>
          </g>

          <!-- Margens palpebrais superior e inferior -->
          <g class="svg-layer svg-layer-lid-margin" data-svg-layer="lid-margin">
            <path
              d="M60 156 Q 200 96 340 156"
              fill="none"
              stroke="#b07a3f"
              stroke-width="5.5"
              stroke-linecap="round"></path>
            <path
              d="M60 244 Q 200 304 340 244"
              fill="none"
              stroke="#b07a3f"
              stroke-width="5.5"
              stroke-linecap="round"></path>
          </g>

          <!-- Marcadores e Pinos de Referência -->
          <g
            class="svg-pin"
            data-svg-pin="tear-film"
            transform="translate(200, 136)"
          >
            <circle r="9" fill="#087f95" opacity="0.25"></circle>
            <circle r="5" fill="#087f95"></circle>
            <circle r="2" fill="#ffffff"></circle>
          </g>
          <g
            class="svg-pin"
            data-svg-pin="cornea"
            transform="translate(245, 185)"
          >
            <circle r="9" fill="#0b827f" opacity="0.25"></circle>
            <circle r="5" fill="#0b827f"></circle>
            <circle r="2" fill="#ffffff"></circle>
          </g>
          <g
            class="svg-pin"
            data-svg-pin="conjunctiva"
            transform="translate(105, 195)"
          >
            <circle r="9" fill="#5c7395" opacity="0.25"></circle>
            <circle r="5" fill="#5c7395"></circle>
            <circle r="2" fill="#ffffff"></circle>
          </g>
          <g
            class="svg-pin"
            data-svg-pin="lid-margin"
            transform="translate(170, 114)"
          >
            <circle r="9" fill="#b07a3f" opacity="0.25"></circle>
            <circle r="5" fill="#b07a3f"></circle>
            <circle r="2" fill="#ffffff"></circle>
          </g>
          <g
            class="svg-pin"
            data-svg-pin="meibomian"
            transform="translate(225, 290)"
          >
            <circle r="9" fill="#d97706" opacity="0.25"></circle>
            <circle r="5" fill="#d97706"></circle>
            <circle r="2" fill="#ffffff"></circle>
          </g>
        </svg>
      </div>
      <figcaption>
        Representação esquemática tridimensional da unidade da superfície ocular
        com identificação topográfica dos eixos fisiológicos.
      </figcaption>
    </figure>

    <div class="eye-structures">
      <ul class="eye-structure-list" data-eye-list>
        {
          structures.map((structure, index) => (
            <li>
              <button
                type="button"
                data-eye-structure={structure.id}
                data-color={structure.color}
                style={`--structure-accent: ${structure.color};`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="eye-structure-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span
                  class="eye-structure-dot"
                  style={`background-color: ${structure.color};`}
                  aria-hidden="true"
                />
                <span class="eye-structure-label">{structure.name}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="eye-structure-details">
        {
          structures.map((structure, index) => (
            <article
              data-eye-detail={structure.id}
              style={`--structure-accent: ${structure.color};`}
              hidden={index !== 0 ? true : undefined}
            >
              <div class="detail-badge-row">
                <span class="detail-tag">{structure.tag}</span>
                <span class="detail-number">Estrutura 0{index + 1}</span>
              </div>
              <h3>{structure.name}</h3>
              <p>{structure.summary}</p>
              <a class="text-link" href={structure.href}>
                {structure.linkLabel}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .eye-explorer {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line-soft);
    background: var(--paper-0);
  }

  .eye-explorer-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .eye-explorer-intro p {
    max-width: var(--measure);
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }

  .eye-stage {
    margin: 0;
  }

  .eye-canvas-holder {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 30% 20%, #ffffff 0%, var(--paper-100) 62%),
      var(--paper-100);
    box-shadow: inset 0 0 0 1px var(--line-soft);
    overflow: hidden;
  }

  .eye-canvas-holder canvas,
  .eye-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .eye-canvas-holder canvas {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out-soft);
    touch-action: pan-y;
    cursor: grab;
  }

  .eye-stage[data-eye-ready="true"] canvas {
    opacity: 1;
  }

  .eye-stage[data-eye-ready="true"] .eye-fallback {
    opacity: 0;
    pointer-events: none;
  }

  .eye-fallback {
    padding: 8%;
    transition: opacity var(--duration-slow) var(--ease-out-soft);
  }

  /* Realce no Fallback SVG */
  .eye-stage[data-active-id="tear-film"] .svg-layer-tear-film circle {
    stroke-width: 4.5;
    opacity: 1;
    stroke: #087f95;
  }
  .eye-stage[data-active-id="cornea"] .svg-layer-cornea circle:last-child {
    stroke-width: 4.5;
    stroke: #0b827f;
  }
  .eye-stage[data-active-id="conjunctiva"]
    .svg-layer-conjunctiva
    path:first-child {
    fill-opacity: 0.28;
    stroke-width: 2.5;
  }
  .eye-stage[data-active-id="lid-margin"] .svg-layer-lid-margin path {
    stroke-width: 8;
    stroke: #9a6430;
  }
  .eye-stage[data-active-id="meibomian"] .svg-layer-meibomian line {
    stroke-width: 4.5;
    stroke: #f59e0b;
    opacity: 1;
  }

  .eye-hud {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    z-index: 2;
  }

  .eye-hud-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(8px);
    box-shadow: 0 2px 8px rgb(0 0 0 / 4%);
  }

  .eye-hud-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--teal-600);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .eye-hud-name {
    font-size: var(--text-meta);
    font-weight: 700;
    color: var(--navy-900);
    letter-spacing: -0.01em;
  }

  .eye-hud-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 75%);
    backdrop-filter: blur(6px);
    font-size: 0.75rem;
    color: var(--navy-600);
  }

  @media (max-width: 480px) {
    .eye-hud-hint {
      display: none;
    }
  }

  .eye-stage figcaption {
    max-width: 48ch;
    margin: 0.9rem auto 0;
    color: var(--ink-soft);
    font-size: var(--text-meta);
    text-align: center;
    line-height: 1.4;
  }

  .eye-structure-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.8rem;
    padding: 0;
    list-style: none;
  }

  .eye-structure-list button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper-0);
    color: var(--ink-soft);
    font-size: var(--text-small);
    font-weight: 650;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .eye-structure-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    opacity: 0.6;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .eye-structure-list button:hover {
    border-color: var(--teal-600);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .eye-structure-list button[aria-pressed="true"] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: #ffffff;
  }

  .eye-structure-list button[aria-pressed="true"] .eye-structure-dot {
    opacity: 1;
    transform: scale(1.3);
    box-shadow: 0 0 6px var(--structure-accent);
  }

  .eye-structure-index {
    color: var(--navy-400);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .eye-structure-list button[aria-pressed="true"] .eye-structure-index {
    color: rgb(255 255 255 / 78%);
  }

  .eye-structure-details article {
    padding: 1.4rem;
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--structure-accent, var(--navy-800));
    border-radius: var(--radius-md);
    background: var(--paper-50);
  }

  .detail-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .detail-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--structure-accent, var(--teal-700));
  }

  .detail-number {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  .eye-structure-details h3 {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
  }

  .eye-structure-details p {
    max-width: var(--measure);
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .eye-explorer-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .eye-explorer-intro {
      grid-column: 1 / -1;
      max-width: 42rem;
    }
  }
</style>

<script>
  import type {
    Mesh,
    MeshBasicMaterial,
    MeshPhysicalMaterial,
    MeshStandardMaterial,
  } from "three";

  type Structure = {
    id: string;
    name: string;
    position: [number, number, number];
    color: number;
    colorHex: string;
  };

  const anchors: Structure[] = [
    {
      id: "tear-film",
      name: "Filme lacrimal",
      position: [0, 0.28, 1.15],
      color: 0x087f95,
      colorHex: "#087f95",
    },
    {
      id: "cornea",
      name: "Córnea",
      position: [0.26, -0.06, 1.12],
      color: 0x0b827f,
      colorHex: "#0b827f",
    },
    {
      id: "conjunctiva",
      name: "Conjuntiva",
      position: [-0.82, 0.18, 0.68],
      color: 0x5c7395,
      colorHex: "#5c7395",
    },
    {
      id: "lid-margin",
      name: "Margem palpebral",
      position: [-0.24, 0.64, 0.84],
      color: 0xb07a3f,
      colorHex: "#b07a3f",
    },
    {
      id: "meibomian",
      name: "Glândulas de Meibômio",
      position: [0.32, -0.68, 0.78],
      color: 0xd97706,
      colorHex: "#d97706",
    },
  ];

  const initEyeExplorer = () => {
    const stage = document.querySelector<HTMLElement>("[data-eye-stage]");
    const canvas =
      document.querySelector<HTMLCanvasElement>("[data-eye-canvas]");
    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-eye-structure]"),
    ];
    const details = [
      ...document.querySelectorAll<HTMLElement>("[data-eye-detail]"),
    ];
    const hudDot = document.querySelector<HTMLElement>("[data-eye-hud-dot]");
    const hudName = document.querySelector<HTMLElement>("[data-eye-hud-name]");

    if (
      !stage ||
      !canvas ||
      buttons.length === 0 ||
      stage.dataset.eyeInited === "true"
    ) {
      return;
    }
    stage.dataset.eyeInited = "true";

    let activeId = anchors[0]?.id ?? "";

    const selectStructure = (id: string) => {
      activeId = id;
      stage.dataset.activeId = id;

      const current = anchors.find((a) => a.id === id);
      if (hudName && current) {
        hudName.textContent = current.name;
      }
      if (hudDot && current) {
        hudDot.style.backgroundColor = current.colorHex;
      }

      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.eyeStructure === id),
        );
      });
      details.forEach((detail) => {
        detail.hidden = detail.dataset.eyeDetail !== id;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const id = button.dataset.eyeStructure;
        if (!id) return;
        selectStructure(id);
        window.dispatchEvent(
          new CustomEvent("olhossecos:eye-select", { detail: { id } }),
        );
      });
    });

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    const isCapable = () => {
      if (!stage || !canvas) return false;
      const memory = (navigator as Navigator & { deviceMemory?: number })
        .deviceMemory;
      if (memory !== undefined && memory < 4) return false;

      const connection = (
        navigator as Navigator & {
          connection?: { saveData?: boolean; effectiveType?: string };
        }
      ).connection;
      if (connection?.saveData) return false;
      if (
        connection?.effectiveType &&
        /(^|-)(slow-)?2g$/u.test(connection.effectiveType)
      ) {
        return false;
      }
      try {
        const probe = document.createElement("canvas");
        return Boolean(probe.getContext("webgl2") ?? probe.getContext("webgl"));
      } catch {
        return false;
      }
    };

    const boot = async () => {
      if (!stage || !canvas || !isCapable()) return;

      const THREE = await import("three");

      const renderer = new THREE.WebGLRenderer({
        canvas,
        antialias: true,
        alpha: true,
        powerPreference: "low-power",
      });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 40);
      camera.position.set(0, 0, 5.2);

      const eye = new THREE.Group();
      eye.rotation.set(0.08, -0.25, 0);
      scene.add(eye);

      // 1. Esclera do globo ocular
      const sclera = new THREE.Mesh(
        new THREE.SphereGeometry(1.0, 64, 48),
        new THREE.MeshStandardMaterial({
          color: 0xf6f4ef,
          roughness: 0.55,
          metalness: 0.02,
        }),
      );
      eye.add(sclera);

      // 2. Conjuntiva bulbar com manto e microvasos
      const conjunctivaMat = new THREE.MeshStandardMaterial({
        color: 0xe8eef5,
        roughness: 0.45,
        transparent: true,
        opacity: 0.22,
      });
      const conjunctivaMesh = new THREE.Mesh(
        new THREE.SphereGeometry(
          1.012,
          56,
          40,
          0,
          Math.PI * 2,
          0.55,
          Math.PI - 0.55,
        ),
        conjunctivaMat,
      );
      conjunctivaMesh.rotation.x = Math.PI / 2;
      eye.add(conjunctivaMesh);

      // Vasos conjuntivais
      const vesselsGroup = new THREE.Group();
      const vesselsMat = new THREE.MeshBasicMaterial({
        color: 0xd88a82,
        transparent: true,
        opacity: 0.7,
      });

      const addVesselArc = (
        x: number,
        y: number,
        z: number,
        rx: number,
        ry: number,
        rz: number,
        scale: number,
      ) => {
        const vMesh = new THREE.Mesh(
          new THREE.TorusGeometry(0.96 * scale, 0.007, 6, 40, Math.PI * 0.45),
          vesselsMat,
        );
        vMesh.position.set(x, y, z);
        vMesh.rotation.set(rx, ry, rz);
        vesselsGroup.add(vMesh);
      };

      addVesselArc(-0.2, 0.1, 0.3, 0.4, 0.6, 1.2, 1.0);
      addVesselArc(-0.1, -0.2, 0.3, -0.3, 0.8, 0.9, 0.95);
      addVesselArc(0.2, 0.15, 0.3, 0.5, -0.5, -1.1, 1.0);
      addVesselArc(0.15, -0.25, 0.3, -0.4, -0.7, -0.8, 0.95);
      eye.add(vesselsGroup);

      // 3. Íris, Limbo e Pupila
      const limbusMat = new THREE.MeshBasicMaterial({
        color: 0x052a36,
        side: THREE.DoubleSide,
      });
      const limbusBorder = new THREE.Mesh(
        new THREE.RingGeometry(0.48, 0.52, 64),
        limbusMat,
      );
      limbusBorder.position.z = 0.94;
      eye.add(limbusBorder);

      const irisMesh = new THREE.Mesh(
        new THREE.CircleGeometry(0.48, 64),
        new THREE.MeshStandardMaterial({
          color: 0x0e5d72,
          roughness: 0.35,
          metalness: 0.05,
        }),
      );
      irisMesh.position.z = 0.945;
      eye.add(irisMesh);

      const irisDetail = new THREE.Mesh(
        new THREE.RingGeometry(0.2, 0.44, 48),
        new THREE.MeshBasicMaterial({
          color: 0x147994,
          transparent: true,
          opacity: 0.45,
          side: THREE.DoubleSide,
        }),
      );
      irisDetail.position.z = 0.948;
      eye.add(irisDetail);

      const pupilMesh = new THREE.Mesh(
        new THREE.CircleGeometry(0.18, 48),
        new THREE.MeshBasicMaterial({ color: 0x03141d }),
      );
      pupilMesh.position.z = 0.95;
      eye.add(pupilMesh);

      // Brilho especular de reflexo
      const gleam = new THREE.Mesh(
        new THREE.CircleGeometry(0.045, 24),
        new THREE.MeshBasicMaterial({
          color: 0xffffff,
          transparent: true,
          opacity: 0.9,
        }),
      );
      gleam.position.set(0.14, 0.16, 1.07);
      eye.add(gleam);

      // 4. Córnea transparente
      const corneaMat = new THREE.MeshPhysicalMaterial({
        color: 0xcfeaf1,
        transparent: true,
        opacity: 0.28,
        roughness: 0.05,
        clearcoat: 1.0,
        side: THREE.DoubleSide,
      });
      const corneaMesh = new THREE.Mesh(
        new THREE.SphereGeometry(1.06, 56, 40, 0, Math.PI * 2, 0, 0.52),
        corneaMat,
      );
      corneaMesh.rotation.x = Math.PI / 2;
      eye.add(corneaMesh);

      // 5. Filme lacrimal e meniscos
      const tearFilmMat = new THREE.MeshPhysicalMaterial({
        color: 0x8fd8e4,
        transparent: true,
        opacity: 0.2,
        roughness: 0.02,
        clearcoat: 1.0,
        side: THREE.DoubleSide,
      });
      const tearFilmMesh = new THREE.Mesh(
        new THREE.SphereGeometry(1.105, 56, 40, 0, Math.PI * 2, 0, 0.56),
        tearFilmMat,
      );
      tearFilmMesh.rotation.x = Math.PI / 2;
      eye.add(tearFilmMesh);

      // Meniscos lacrimais
      const meniscusMat = new THREE.MeshBasicMaterial({
        color: 0x2fb6c8,
        transparent: true,
        opacity: 0.45,
      });
      const upperMeniscus = new THREE.Mesh(
        new THREE.TorusGeometry(0.53, 0.015, 10, 48, Math.PI * 0.7),
        meniscusMat,
      );
      upperMeniscus.position.set(0, 0.44, 0.9);
      upperMeniscus.rotation.z = Math.PI * 0.15;
      eye.add(upperMeniscus);

      const lowerMeniscus = new THREE.Mesh(
        new THREE.TorusGeometry(0.53, 0.015, 10, 48, Math.PI * 0.7),
        meniscusMat,
      );
      lowerMeniscus.position.set(0, -0.44, 0.9);
      lowerMeniscus.rotation.z = Math.PI * 1.15;
      eye.add(lowerMeniscus);

      // 6. Margens palpebrais superior e inferior
      const lidMarginMat = new THREE.MeshStandardMaterial({
        color: 0xb07a3f,
        roughness: 0.55,
        metalness: 0.05,
      });
      const upperLid = new THREE.Mesh(
        new THREE.TorusGeometry(0.88, 0.048, 16, 64, Math.PI * 0.84),
        lidMarginMat,
      );
      upperLid.position.set(0, 0.18, 0.6);
      upperLid.rotation.z = Math.PI * 0.08;
      eye.add(upperLid);

      const lowerLid = new THREE.Mesh(
        new THREE.TorusGeometry(0.88, 0.048, 16, 64, Math.PI * 0.84),
        lidMarginMat,
      );
      lowerLid.position.set(0, -0.18, 0.6);
      lowerLid.rotation.z = Math.PI * 1.08;
      eye.add(lowerLid);

      // 7. Glândulas de Meibômio (colunas verticais tarsais)
      const meibomianGroup = new THREE.Group();
      const glandMat = new THREE.MeshStandardMaterial({
        color: 0xb46b28,
        roughness: 0.5,
        metalness: 0.1,
      });
      const orificeMat = new THREE.MeshBasicMaterial({ color: 0x7c3d12 });

      // Glândulas inferiores
      for (let i = 0; i < 11; i += 1) {
        const gland = new THREE.Mesh(
          new THREE.CapsuleGeometry(0.02, 0.16, 4, 8),
          glandMat,
        );
        const angle = Math.PI * (1.13 + i * 0.068);
        gland.position.set(
          Math.cos(angle) * 0.92,
          Math.sin(angle) * 0.92,
          0.44,
        );
        gland.rotation.z = angle + Math.PI / 2;
        meibomianGroup.add(gland);

        const orifice = new THREE.Mesh(
          new THREE.SphereGeometry(0.018, 8, 8),
          orificeMat,
        );
        orifice.position.set(
          Math.cos(angle) * 0.86,
          Math.sin(angle) * 0.86,
          0.58,
        );
        meibomianGroup.add(orifice);
      }

      // Glândulas superiores
      for (let i = 0; i < 11; i += 1) {
        const gland = new THREE.Mesh(
          new THREE.CapsuleGeometry(0.02, 0.18, 4, 8),
          glandMat,
        );
        const angle = Math.PI * (0.13 + i * 0.068);
        gland.position.set(
          Math.cos(angle) * 0.92,
          Math.sin(angle) * 0.92,
          0.44,
        );
        gland.rotation.z = angle + Math.PI / 2;
        meibomianGroup.add(gland);

        const orifice = new THREE.Mesh(
          new THREE.SphereGeometry(0.018, 8, 8),
          orificeMat,
        );
        orifice.position.set(
          Math.cos(angle) * 0.86,
          Math.sin(angle) * 0.86,
          0.58,
        );
        meibomianGroup.add(orifice);
      }
      eye.add(meibomianGroup);

      // Iluminação
      scene.add(new THREE.AmbientLight(0xffffff, 1.15));
      const keyLight = new THREE.DirectionalLight(0xffffff, 2.5);
      keyLight.position.set(2.4, 2.8, 3.2);
      scene.add(keyLight);
      const rimLight = new THREE.DirectionalLight(0x8fc9dd, 1.2);
      rimLight.position.set(-3, -1.2, 0.8);
      scene.add(rimLight);
      const fillLight = new THREE.DirectionalLight(0xffe8d6, 0.6);
      fillLight.position.set(0, -2.5, 2.0);
      scene.add(fillLight);

      // 8. Marcadores Hotspots com Anel Pulsante
      const markerMeshes = new Map<string, { core: Mesh; ring: Mesh }>();
      anchors.forEach((anchor) => {
        const markerGroup = new THREE.Group();
        markerGroup.position.set(...anchor.position);

        const core = new THREE.Mesh(
          new THREE.SphereGeometry(0.052, 16, 12),
          new THREE.MeshBasicMaterial({
            color: anchor.color,
            transparent: true,
            depthWrite: false,
          }),
        );
        core.userData.structureId = anchor.id;
        markerGroup.add(core);

        const ring = new THREE.Mesh(
          new THREE.RingGeometry(0.068, 0.088, 28),
          new THREE.MeshBasicMaterial({
            color: anchor.color,
            transparent: true,
            opacity: 0.6,
            depthWrite: false,
            side: THREE.DoubleSide,
          }),
        );
        markerGroup.add(ring);

        markerGroup.renderOrder = 4;
        eye.add(markerGroup);
        markerMeshes.set(anchor.id, { core, ring });
      });

      let needsRender = true;
      let visible = false;
      let frame = 0;
      let drifting = !prefersReducedMotion.matches;
      let idleTimer = 0;

      const resize = () => {
        const size = canvas.clientWidth || 1;
        renderer.setSize(size, size, false);
        camera.aspect = 1;
        camera.updateProjectionMatrix();
        needsRender = true;
      };

      const highlight = () => {
        // Atualiza Marcadores
        markerMeshes.forEach(({ core, ring }, id) => {
          const isActive = id === activeId;
          core.scale.setScalar(isActive ? 1.6 : 1.0);
          (core.material as MeshBasicMaterial).opacity = isActive ? 1.0 : 0.6;
          (ring.material as MeshBasicMaterial).opacity = isActive ? 0.9 : 0.35;
          ring.scale.setScalar(isActive ? 1.4 : 1.0);
        });

        // 1. Filme lacrimal
        const isTear = activeId === "tear-film";
        (tearFilmMesh.material as MeshPhysicalMaterial).opacity = isTear
          ? 0.68
          : 0.2;
        (tearFilmMesh.material as MeshPhysicalMaterial).color.setHex(
          isTear ? 0x2fb6c8 : 0x8fd8e4,
        );
        (tearFilmMesh.material as MeshPhysicalMaterial).emissive.setHex(
          isTear ? 0x117285 : 0x000000,
        );
        (tearFilmMesh.material as MeshPhysicalMaterial).emissiveIntensity =
          isTear ? 0.7 : 0;
        (meniscusMat as MeshBasicMaterial).opacity = isTear ? 0.95 : 0.45;
        (meniscusMat as MeshBasicMaterial).color.setHex(
          isTear ? 0x38d8ec : 0x2fb6c8,
        );

        // 2. Córnea
        const isCornea = activeId === "cornea";
        (corneaMesh.material as MeshPhysicalMaterial).opacity = isCornea
          ? 0.65
          : 0.28;
        (corneaMesh.material as MeshPhysicalMaterial).color.setHex(
          isCornea ? 0x0b827f : 0xcfeaf1,
        );
        (corneaMesh.material as MeshPhysicalMaterial).emissive.setHex(
          isCornea ? 0x044b49 : 0x000000,
        );
        (corneaMesh.material as MeshPhysicalMaterial).emissiveIntensity =
          isCornea ? 0.65 : 0;
        (limbusMat as MeshBasicMaterial).color.setHex(
          isCornea ? 0x18b8b4 : 0x052a36,
        );

        // 3. Conjuntiva
        const isConj = activeId === "conjunctiva";
        (conjunctivaMesh.material as MeshStandardMaterial).opacity = isConj
          ? 0.58
          : 0.22;
        (conjunctivaMesh.material as MeshStandardMaterial).color.setHex(
          isConj ? 0x5c7395 : 0xe8eef5,
        );
        (conjunctivaMesh.material as MeshStandardMaterial).emissive.setHex(
          isConj ? 0x203554 : 0x000000,
        );
        (conjunctivaMesh.material as MeshStandardMaterial).emissiveIntensity =
          isConj ? 0.6 : 0;
        (vesselsMat as MeshBasicMaterial).color.setHex(
          isConj ? 0xe84f44 : 0xd88a82,
        );
        (vesselsMat as MeshBasicMaterial).opacity = isConj ? 0.95 : 0.7;

        // 4. Margem palpebral
        const isLid = activeId === "lid-margin";
        (lidMarginMat as MeshStandardMaterial).color.setHex(
          isLid ? 0xd98c48 : 0xb07a3f,
        );
        (lidMarginMat as MeshStandardMaterial).emissive.setHex(
          isLid ? 0x733b10 : 0x000000,
        );
        (lidMarginMat as MeshStandardMaterial).emissiveIntensity = isLid
          ? 0.75
          : 0;

        // 5. Glândulas de Meibômio
        const isMeib = activeId === "meibomian";
        (glandMat as MeshStandardMaterial).color.setHex(
          isMeib ? 0xfbbf24 : 0xb46b28,
        );
        (glandMat as MeshStandardMaterial).emissive.setHex(
          isMeib ? 0xd97706 : 0x000000,
        );
        (glandMat as MeshStandardMaterial).emissiveIntensity = isMeib ? 0.9 : 0;
        (orificeMat as MeshBasicMaterial).color.setHex(
          isMeib ? 0xfde68a : 0x7c3d12,
        );

        needsRender = true;
      };

      // Rotação suave orientada pelo menor arco
      let targetYaw = -0.25;
      let targetPitch = 0.08;
      const faceStructure = (id: string) => {
        const anchor = anchors.find((item) => item.id === id);
        if (!anchor) return;
        const [x, y, z] = anchor.position;
        const baseYaw = -Math.atan2(x, z) * 0.55;
        const currentYaw = eye.rotation.y;
        const diff =
          ((((baseYaw - currentYaw + Math.PI) % (Math.PI * 2)) + Math.PI * 2) %
            (Math.PI * 2)) -
          Math.PI;
        targetYaw = currentYaw + diff;
        targetPitch = Math.max(
          -0.28,
          Math.min(0.28, Math.atan2(y, Math.hypot(x, z)) * 0.4),
        );
        needsRender = true;
      };

      const loop = () => {
        frame = 0;
        if (!visible) return;

        if (drifting) {
          targetYaw += 0.0016;
        }

        const yawDelta = targetYaw - eye.rotation.y;
        const pitchDelta = targetPitch - eye.rotation.x;
        if (Math.abs(yawDelta) > 0.0005 || Math.abs(pitchDelta) > 0.0005) {
          eye.rotation.y += yawDelta * 0.08;
          eye.rotation.x += pitchDelta * 0.08;
          needsRender = true;
        }

        if (needsRender) {
          renderer.render(scene, camera);
          needsRender = false;
        }

        if (visible && (drifting || needsRender)) {
          frame = requestAnimationFrame(loop);
        }
      };

      const kick = () => {
        needsRender = true;
        if (!frame && visible) frame = requestAnimationFrame(loop);
      };

      let dragging = false;
      let lastX = 0;
      let lastY = 0;

      const pauseDrift = () => {
        drifting = false;
        window.clearTimeout(idleTimer);
        if (prefersReducedMotion.matches) return;
        idleTimer = window.setTimeout(() => {
          drifting = true;
          kick();
        }, 6000);
      };

      canvas.addEventListener("pointerdown", (event) => {
        dragging = true;
        lastX = event.clientX;
        lastY = event.clientY;
        targetYaw = eye.rotation.y;
        targetPitch = eye.rotation.x;
        canvas.setPointerCapture(event.pointerId);
        pauseDrift();
      });

      canvas.addEventListener("pointermove", (event) => {
        if (!dragging) return;
        targetYaw += (event.clientX - lastX) * 0.006;
        targetPitch = Math.max(
          -0.6,
          Math.min(0.6, targetPitch + (event.clientY - lastY) * 0.004),
        );
        lastX = event.clientX;
        lastY = event.clientY;
        kick();
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        canvas.releasePointerCapture?.(event.pointerId);
      };
      canvas.addEventListener("pointerup", endDrag);
      canvas.addEventListener("pointercancel", endDrag);

      canvas.addEventListener(
        "wheel",
        (event) => {
          if (!event.ctrlKey && Math.abs(event.deltaY) < 24) return;
          event.preventDefault();
          camera.position.z = Math.max(
            3.6,
            Math.min(6.4, camera.position.z + event.deltaY * 0.004),
          );
          kick();
        },
        { passive: false },
      );

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();

      const pickMarker = (event: PointerEvent | MouseEvent) => {
        const rect = canvas.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hitObjects = [...markerMeshes.values()].map((m) => m.core);
        return raycaster.intersectObjects(hitObjects)[0];
      };

      canvas.addEventListener("pointermove", (event) => {
        if (dragging) return;
        canvas.style.cursor = pickMarker(event) ? "pointer" : "grab";
      });

      canvas.addEventListener("click", (event) => {
        const hit = pickMarker(event);
        const id = hit?.object.userData.structureId as string | undefined;
        if (!id) return;
        selectStructure(id);
        faceStructure(id);
        highlight();
        pauseDrift();
        kick();
      });

      window.addEventListener("olhossecos:eye-select", (event) => {
        const id = (event as CustomEvent<{ id: string }>).detail.id;
        faceStructure(id);
        highlight();
        pauseDrift();
        kick();
      });

      prefersReducedMotion.addEventListener("change", (event) => {
        drifting = !event.matches;
        kick();
      });

      const observer = new IntersectionObserver(
        (entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          if (visible) kick();
          else if (frame) {
            cancelAnimationFrame(frame);
            frame = 0;
          }
        },
        { rootMargin: "120px" },
      );
      observer.observe(stage);

      new ResizeObserver(() => {
        resize();
        kick();
      }).observe(canvas);

      resize();
      highlight();
      faceStructure(activeId);
      stage.dataset.eyeReady = "true";
      kick();
    };

    if (stage && canvas) {
      const loadObserver = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          loadObserver.disconnect();
          void boot().catch(() => {
            stage.dataset.eyeReady = "false";
          });
        },
        { rootMargin: "300px" },
      );
      loadObserver.observe(stage);
    }
  };

  initEyeExplorer();
  document.addEventListener("astro:page-load", initEyeExplorer);
</script>
