---
/**
 * Olho interativo. O 3D aqui tem função: localizar no espaço as estruturas que
 * o texto do portal descreve em separado — filme lacrimal, córnea, conjuntiva,
 * margem palpebral e glândulas de Meibômio.
 *
 * Regras de carga: Three.js só é importado quando a seção entra na viewport, o
 * render roda sob demanda (nunca em loop contínuo), o DPR é limitado e a
 * rotação automática não existe quando o visitante pede menos movimento.
 * Antes disso — e se o WebGL falhar — fica a ilustração estática, e a lista de
 * estruturas é HTML de verdade: o conteúdo não depende do canvas.
 */
const structures = [
  {
    id: "tear-film",
    name: "Filme lacrimal",
    summary:
      "Película que cobre a superfície exposta do olho. Sua estabilidade determina conforto e qualidade óptica; quando se rompe cedo demais entre uma piscada e outra, os sintomas aparecem.",
    href: "/guias/olho-seco-guia-essencial",
    linkLabel: "Como o filme lacrimal se organiza",
  },
  {
    id: "cornea",
    name: "Córnea",
    summary:
      "Superfície transparente e densamente inervada, responsável por boa parte do poder óptico do olho. É onde o dano epitelial e a alteração da sensibilidade se manifestam.",
    href: "/diagnostico",
    linkLabel: "O que o exame investiga",
  },
  {
    id: "conjunctiva",
    name: "Conjuntiva",
    summary:
      "Membrana que reveste a esclera e a face interna das pálpebras. Participa da produção de mucina e concentra boa parte da resposta inflamatória da superfície.",
    href: "/guias/conjuntivocalase-olho-seco-mecanico",
    linkLabel: "Quando a conjuntiva sobra e atrapalha",
  },
  {
    id: "lid-margin",
    name: "Margem palpebral",
    summary:
      "Linha onde as glândulas desembocam e por onde a piscada espalha o filme. Piscada incompleta e alterações da margem mudam a distribuição das lágrimas.",
    href: "/guias/higiene-palpebral-com-seguranca",
    linkLabel: "Higiene palpebral com segurança",
  },
  {
    id: "meibomian",
    name: "Glândulas de Meibômio",
    summary:
      "Produzem a camada lipídica que retarda a evaporação. Sua disfunção é a via mais frequente do olho seco evaporativo.",
    href: "/causas#evaporacao",
    linkLabel: "Evaporação como causa",
  },
];
---

<section class="eye-explorer" aria-labelledby="eye-explorer-title">
  <div class="page-shell eye-explorer-grid">
    <header class="eye-explorer-intro">
      <p class="eyebrow">Anatomia da superfície</p>
      <h2 id="eye-explorer-title" class="section-heading">
        Onde cada estrutura entra na história
      </h2>
      <p>
        Olho seco raramente é um problema de uma estrutura só. Gire o modelo ou
        escolha uma estrutura para ver o papel de cada parte — e onde o portal
        aprofunda o assunto.
      </p>
    </header>

    <figure class="eye-stage" data-eye-stage>
      <div class="eye-canvas-holder">
        <canvas data-eye-canvas aria-hidden="true"></canvas>
        <svg
          class="eye-fallback"
          viewBox="0 0 320 320"
          role="img"
          aria-label="Corte esquemático da superfície ocular mostrando filme lacrimal, córnea, conjuntiva e margem palpebral"
          data-eye-fallback
        >
          <defs>
            <radialGradient id="eye-sclera" cx="42%" cy="38%" r="72%">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="72%" stop-color="#eef1f6"></stop>
              <stop offset="100%" stop-color="#cfd8e4"></stop>
            </radialGradient>
            <radialGradient id="eye-iris" cx="45%" cy="40%" r="65%">
              <stop offset="0%" stop-color="#1c6f80"></stop>
              <stop offset="100%" stop-color="#05384a"></stop>
            </radialGradient>
          </defs>
          <circle cx="160" cy="160" r="120" fill="url(#eye-sclera)"></circle>
          <circle cx="160" cy="160" r="120" fill="none" stroke="#b9c6d6"
          ></circle>
          <circle cx="160" cy="160" r="58" fill="url(#eye-iris)"></circle>
          <circle cx="160" cy="160" r="22" fill="#03202b"></circle>
          <circle cx="142" cy="140" r="10" fill="#ffffff" opacity="0.55"
          ></circle>
          <path
            d="M52 128q108 -54 216 0"
            fill="none"
            stroke="#0b827f"
            stroke-width="2"
            opacity="0.5"></path>
          <path
            d="M46 196q114 52 228 0"
            fill="none"
            stroke="#0b827f"
            stroke-width="2"
            opacity="0.35"></path>
        </svg>
      </div>
      <figcaption>
        Representação esquemática, sem escala anatômica e não é uma fotografia
        clínica.
      </figcaption>
    </figure>

    <div class="eye-structures">
      <ul class="eye-structure-list" data-eye-list>
        {
          structures.map((structure, index) => (
            <li>
              <button
                type="button"
                data-eye-structure={structure.id}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="eye-structure-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {structure.name}
              </button>
            </li>
          ))
        }
      </ul>

      <div class="eye-structure-details">
        {
          structures.map((structure, index) => (
            <article
              data-eye-detail={structure.id}
              hidden={index !== 0 ? true : undefined}
            >
              <h3>{structure.name}</h3>
              <p>{structure.summary}</p>
              <a class="text-link" href={structure.href}>
                {structure.linkLabel}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .eye-explorer {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line-soft);
    background: var(--paper-0);
  }

  .eye-explorer-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .eye-explorer-intro p {
    max-width: var(--measure);
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }

  .eye-stage {
    margin: 0;
  }

  .eye-canvas-holder {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 30% 20%, #ffffff 0%, var(--paper-100) 62%),
      var(--paper-100);
    overflow: hidden;
  }

  .eye-canvas-holder canvas,
  .eye-fallback {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .eye-canvas-holder canvas {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-out-soft);
    touch-action: pan-y;
  }

  .eye-stage[data-eye-ready="true"] canvas {
    opacity: 1;
  }

  .eye-stage[data-eye-ready="true"] .eye-fallback {
    opacity: 0;
  }

  .eye-fallback {
    padding: 12%;
    transition: opacity var(--duration-slow) var(--ease-out-soft);
  }

  .eye-stage figcaption {
    max-width: 46ch;
    margin: 0.9rem auto 0;
    color: var(--ink-soft);
    font-size: var(--text-meta);
    text-align: center;
  }

  .eye-structure-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.8rem;
    padding: 0;
    list-style: none;
  }

  .eye-structure-list button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper-0);
    color: var(--ink-soft);
    font-size: var(--text-small);
    font-weight: 650;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .eye-structure-list button:hover {
    border-color: var(--teal-600);
    color: var(--ink);
  }

  .eye-structure-list button[aria-pressed="true"] {
    border-color: var(--navy-800);
    background: var(--navy-800);
    color: #ffffff;
  }

  /* O numerador é texto pequeno: opacidade sobre o branco derrubava o
     contraste para 3,95:1. O tom mais claro da escala já dá a hierarquia sem
     sair do 4,5:1. */
  .eye-structure-index {
    color: var(--navy-400);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .eye-structure-list button[aria-pressed="true"] .eye-structure-index {
    color: rgb(255 255 255 / 78%);
  }

  .eye-structure-details h3 {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
  }

  .eye-structure-details p {
    max-width: var(--measure);
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
  }

  @media (min-width: 900px) {
    .eye-explorer-grid {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }

    .eye-explorer-intro {
      grid-column: 1 / -1;
      max-width: 42rem;
    }
  }
</style>

<script>
  import type { Mesh, MeshBasicMaterial } from "three";

  type Structure = {
    id: string;
    position: [number, number, number];
    color: number;
  };

  // Âncoras das estruturas no modelo. Ficam no cliente porque só existem em
  // função da geometria — o texto de cada estrutura já está no HTML.
  // Os pontos ficam num raio maior que o do filme lacrimal (1,09): dentro dele
  // as cúpulas transparentes escondiam o marcador.
  const anchors: Structure[] = [
    { id: "tear-film", position: [-0.34, 0.66, 0.94], color: 0x2fb6c8 },
    { id: "cornea", position: [0.3, 0.16, 1.14], color: 0x0b827f },
    { id: "conjunctiva", position: [-1.06, 0.12, 0.5], color: 0x5c7395 },
    { id: "lid-margin", position: [0, -0.94, 0.72], color: 0xb07a3f },
    { id: "meibomian", position: [0.54, -0.98, 0.48], color: 0x9a6430 },
  ];

  const stage = document.querySelector<HTMLElement>("[data-eye-stage]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-eye-canvas]");
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>("[data-eye-structure]"),
  ];
  const details = [
    ...document.querySelectorAll<HTMLElement>("[data-eye-detail]"),
  ];

  let activeId = anchors[0]?.id ?? "";

  const selectStructure = (id: string) => {
    activeId = id;
    buttons.forEach((button) => {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.eyeStructure === id),
      );
    });
    details.forEach((detail) => {
      detail.hidden = detail.dataset.eyeDetail !== id;
    });
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.eyeStructure;
      if (!id) return;
      selectStructure(id);
      window.dispatchEvent(
        new CustomEvent("olhossecos:eye-select", { detail: { id } }),
      );
    });
  });

  // A partir daqui é só o 3D. Sem WebGL, sem Three.js ou com pouca memória, a
  // seção continua funcionando com a ilustração e a lista acima.
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  const isCapable = () => {
    if (!stage || !canvas) return false;
    // deviceMemory só existe em navegadores Chromium; onde não existe, seguimos
    // adiante e o próprio teste de contexto WebGL decide.
    const memory = (navigator as Navigator & { deviceMemory?: number })
      .deviceMemory;
    if (memory !== undefined && memory < 4) return false;

    // Three.js passa de 700 KB antes da compressão. Em modo de economia de
    // dados ou em conexão lenta declarada, a ilustração estática é a resposta
    // certa — ela já contém a mesma informação.
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    if (connection?.saveData) return false;
    if (
      connection?.effectiveType &&
      /(^|-)(slow-)?2g$/u.test(connection.effectiveType)
    ) {
      return false;
    }
    try {
      const probe = document.createElement("canvas");
      return Boolean(probe.getContext("webgl2") ?? probe.getContext("webgl"));
    } catch {
      return false;
    }
  };

  const boot = async () => {
    if (!stage || !canvas || !isCapable()) return;

    const THREE = await import("three");

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
      powerPreference: "low-power",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, 0.1, 40);
    camera.position.set(0, 0, 5.1);

    const eye = new THREE.Group();
    eye.rotation.set(0.08, -0.25, 0);
    scene.add(eye);

    // Esclera. O leve tom quente evita o branco chapado, que sob luz frontal
    // some contra o fundo claro da seção.
    const sclera = new THREE.Mesh(
      new THREE.SphereGeometry(1, 56, 40),
      new THREE.MeshStandardMaterial({
        color: 0xf3f1ec,
        roughness: 0.62,
        metalness: 0,
      }),
    );
    eye.add(sclera);

    // Vasos discretos na esclera: dois anéis finos, o suficiente para o olho
    // não parecer uma esfera de plástico.
    const vessels = new THREE.Mesh(
      new THREE.TorusGeometry(0.94, 0.006, 6, 60, Math.PI * 1.2),
      new THREE.MeshBasicMaterial({ color: 0xd8a9a4 }),
    );
    vessels.rotation.set(0.4, 0.3, 1.1);
    eye.add(vessels);

    // Íris e pupila ficam à frente da esfera (z > raio) e sob a cúpula da
    // córnea: dentro dela a esclera as esconderia.
    const iris = new THREE.Mesh(
      new THREE.CircleGeometry(0.4, 56),
      new THREE.MeshStandardMaterial({
        color: 0x0f5f72,
        roughness: 0.35,
        metalness: 0.05,
      }),
    );
    iris.position.z = 1.005;
    eye.add(iris);

    const irisRing = new THREE.Mesh(
      new THREE.RingGeometry(0.38, 0.42, 56),
      new THREE.MeshBasicMaterial({ color: 0x063343 }),
    );
    irisRing.position.z = 1.008;
    eye.add(irisRing);

    const pupil = new THREE.Mesh(
      new THREE.CircleGeometry(0.16, 40),
      new THREE.MeshBasicMaterial({ color: 0x041b24 }),
    );
    pupil.position.z = 1.012;
    eye.add(pupil);

    // Córnea: calota transparente sobre a íris. Sem transmission — o custo em
    // GPU não se paga num objeto deste tamanho na tela.
    const cornea = new THREE.Mesh(
      new THREE.SphereGeometry(1.05, 48, 32, 0, Math.PI * 2, 0, 0.52),
      new THREE.MeshPhysicalMaterial({
        color: 0xcfeaf1,
        transparent: true,
        opacity: 0.26,
        roughness: 0.06,
        clearcoat: 1,
        side: THREE.DoubleSide,
      }),
    );
    cornea.rotation.x = Math.PI / 2;
    eye.add(cornea);

    // Filme lacrimal: cúpula fina por cima da córnea, quase só um brilho.
    const tearFilm = new THREE.Mesh(
      new THREE.SphereGeometry(1.09, 40, 28, 0, Math.PI * 2, 0, 0.6),
      new THREE.MeshPhysicalMaterial({
        color: 0x8fd8e4,
        transparent: true,
        opacity: 0.12,
        roughness: 0.02,
        side: THREE.DoubleSide,
      }),
    );
    tearFilm.rotation.x = Math.PI / 2;
    eye.add(tearFilm);

    // Margens palpebrais: dois arcos deslocados para a frente, como as bordas
    // que tocam a superfície.
    const lidMaterial = new THREE.MeshStandardMaterial({
      color: 0xb07a3f,
      roughness: 0.55,
    });
    const upperLid = new THREE.Mesh(
      new THREE.TorusGeometry(0.86, 0.045, 12, 56, Math.PI * 0.86),
      lidMaterial,
    );
    upperLid.position.z = 0.5;
    upperLid.rotation.z = Math.PI * 0.07;
    eye.add(upperLid);

    const lowerLid = new THREE.Mesh(
      new THREE.TorusGeometry(0.86, 0.045, 12, 56, Math.PI * 0.86),
      lidMaterial,
    );
    lowerLid.position.z = 0.5;
    lowerLid.rotation.z = Math.PI * 1.07;
    eye.add(lowerLid);

    // Glândulas de Meibômio: fileira curta atrás da margem inferior.
    const glands = new THREE.Group();
    const glandMaterial = new THREE.MeshStandardMaterial({
      color: 0x9a6430,
      roughness: 0.7,
    });
    for (let index = 0; index < 11; index += 1) {
      const gland = new THREE.Mesh(
        new THREE.CapsuleGeometry(0.02, 0.13, 4, 8),
        glandMaterial,
      );
      const angle = Math.PI * (1.12 + index * 0.07);
      gland.position.set(Math.cos(angle) * 0.9, Math.sin(angle) * 0.9, 0.42);
      gland.rotation.z = angle + Math.PI / 2;
      glands.add(gland);
    }
    eye.add(glands);

    // Conjuntiva: faixa lateral levemente destacada sobre a esclera.
    const conjunctiva = new THREE.Mesh(
      new THREE.SphereGeometry(1.005, 40, 28, Math.PI * 0.62, Math.PI * 0.5),
      new THREE.MeshStandardMaterial({
        color: 0xdfe7ef,
        roughness: 0.5,
        transparent: true,
        opacity: 0.85,
      }),
    );
    eye.add(conjunctiva);

    scene.add(new THREE.AmbientLight(0xffffff, 1.1));
    const keyLight = new THREE.DirectionalLight(0xffffff, 2.4);
    keyLight.position.set(2.4, 2.8, 3.2);
    scene.add(keyLight);
    const rimLight = new THREE.DirectionalLight(0x8fc9dd, 1.1);
    rimLight.position.set(-3, -1.2, 0.8);
    scene.add(rimLight);

    const markers = new Map<string, Mesh>();
    anchors.forEach((anchor) => {
      const marker = new THREE.Mesh(
        new THREE.SphereGeometry(0.055, 16, 12),
        new THREE.MeshBasicMaterial({
          color: anchor.color,
          transparent: true,
          // Sem depthWrite o marcador não é recortado pelas cúpulas
          // transparentes que passam por cima dele.
          depthWrite: false,
        }),
      );
      marker.position.set(...anchor.position);
      marker.renderOrder = 3;
      marker.userData.structureId = anchor.id;
      markers.set(anchor.id, marker);
      eye.add(marker);
    });

    let needsRender = true;
    let visible = false;
    let frame = 0;
    let drifting = !prefersReducedMotion.matches;
    let idleTimer = 0;

    const resize = () => {
      const size = canvas.clientWidth || 1;
      renderer.setSize(size, size, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
      needsRender = true;
    };

    const highlight = () => {
      markers.forEach((marker, id) => {
        const scale = id === activeId ? 1.7 : 1;
        marker.scale.setScalar(scale);
        (marker.material as MeshBasicMaterial).opacity =
          id === activeId ? 1 : 0.55;
        (marker.material as MeshBasicMaterial).transparent = true;
      });
      needsRender = true;
    };

    // Gira o modelo até a estrutura escolhida ficar de frente. Interpolação
    // curta: o movimento orienta, não faz cena.
    let targetYaw = 0;
    let targetPitch = 0;
    const faceStructure = (id: string) => {
      const anchor = anchors.find((item) => item.id === id);
      if (!anchor) return;
      const [x, y, z] = anchor.position;
      targetYaw = -Math.atan2(x, z) * 0.55;
      targetPitch = Math.max(
        -0.28,
        Math.min(0.28, Math.atan2(y, Math.hypot(x, z)) * 0.4),
      );
      needsRender = true;
    };

    const loop = () => {
      frame = 0;
      if (!visible) return;

      if (drifting) {
        targetYaw += 0.0016;
      }

      const yawDelta = targetYaw - eye.rotation.y;
      const pitchDelta = targetPitch - eye.rotation.x;
      if (Math.abs(yawDelta) > 0.0005 || Math.abs(pitchDelta) > 0.0005) {
        eye.rotation.y += yawDelta * 0.08;
        eye.rotation.x += pitchDelta * 0.08;
        needsRender = true;
      }

      if (needsRender) {
        renderer.render(scene, camera);
        needsRender = false;
      }

      if (visible && (drifting || needsRender)) {
        frame = requestAnimationFrame(loop);
      }
    };

    const kick = () => {
      needsRender = true;
      if (!frame && visible) frame = requestAnimationFrame(loop);
    };

    // Arrasto: rotação manual com limites, para o modelo nunca ficar de costas.
    let dragging = false;
    let lastX = 0;
    let lastY = 0;

    const pauseDrift = () => {
      drifting = false;
      window.clearTimeout(idleTimer);
      if (prefersReducedMotion.matches) return;
      idleTimer = window.setTimeout(() => {
        drifting = true;
        kick();
      }, 6000);
    };

    canvas.addEventListener("pointerdown", (event) => {
      dragging = true;
      lastX = event.clientX;
      lastY = event.clientY;
      canvas.setPointerCapture(event.pointerId);
      pauseDrift();
    });

    canvas.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      targetYaw += (event.clientX - lastX) * 0.006;
      targetPitch = Math.max(
        -0.6,
        Math.min(0.6, targetPitch + (event.clientY - lastY) * 0.004),
      );
      lastX = event.clientX;
      lastY = event.clientY;
      kick();
    });

    const endDrag = (event: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      canvas.releasePointerCapture?.(event.pointerId);
    };
    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);

    canvas.addEventListener(
      "wheel",
      (event) => {
        if (!event.ctrlKey && Math.abs(event.deltaY) < 24) return;
        event.preventDefault();
        camera.position.z = Math.max(
          3.6,
          Math.min(6.4, camera.position.z + event.deltaY * 0.004),
        );
        kick();
      },
      { passive: false },
    );

    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();

    const pickMarker = (event: PointerEvent | MouseEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
      raycaster.setFromCamera(pointer, camera);
      return raycaster.intersectObjects([...markers.values()])[0];
    };

    canvas.addEventListener("pointermove", (event) => {
      if (dragging) return;
      canvas.style.cursor = pickMarker(event) ? "pointer" : "grab";
    });
    canvas.addEventListener("click", (event) => {
      const hit = pickMarker(event);
      const id = hit?.object.userData.structureId as string | undefined;
      if (!id) return;
      selectStructure(id);
      faceStructure(id);
      highlight();
      pauseDrift();
      kick();
    });

    window.addEventListener("olhossecos:eye-select", (event) => {
      const id = (event as CustomEvent<{ id: string }>).detail.id;
      faceStructure(id);
      highlight();
      pauseDrift();
      kick();
    });

    prefersReducedMotion.addEventListener("change", (event) => {
      drifting = !event.matches;
      kick();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
        if (visible) kick();
        else if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      },
      { rootMargin: "120px" },
    );
    observer.observe(stage);

    new ResizeObserver(() => {
      resize();
      kick();
    }).observe(canvas);

    resize();
    highlight();
    faceStructure(activeId);
    stage.dataset.eyeReady = "true";
    kick();
  };

  // Só busca o Three.js quando a seção se aproxima da viewport.
  if (stage && canvas) {
    const loadObserver = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        loadObserver.disconnect();
        void boot().catch(() => {
          stage.dataset.eyeReady = "false";
        });
      },
      { rootMargin: "300px" },
    );
    loadObserver.observe(stage);
  }
</script>
