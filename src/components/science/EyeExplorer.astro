---
/**
 * Explorador Anatômico Interativo de Alta Fidelidade da Superfície Ocular.
 *
 * Integra renderização médica 3D de alta definição, iluminação dinâmica interativa,
 * mapeamento topográfico vetorial e marcadores de sonar com biomarcadores clínicos.
 */
const structures = [
  {
    id: "tear-film",
    name: "Filme lacrimal",
    color: "#087f95",
    // Tom escuro do mesmo acento, para o texto do rótulo: o claro fica em
    // 4,49:1 sobre o papel quente — 0,01 abaixo do mínimo de AA.
    textColor: "#00657a",
    colorRgb: "8, 127, 149",
    tag: "Película & Meniscos",
    biomarker: "NIBUT / Estabilidade lacrimal",
    top: "32%",
    left: "48%",
    summary:
      "Película fluida de 3 a 5 micrômetros que recobre a superfície exposta do olho e forma meniscos nas margens palpebrais. Sua estabilidade físico-química e tensão superficial determinam o conforto e a qualidade da refração óptica.",
    clinicalDetail:
      "A ruptura precoce (BUT < 10s) expõe o epitélio e desencadeia estresse hiperosmolar.",
    href: "/guias/olho-seco-guia-essencial",
    linkLabel: "Como o filme lacrimal se organiza",
  },
  {
    id: "cornea",
    name: "Córnea",
    color: "#0b827f",
    // Tom escuro do mesmo acento, para o texto do rótulo: o claro fica em
    // 4,49:1 sobre o papel quente — 0,01 abaixo do mínimo de AA.
    textColor: "#066765",
    colorRgb: "11, 130, 127",
    tag: "Cúpula Óptica Transparente",
    biomarker: "Fluoresceína / Integridade epitelial",
    top: "48%",
    left: "54%",
    summary:
      "Lente biológica asférica transparente, prolata e avascular, densamente inervada pelos ramos ciliares do trigêmeo. Responde por cerca de 70% do poder dióptrico ocular e é onde a perda celular e a dor neuropática se manifestam.",
    clinicalDetail:
      "A ceratite ponteada e as alterações na sensibilidade corneana são avaliadas com corantes vitais.",
    href: "/diagnostico",
    linkLabel: "O que o exame investiga",
  },
  {
    id: "conjunctiva",
    name: "Conjuntiva",
    color: "#5c7395",
    // Tom escuro do mesmo acento, para o texto do rótulo: o claro fica em
    // 4,49:1 sobre o papel quente — 0,01 abaixo do mínimo de AA.
    textColor: "#465a78",
    colorRgb: "92, 115, 149",
    tag: "Mucosa Bulbar & Fórnices",
    biomarker: "Lissamina verde / Células caliciformes",
    top: "54%",
    left: "78%",
    summary:
      "Membrana mucosa ricamente vascularizada que reveste a esclera (conjuntiva bulbar) até o limbo e dobra-se nos fórnices. Abriga as células caliciformes que produzem a camada de mucina essencial para a aderência da lágrima.",
    clinicalDetail:
      "A conjuntivocalase e a microinflamação geram atrito mecânico constante durante a piscada.",
    href: "/guias/conjuntivocalase-olho-seco-mecanico",
    linkLabel: "Quando a conjuntiva sobra e atrapalha",
  },
  {
    id: "lid-margin",
    name: "Margem palpebral",
    color: "#b07a3f",
    // Tom escuro do mesmo acento, para o texto do rótulo: o claro fica em
    // 4,49:1 sobre o papel quente — 0,01 abaixo do mínimo de AA.
    textColor: "#7d4f22",
    colorRgb: "176, 122, 63",
    tag: "Borda Livre de Aposição",
    biomarker: "Linha de Marx / Dinâmica do piscar",
    top: "22%",
    left: "40%",
    summary:
      "Borda livre de contato e aposição entre as pálpebras superior e inferior. A dinâmica da piscada completa distribui o filme, enquanto a integridade da linha mucocutânea previne o escape prematuro de lágrimas.",
    clinicalDetail:
      "Piscadas incompletas e queratinização da margem reduzem a renovação do filme sobre a córnea.",
    href: "/guias/higiene-palpebral-com-seguranca",
    linkLabel: "Higiene palpebral com segurança",
  },
  {
    id: "meibomian",
    name: "Glândulas de Meibômio",
    color: "#d97706",
    // Tom escuro do mesmo acento, para o texto do rótulo: o claro fica em
    // 4,49:1 sobre o papel quente — 0,01 abaixo do mínimo de AA.
    textColor: "#8a5a08",
    colorRgb: "217, 119, 6",
    tag: "Colunas Lipídicas Tarsais",
    biomarker: "Meibografia infravermelha / Meiboscore",
    top: "76%",
    left: "60%",
    summary:
      "Glândulas sebáceas modificadas dispostas verticalmente nas placas tarsais, com orifícios excretores na margem palpebral. Secretam o meibum, fração lipídica que retarda em até 95% a evaporação da fase aquosa.",
    clinicalDetail:
      "A Disfunção das Glândulas de Meibômio (DGM) é o fator etiológico mais comum do olho seco evaporativo.",
    href: "/causas#evaporacao",
    linkLabel: "Evaporação como causa",
  },
];
---

<section class="eye-explorer" aria-labelledby="eye-explorer-title">
  <div class="page-shell eye-explorer-grid">
    <header class="eye-explorer-intro">
      <p class="eyebrow">Anatomia da superfície ocular</p>
      <h2 id="eye-explorer-title" class="section-heading">
        Onde cada estrutura entra na história
      </h2>
      <p>
        O olho seco é uma disfunção multifatorial da unidade integrada da
        superfície. Explore a renderização médica em alta definição, interaja
        com a iluminação dinâmica ou selecione cada estrutura para examinar seus
        marcadores fisiológicos.
      </p>
    </header>

    <!-- Palco Visual de Alta Fidelidade -->
    <figure
      class="eye-stage"
      data-eye-stage
      data-active-id="tear-film"
      role="region"
      aria-label="Explorador anatômico interativo da superfície ocular"
    >
      <div class="eye-canvas-holder" data-eye-holder>
        <!-- Camada Base: Renderização Médica 3D Fotorealista -->
        <picture class="eye-render-picture">
          <source
            srcset="/images/educacao/anatomia-superficie-ocular-3d-760.avif 760w, /images/educacao/anatomia-superficie-ocular-3d-1200.avif 1200w"
            type="image/avif"
          />
          <source
            srcset="/images/educacao/anatomia-superficie-ocular-3d-760.webp 760w, /images/educacao/anatomia-superficie-ocular-3d-1200.webp 1200w"
            type="image/webp"
          />
          <img
            src="/images/educacao/anatomia-superficie-ocular-3d.jpg"
            alt="Renderização médica tridimensional do segmento anterior e superfície ocular de alta definição"
            width="1200"
            height="1200"
            loading="lazy"
            class="eye-render-img"
            data-eye-img
          />
        </picture>

        <!-- Camada Dinâmica de Brilho e Iluminação Interativa -->
        <canvas class="eye-shimmer-canvas" data-eye-canvas aria-hidden="true"
        ></canvas>

        <!-- Camada Vetorial de Realce Anatômico Topográfico -->
        <svg
          class="eye-vector-overlay"
          viewBox="0 0 1000 1000"
          aria-hidden="true"
        >
          <defs>
            <!-- Gradiente de Menisco / Filme Lacrimal -->
            <radialGradient id="grad-tear" cx="48%" cy="46%" r="52%">
              <stop offset="0%" stop-color="#087f95" stop-opacity="0.1"></stop>
              <stop offset="70%" stop-color="#2fb6c8" stop-opacity="0.45"
              ></stop>
              <stop offset="100%" stop-color="#38d8ec" stop-opacity="0.85"
              ></stop>
            </radialGradient>

            <!-- Gradiente da Córnea -->
            <radialGradient id="grad-cornea" cx="46%" cy="48%" r="48%">
              <stop offset="0%" stop-color="#0b827f" stop-opacity="0.08"></stop>
              <stop offset="75%" stop-color="#0b827f" stop-opacity="0.38"
              ></stop>
              <stop offset="100%" stop-color="#14b8a6" stop-opacity="0.9"
              ></stop>
            </radialGradient>

            <!-- Filtro de Brilho Lúmen -->
            <filter
              id="glow-lumen"
              x="-20%"
              y="-20%"
              width="140%"
              height="140%"
            >
              <feGaussianBlur stdDeviation="6" result="blur"></feGaussianBlur>
              <feComposite in="SourceGraphic" in2="blur" operator="over"
              ></feComposite>
            </filter>
          </defs>

          <!-- 1. Camada Filme Lacrimal & Meniscos -->
          <g
            class="vector-structure-layer layer-tear-film"
            data-layer="tear-film"
          >
            <!-- Película sobre a zona óptica -->
            <ellipse
              cx="490"
              cy="495"
              rx="230"
              ry="230"
              fill="url(#grad-tear)"
              stroke="#2fb6c8"
              stroke-width="3"
              stroke-dasharray="8 6"
              filter="url(#glow-lumen)"></ellipse>
            <!-- Menisco Superior -->
            <path
              d="M260 300 Q 480 235 710 295"
              fill="none"
              stroke="#38d8ec"
              stroke-width="6"
              stroke-linecap="round"
              filter="url(#glow-lumen)"></path>
            <!-- Menisco Inferior -->
            <path
              d="M265 690 Q 490 755 725 695"
              fill="none"
              stroke="#38d8ec"
              stroke-width="6"
              stroke-linecap="round"
              filter="url(#glow-lumen)"></path>
          </g>

          <!-- 2. Camada Córnea & Anel Limbar -->
          <g class="vector-structure-layer layer-cornea" data-layer="cornea">
            <circle
              cx="490"
              cy="495"
              r="225"
              fill="url(#grad-cornea)"
              stroke="#0b827f"
              stroke-width="4.5"
              filter="url(#glow-lumen)"></circle>
            <!-- Anel Limbar de Transição -->
            <circle
              cx="490"
              cy="495"
              r="232"
              fill="none"
              stroke="#14b8a6"
              stroke-width="3"
              stroke-dasharray="5 3"></circle>
          </g>

          <!-- 3. Camada Conjuntiva Bulbar -->
          <g
            class="vector-structure-layer layer-conjunctiva"
            data-layer="conjunctiva"
          >
            <!-- Zona Bulbar Temporal -->
            <path
              d="M710 320 Q 880 430 920 540 Q 880 660 720 705 Q 740 540 710 320 Z"
              fill="#5c7395"
              fill-opacity="0.32"
              stroke="#8fa3bd"
              stroke-width="2.5"
              filter="url(#glow-lumen)"></path>
            <!-- Zona Bulbar Nasal -->
            <path
              d="M260 310 Q 140 430 110 520 Q 140 640 260 690 Q 240 530 260 310 Z"
              fill="#5c7395"
              fill-opacity="0.32"
              stroke="#8fa3bd"
              stroke-width="2.5"
              filter="url(#glow-lumen)"></path>
          </g>

          <!-- 4. Camada Margem Palpebral -->
          <g
            class="vector-structure-layer layer-lid-margin"
            data-layer="lid-margin"
          >
            <!-- Arco Margem Superior -->
            <path
              d="M110 520 Q 480 180 910 500"
              fill="none"
              stroke="#d97706"
              stroke-width="8"
              stroke-linecap="round"
              filter="url(#glow-lumen)"></path>
            <!-- Arco Margem Inferior -->
            <path
              d="M110 520 Q 490 820 910 500"
              fill="none"
              stroke="#d97706"
              stroke-width="8"
              stroke-linecap="round"
              filter="url(#glow-lumen)"></path>
          </g>

          <!-- 5. Camada Glândulas de Meibômio -->
          <g
            class="vector-structure-layer layer-meibomian"
            data-layer="meibomian"
          >
            <!-- Orifícios excretores ao longo da margem inferior -->
            <g fill="#f59e0b" filter="url(#glow-lumen)">
              <circle cx="280" cy="712" r="5"></circle>
              <circle cx="320" cy="735" r="5"></circle>
              <circle cx="365" cy="754" r="5"></circle>
              <circle cx="415" cy="768" r="5"></circle>
              <circle cx="465" cy="775" r="5"></circle>
              <circle cx="515" cy="775" r="5"></circle>
              <circle cx="565" cy="768" r="5"></circle>
              <circle cx="615" cy="754" r="5"></circle>
              <circle cx="660" cy="735" r="5"></circle>
              <circle cx="700" cy="712" r="5"></circle>
            </g>
            <!-- Colunas Tarsais Verticais -->
            <g
              stroke="#f59e0b"
              stroke-width="4.5"
              stroke-linecap="round"
              filter="url(#glow-lumen)"
            >
              <line x1="320" y1="745" x2="315" y2="820"></line>
              <line x1="365" y1="765" x2="360" y2="840"></line>
              <line x1="415" y1="778" x2="410" y2="860"></line>
              <line x1="465" y1="785" x2="465" y2="870"></line>
              <line x1="515" y1="785" x2="515" y2="870"></line>
              <line x1="565" y1="778" x2="570" y2="860"></line>
              <line x1="615" y1="765" x2="620" y2="840"></line>
              <line x1="660" y1="745" x2="665" y2="820"></line>
            </g>
          </g>
        </svg>

        <!-- Marcadores Sonar Interativos -->
        <div class="eye-pins-overlay">
          {
            structures.map((s, index) => (
              <button
                type="button"
                class="eye-sonar-pin"
                data-pin-id={s.id}
                style={`top: ${s.top}; left: ${s.left}; --pin-color: ${s.color};`}
                aria-label={`Visualizar ${s.name}`}
                aria-pressed={index === 0 ? "true" : "false"}
              >
                <span class="sonar-wave" aria-hidden="true" />
                <span class="sonar-core">
                  <span class="sonar-num">{index + 1}</span>
                </span>
                <span class="sonar-tooltip" role="tooltip">
                  <strong>{s.name}</strong>
                  <small>{s.tag}</small>
                </span>
              </button>
            ))
          }
        </div>

        <!-- HUD Superior com Identificação e Biomarcadores -->
        <div class="eye-stage-hud" data-eye-hud aria-hidden="true">
          <div class="hud-pill-badge">
            <span class="hud-dot" data-eye-hud-dot></span>
            <span class="hud-name" data-eye-hud-name>Filme lacrimal</span>
            <span class="hud-tag" data-eye-hud-tag>Película & Meniscos</span>
          </div>

          <div class="hud-biomarker" data-eye-hud-biomarker>
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="22" y1="12" x2="18" y2="12"></line>
              <line x1="6" y1="12" x2="2" y2="12"></line>
              <line x1="12" y1="6" x2="12" y2="2"></line>
              <line x1="12" y1="22" x2="12" y2="18"></line>
            </svg>
            <span data-eye-hud-biomarker-text
              >NIBUT / Estabilidade lacrimal</span
            >
          </div>
        </div>

        <!-- Dica de Interação no Rodapé do Palco -->
        <div class="eye-stage-footer">
          <span class="footer-hint">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M15 15l6 6m-11-4a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm-3-7h6m-3-3v6"
              ></path>
            </svg>
            Toque nos pontos numerados ou alterne os botões para examinar cada camada
          </span>
        </div>
      </div>

      <figcaption>
        Visualização 3D de alta resolução do segmento anterior. Representação
        anatômica integrada da unidade funcional da superfície ocular.
      </figcaption>
    </figure>

    <!-- Lista de Navegação e Artigos Explicativos -->
    <div class="eye-structures">
      <ul
        class="eye-structure-list"
        data-eye-list
        role="tablist"
        aria-label="Estruturas da superfície ocular"
      >
        {
          structures.map((structure, index) => (
            <li role="presentation">
              <button
                type="button"
                role="tab"
                data-eye-structure={structure.id}
                data-color={structure.color}
                style={`--structure-accent: ${structure.color};`}
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls={`detail-${structure.id}`}
                id={`tab-${structure.id}`}
                tabindex={index === 0 ? "0" : "-1"}
              >
                <span class="eye-structure-index">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span
                  class="eye-structure-dot"
                  style={`background-color: ${structure.color};`}
                  aria-hidden="true"
                />
                <span class="eye-structure-label">{structure.name}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="eye-structure-details">
        {
          structures.map((structure, index) => (
            <article
              id={`detail-${structure.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${structure.id}`}
              data-eye-detail={structure.id}
              style={`--structure-accent: ${structure.color}; --structure-accent-text: ${structure.textColor};`}
              hidden={index !== 0 ? true : undefined}
            >
              <div class="detail-header-row">
                <span class="detail-tag">{structure.tag}</span>
                <span class="detail-biomarker-pill">
                  🎯 {structure.biomarker}
                </span>
              </div>
              <h3>{structure.name}</h3>
              <p>{structure.summary}</p>
              <div class="detail-clinical-box">
                <span class="clinical-icon">⚕️</span>
                <p class="clinical-text">
                  <strong>Relevância clínica:</strong>{" "}
                  {structure.clinicalDetail}
                </p>
              </div>
              <a class="text-link" href={structure.href}>
                {structure.linkLabel}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 12h16m-5-5 5 5-5 5" />
                </svg>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .eye-explorer {
    padding-block: var(--space-section);
    border-top: 1px solid var(--line-soft);
    background: var(--paper-0);
  }

  .eye-explorer-grid {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .eye-explorer-intro p {
    max-width: var(--measure);
    margin: 1.4rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-lead);
    line-height: 1.6;
  }

  .eye-stage {
    margin: 0;
  }

  .eye-canvas-holder {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 540px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    background: #020b14;
    box-shadow:
      0 12px 32px rgb(4 20 47 / 8%),
      0 1px 3px rgb(4 20 47 / 5%),
      inset 0 0 0 1px rgb(255 255 255 / 12%);
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }

  /* Camada 1: Render 3D Fotorealista */
  .eye-render-picture,
  .eye-render-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform var(--duration-slow) var(--ease-out-soft),
      filter var(--duration-standard) var(--ease-standard);
  }

  /* Camada 2: Canvas de Shimmer e Especularidade Dinâmica */
  .eye-shimmer-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mix-blend-mode: screen;
    opacity: 0.85;
    z-index: 2;
  }

  /* Camada 3: SVG Vetorial Anatômico de Realce */
  .eye-vector-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 3;
  }

  .vector-structure-layer {
    opacity: 0;
    transition:
      opacity var(--duration-standard) var(--ease-out-soft),
      transform var(--duration-standard) var(--ease-out-soft);
    transform-origin: center;
  }

  /* Realce das camadas conforme o estado ativo */
  .eye-stage[data-active-id="tear-film"] .layer-tear-film,
  .eye-stage[data-active-id="cornea"] .layer-cornea,
  .eye-stage[data-active-id="conjunctiva"] .layer-conjunctiva,
  .eye-stage[data-active-id="lid-margin"] .layer-lid-margin,
  .eye-stage[data-active-id="meibomian"] .layer-meibomian {
    opacity: 1;
    transform: scale(1.01);
  }

  /* Camada 4: Marcadores Sonar */
  .eye-pins-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
  }

  .eye-sonar-pin {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 38px;
    height: 38px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .eye-sonar-pin:focus {
    outline: none;
  }

  .eye-sonar-pin:focus-visible {
    outline: var(--focus-ring-width, 2px) solid
      var(--focus-ring, var(--teal-600, #087f95));
    outline-offset: var(--focus-ring-offset, 2px);
  }

  .sonar-wave {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background-color: var(--pin-color, #087f95);
    opacity: 0.4;
    animation: sonar-pulse 2.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }

  @keyframes sonar-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    70% {
      transform: scale(1.8);
      opacity: 0;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .sonar-core {
    position: relative;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--pin-color, #087f95);
    border: 2.5px solid #ffffff;
    box-shadow:
      0 2px 8px rgb(0 0 0 / 30%),
      0 0 12px var(--pin-color);
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .sonar-num {
    font-size: 0.875rem;
    font-weight: 800;
    color: #ffffff;
    font-variant-numeric: tabular-nums;
  }

  .eye-sonar-pin:hover .sonar-core,
  .eye-sonar-pin:focus-visible .sonar-core,
  .eye-sonar-pin[data-active="true"] .sonar-core {
    transform: scale(1.25);
    box-shadow:
      0 3px 12px rgb(0 0 0 / 40%),
      0 0 20px var(--pin-color);
  }

  /* Tooltip Flutuante no Pin */
  .sonar-tooltip {
    position: absolute;
    bottom: 115%;
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    background: rgb(4 20 47 / 94%);
    backdrop-filter: blur(8px);
    border: 1px solid rgb(255 255 255 / 15%);
    color: #ffffff;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-meta);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      visibility var(--duration-fast);
    box-shadow: 0 4px 14px rgb(0 0 0 / 25%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    z-index: 10;
  }

  .sonar-tooltip strong {
    font-weight: 700;
  }

  .sonar-tooltip small {
    color: var(--teal-100);
    font-size: 0.875rem;
  }

  .eye-sonar-pin:hover .sonar-tooltip,
  .eye-sonar-pin:focus-visible .sonar-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* HUD Superior no Palco */
  .eye-stage-hud {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    z-index: 5;
    gap: 0.5rem;
  }

  .hud-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 999px;
    background: rgb(4 20 47 / 85%);
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 12px rgb(0 0 0 / 20%);
  }

  .hud-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background-color: var(--teal-600);
    box-shadow: 0 0 8px currentColor;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }

  .hud-name {
    font-size: var(--text-meta);
    font-weight: 700;
    color: #ffffff;
  }

  .hud-tag {
    font-size: 0.875rem;
    color: var(--teal-100);
    opacity: 0.85;
  }

  .hud-biomarker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(8px);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--navy-800);
    box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
  }

  @media (max-width: 580px) {
    .hud-tag,
    .hud-biomarker {
      display: none;
    }
  }

  /* Rodapé do Palco */
  .eye-stage-footer {
    position: absolute;
    bottom: 0.75rem;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 5;
  }

  .footer-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: rgb(4 20 47 / 75%);
    backdrop-filter: blur(6px);
    font-size: 0.875rem;
    color: rgb(255 255 255 / 90%);
  }

  .eye-stage figcaption {
    max-width: 52ch;
    margin: 0.9rem auto 0;
    color: var(--ink-soft);
    font-size: var(--text-meta);
    text-align: center;
    line-height: 1.4;
  }

  /* Lista de Estruturas (Botões) */
  .eye-structure-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.8rem;
    padding: 0;
    list-style: none;
  }

  .eye-structure-list button {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 46px;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--paper-0);
    color: var(--ink-soft);
    font-size: var(--text-small);
    font-weight: 650;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .eye-structure-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.75;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .eye-structure-list button:hover {
    border-color: var(--teal-600);
    color: var(--ink);
    transform: translateY(-1px);
  }

  .eye-structure-list button[aria-selected="true"] {
    border-color: var(--surface-inverse);
    background: var(--surface-inverse);
    color: var(--on-inverse);
  }

  .eye-structure-list button[aria-selected="true"] .eye-structure-dot {
    opacity: 1;
    transform: scale(1.3);
    box-shadow: 0 0 8px var(--structure-accent);
  }

  .eye-structure-index {
    color: var(--navy-400);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .eye-structure-list button[aria-selected="true"] .eye-structure-index {
    color: rgb(255 255 255 / 78%);
  }

  /* Painel de Detalhes da Estrutura */
  .eye-structure-details article {
    padding: 1.6rem;
    border: 1px solid var(--line-soft);
    border-left: 4px solid var(--structure-accent, var(--navy-800));
    border-radius: var(--radius-md);
    background: var(--paper-50);
    box-shadow: 0 4px 16px rgb(4 20 47 / 3%);
  }

  .detail-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .detail-tag {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--structure-accent-text, var(--teal-700));
  }

  .detail-biomarker-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--paper-0);
    border: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--navy-800);
  }

  .eye-structure-details h3 {
    margin: 0 0 0.6rem;
    font-family: var(--serif);
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
  }

  .eye-structure-details p {
    max-width: var(--measure);
    margin: 0 0 1.1rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .detail-clinical-box {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    margin-bottom: 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--paper-100);
    border: 1px solid var(--line-soft);
  }

  .clinical-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .clinical-text {
    margin: 0 !important;
    font-size: var(--text-small);
    color: var(--navy-800);
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .eye-explorer-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }

    .eye-explorer-intro {
      grid-column: 1 / -1;
      max-width: 42rem;
    }
  }
</style>

<script>
  type StructureData = {
    id: string;
    name: string;
    color: string;
    tag: string;
    biomarker: string;
  };

  const structuresData: Record<string, StructureData> = {
    "tear-film": {
      id: "tear-film",
      name: "Filme lacrimal",
      color: "#087f95",
      tag: "Película & Meniscos",
      biomarker: "NIBUT / Estabilidade lacrimal",
    },
    cornea: {
      id: "cornea",
      name: "Córnea",
      color: "#0b827f",
      tag: "Cúpula Óptica Transparente",
      biomarker: "Fluoresceína / Integridade epitelial",
    },
    conjunctiva: {
      id: "conjunctiva",
      name: "Conjuntiva",
      color: "#5c7395",
      tag: "Mucosa Bulbar & Fórnices",
      biomarker: "Lissamina verde / Células caliciformes",
    },
    "lid-margin": {
      id: "lid-margin",
      name: "Margem palpebral",
      color: "#b07a3f",
      tag: "Borda Livre de Aposição",
      biomarker: "Linha de Marx / Dinâmica do piscar",
    },
    meibomian: {
      id: "meibomian",
      name: "Glândulas de Meibômio",
      color: "#d97706",
      tag: "Colunas Lipídicas Tarsais",
      biomarker: "Meibografia infravermelha / Meiboscore",
    },
  };

  const initEyeExplorer = () => {
    const stage = document.querySelector<HTMLElement>("[data-eye-stage]");
    const holder = document.querySelector<HTMLElement>("[data-eye-holder]");
    const image = document.querySelector<HTMLElement>("[data-eye-img]");
    const canvas =
      document.querySelector<HTMLCanvasElement>("[data-eye-canvas]");
    const buttons = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-eye-structure]"),
    ];
    const pins = [
      ...document.querySelectorAll<HTMLButtonElement>("[data-pin-id]"),
    ];
    const details = [
      ...document.querySelectorAll<HTMLElement>("[data-eye-detail]"),
    ];
    const hudDot = document.querySelector<HTMLElement>("[data-eye-hud-dot]");
    const hudName = document.querySelector<HTMLElement>("[data-eye-hud-name]");
    const hudTag = document.querySelector<HTMLElement>("[data-eye-hud-tag]");
    const hudBiomarkerText = document.querySelector<HTMLElement>(
      "[data-eye-hud-biomarker-text]",
    );

    if (!stage || !holder || buttons.length === 0) return;
    if (stage.dataset.eyeInited === "true") return;
    stage.dataset.eyeInited = "true";

    let activeId = "tear-film";

    const selectStructure = (id: string) => {
      activeId = id;
      stage.dataset.activeId = id;

      const data = structuresData[id];
      if (data) {
        if (hudName) hudName.textContent = data.name;
        if (hudTag) hudTag.textContent = data.tag;
        if (hudDot) hudDot.style.backgroundColor = data.color;
        if (hudBiomarkerText) hudBiomarkerText.textContent = data.biomarker;
      }

      buttons.forEach((btn) => {
        const isSelected = btn.dataset.eyeStructure === id;
        btn.setAttribute("aria-selected", String(isSelected));
        btn.tabIndex = isSelected ? 0 : -1;
      });

      pins.forEach((pin) => {
        const isPinActive = pin.dataset.pinId === id;
        pin.dataset.active = String(isPinActive);
        pin.setAttribute("aria-pressed", String(isPinActive));
      });

      details.forEach((det) => {
        det.hidden = det.dataset.eyeDetail !== id;
      });
    };

    // Cliques nos Botões da Lista
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.eyeStructure;
        if (id) selectStructure(id);
      });

      btn.addEventListener("keydown", (event) => {
        const currentIndex = buttons.indexOf(btn);
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight" || event.key === "ArrowDown") {
          nextIndex = (currentIndex + 1) % buttons.length;
        } else if (event.key === "ArrowLeft" || event.key === "ArrowUp") {
          nextIndex = (currentIndex - 1 + buttons.length) % buttons.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = buttons.length - 1;
        }

        if (nextIndex === undefined) return;
        event.preventDefault();
        const nextButton = buttons[nextIndex];
        const id = nextButton.dataset.eyeStructure;
        if (id) selectStructure(id);
        nextButton.focus();
      });
    });

    // Cliques nos Pinos Sonar sobre o Modelo
    pins.forEach((pin) => {
      pin.addEventListener("click", () => {
        const id = pin.dataset.pinId;
        if (id) selectStructure(id);
      });
    });

    // Efeito Interativo de Shimmer e Parallax Suave (WebGL / Canvas)
    if (canvas) {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        let width = (canvas.width = holder.clientWidth);
        let height = (canvas.height = holder.clientHeight);

        const resizeCanvas = () => {
          width = canvas.width = holder.clientWidth;
          height = canvas.height = holder.clientHeight;
        };
        window.addEventListener("resize", resizeCanvas, { passive: true });

        let pointerX = width * 0.48;
        let pointerY = height * 0.45;
        let currentX = pointerX;
        let currentY = pointerY;
        let isHovered = false;
        let animFrame = 0;

        const renderShimmer = () => {
          ctx.clearRect(0, 0, width, height);

          // Interpolação suave do brilho
          currentX += (pointerX - currentX) * 0.08;
          currentY += (pointerY - currentY) * 0.08;

          // Gradiente de especularidade óptica sobre o filme lacrimal
          const gradient = ctx.createRadialGradient(
            currentX,
            currentY,
            8,
            currentX,
            currentY,
            width * 0.38,
          );

          const baseColor =
            activeId === "tear-film"
              ? "rgba(56, 216, 236, 0.45)"
              : activeId === "cornea"
                ? "rgba(20, 184, 166, 0.42)"
                : activeId === "meibomian"
                  ? "rgba(245, 158, 11, 0.45)"
                  : "rgba(255, 255, 255, 0.35)";

          gradient.addColorStop(0, "rgba(255, 255, 255, 0.75)");
          gradient.addColorStop(0.2, baseColor);
          gradient.addColorStop(0.6, "rgba(8, 127, 149, 0.08)");
          gradient.addColorStop(1, "rgba(0, 0, 0, 0)");

          ctx.fillStyle = gradient;
          ctx.beginPath();
          ctx.arc(width * 0.49, height * 0.495, width * 0.23, 0, Math.PI * 2);
          ctx.fill();

          if (isHovered || Math.abs(pointerX - currentX) > 0.5) {
            animFrame = requestAnimationFrame(renderShimmer);
          } else {
            animFrame = 0;
          }
        };

        const handlePointerMove = (event: PointerEvent) => {
          const rect = holder.getBoundingClientRect();
          pointerX = event.clientX - rect.left;
          pointerY = event.clientY - rect.top;

          // Parallax 3D sutil na imagem
          if (image) {
            const tiltX = (pointerY / rect.height - 0.5) * -4;
            const tiltY = (pointerX / rect.width - 0.5) * 4;
            image.style.transform = `scale(1.02) rotateX(${tiltX}deg) rotateY(${tiltY}deg)`;
          }

          isHovered = true;
          if (!animFrame) animFrame = requestAnimationFrame(renderShimmer);
        };

        const handlePointerLeave = () => {
          isHovered = false;
          pointerX = width * 0.48;
          pointerY = height * 0.45;
          if (image) {
            image.style.transform = "scale(1) rotateX(0deg) rotateY(0deg)";
          }
          if (!animFrame) animFrame = requestAnimationFrame(renderShimmer);
        };

        holder.addEventListener("pointermove", handlePointerMove);
        holder.addEventListener("pointerleave", handlePointerLeave);

        renderShimmer();
      }
    }

    // Inicialização da primeira estrutura
    selectStructure(activeId);
  };

  initEyeExplorer();
  document.addEventListener("astro:page-load", initEyeExplorer);
</script>
