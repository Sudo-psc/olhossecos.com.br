---
import { responsibleDoctor } from "@/lib/doctor";

const year = new Date().getFullYear();

const groups = [
  {
    title: "Conteúdo",
    links: [
      ["Edições", "/superficie/edicoes"],
      ["Artigos", "/superficie/artigos"],
      // Entrevistas saiu daqui pelo mesmo motivo que saiu do header: nav que
      // aponta para "Em breve" anuncia conteúdo que não existe.
      ["RADAR Científico", "/superficie/radar"],
    ],
  },
  {
    title: "Revista",
    links: [
      ["Tecnologia", "/superficie#tecnologia"],
      ["Parceiros", "/superficie/parceiros"],
      ["Newsletter", "/superficie#newsletter"],
      ["Política editorial", "/superficie#independencia"],
      ["Correção e retratação", "/politica-de-correcao"],
    ],
  },
  {
    title: "Ecossistema",
    links: [
      ["Portal Olho Seco", "/"],
      ["Livros", "/livros"],
      ["Dry Eye Widget", "/app"],
      ["Privacidade", "/privacidade"],
    ],
  },
];
---

<footer class="surface-footer">
  <div class="surface-shell footer-grid">
    <div class="footer-brand">
      <a href="/superficie">SUPERFÍCIE</a>
      <p>Revista de Olho Seco e Superfície Ocular.</p>
      <em>Evidência que chega à prática.</em>
    </div>
    {
      groups.map((group) => (
        <nav aria-label={group.title}>
          <h2>{group.title}</h2>
          {group.links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="surface-shell footer-imprint">
    <p>
      <span>Editor responsável</span>
      <strong>
        <a href={responsibleDoctor.website}>Dr. {responsibleDoctor.name}</a>
      </strong>
      <em>{responsibleDoctor.registration}</em>
    </p>
  </div>

  <div class="surface-shell footer-bottom">
    <p>© {year} SUPERFÍCIE Media.</p>
    <p>Feito com ❤️ pela equipe do Dr. {responsibleDoctor.name}.</p>
    <p>Conteúdo editorial independente. Sem fins promocionais.</p>
  </div>
</footer>

<style>
  .surface-footer {
    background: var(--surface-navy);
    color: var(--surface-paper);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.45fr repeat(3, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .footer-brand a {
    display: block;
    font-family: var(--surface-serif);
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: 0.16em;
  }

  .footer-brand p {
    max-width: 28rem;
    margin: 1rem 0 0.35rem;
    color: var(--surface-muted-on-dark);
  }

  .footer-brand em {
    color: var(--surface-gold-light);
    font-family: var(--surface-serif);
  }

  .surface-footer nav {
    display: grid;
    align-content: start;
    gap: 0.55rem;
  }

  .surface-footer h2 {
    margin: 0 0 0.6rem;
    color: var(--surface-gold-light);
    font-family: var(--surface-sans);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .surface-footer nav a {
    color: var(--surface-muted-on-dark);
    font-size: 0.88rem;
  }

  .surface-footer nav a:hover,
  .surface-footer nav a:focus-visible {
    color: var(--surface-paper);
  }

  /* Identificação do médico responsável (CFM): registro sempre visível. */
  .footer-imprint {
    padding-block: 1.15rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
  }

  .footer-imprint p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.85rem;
    margin: 0;
  }

  .footer-imprint span {
    color: var(--surface-gold-light);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-imprint strong {
    font-family: var(--surface-serif);
    font-size: 1.05rem;
    font-weight: 400;
  }

  .footer-imprint a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer-imprint em {
    color: var(--surface-muted-on-dark);
    font-size: 0.875rem;
    font-style: normal;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .footer-bottom {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
    color: var(--surface-muted-on-dark);
    font-size: 0.875rem;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }

    .surface-footer nav {
      padding-top: 1rem;
      border-top: 1px solid rgb(255 255 255 / 14%);
    }

    .footer-bottom {
      min-height: 96px;
      align-items: flex-start;
      flex-direction: column;
      justify-content: center;
    }

    .footer-bottom p {
      margin: 0;
    }
  }
</style>
