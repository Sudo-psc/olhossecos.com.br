---
import ArticleCitationModal from "@/components/superficie/ArticleCitationModal.astro";
import ArticleFigure from "@/components/superficie/ArticleFigure.astro";
import ArticleQuadro from "@/components/superficie/ArticleQuadro.astro";
import { formatLongDate } from "@/lib/dates";
import {
  calculateArticleReadingTime,
  type MagazineArticle,
} from "@/lib/superficie";
import type { RelatedContent } from "@/lib/related-content";

interface Props {
  article: MagazineArticle;
  related: RelatedContent[];
}

const { article, related } = Astro.props;

/**
 * Quais seções ganham quadro. São as duas que o leitor clínico procura numa
 * leitura em diagonal: a conduta e a ressalva. As demais seguem como corpo,
 * porque encaixotar tudo é o mesmo que não destacar nada.
 */
const quadroDaSecao = (kind: MagazineArticle["content"][number]["kind"]) =>
  kind === "practice"
    ? "O que muda no consultório"
    : kind === "limitations"
      ? "Limitações"
      : null;
const readingTime = calculateArticleReadingTime(article);
const isPreview = article.status !== "published";
const formatDate = formatLongDate;
---

<article class="magazine-article">
  <div class="reading-progress" aria-hidden="true"><span></span></div>

  <header class="article-hero">
    <div
      class="surface-shell article-breadcrumb"
      aria-label="Navegação estrutural"
    >
      <a href="/superficie">SUPERFÍCIE</a>
      <span aria-hidden="true">/</span>
      <a href="/superficie/artigos">Artigos</a>
      <span aria-hidden="true">/</span>
      <span>{article.category}</span>
    </div>

    <div class="surface-shell article-hero-grid">
      <div class="article-heading">
        {
          isPreview && (
            <p class="preview-label">Prévia editorial • não publicada</p>
          )
        }
        {
          article.sponsored && article.sponsor && (
            <p class="sponsor-label">{article.sponsor.label}</p>
          )
        }
        <p class="category">{article.category}</p>
        <p class="review-seal">{article.reviewSeal}</p>
        <h1>{article.title}</h1>
        {article.subtitle && <p class="subtitle">{article.subtitle}</p>}
        <p class="excerpt">{article.excerpt}</p>
      </div>

      <dl class="article-facts">
        <div>
          <dt>Autoria</dt>
          <dd>
            {
              article.author.slug ? (
                <a
                  href={`/autor/${article.author.slug}`}
                  data-analytics-event="author_click"
                  data-analytics-label={article.author.slug}
                >
                  {article.author.name}
                </a>
              ) : (
                article.author.name
              )
            }
          </dd>
          {article.author.specialty && <dd>{article.author.specialty}</dd>}
          {article.author.affiliation && <dd>{article.author.affiliation}</dd>}
        </div>
        {
          article.reviewer && (
            <div>
              <dt>Revisão</dt>
              <dd>{article.reviewer.name}</dd>
            </div>
          )
        }
        <div>
          <dt>Leitura</dt>
          <dd>{readingTime} min</dd>
        </div>
        {
          article.publishedAt && (
            <div>
              <dt>Publicado em</dt>
              <dd>
                <time datetime={article.publishedAt}>
                  {formatDate(article.publishedAt)}
                </time>
              </dd>
            </div>
          )
        }
        {
          article.modifiedAt && (
            <div>
              <dt>Atualizado em</dt>
              <dd>
                <time datetime={article.modifiedAt}>
                  {formatDate(article.modifiedAt)}
                </time>
              </dd>
            </div>
          )
        }
        <div class="article-fact-citation">
          <dt>Citação</dt>
          <dd>
            <ArticleCitationModal {article} />
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <div class="surface-shell article-grid">
    <aside class="article-toc" aria-label="Nesta matéria">
      <p>Nesta matéria</p>
      <nav>
        {
          article.content.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
        {
          article.references.length > 0 && (
            <a href="#referencias">Referências</a>
          )
        }
        <a href="#disclosures">Disclosures</a>
      </nav>
    </aside>

    <div class="article-body">
      {
        article.content.map((section, index) => (
          <section
            id={section.id}
            class:list={["article-section", section.kind]}
          >
            <p class="section-kicker">
              {section.kind === "evidence"
                ? "Evidência"
                : section.kind === "limitations"
                  ? "Limitações"
                  : section.kind === "practice"
                    ? "Aplicação"
                    : "Análise editorial"}
            </p>
            <div class="section-title">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h2>{section.title}</h2>
            </div>
            {section.figure && (
              <ArticleFigure figure={section.figure} priority={index === 0} />
            )}
            {quadroDaSecao(section.kind) ? (
              <ArticleQuadro
                variant={section.kind as "practice" | "limitations"}
                label={quadroDaSecao(section.kind) as string}
              >
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </ArticleQuadro>
            ) : (
              <>
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </>
            )}
            {section.callout && (
              <aside class="article-callout" role="note">
                <p>{section.callout}</p>
              </aside>
            )}
          </section>
        ))
      }

      {
        article.references.length > 0 && (
          <section id="referencias" class="references-section">
            <div class="references-header">
              <div>
                <p class="section-kicker">Fontes</p>
                <h2>Referências</h2>
              </div>
              <ArticleCitationModal {article} />
            </div>
            {/* A citação fica em texto corrido e só o identificador é
                acionável. Envolver a citação inteira num link produzia
                blocos de três linhas sublinhadas — ruído visual em 25
                entradas — e devolvia a referência completa como "texto do
                link" na navegação por leitor de tela. */}
            <ol class="reference-list">
              {article.references.map((reference) => (
                <li>
                  <cite>{reference.label}</cite>
                  <a
                    class="reference-link"
                    href={reference.url}
                    rel="noreferrer"
                  >
                    {reference.doi ? `DOI ${reference.doi}` : "Ver fonte"}
                    <span class="sr-only"> — {reference.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <section id="disclosures" class="disclosure-section">
        <p class="section-kicker">Transparência</p>
        <h2>Conflitos de interesse / disclosures</h2>
        <dl class="disclosure-list">
          {
            article.disclosures.map(({ label, text }) => (
              <>
                <dt>{label}</dt>
                <dd>{text}</dd>
              </>
            ))
          }
        </dl>
        {
          article.sponsored && article.sponsor && (
            <p>
              <strong>{article.sponsor.label}:</strong> {article.sponsor.name}.
            </p>
          )
        }
      </section>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="related-section" aria-labelledby="related-title">
        <div class="surface-shell">
          <header>
            <p>Próximas leituras</p>
            <h2 id="related-title">Conteúdos relacionados</h2>
          </header>
          <ul class="related-grid">
            {related.map((item) => (
              <li>
                <a class="related-card" href={item.href}>
                  <span class="related-label">{item.label}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                  <span class="related-arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M5 19 19 5m-10 0h10v10" />
                    </svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section
    class="article-newsletter"
    aria-labelledby="article-newsletter-title"
  >
    <div class="surface-shell">
      <div>
        <p>Próximas leituras</p>
        <h2 id="article-newsletter-title">Receba a SUPERFÍCIE</h2>
      </div>
      <div>
        <p>
          Novas edições, artigos, entrevistas e evidências diretamente no seu
          e-mail.
        </p>
        <a href="/superficie#newsletter">Receber novas edições</a>
      </div>
    </div>
  </section>
</article>

<script>
  const analyticsWindow = window as typeof window & {
    dataLayer?: Array<Record<string, unknown>>;
  };
  analyticsWindow.dataLayer = analyticsWindow.dataLayer ?? [];

  const progressBar = document.querySelector<HTMLElement>(
    ".reading-progress span",
  );
  const reportedDepths = new Set<number>();

  const updateReadingProgress = () => {
    if (!progressBar) return;
    const article = document.querySelector<HTMLElement>(".magazine-article");
    if (!article) return;
    const start = article.offsetTop;
    const distance = Math.max(1, article.offsetHeight - window.innerHeight);
    const progress = Math.min(
      1,
      Math.max(0, (window.scrollY - start) / distance),
    );
    progressBar.style.transform = `scaleX(${progress})`;

    const percentage = Math.round(progress * 100);
    [25, 50, 75, 100].forEach((depth) => {
      if (percentage < depth || reportedDepths.has(depth)) return;
      reportedDepths.add(depth);
      analyticsWindow.dataLayer?.push({
        event: "article_read_depth",
        depth,
        article_path: window.location.pathname,
      });
    });
  };

  document
    .querySelectorAll<HTMLElement>("[data-analytics-event]")
    .forEach((element) => {
      element.addEventListener("click", () => {
        const detail = {
          event: element.dataset.analyticsEvent,
          label: element.dataset.analyticsLabel ?? "",
          page_path: window.location.pathname,
        };
        analyticsWindow.dataLayer?.push(detail);
        window.dispatchEvent(
          new CustomEvent("olhossecos:analytics", { detail }),
        );
      });
    });

  updateReadingProgress();
  window.addEventListener("scroll", updateReadingProgress, { passive: true });
</script>

<style>
  .magazine-article {
    background: var(--surface-paper);
  }

  .reading-progress {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    height: 3px;
    pointer-events: none;
  }

  .reading-progress span {
    width: 100%;
    height: 100%;
    display: block;
    transform: scaleX(0);
    transform-origin: left;
    background: var(--surface-gold-light);
  }

  .article-hero {
    padding-block: 1rem clamp(4rem, 8vw, 7rem);
    background: var(--surface-navy);
    color: var(--surface-paper);
  }

  .article-breadcrumb {
    min-height: 48px;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--surface-muted-on-dark);
    font-size: var(--text-meta);
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* A linha do breadcrumb permanece fina; a área de 44×44 vem do
     padding + margem em touch-targets.css. */
  .article-breadcrumb a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  .article-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
    align-items: end;
    gap: clamp(3rem, 8vw, 9rem);
    padding-top: clamp(2rem, 5vw, 4.5rem);
  }

  .preview-label,
  .sponsor-label,
  .category,
  .review-seal,
  .section-kicker,
  .article-toc > p,
  .related-section header > p,
  .article-newsletter > div > div:first-child > p {
    margin: 0 0 0.9rem;
    color: var(--surface-gold-light);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .preview-label,
  .sponsor-label,
  .review-seal {
    display: inline-block;
    padding: 0.45rem 0.65rem;
    border: 1px solid currentColor;
  }

  /* O selo informa o processo editorial executado, não é distintivo de
     prestígio — daí o tom neutro, distinto do ouro da marca. Precisa do
     token para fundo escuro: --surface-copy é texto de papel claro e sobre
     o navy do hero fica em 1,54:1, ou seja, ilegível. */
  .review-seal {
    color: var(--surface-muted-on-dark);
    letter-spacing: 0.1em;
  }

  .article-heading h1 {
    max-width: 980px;
    margin: 0 0 1.4rem;
    font-family: var(--surface-serif);
    font-size: var(--text-headline);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .subtitle {
    max-width: 860px;
    color: var(--surface-gold-light);
    font-family: var(--surface-serif);
    font-size: var(--text-h3);
    line-height: 1.25;
  }

  .excerpt {
    max-width: var(--article-column);
    margin-bottom: 0;
    color: var(--surface-muted-on-dark);
    font-size: var(--text-body);
  }

  .article-facts {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 1px solid rgb(255 255 255 / 20%);
  }

  .article-facts div {
    padding-block: 0.8rem;
    border-top: 1px solid rgb(255 255 255 / 18%);
  }

  .article-facts dt {
    color: var(--surface-gold-light);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-facts dd {
    margin: 0.2rem 0 0;
    color: var(--surface-muted-on-dark);
    font-size: var(--text-meta);
  }

  .article-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, var(--article-column));
    justify-content: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .article-toc {
    position: sticky;
    top: 5rem;
    align-self: start;
    padding-top: 1rem;
    border-top: 3px solid var(--surface-teal);
  }

  .article-toc > p,
  .section-kicker,
  .related-section header > p {
    color: var(--surface-teal-dark);
  }

  .article-toc nav {
    display: grid;
  }

  .article-toc a {
    padding-block: 0.65rem;
    border-top: 1px solid var(--surface-line);
    color: var(--surface-muted);
    font-size: var(--text-meta);
    line-height: 1.35;
  }

  .article-toc a:hover,
  .article-toc a:focus-visible {
    color: var(--surface-teal-dark);
  }

  .article-section,
  .references-section,
  .disclosure-section {
    scroll-margin-top: 5rem;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .article-section h2,
  .references-section h2,
  .disclosure-section h2,
  .related-section h2,
  .article-newsletter h2 {
    margin: 0 0 1.4rem;
    font-family: var(--surface-serif);
    font-size: var(--text-display);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .section-title {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: start;
    gap: 0.9rem;
  }

  .section-title > span {
    padding-top: 0.35rem;
    color: var(--surface-gold-text);
    font-family: var(--surface-serif);
    font-size: var(--text-body);
    line-height: 1;
  }

  .section-title h2 {
    padding-left: 1rem;
    border-left: 1px solid var(--surface-gold);
  }

  /* Descendente, não filho direto: o <ArticleQuadro> aninha os parágrafos de
     prática e limitações um nível abaixo, e com `>` eles perdiam a tipografia
     do corpo e caíam para o tamanho de interface. A legenda da figura não é
     atingida — ela mora em ArticleFigure, com escopo próprio. */
  .article-section p:not(.section-kicker),
  .article-section li,
  .disclosure-list dd,
  .disclosure-section > p:not(.section-kicker) {
    color: var(--surface-copy);
    font-family: var(--surface-serif);
    font-size: var(--text-body);
    line-height: 1.75;
  }

  .disclosure-list {
    margin: 0;
  }

  .disclosure-list dt {
    margin-bottom: 0.3rem;
    color: var(--surface-ink);
    font-family: var(--surface-sans);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .disclosure-list dd {
    margin: 0;
    max-width: 68ch;
  }

  .disclosure-list dd + dt {
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--surface-line);
  }

  .article-callout {
    margin: 1.6rem 0 0;
    padding: 1rem 1.2rem;
    max-width: 68ch;
    background: color-mix(
      in srgb,
      var(--surface-gold) 18%,
      var(--surface-white)
    );
    border: 1px solid var(--surface-gold);
    border-left-width: 4px;
  }

  .article-callout p {
    margin: 0;
    color: var(--surface-ink, #1b1b1b);
    font-family: var(--surface-sans);
    font-size: var(--text-meta);
    font-weight: 650;
    line-height: 1.55;
  }

  .article-section ul {
    margin-block: 1.5rem;
    padding-left: 1.4rem;
  }

  /* A lista da seção prática é um roteiro de conduta, e a de limitações é um
     inventário de lacunas. Com o mesmo marcador redondo as duas se lêem como
     o mesmo tipo de conteúdo — o que, num texto que insiste na diferença
     entre o que fazer e o que ainda não se sabe, apaga justamente a
     distinção que o artigo defende. */
  .article-section.practice ul {
    margin-block: 1.8rem;
    padding-left: 0;
    list-style: none;
    counter-reset: conduta;
  }

  .article-section.practice li {
    position: relative;
    counter-increment: conduta;
    padding: 0.2rem 0 0.2rem 3rem;
  }

  .article-section.practice li + li {
    margin-top: 1rem;
  }

  .article-section.practice li::before {
    content: counter(conduta);
    position: absolute;
    top: 0.5rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--surface-teal);
    border-radius: 50%;
    color: var(--surface-teal-dark);
    font-family: var(--surface-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .article-section.limitations li::marker {
    color: var(--surface-gold-text);
  }

  .article-section.evidence,
  .article-section.limitations,
  .disclosure-section {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--surface-white);
    border-left: 4px solid var(--surface-teal);
  }

  .article-section.limitations {
    border-left-color: var(--surface-gold);
  }

  .references-section {
    padding-top: 2rem;
    border-top: 1px solid var(--surface-line);
  }

  .references-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
  }

  .references-header h2 {
    margin-bottom: 0;
  }

  .article-fact-citation dd {
    margin-top: 0.45rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Numeração desenhada à mão: o marcador nativo do <ol> alinha à direita e
     descola do texto quando a citação passa de uma linha. */
  .reference-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: referencia;
  }

  .reference-list li {
    position: relative;
    counter-increment: referencia;
    padding: 1.15rem 0 1.15rem 3rem;
    color: var(--surface-copy);
  }

  .reference-list li + li {
    border-top: 1px solid var(--surface-line);
  }

  .reference-list li::before {
    content: counter(referencia);
    position: absolute;
    top: 1.15rem;
    left: 0;
    min-width: 2rem;
    color: var(--surface-gold-text);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .reference-list cite {
    display: block;
    max-width: 62ch;
    font-size: var(--text-meta);
    font-style: normal;
    line-height: 1.55;
  }

  .reference-link {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    margin-top: 0.45rem;
    color: var(--surface-teal-dark);
    font-family: var(--surface-sans);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    word-break: break-all;
  }

  /* O hover escurece, não clareia: --surface-teal dá 4,24:1 e derrubava o
     link abaixo do AA justamente no estado em que o usuário está mirando.
     --surface-navy é o mesmo hover que os text-link da revista já usam. */
  .reference-link:hover,
  .reference-link:focus-visible {
    color: var(--surface-navy);
  }

  .related-section {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    background: var(--surface-white);
  }

  .related-section header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--surface-line);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-grid li {
    min-width: 0;
  }

  .related-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1.35rem 0 0;
    border-top: 2px solid var(--surface-teal);
    color: var(--surface-copy);
    transition:
      border-color 220ms ease,
      color 220ms ease;
  }

  .related-card:hover,
  .related-card:focus-visible {
