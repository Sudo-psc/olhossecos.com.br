---
import {
  calculateArticleReadingTime,
  getMagazineArticlePath,
  type MagazineArticle,
} from "@/lib/superficie";

interface Props {
  article: MagazineArticle;
  compact?: boolean;
  hideImage?: boolean;
}

const { article, compact = false, hideImage = false } = Astro.props;
const path = getMagazineArticlePath(article);
const readingTime = calculateArticleReadingTime(article);
---

<article
  class:list={["article-card", { compact, "tilt-glow": !compact }]}
  data-tilt={compact ? undefined : true}
>
  {
    article.featuredImage && !compact && !hideImage && (
      <a
        class="article-image"
        href={path}
        tabindex="-1"
        aria-hidden="true"
        data-analytics-event="article_click"
        data-analytics-label={article.slug}
      >
        <img
          src={article.featuredImage.src}
          alt=""
          width={article.featuredImage.width}
          height={article.featuredImage.height}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="article-card-body">
    <div class="article-meta">
      <span>{article.category}</span>
      <span>{readingTime} min de leitura</span>
    </div>
    <h3><a href={path}>{article.title}</a></h3>
    {!compact && <p>{article.excerpt}</p>}
    <div class="article-byline">
      <span>Por {article.author.name}</span>
      <a
        href={path}
        data-analytics-event="article_click"
        data-analytics-label={article.slug}>Ler artigo</a
      >
    </div>
  </div>
</article>

<style>
  .article-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    border-top: 4px solid var(--surface-teal);
    border-radius: var(--surface-radius-md);
    background: var(--surface-white);
    box-shadow: 0 1px 2px rgb(4 12 22 / 8%);
    transition:
      box-shadow 420ms var(--surface-ease),
      border-top-color 420ms ease;
  }

  .article-card:not(.compact):hover {
    border-top-color: var(--surface-gold);
    box-shadow: var(--surface-shadow-lg);
  }

  .article-card.compact {
    border-top-width: 2px;
    background: transparent;
    box-shadow: none;
  }

  .article-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--surface-ease);
  }

  .article-card:hover .article-image img {
    transform: scale(1.06);
  }

  .article-card-body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .compact .article-card-body {
    padding-inline: 0;
  }

  .article-meta,
  .article-byline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--surface-muted);
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-meta span:first-child {
    color: var(--surface-teal-dark);
  }

  h3 {
    margin: 1rem 0 0.8rem;
    font-family: var(--surface-serif);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
  }

  .compact h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.9rem);
  }

  h3 a:hover,
  h3 a:focus-visible {
    color: var(--surface-teal-dark);
  }

  .article-card-body > p {
    color: var(--surface-copy);
    min-height: 6.5em;
  }

  .article-byline {
    align-items: end;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-line);
  }

  .article-byline a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--surface-teal-dark);
    border-bottom: 1px solid currentColor;
  }
</style>
