---
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { selectRelatedHubGuides } from "@/lib/related-hub-guides";

interface PageLink {
  label: string;
  href: string;
}

interface SourceLink {
  label: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  intro: string;
  links: PageLink[];
  summary?: string[];
  sources?: SourceLink[];
  sourcesVerified?: string;
  updated?: string;
  dateModified?: string;
  /** Card OpenGraph próprio da seção; sem ele o Layout usa o genérico. */
  image?: string;
  /**
   * O componente serve tanto conteúdo clínico quanto páginas institucionais.
   * MedicalWebPage arrasta consigo `about: MedicalCondition`, então declarar
   * privacidade ou política editorial como conteúdo médico afirmava ao
   * rastreador que aquelas páginas tratam da doença do olho seco.
   */
  schemaType?: "MedicalWebPage" | "WebPage";
  extraSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  intro,
  links,
  summary = [],
  sources = [],
  sourcesVerified = "25 de julho de 2026",
  updated = "25 de julho de 2026",
  dateModified = "2026-07-25",
  image,
  schemaType = "MedicalWebPage",
  extraSchema,
} = Astro.props;

const relatedGuides = selectRelatedHubGuides(Astro.url.pathname);
---

<Layout
  title={title}
  description={description}
  {schemaType}
  dateModified={dateModified}
  {image}
  {extraSchema}
  breadcrumbs={[
    { name: "Início", url: "/" },
    { name: title, url: Astro.url.pathname },
  ]}
>
  <header class="page-intro">
    <div class="page-shell">
      <Breadcrumbs
        items={[
          { name: "Início", url: "/" },
          { name: title, url: Astro.url.pathname },
        ]}
      />
      <h1 class="page-title">{title}</h1>
      <p>{intro}</p>
    </div>
  </header>

  <div class="page-shell content-layout">
    <aside class="on-this-page">
      <p>Nesta página</p>
      <nav aria-label="Nesta página">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <a class="safety-shortcut" href="/sinais-de-alerta">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 3 2.8 20h18.4L12 3Z"></path>
          <path d="M12 9v5M12 17.5v.2"></path>
        </svg>
        Sinais de alerta
      </a>
    </aside>

    <article class="prose">
      {
        summary.length > 0 && (
          <section class="content-summary" aria-labelledby="summary-title">
            <h2 id="summary-title">Em poucas palavras</h2>
            <ul>
              {summary.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }
      <slot />
      {
        sources.length > 0 && (
          <section class="page-sources" aria-labelledby="page-sources-title">
            <h2 id="page-sources-title">Fontes desta página</h2>
            <p>
              Referências principais usadas para revisar e contextualizar este
              conteúdo.
            </p>
            <ul>
              {sources.map((source) => (
                <li>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
            <small>Links verificados em {sourcesVerified}.</small>
          </section>
        )
      }
      {
        relatedGuides.length > 0 && (
          <section
            class="related-hub-guides"
            aria-labelledby="related-hub-guides-title"
          >
            <h2 id="related-hub-guides-title">Leia também</h2>
            <p>
              Leituras mais longas sobre o mesmo assunto, com limites da
              evidência ao lado de cada número.
            </p>
            <ul>
              {relatedGuides.map((guide) => (
                <li>
                  <a href={`/guias/${guide.slug}`}>
                    <span>{guide.category}</span>
                    <strong>{guide.title}</strong>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <footer class="content-meta">
        <p>Última revisão editorial: {updated}</p>
        <a href="/fontes">Como usamos e apresentamos as fontes</a>
      </footer>
    </article>
  </div>
</Layout>

<style>
  .content-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 780px);
    justify-content: center;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .on-this-page {
    position: sticky;
    top: 130px;
    align-self: start;
  }

  .on-this-page > p {
    margin: 0 0 1rem;
    color: var(--teal-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .on-this-page nav {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .on-this-page nav a {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .on-this-page nav a:hover {
    color: var(--teal-dark);
  }

  .safety-shortcut {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: var(--coral-text);
    font-size: 0.84rem;
    font-weight: 750;
  }

  .safety-shortcut svg {
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .content-meta {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-top: 5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    color: #5a6b80;
    font-size: 0.75rem;
  }

  .content-meta p {
    margin: 0;
  }

  .page-sources {
    margin-top: 5rem;
    padding: 2rem;
    background: var(--mist);
  }

  .page-sources h2 {
    margin-top: 0;
  }

  .page-sources ul {
    padding-left: 1.2rem;
  }

  .page-sources li {
    font-size: 0.88rem;
  }

  .page-sources small {
    display: block;
    margin-top: 1.4rem;
    color: #5a6b80;
    font-size: 0.75rem;
  }

  .content-summary {
    margin: 0 0 3.5rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border-left: 4px solid var(--teal);
    background: var(--mist);
  }

  .content-summary h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.55rem, 3vw, 2rem);
  }

  .content-summary ul {
    margin: 0;
  }

  .content-summary li + li {
    margin-top: 0.55rem;
  }

  .related-hub-guides {
    margin-top: 4.5rem;
  }

  .related-hub-guides h2 {
    margin: 0 0 0.6rem;
  }

  .related-hub-guides > p {
    margin: 0 0 1.4rem;
    color: var(--ink-soft);
  }

  .related-hub-guides ul {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-hub-guides a {
    display: grid;
    gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .related-hub-guides li:last-child a {
    border-bottom: 1px solid var(--line);
  }

  .related-hub-guides span {
    color: var(--teal-dark);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .related-hub-guides strong {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.3;
  }

  .related-hub-guides a:hover strong {
    color: var(--teal-dark);
  }

  @media (max-width: 850px) {
    .content-layout {
      grid-template-columns: 1fr;
    }

    .on-this-page {
      position: static;
      padding: 1.2rem;
      background: var(--mist);
    }

    .content-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
