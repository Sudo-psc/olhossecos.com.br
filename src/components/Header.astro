---
import EyeMark from "./EyeMark.astro";

const pathname = Astro.url.pathname;
const nav = [
  { label: "Olho Seco", href: "/olho-seco" },
  { label: "Profissionais", href: "/profissionais" },
  { label: "SUPERFÍCIE", href: "/superficie" },
  { label: "Livros", href: "/livros" },
  { label: "App", href: "/app" },
  { label: "Sobre", href: "/politica-editorial" },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a href="/" class="brand">
      <EyeMark class="brand-mark" />
      <span>
        <strong>Olhos Secos</strong>
        <small>Ciência e informação</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="header-cta" href="/newsletter"> Newsletter </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação móvel" hidden>
    <div class="page-shell">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="mobile-newsletter" href="/newsletter">Newsletter</a>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  const setMenuOpen = (open: boolean) => {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
  };

  button?.addEventListener("click", () => {
    if (!menu) return;
    setMenuOpen(menu.hidden);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu || menu.hidden) return;
    setMenuOpen(false);
    button?.focus();
  });
</script>
