---
import EyeMark from "./EyeMark.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import { isPortalNavCurrent, portalFor } from "@/lib/portals";

const pathname = Astro.url.pathname;
const portal = portalFor(pathname);
// Na pré-página o cabeçalho fica só com a marca e a busca: qualquer navegação
// ali já empurraria o leitor para um dos dois portais antes da escolha.
const nav = portal?.nav ?? [];
---

<header class="site-header" data-scrolled="false" data-portal={portal?.id}>
  <div class="page-shell header-inner" data-bare={portal ? undefined : "true"}>
    <a href={portal?.home ?? "/"} class="brand">
      <EyeMark class="brand-mark" />
      <span>
        <strong>{portal?.brandTitle ?? "Olhos Secos"}</strong>
        <small>{portal?.brandSubtitle ?? "Ciência e informação"}</small>
      </span>
    </a>

    {
      nav.length > 0 && (
        <nav class="desktop-nav" aria-label="Navegação principal">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                isPortalNavCurrent(item.href, pathname) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="header-actions">
      <ThemeSwitch />
      <button
        type="button"
        class="header-search-btn"
        aria-label="Buscar no site"
        data-open-global-search
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle
            cx="10.8"
            cy="10.8"
            r="6.7"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></circle>
          <path
            d="m16 16 4.5 4.5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
        <span class="search-btn-label">Buscar</span>
        <kbd data-search-shortcut>Ctrl+K</kbd>
      </button>
      {
        portal && (
          <a class="portal-switch" href={portal.crossLink.href}>
            {portal.crossLink.label}
          </a>
        )
      }
      {
        portal && (
          <a class="header-cta" href="/newsletter">
            Newsletter
          </a>
        )
      }
    </div>

    {
      nav.length > 0 && (
        <button
          class="menu-button"
          type="button"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span />
          <span />
          <span />
        </button>
      )
    }
  </div>

  {
    portal && (
      <nav
        id="mobile-menu"
        class="mobile-nav"
        aria-label="Navegação móvel"
        hidden
      >
        <div class="page-shell">
          <ThemeSwitch />
          <button
            type="button"
            class="mobile-search-btn"
            data-open-global-search
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle
                cx="10.8"
                cy="10.8"
                r="6.7"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="m16 16 4.5 4.5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
            <span>Buscar no portal...</span>
            <kbd data-search-shortcut>Ctrl+K</kbd>
          </button>
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={
                isPortalNavCurrent(item.href, pathname) ? "page" : undefined
              }
            >
              {item.label}
            </a>
          ))}
          <a class="mobile-portal-switch" href={portal.crossLink.href}>
            {portal.crossLink.label}
          </a>
          <a class="mobile-newsletter" href="/newsletter">
            Newsletter
          </a>
        </div>
      </nav>
    )
  }
</header>

<style>
  .header-actions {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    gap: 0.5rem;
  }

  .mobile-nav :global(.theme-switch) {
    margin-bottom: 0.8rem;
  }

  /* Só o ícone: com rótulo e atalho o botão tinha 175px e a navegação do
     paciente não cabia nem em 1920px. O aria-label leva o texto e o atalho;
     o rótulo completo continua na busca do menu móvel. */
  .header-search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line, #c8d7e2);
    border-radius: var(--control-radius, 6px);
    background: var(--mist, #eff8fb);
    color: var(--ink-soft, #263d61);
    font-size: 0.875rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .header-search-btn svg {
    width: 16px;
    height: 16px;
    color: var(--teal, #087f95);
  }

  .header-search-btn kbd {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--line, #d3dbe4);
    border-radius: 3px;
    background: var(--paper, #ffffff);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    color: var(--navy-400, #405168);
  }

  /* Na pré-página há espaço para rótulo e atalho; dentro dos portais, não. */
  .header-inner:not([data-bare]) .search-btn-label,
  .header-inner:not([data-bare]) .header-search-btn kbd {
    display: none;
  }

  .header-search-btn:hover {
    background: var(--teal-100, #dff3f7);
    border-color: var(--teal, #087f95);
    color: var(--ink, #071d45);
  }

  .header-search-btn:active {
    background: color-mix(
      in srgb,
      var(--teal, #087f95) 18%,
      var(--paper, #ffffff)
    );
  }

  .mobile-search-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    width: 100%;
    padding: 0.75rem 1rem;
    margin-bottom: 0.8rem;
    border: 1.5px solid var(--teal, #087f95);
    border-radius: var(--control-radius, 6px);
    background: var(--mist, #eff8fb);
    color: var(--ink, #071d45);
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .mobile-search-btn:hover {
    background: var(--teal-100, #dff3f7);
    border-color: var(--teal-dark, #00657a);
  }

  .mobile-search-btn:active {
    background: color-mix(
      in srgb,
      var(--teal, #087f95) 18%,
      var(--paper, #ffffff)
    );
  }

  .mobile-search-btn svg {
    width: 18px;
    height: 18px;
    color: var(--teal, #087f95);
  }

  .mobile-search-btn kbd {
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--line, #d3dbe4);
    border-radius: 3px;
    background: var(--paper, #ffffff);
    font-family: ui-monospace, monospace;
    font-size: 0.875rem;
    color: var(--navy-400, #405168);
  }

  /* Sem teclado físico o atalho é ruído. */
  @media (hover: none) {
    .mobile-search-btn {
      justify-content: flex-start;
    }

    .mobile-search-btn kbd {
      display: none;
    }
  }

  /* Ponte entre os dois portais. Fica ao lado da busca, discreta: é rota de
     fuga para quem entrou pelo lado errado, não chamada de ação concorrente
     com a newsletter. */
  .portal-switch {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.75rem;
    border-radius: var(--control-radius, 6px);
    color: var(--ink-soft, #263d61);
    font-size: 0.875rem;
    font-weight: 650;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .portal-switch::before {
    margin-right: 0.35rem;
    color: var(--teal, #087f95);
    content: "\21C4";
    font-size: 0.95rem;
  }

  .portal-switch:hover {
    background: var(--mist, #eff8fb);
    color: var(--ink, #071d45);
  }

  .portal-switch:active {
    background: color-mix(
      in srgb,
      var(--teal, #087f95) 18%,
      var(--paper, #ffffff)
    );
  }

  .mobile-portal-switch::before {
    margin-right: 0.4rem;
    color: var(--teal, #087f95);
    content: "\21C4";
  }

  /* Pré-página: sem navegação, a grade de três colunas deixaria a marca
     solta no canto e um vão no meio. */
  .header-inner[data-bare] {
    grid-template-columns: 1fr auto;
  }

  @media (max-width: 1360px) {
    .header-actions {
      display: none;
    }

    /* Sem menu móvel na pré-página, esconder as ações deixaria o cabeçalho
       sem busca nenhuma em tela estreita. */
    .header-inner[data-bare] .header-actions {
      display: flex;
    }

    .search-btn-label,
    .header-search-btn kbd,
    .header-inner[data-bare] .search-btn-label,
    .header-inner[data-bare] kbd {
      display: none;
    }
  }
</style>

<script>
  // Transparência do header reage ao scroll. rAF + limiar com histerese:
  // sem a folga o estado piscava a cada pixel na faixa de troca.
  const header = document.querySelector<HTMLElement>(".site-header");
  let scrollFrame = 0;

  const syncHeaderState = () => {
    scrollFrame = 0;
    if (!header) return;
    const scrolled = header.dataset.scrolled === "true";
    const y = window.scrollY;
    if (!scrolled && y > 24) header.dataset.scrolled = "true";
    else if (scrolled && y < 8) header.dataset.scrolled = "false";
  };

  window.addEventListener(
    "scroll",
    () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(syncHeaderState);
    },
    { passive: true },
  );

  syncHeaderState();

  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const main = document.querySelector("main");
  const footer = document.querySelector("footer");

  const isApplePlatform = () =>
    /Mac OS X|iPhone|iPad|iPod/u.test(navigator.userAgent);

  document
    .querySelectorAll<HTMLElement>("[data-search-shortcut]")
    .forEach((shortcut) => {
      shortcut.textContent = isApplePlatform() ? "⌘K" : "Ctrl+K";
    });
  document
    .querySelectorAll<HTMLButtonElement>("[data-open-global-search]")
    .forEach((trigger) => {
      const hint = isApplePlatform() ? "⌘K" : "Ctrl+K";
      if (!trigger.getAttribute("aria-label")?.includes("Buscar")) return;
      trigger.setAttribute("aria-label", `Buscar no site (${hint})`);
    });

  const menuFocusables = () => {
    if (!menu) return [];
    return [
      button,
      ...menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
    ].filter((element): element is HTMLElement => Boolean(element));
  };

  const setMenuOpen = (open: boolean) => {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    main?.toggleAttribute("aria-hidden", open);
    footer?.toggleAttribute("aria-hidden", open);
    if (open) {
      const first = menu.querySelector<HTMLElement>("a, button");
      first?.focus();
    }
  };

  button?.addEventListener("click", () => {
    if (!menu) return;
    setMenuOpen(menu.hidden);
  });

  document.addEventListener("keydown", (event) => {
    if (!menu || menu.hidden) return;

    if (event.key === "Escape") {
      setMenuOpen(false);
      button?.focus();
      return;
    }

    if (event.key !== "Tab") return;
    const focusable = menuFocusables();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
</script>
