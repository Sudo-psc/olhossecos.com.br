---
import EyeMark from "./EyeMark.astro";

const pathname = Astro.url.pathname;
const nav = [
  { label: "Entenda", href: "/olho-seco" },
  { label: "Sintomas", href: "/sintomas" },
  { label: "Autocuidado", href: "/autocuidado" },
  { label: "Tratamentos", href: "/tratamentos" },
  { label: "Guias", href: "/guias" },
  { label: "Glossário", href: "/glossario" },
];

const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header">
  <div class="page-shell header-inner">
    <a href="/" class="brand" aria-label="Olho Seco — Portal do paciente">
      <EyeMark class="brand-mark" />
      <span>
        <strong>Olho Seco</strong>
        <small>Portal do paciente</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="sources-link" href="/fontes">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 3.5h9l3 3V20.5H6z" />
        <path d="M15 3.5v3h3M9 11h6M9 15h6" />
      </svg>
      Fontes e revisão
    </a>

    <button
      class="menu-button"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação móvel" hidden>
    <div class="page-shell">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/fontes">Fontes e revisão</a>
    </div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>(".menu-button");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");

  button?.addEventListener("click", () => {
    if (!menu) return;
    const willOpen = menu.hidden;
    menu.hidden = !willOpen;
    button.setAttribute("aria-expanded", String(willOpen));
    button.setAttribute("aria-label", willOpen ? "Fechar menu" : "Abrir menu");
  });
</script>
