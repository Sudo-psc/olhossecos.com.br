---
const searchIndexUrl = `${import.meta.env.BASE_URL.replace(/\/$/u, "")}/search-index.json`;
---

<dialog
  id="global-search-dialog"
  class="global-search-dialog"
  aria-modal="true"
  aria-labelledby="global-search-label"
  data-search-index-url={searchIndexUrl}
>
  <div class="search-dialog-card">
    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle
          cx="10.8"
          cy="10.8"
          r="6.7"
          fill="none"
          stroke="currentColor"
          stroke-width="2"></circle>
        <path
          d="m16 16 4.5 4.5"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
      <label
        id="global-search-label"
        for="global-search-input"
        class="visually-hidden"
      >
        Buscar em todo o portal
      </label>
      <input
        id="global-search-input"
        type="search"
        placeholder="Buscar guias, artigos, termos médicos, exames..."
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="button"
        id="global-search-close-btn"
        class="search-close-btn"
        aria-label="Fechar busca"
      >
        <kbd>ESC</kbd>
      </button>
    </div>

    <div
      class="search-filter-rail"
      role="tablist"
      aria-label="Filtrar por tipo"
    >
      <button type="button" class="filter-chip active" data-filter="all"
        >Todos</button
      >
      <button type="button" class="filter-chip" data-filter="guia">Guias</button
      >
      <button type="button" class="filter-chip" data-filter="artigo"
        >SUPERFÍCIE</button
      >
      <button type="button" class="filter-chip" data-filter="radar"
        >RADAR</button
      >
      <button type="button" class="filter-chip" data-filter="glossario"
        >Glossário</button
      >
      <button type="button" class="filter-chip" data-filter="portal"
        >Portal</button
      >
      <button type="button" class="filter-chip" data-filter="livro"
        >Livros</button
      >
    </div>

    <div
      id="global-search-results"
      class="search-results"
      role="listbox"
      aria-label="Resultados da busca"
    >
      <!-- Injetado dinamicamente via JS -->
    </div>

    <div id="global-search-suggestions" class="search-suggestions">
      <p class="suggestions-kicker">Sugestões de busca</p>
      <div class="suggestions-tags">
        <button type="button" data-search-term="sintomas"
          >Sintomas comuns</button
        >
        <button type="button" data-search-term="meibomius"
          >Glândulas de Meibomius</button
        >
        <button type="button" data-search-term="telas">Telas e piscadas</button>
        <button type="button" data-search-term="nibut">NIBUT</button>
        <button type="button" data-search-term="conjuntivocalase"
          >Conjuntivocálase</button
        >
        <button type="button" data-search-term="dews iii">TFOS DEWS III</button>
        <button type="button" data-search-term="widget">Dry Eye Widget</button>
      </div>
    </div>

    <div id="global-search-empty" class="search-empty" hidden>
      <p>Nenhum resultado encontrado para esta busca.</p>
      <small
        >Tente usar termos mais simples como <em>lágrima</em>, <em>ardor</em>, <em
          >exames</em
        > ou <em>tratamentos</em>.</small
      >
    </div>

    <footer class="search-dialog-footer">
      <div class="shortcut-hints">
        <span><kbd>↑</kbd> <kbd>↓</kbd> navegar</span>
        <span><kbd>↵</kbd> selecionar</span>
        <span><kbd>ESC</kbd> fechar</span>
      </div>
      <span class="index-count" data-search-index-count></span>
    </footer>
  </div>
</dialog>

<script>
  interface SearchItem {
    type: string;
    typeLabel: string;
    title: string;
    description: string;
    href: string;
    meta?: string;
    tags: string[];
  }

  const initGlobalSearch = () => {
    const dialog = document.getElementById(
      "global-search-dialog",
    ) as HTMLDialogElement | null;
    const input = document.getElementById(
      "global-search-input",
    ) as HTMLInputElement | null;
    const closeBtn = document.getElementById("global-search-close-btn");
    const resultsContainer = document.getElementById("global-search-results");
    const suggestionsContainer = document.getElementById(
      "global-search-suggestions",
    );
    const emptyState = document.getElementById("global-search-empty");
    const indexCount = document.querySelector<HTMLElement>(
      "[data-search-index-count]",
    );
    const filterButtons =
      document.querySelectorAll<HTMLButtonElement>(".filter-chip");

    if (!dialog || !input || !resultsContainer) return;
    if (dialog.dataset.searchBound === "true") return;
    dialog.dataset.searchBound = "true";

    let searchItems: SearchItem[] = [];
    let indexPromise: Promise<void> | null = null;

    let activeFilter = "all";
    let activeIndex = -1;
    let currentResults: SearchItem[] = [];
    let searchAnalyticsTimer = 0;
    let lastTrackedQuery = "";

    const emitSearchAnalytics = (query: string, resultCount: number) => {
      const trimmed = query.trim();
      if (trimmed.length < 2) return;
      window.clearTimeout(searchAnalyticsTimer);
      searchAnalyticsTimer = window.setTimeout(() => {
        const fingerprint = `${trimmed.length}:${resultCount}:${activeFilter}`;
        if (fingerprint === lastTrackedQuery) return;
        lastTrackedQuery = fingerprint;
        const detail = {
          event: "search",
          query_length: trimmed.length,
          result_count: resultCount,
          source: "global_search",
        };
        window.dispatchEvent(
          new CustomEvent("olhossecos:analytics", { detail }),
        );
      }, 450);
    };

    const normalize = (val: string) =>
      val
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();

    const setIndexCount = (label: string) => {
      if (indexCount) indexCount.textContent = label;
    };

    const loadIndex = () => {
      if (indexPromise) return indexPromise;
      const url = dialog.dataset.searchIndexUrl;
      if (!url) {
        setIndexCount("índice indisponível");
        indexPromise = Promise.resolve();
        return indexPromise;
      }

      setIndexCount("carregando índice…");
      indexPromise = fetch(url)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }
          return response.json() as Promise<SearchItem[]>;
        })
        .then((data) => {
          searchItems = Array.isArray(data) ? data : [];
          setIndexCount(`${searchItems.length} itens indexados`);
        })
        .catch(() => {
          searchItems = [];
          setIndexCount("índice indisponível");
        });
      return indexPromise;
    };

    const openSearch = () => {
      dialog.showModal();
      document.body.style.overflow = "hidden";
      input.value = "";
      activeFilter = "all";
      filterButtons.forEach((b) =>
        b.classList.toggle("active", b.dataset.filter === "all"),
      );
      renderResults("");
      setTimeout(() => input.focus(), 50);
      void loadIndex().then(() => {
        if (dialog.open) renderResults(input.value);
      });
    };

    const closeSearch = () => {
      dialog.close();
      document.body.style.overflow = "";
    };

    // Abre com data-open-global-search
    document
      .querySelectorAll("[data-open-global-search]")
      .forEach((trigger) => {
        trigger.addEventListener("click", (e) => {
          e.preventDefault();
          openSearch();
        });
      });

    closeBtn?.addEventListener("click", closeSearch);

    // Fecha ao clicar fora do card
    dialog.addEventListener("click", (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog =
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width;
      if (!isInDialog) closeSearch();
    });

    // Atalhos de teclado globais (Cmd+K, Ctrl+K, '/')
    document.addEventListener("keydown", (e) => {
      const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
      const isSlash =
        e.key === "/" &&
        !(
          e.target instanceof HTMLInputElement ||
          e.target instanceof HTMLTextAreaElement
        );

      if (isCmdK || isSlash) {
        e.preventDefault();
        if (dialog.open) closeSearch();
        else openSearch();
      }

      if (e.key === "Escape" && dialog.open) {
        closeSearch();
      }
    });

    const calculateScore = (
      item: SearchItem,
      queryNorm: string,
      tokens: string[],
    ) => {
      const titleNorm = normalize(item.title);
      const descNorm = normalize(item.description);
      const tagsNorm = item.tags.map((t) => normalize(t)).join(" ");
      const metaNorm = normalize(item.meta || "");

      let score = 0;
      if (titleNorm === queryNorm) score += 100;
      else if (titleNorm.startsWith(queryNorm)) score += 60;
      else if (titleNorm.includes(queryNorm)) score += 40;

      if (tagsNorm.includes(queryNorm)) score += 30;
      if (descNorm.includes(queryNorm)) score += 20;
      if (metaNorm.includes(queryNorm)) score += 10;

      const allTokensMatch = tokens.every(
        (tok) =>
          titleNorm.includes(tok) ||
          descNorm.includes(tok) ||
          tagsNorm.includes(tok) ||
          metaNorm.includes(tok),
      );

      if (
        !allTokensMatch &&
        !titleNorm.includes(queryNorm) &&
        !tagsNorm.includes(queryNorm)
      ) {
        return 0;
      }

      for (const tok of tokens) {
        if (titleNorm.includes(tok)) score += 15;
        if (tagsNorm.includes(tok)) score += 10;
        if (descNorm.includes(tok)) score += 5;
      }

      return score;
    };

    const renderResults = (query: string) => {
      const queryNorm = normalize(query);

      if (!queryNorm) {
        resultsContainer.innerHTML = "";
        resultsContainer.hidden = true;
        if (suggestionsContainer) suggestionsContainer.hidden = false;
        if (emptyState) emptyState.hidden = true;
        currentResults = [];
        activeIndex = -1;
        return;
      }

      if (suggestionsContainer) suggestionsContainer.hidden = true;
      const tokens = queryNorm.split(/\s+/u).filter((t) => t.length > 1);

      let filteredItems = searchItems;
      if (activeFilter !== "all") {
        filteredItems = searchItems.filter(
          (item) => item.type === activeFilter,
        );
      }

      const scored = filteredItems
        .map((item) => ({
          item,
          score: calculateScore(
            item,
            queryNorm,
            tokens.length ? tokens : [queryNorm],
          ),
        }))
        .filter(({ score }) => score > 0)
        .sort(
          (a, b) =>
            b.score - a.score || a.item.title.localeCompare(b.item.title),
        );

      currentResults = scored.map(({ item }) => item).slice(0, 15);
      activeIndex = currentResults.length > 0 ? 0 : -1;

      if (currentResults.length === 0) {
        resultsContainer.innerHTML = "";
        resultsContainer.hidden = true;
        if (emptyState) emptyState.hidden = false;
        emitSearchAnalytics(query, 0);
        return;
      }

      emitSearchAnalytics(query, currentResults.length);

      if (emptyState) emptyState.hidden = true;
      resultsContainer.hidden = false;

      resultsContainer.innerHTML = currentResults
        .map(
          (item, idx) => `
          <a
            href="${item.href}"
            class="search-result-item ${idx === 0 ? "is-selected" : ""}"
            role="option"
            aria-selected="${idx === 0 ? "true" : "false"}"
            data-index="${idx}"
          >
            <div class="result-top">
              <span class="result-badge badge-${item.type}">${item.typeLabel}</span>
              ${item.meta ? `<span class="result-meta">${item.meta}</span>` : ""}
            </div>
            <strong class="result-title">${item.title}</strong>
            <p class="result-desc">${item.description}</p>
          </a>
        `,
        )
        .join("");

      resultsContainer.querySelectorAll(".search-result-item").forEach((el) => {
        el.addEventListener("mouseenter", () => {
          const index = Number((el as HTMLElement).dataset.index);
          setActiveResult(index);
        });
      });
    };

    const setActiveResult = (index: number) => {
      const items = resultsContainer.querySelectorAll(".search-result-item");
      if (items.length === 0) return;
      activeIndex = Math.max(0, Math.min(items.length - 1, index));
      items.forEach((item, i) => {
        const isSel = i === activeIndex;
        item.classList.toggle("is-selected", isSel);
        item.setAttribute("aria-selected", String(isSel));
        if (isSel) {
          item.scrollIntoView({ block: "nearest" });
        }
      });
    };

    input.addEventListener("input", () => {
      renderResults(input.value);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActiveResult(activeIndex + 1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActiveResult(activeIndex - 1);
      } else if (
        e.key === "Enter" &&
        activeIndex >= 0 &&
        currentResults[activeIndex]
      ) {
        e.preventDefault();
        window.location.href = currentResults[activeIndex].href;
      }
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        activeFilter = btn.dataset.filter || "all";
        filterButtons.forEach((b) => b.classList.toggle("active", b === btn));
        renderResults(input.value);
      });
    });

    // Cliques nas tags de sugestão rápida
    document
      .querySelectorAll<HTMLButtonElement>(".suggestions-tags button")
      .forEach((tagBtn) => {
        tagBtn.addEventListener("click", () => {
          const term =
            tagBtn.dataset.searchTerm || tagBtn.textContent?.trim() || "";
          input.value = term;
          renderResults(term);
          input.focus();
        });
      });
  };

  initGlobalSearch();
  document.addEventListener("astro:page-load", initGlobalSearch);
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .global-search-dialog {
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    width: min(720px, 94vw);
    max-height: min(85vh, 760px);
    box-shadow: 0 28px 80px rgb(7 29 69 / 40%);
    overflow: hidden;
  }

  .global-search-dialog::backdrop {
    background: rgb(7 29 69 / 65%);
    backdrop-filter: blur(6px);
  }

  .search-dialog-card {
    background: #ffffff;
    color: #071d45;
    border: 1px solid #c8d7e2;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    max-height: min(85vh, 760px);
  }

  .search-input-wrap {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.8rem;
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid #e2e9ef;
    background: #fbfbf9;
  }

  .search-icon {
    width: 22px;
    height: 22px;
    color: #087f95;
  }

  .search-input-wrap:focus-within {
    box-shadow: inset 0 -2px 0 #087f95;
  }

  .search-input-wrap input {
    border: 0;
    outline: 0;
    background: transparent;
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 1.08rem;
    color: #071d45;
    width: 100%;
  }

  .search-input-wrap input::placeholder {
    color: #8395a7;
  }

  .search-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    min-height: 36px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .search-close-btn:hover {
    background: #eef3f6;
  }

  .search-close-btn:active {
    background: #e2e9ef;
  }

  .search-close-btn kbd,
  .shortcut-hints kbd {
    padding: 0.2rem 0.45rem;
    border: 1px solid #ccd9e2;
    border-radius: 4px;
    background: #eef3f6;
    color: #486581;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .search-filter-rail {
    display: flex;
    gap: 0.4rem;
    padding: 0.65rem 1.4rem;
    border-bottom: 1px solid #eef2f5;
    background: #f7fafb;
    overflow-x: auto;
  }

  .filter-chip {
    padding: 0.35rem 0.75rem;
    border: 1px solid #d4e0e8;
    border-radius: 999px;
    background: #ffffff;
    color: #486581;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  .filter-chip:hover {
    border-color: #087f95;
    color: #087f95;
  }

  .filter-chip:active {
    background: #e8f4f7;
  }

  .filter-chip.active {
    background: #071d45;
    border-color: #071d45;
    color: #ffffff;
  }

  .search-results {
    padding: 0.75rem 1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 440px;
  }

  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid transparent;
    border-radius: 8px;
    background: #ffffff;
    text-decoration: none;
    color: inherit;
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }

  .search-result-item:hover,
  .search-result-item.is-selected {
    background: #f0f7f9;
    border-color: #bee3eb;
  }

  .result-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .result-badge {
    display: inline-block;
    padding: 0.18rem 0.48rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .badge-guia {
    background: #e0f2fe;
    color: #0369a1;
  }

  .badge-artigo {
    background: #001a33;
    color: #d9b665;
  }

  .badge-radar {
    background: #0b827f;
    color: #f7f4ed;
  }

  .badge-glossario {
    background: #ecfdf5;
    color: #047857;
  }

  .badge-portal {
    background: #f1f5f9;
    color: #334155;
  }

  .badge-livro {
    background: #fef3c7;
    color: #92400e;
  }

  .result-meta {
    color: #627d98;
    font-size: 0.75rem;
  }

  .result-title {
    font-family: "Iowan Old Style", Georgia, serif;
    font-size: 1.12rem;
    font-weight: 600;
    color: #071d45;
    line-height: 1.25;
  }

  .result-desc {
    margin: 0;
    color: #486581;
    font-size: 0.82rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-suggestions {
    padding: 1.5rem 1.4rem 1.8rem;
  }

  .suggestions-kicker {
    margin: 0 0 0.8rem;
    color: #087f95;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .suggestions-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .suggestions-tags button {
    padding: 0.45rem 0.85rem;
    border: 1px solid #d4e0e8;
    border-radius: 6px;
    background: #f7fafb;
    color: #071d45;
    font-size: 0.82rem;
    font-weight: 650;
    cursor: pointer;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .suggestions-tags button:hover {
    background: #eef6f8;
    border-color: #087f95;
    color: #00657a;
  }

  .suggestions-tags button:active {
    background: #e2eef1;
  }

  .search-empty {
    padding: 3rem 1.5rem;
    text-align: center;
    color: #486581;
  }

  .search-empty p {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
    color: #071d45;
  }

  .search-empty small {
    font-size: 0.82rem;
  }

  .search-dialog-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.4rem;
    border-top: 1px solid #e2e9ef;
    background: #fbfbf9;
    font-size: 0.75rem;
    color: #627d98;
  }

  .shortcut-hints {
    display: flex;
    gap: 1rem;
  }

  .index-count {
    font-weight: 650;
  }

  @media (max-width: 600px) {
    .search-input-wrap {
      padding: 0.85rem 1rem;
    }

    .search-filter-rail {
      padding: 0.5rem 1rem;
    }

    .shortcut-hints {
      display: none;
    }
  }
</style>
