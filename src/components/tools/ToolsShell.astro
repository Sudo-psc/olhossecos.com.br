---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ToolPrivacy from "@/components/tools/ToolPrivacy.astro";

interface Props {
  kicker: string;
  title: string;
  lead: string;
  crumbs: { name: string; url: string }[];
}

const { kicker, title, lead, crumbs } = Astro.props;
---

<section class="tool-shell page-shell">
  <Breadcrumbs items={crumbs} />
  <p class="eyebrow">{kicker}</p>
  <h1 class="page-title">{title}</h1>
  <p class="tool-lead">{lead}</p>
  <ToolPrivacy />
  <slot />
</section>

<style>
  .tool-shell {
    padding-block: 2rem 5rem;
  }

  .tool-lead {
    max-width: 42rem;
    margin: 1.25rem 0 1.5rem;
    color: var(--ink-soft);
    font-size: var(--text-lead);
  }

  .tool-shell :global(.tool-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .tool-shell :global(.tool-panel) {
    margin-block: 1.75rem;
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-0);
  }

  .tool-shell :global(.tool-score) {
    margin: 0 0 0.4rem;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .tool-shell :global(.tool-score span) {
    color: var(--teal-dark);
  }

  .tool-shell :global(.tool-band) {
    margin: 0 0 0.75rem;
    color: var(--teal-dark);
    font-weight: 750;
  }

  .tool-shell :global(.tool-limit) {
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .tool-shell :global(fieldset) {
    margin: 0 0 1.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .tool-shell :global(legend) {
    padding-inline: 0.35rem;
    font-weight: 750;
  }

  .tool-shell :global(.tool-gloss) {
    margin: 0.35rem 0 0.85rem;
    color: var(--ink-soft);
    font-size: var(--text-small);
  }

  .tool-shell :global(.tool-options) {
    display: grid;
    gap: 0.45rem;
  }

  .tool-shell :global(.tool-option) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.35rem 0.5rem;
    border-radius: var(--control-radius);
  }

  .tool-shell :global(.tool-option:hover) {
    background: var(--mist);
  }

  .tool-shell :global(.tool-table) {
    width: 100%;
    border-collapse: collapse;
  }

  .tool-shell :global(.tool-table th),
  .tool-shell :global(.tool-table td) {
    padding: 0.55rem 0.4rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
  }

  .tool-shell :global(.tool-table input) {
    width: 100%;
    min-height: 44px;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--control-radius);
    background: var(--paper-0);
  }

  .tool-shell :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
