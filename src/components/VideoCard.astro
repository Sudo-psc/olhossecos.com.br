---
interface Props {
  title: string;
  src: string;
  poster?: string;
  description?: string;
  tags?: string[];
  duration?: string;
  audience?: 'pacientes' | 'profissionais';
  transcript?: string;
}

const { title, src, poster = "/video-placeholder.svg", description, tags = [], duration, audience, transcript } = Astro.props;
---

<div class="video-card-container group relative bg-[#0f172a]/80 backdrop-blur-sm rounded-2xl overflow-hidden border border-white/10 hover:border-cyan-500/50 transition-all duration-500 hover:shadow-2xl hover:shadow-cyan-500/10">
  <!-- Poster/Thumbnail Container -->
  <div class="relative aspect-video bg-black overflow-hidden">
    <video
      data-video-player
      controls
      preload="none"
      playsinline
      poster={poster}
      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
    >
      <source src={src} type="video/mp4" />
      Seu navegador não suporta o elemento de vídeo.
    </video>

    {audience && (
      <span class="absolute left-4 top-4 rounded-full bg-black/60 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-cyan-200 border border-cyan-400/30">
        {audience === 'pacientes' ? 'Para pacientes' : 'Para profissionais'}
      </span>
    )}
    {duration && (
      <span class="absolute right-4 top-4 rounded-full bg-black/60 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white/80 border border-white/20">
        {duration}
      </span>
    )}

    <!-- Play Icon Overlay (Hidden when video is playing) -->
    <div
      data-play-overlay
      class="absolute inset-0 flex items-center justify-center pointer-events-none group-hover:scale-110 transition-all duration-300"
    >
      <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur-md flex items-center justify-center border border-white/20 shadow-lg group-hover:bg-cyan-500/20 group-hover:border-cyan-400/50">
        <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="p-6">
    <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-2 mb-3">
      {title}
    </h3>
    {description && (
      <p class="text-gray-400 text-sm leading-relaxed line-clamp-2 group-hover:text-gray-300 transition-colors">
        {description}
      </p>
    )}
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-widest text-cyan-200">
        {tags.map((tag) => (
          <span class="rounded-full border border-cyan-400/30 bg-cyan-500/10 px-3 py-1">{tag}</span>
        ))}
      </div>
    )}
    {transcript && (
      <details class="mt-4 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-xs text-gray-400">
        <summary class="cursor-pointer text-[11px] font-semibold uppercase tracking-widest text-cyan-200">
          Resumo e transcrição
        </summary>
        <div class="mt-3 leading-relaxed">
          <span class="text-gray-300 font-semibold">Transcrição rápida:</span> {transcript}
        </div>
      </details>
    )}
  </div>
</div>

<script>
  // Script para controlar visibilidade dos botões play nos vídeos
  const initVideoOverlays = () => {
    const videoContainers = document.querySelectorAll('.video-card-container');

    videoContainers.forEach((container) => {
      const video = container.querySelector('[data-video-player]') as HTMLVideoElement;
      const overlay = container.querySelector('[data-play-overlay]') as HTMLElement;

      if (!video || !overlay) {
        return;
      }

      const updateOverlay = () => {
        const isPlaying = !video.paused && !video.ended && video.readyState > 2;
        overlay.style.opacity = isPlaying ? '0' : '1';
        overlay.style.visibility = isPlaying ? 'hidden' : 'visible';
      };

      video.addEventListener('play', updateOverlay);
      video.addEventListener('playing', updateOverlay);
      video.addEventListener('pause', updateOverlay);
      video.addEventListener('ended', updateOverlay);
      video.addEventListener('loadeddata', updateOverlay);

      updateOverlay();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoOverlays);
  } else {
    initVideoOverlays();
  }
</script>
