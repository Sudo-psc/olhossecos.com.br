---
interface Props {
  title: string;
  src: string;
  poster?: string;
  description?: string;
  tags?: string[];
  duration?: string;
  audience?: 'pacientes' | 'profissionais';
  transcript?: string;
}

const { title, src, poster = "/video-placeholder.svg", description, tags = [], duration, audience, transcript } = Astro.props;
---

<div class="video-card-container card-premium group relative overflow-hidden">
  <!-- Poster/Thumbnail Container -->
  <div class="relative aspect-video bg-brand-dark overflow-hidden">
    <video
      data-video-player
      controls
      preload="none"
      playsinline
      poster={poster}
      class="w-full h-full object-cover"
    >
      <source src={src} type="video/mp4" />
      Seu navegador não suporta o elemento de vídeo.
    </video>

    {audience && (
      <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-brand border border-[#E7E5E0]">
        {audience === 'pacientes' ? 'Para pacientes' : 'Para profissionais'}
      </span>
    )}
    {duration && (
      <span class="absolute right-4 top-4 rounded-full bg-brand-dark/80 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-white/90 border border-white/20">
        {duration}
      </span>
    )}

    <!-- Play Icon Overlay (Hidden when video is playing) -->
    <div
      data-play-overlay
      class="absolute inset-0 flex items-center justify-center pointer-events-none transition-opacity duration-300"
    >
      <div class="w-16 h-16 rounded-full bg-white/90 flex items-center justify-center border border-[#E7E5E0] shadow-sm">
        <svg class="w-8 h-8 text-brand ml-1" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
  </div>

  <div class="p-6">
    <h3 class="text-lg font-bold text-brand group-hover:text-brand-light transition-colors line-clamp-2 mb-3">
      {title}
    </h3>
    {description && (
      <p class="text-slate-600 text-sm leading-relaxed line-clamp-2">
        {description}
      </p>
    )}
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-semibold uppercase tracking-widest text-brand-light">
        {tags.map((tag) => (
          <span class="rounded-full border border-[#E7E5E0] bg-alt px-3 py-1">{tag}</span>
        ))}
      </div>
    )}
    {transcript && (
      <details class="mt-4 rounded-lg border border-[#E7E5E0] bg-alt px-4 py-3 text-xs text-slate-600">
        <summary class="cursor-pointer text-[11px] font-semibold uppercase tracking-widest text-brand-light">
          Resumo e transcrição
        </summary>
        <div class="mt-3 leading-relaxed">
          <span class="text-slate-700 font-semibold">Transcrição rápida:</span> {transcript}
        </div>
      </details>
    )}
  </div>
</div>

<script>
  // Script para controlar visibilidade dos botões play nos vídeos
  const initVideoOverlays = () => {
    const videoContainers = document.querySelectorAll('.video-card-container');

    videoContainers.forEach((container) => {
      const video = container.querySelector('[data-video-player]') as HTMLVideoElement;
      const overlay = container.querySelector('[data-play-overlay]') as HTMLElement;

      if (!video || !overlay) {
        return;
      }

      const updateOverlay = () => {
        const isPlaying = !video.paused && !video.ended && video.readyState > 2;
        overlay.style.opacity = isPlaying ? '0' : '1';
        overlay.style.visibility = isPlaying ? 'hidden' : 'visible';
      };

      video.addEventListener('play', updateOverlay);
      video.addEventListener('playing', updateOverlay);
      video.addEventListener('pause', updateOverlay);
      video.addEventListener('ended', updateOverlay);
      video.addEventListener('loadeddata', updateOverlay);

      updateOverlay();
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoOverlays);
  } else {
    initVideoOverlays();
  }
</script>
