---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schemaType?: "WebPage" | "MedicalWebPage" | "CollectionPage" | "Article";
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title = "Olho seco: sintomas, causas e cuidados",
  description = "Informação clara, independente e baseada em evidências sobre sintomas, causas, autocuidado e tratamentos do olho seco.",
  image = "/og-image.png",
  imageAlt = "Olho Seco — Portal do paciente",
  noindex = false,
  schemaType = "WebPage",
  datePublished,
  dateModified = "2026-07-25",
  breadcrumbs,
} = Astro.props;

const siteUrl = new URL("/", Astro.site);
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const isHome = canonical.pathname === "/";
const shouldNoindex = noindex;
const fullTitle = isHome
  ? `${title} | Portal do paciente`
  : title.toLocaleLowerCase("pt-BR").includes("olho seco")
    ? title
    : `${title} | Olho Seco`;
const breadcrumbItems =
  breadcrumbs ??
  (isHome
    ? []
    : [
        { name: "Início", url: "/" },
        { name: title, url: canonical.pathname },
      ]);

const organization = {
  "@type": "Organization",
  "@id": `${siteUrl.href}#organization`,
  name: "Olho Seco — Portal do paciente",
  url: siteUrl.href,
  logo: {
    "@type": "ImageObject",
    url: new URL("/favicon.svg", siteUrl).href,
  },
};

const website = {
  "@type": "WebSite",
  "@id": `${siteUrl.href}#website`,
  url: siteUrl.href,
  name: "Olho Seco — Portal do paciente",
  alternateName: "Portal Olho Seco",
  description,
  inLanguage: "pt-BR",
  publisher: { "@id": organization["@id"] },
};

const page = {
  "@type": schemaType,
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: fullTitle,
  headline: title,
  description,
  inLanguage: "pt-BR",
  isPartOf: { "@id": website["@id"] },
  primaryImageOfPage: { "@id": `${imageUrl.href}#primaryimage` },
  breadcrumb:
    breadcrumbItems.length > 0
      ? { "@id": `${canonical.href}#breadcrumb` }
      : undefined,
  datePublished,
  dateModified,
  about:
    schemaType === "MedicalWebPage" || schemaType === "Article"
      ? {
          "@type": "MedicalCondition",
          name: "Doença do olho seco",
          alternateName: "Olho seco",
        }
      : undefined,
  author:
    schemaType === "Article" ? { "@id": organization["@id"] } : undefined,
  publisher:
    schemaType === "Article" ? { "@id": organization["@id"] } : undefined,
};

const imageObject = {
  "@type": "ImageObject",
  "@id": `${imageUrl.href}#primaryimage`,
  url: imageUrl.href,
  contentUrl: imageUrl.href,
  width: 1200,
  height: 630,
  caption: imageAlt,
};

const breadcrumbSchema =
  breadcrumbItems.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonical.href}#breadcrumb`,
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: new URL(item.url, siteUrl).href,
        })),
      }
    : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    website,
    imageObject,
    page,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071D45" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={shouldNoindex
        ? "noindex,follow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Olho Seco — Portal do paciente" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #071d45;
    --ink-soft: #263d61;
    --teal: #087f95;
    --teal-dark: #00657a;
    --aqua: #dff3f7;
    --mist: #eff8fb;
    --line: #c8d7e2;
    --paper: #ffffff;
    --coral: #e95f4f;
    --coral-text: #a93c32;
    --coral-soft: #fff6f3;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    --shadow: 0 24px 60px rgb(7 29 69 / 10%);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    color-scheme: light;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 4px;
    border-radius: 3px;
  }

  ::selection {
    background: #cceef4;
    color: var(--ink);
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    left: 1rem;
    top: 1rem;
    transform: translateY(-160%);
    background: var(--ink);
    color: white;
    padding: 0.7rem 1rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .page-shell {
    width: min(100% - 6rem, 1440px);
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: rgb(255 255 255 / 96%);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: 92px;
    display: grid;
    grid-template-columns: 260px 1fr auto;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
  }

  .brand-mark {
    width: 52px;
    color: var(--ink);
  }

  .brand span {
    display: grid;
    line-height: 1.05;
  }

  .brand strong {
    font-family: var(--serif);
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }

  .brand small {
    margin-top: 0.35rem;
    color: var(--teal-dark);
    font-size: 0.86rem;
    letter-spacing: 0.01em;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(0.4rem, 1.7vw, 1.7rem);
  }

  .desktop-nav a,
  .sources-link {
    position: relative;
    font-size: 0.91rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    left: 0;
    height: 2px;
    background: var(--teal);
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .sources-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
    color: var(--teal-dark);
  }

  .sources-link svg {
    width: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .menu-button,
  .mobile-nav {
    display: none;
  }

  .section-heading,
  .page-title,
  .article-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .section-heading {
    font-size: clamp(2.65rem, 5vw, 5.2rem);
  }

  .page-title {
    max-width: 980px;
    font-size: clamp(3.1rem, 6vw, 5.8rem);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 100%;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-weight: 700;
    line-height: 1.35;
  }

  .text-link svg {
    width: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 180ms ease;
  }

  .text-link:hover svg {
    transform: translateX(4px);
  }

  .button-primary {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--teal-dark);
    border-radius: 8px;
    background: var(--teal-dark);
    color: white;
    font-size: 0.98rem;
    font-weight: 750;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .button-primary:hover {
    background: var(--ink);
    transform: translateY(-2px);
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--teal-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .page-intro {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .page-intro p {
    max-width: 760px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .content-section {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }

  .prose {
    max-width: 780px;
    color: var(--ink-soft);
  }

  .prose h2 {
    margin: 3.5rem 0 1.15rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .prose h3 {
    margin: 2.4rem 0 0.7rem;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.3rem;
  }

  .prose li + li {
    margin-top: 0.55rem;
  }

  .prose a {
    color: var(--teal-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-note {
    margin-block: 2.5rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--teal);
    background: var(--mist);
    color: var(--ink);
  }

  .alert-note {
    margin-block: 2.5rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--coral);
    background: var(--coral-soft);
    color: var(--ink);
  }

  .site-footer {
    overflow: hidden;
    background: var(--ink);
    color: white;
  }

  .footer-main {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 2fr 0.8fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: 4.5rem 3.2rem;
  }

  .brand-inverse .brand-mark {
    color: white;
  }

  .brand-inverse small {
    color: #78d7e5;
  }

  .footer-brand > p {
    max-width: 380px;
    margin: 1.6rem 0 0;
    color: rgb(255 255 255 / 72%);
    font-size: 0.91rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.8rem;
  }

  .footer-links > div {
    display: grid;
    align-content: start;
    gap: 0.62rem;
  }

  .footer-links h2 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(255 255 255 / 22%);
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .footer-links a {
    color: rgb(255 255 255 / 72%);
    font-size: 0.86rem;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-art {
    position: relative;
    min-height: 180px;
  }

  .footer-orbit {
    position: absolute;
    width: 150px;
    height: 150px;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 50%;
  }

  .footer-wave {
    position: absolute;
    right: -90px;
    bottom: 30px;
    width: 360px;
    height: 95px;
    border-top: 3px solid #22b8cf;
    border-radius: 50%;
    transform: rotate(6deg);
  }

  .footer-dots {
    position: absolute;
    right: -10px;
    bottom: 0;
    width: 130px;
    height: 100px;
    background-image: radial-gradient(#22b8cf 1.5px, transparent 1.5px);
    background-size: 14px 14px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 25%);
    color: rgb(255 255 255 / 60%);
    font-size: 0.76rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 1080px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 78px;
    }

    .desktop-nav,
    .sources-link {
      display: none;
    }

    .menu-button {
      position: relative;
      display: block;
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    .menu-button span {
      position: absolute;
      left: 10px;
      width: 24px;
      height: 2px;
      background: currentColor;
      transition:
        top 180ms ease,
        opacity 180ms ease,
        transform 180ms ease;
    }

    .menu-button span:nth-child(1) {
      top: 14px;
    }

    .menu-button span:nth-child(2) {
      top: 21px;
    }

    .menu-button span:nth-child(3) {
      top: 28px;
    }

    .menu-button[aria-expanded="true"] span:nth-child(1) {
      top: 21px;
      transform: rotate(45deg);
    }

    .menu-button[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-button[aria-expanded="true"] span:nth-child(3) {
      top: 21px;
      transform: rotate(-45deg);
    }

    .mobile-nav {
      display: block;
      border-bottom: 1px solid var(--line);
      background: white;
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav .page-shell {
      display: grid;
      padding-block: 1rem 1.5rem;
    }

    .mobile-nav a {
      padding-block: 0.7rem;
      border-bottom: 1px solid #e8eef2;
      font-weight: 650;
    }

    .mobile-nav a[aria-current="page"] {
      color: var(--teal-dark);
    }

    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-art {
      display: none;
    }
  }

  @media (max-width: 720px) {
    body {
      font-size: 16px;
    }

    .page-shell {
      width: min(100% - 2rem, 1320px);
    }

    .brand-mark {
      width: 44px;
    }

    .brand strong {
      font-size: 1.4rem;
    }

    .brand small {
      font-size: 0.75rem;
    }

    .footer-links {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
