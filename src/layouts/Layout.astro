---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AnalyticsCollector from "@/components/AnalyticsCollector.astro";
import { author } from "@/lib/books";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  schemaType?: "WebPage" | "MedicalWebPage" | "CollectionPage" | "Article";
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title = "Olho seco: sintomas, causas e cuidados",
  description = "Informação clara, independente e baseada em evidências sobre sintomas, causas, autocuidado e tratamentos do olho seco.",
  image = "/og-image.png",
  imageAlt = "Olho Seco — Portal do paciente",
  imageType = "image/png",
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  schemaType = "WebPage",
  datePublished,
  dateModified = "2026-07-25",
  breadcrumbs,
} = Astro.props;

const siteUrl = new URL("/", Astro.site);
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const isHome = canonical.pathname === "/";
const canonicalHref = isHome ? siteUrl.origin : canonical.href;
const shouldNoindex = noindex;
const fullTitle = isHome
  ? title
  : title.toLocaleLowerCase("pt-BR").includes("olho seco")
    ? title
    : `${title} | Olho Seco`;
const breadcrumbItems =
  breadcrumbs ??
  (isHome
    ? []
    : [
        { name: "Início", url: "/" },
        { name: title, url: canonical.pathname },
      ]);

const organization = {
  "@type": "Organization",
  "@id": `${siteUrl.href}#organization`,
  name: "Olhos Secos",
  url: siteUrl.href,
  logo: {
    "@type": "ImageObject",
    url: new URL("/favicon.svg", siteUrl).href,
  },
};

// Conteúdo médico é YMYL: quem assina importa tanto quanto o que está escrito.
// Os guias declaravam a organização como autora, o que não carrega credencial
// nenhuma. O nó aponta para a mesma Person de /autor/philipe-saraiva-cruz e
// leva CRM e RQE em identifier.
const person = {
  "@type": "Person",
  "@id": new URL(`/autor/${author.slug}#person`, siteUrl).href,
  name: author.name,
  jobTitle: author.role,
  identifier: author.registration,
  url: new URL(`/autor/${author.slug}`, siteUrl).href,
};

const website = {
  "@type": "WebSite",
  "@id": `${siteUrl.href}#website`,
  url: siteUrl.href,
  name: "Olhos Secos",
  alternateName: "olhossecos.com.br",
  description,
  inLanguage: "pt-BR",
  publisher: { "@id": organization["@id"] },
};

const page = {
  "@type": schemaType,
  "@id": `${canonicalHref}#webpage`,
  url: canonicalHref,
  name: fullTitle,
  headline: title,
  description,
  inLanguage: "pt-BR",
  isPartOf: { "@id": website["@id"] },
  primaryImageOfPage: { "@id": `${imageUrl.href}#primaryimage` },
  breadcrumb:
    breadcrumbItems.length > 0
      ? { "@id": `${canonicalHref}#breadcrumb` }
      : undefined,
  datePublished,
  dateModified,
  about:
    schemaType === "MedicalWebPage" || schemaType === "Article"
      ? {
          "@type": "MedicalCondition",
          name: "Doença do olho seco",
          alternateName: "Olho seco",
        }
      : undefined,
  author: schemaType === "Article" ? { "@id": person["@id"] } : undefined,
  publisher:
    schemaType === "Article" ? { "@id": organization["@id"] } : undefined,
};

const imageObject = {
  "@type": "ImageObject",
  "@id": `${imageUrl.href}#primaryimage`,
  url: imageUrl.href,
  contentUrl: imageUrl.href,
  width: imageWidth,
  height: imageHeight,
  caption: imageAlt,
};

const breadcrumbSchema =
  breadcrumbItems.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonicalHref}#breadcrumb`,
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: new URL(item.url, siteUrl).href,
        })),
      }
    : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    website,
    imageObject,
    // A Person só entra no grafo quando algo aponta para ela; nas páginas que
    // não são Article o nó seria órfão.
    ...(schemaType === "Article" ? [person] : []),
    page,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#071D45" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={shouldNoindex
        ? "noindex,follow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Olhos Secos" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <AnalyticsCollector />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --ink: #071d45;
    --ink-soft: #263d61;
    --teal: #087f95;
    --teal-dark: #00657a;
    --aqua: #dff3f7;
    --mist: #eff8fb;
    --line: #c8d7e2;
    --paper: #ffffff;
    --coral: #e95f4f;
    --coral-text: #a93c32;
    --coral-soft: #fff6f3;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    /* Sem fonte web: o site não faz nenhuma requisição de fonte, e é parte de
       por que ele é rápido. A pilha começava com Inter, que não é hospedada
       aqui — só quem já tinha Inter instalada via o design pretendido, e todo
       o resto caía em system-ui. Duas renderizações decididas pela máquina do
       visitante. Assumida a do sistema, que é o que quase todos já viam. */
    --sans:
      ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    --shadow: 0 24px 60px rgb(7 29 69 / 10%);
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-24: 6rem;
    --header-height: 76px;
    --control-radius: 6px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    color-scheme: light;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(1rem, 0.98rem + 0.1vw, 1.0625rem);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  :focus-visible {
    outline: 3px solid var(--teal);
    outline-offset: 4px;
    border-radius: 3px;
  }

  ::selection {
    background: #cceef4;
    color: var(--ink);
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    left: 1rem;
    top: 1rem;
    transform: translateY(-160%);
    background: var(--ink);
    color: white;
    padding: 0.7rem 1rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-shell {
    width: min(100% - 4rem, 1340px);
    margin-inline: auto;
  }

  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: rgb(255 255 255 / 96%);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: max-content;
  }

  .brand-mark {
    width: 48px;
    color: var(--ink);
  }

  .brand span {
    display: grid;
    line-height: 1.05;
  }

  .brand strong {
    font-family: var(--serif);
    font-size: 1.45rem;
    letter-spacing: -0.03em;
  }

  .brand small {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: clamp(0.4rem, 1.7vw, 1.7rem);
  }

  .desktop-nav a,
  .header-cta {
    position: relative;
    font-size: 0.91rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    left: 0;
    height: 2px;
    background: var(--teal);
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    justify-content: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--ink);
    border-radius: var(--control-radius);
    color: var(--ink);
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .header-cta:hover {
    background: var(--ink);
    color: white;
  }

  .menu-button,
  .mobile-nav {
    display: none;
  }

  .section-heading,
  .page-title,
  .article-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .section-heading {
    font-size: clamp(2.35rem, 4.5vw, 4.7rem);
  }

  .page-title {
    max-width: 980px;
    font-size: clamp(2.8rem, 5vw, 5rem);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 100%;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-weight: 700;
    line-height: 1.35;
  }

  .text-link svg {
    width: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 180ms ease;
  }

  .text-link:hover svg {
    transform: translateX(4px);
  }

  .button-primary {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--teal-dark);
    border-radius: var(--control-radius);
    background: var(--teal-dark);
    color: white;
    font-size: 0.98rem;
    font-weight: 750;
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .button-primary:hover {
    background: var(--ink);
    transform: translateY(-2px);
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--teal-dark);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .page-intro {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .page-intro p {
    max-width: 760px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .content-section {
    padding-block: clamp(4.5rem, 9vw, 8.5rem);
  }

  .prose {
    max-width: 780px;
    color: var(--ink-soft);
  }

  .prose h2 {
    margin: 3.5rem 0 1.15rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
  }

  .prose h3 {
    margin: 2.4rem 0 0.7rem;
    color: var(--ink);
    font-size: 1.1rem;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.3rem;
  }

  .prose li + li {
    margin-top: 0.55rem;
  }

  .prose a {
    color: var(--teal-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .info-note {
    margin-block: 2.5rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--teal);
    background: var(--mist);
    color: var(--ink);
  }

  .alert-note {
    margin-block: 2.5rem;
    padding: 1.4rem 1.6rem;
    border-left: 3px solid var(--coral);
    background: var(--coral-soft);
    color: var(--ink);
  }

  .site-footer {
    overflow: hidden;
    background: var(--ink);
    color: white;
  }

  .footer-main {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 2fr 0.8fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: 4.5rem 3.2rem;
  }

  .brand-inverse .brand-mark {
    color: white;
  }

  .brand-inverse small {
    color: #78d7e5;
  }

  .footer-brand > p {
    max-width: 380px;
    margin: 1.6rem 0 0;
    color: rgb(255 255 255 / 72%);
    font-size: 0.91rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.8rem;
  }

  .footer-links > div {
    display: grid;
    align-content: start;
    gap: 0.62rem;
  }

  .footer-links h2 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(255 255 255 / 22%);
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .footer-links a {
    color: rgb(255 255 255 / 72%);
    font-size: 0.86rem;
  }

  .footer-links a:hover {
    color: white;
  }

  .footer-art {
    position: relative;
    min-height: 180px;
  }

  .footer-orbit {
    position: absolute;
    width: 150px;
    height: 150px;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 50%;
  }

  .footer-wave {
    position: absolute;
    right: -90px;
    bottom: 30px;
    width: 360px;
    height: 95px;
    border-top: 3px solid #22b8cf;
    border-radius: 50%;
    transform: rotate(6deg);
  }

  .footer-dots {
    position: absolute;
    right: -10px;
    bottom: 0;
    width: 130px;
    height: 100px;
    background-image: radial-gradient(#22b8cf 1.5px, transparent 1.5px);
    background-size: 14px 14px;
  }

  /* Registro do responsável técnico: exigido pelo CFM, então fica acima da
     linha de créditos e com contraste próprio, não na fonte reduzida do
     rodapé inferior. */
  .footer-imprint {
    padding-block: 1.15rem;
    border-top: 1px solid rgb(255 255 255 / 25%);
  }

  .footer-imprint p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.85rem;
    margin: 0;
  }

  .footer-imprint span {
    color: #78d7e5;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-imprint strong {
    font-family: var(--serif);
    font-size: 1.02rem;
    font-weight: 600;
  }

  .footer-imprint em {
    color: rgb(255 255 255 / 82%);
    font-size: 0.84rem;
    font-style: normal;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.25rem 2rem;
    border-top: 1px solid rgb(255 255 255 / 25%);
    color: rgb(255 255 255 / 60%);
    font-size: 0.76rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 1080px) {
    :root {
      --header-height: 68px;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: var(--header-height);
    }

    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-button {
      position: relative;
      display: block;
      width: 44px;
      height: 44px;
      border: 0;
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }

    .menu-button span {
      position: absolute;
      left: 10px;
      width: 24px;
      height: 2px;
      background: currentColor;
      transition:
        top 180ms ease,
        opacity 180ms ease,
        transform 180ms ease;
    }

    .menu-button span:nth-child(1) {
      top: 14px;
    }

    .menu-button span:nth-child(2) {
      top: 21px;
    }

    .menu-button span:nth-child(3) {
      top: 28px;
    }

    .menu-button[aria-expanded="true"] span:nth-child(1) {
      top: 21px;
      transform: rotate(45deg);
    }

    .menu-button[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .menu-button[aria-expanded="true"] span:nth-child(3) {
      top: 21px;
      transform: rotate(-45deg);
    }

    .mobile-nav {
      display: block;
      border-bottom: 1px solid var(--line);
      background: white;
    }

    .mobile-nav[hidden] {
      display: none;
    }

    .mobile-nav .page-shell {
      display: grid;
      padding-block: 1rem 1.5rem;
    }

    .mobile-nav a {
      padding-block: 0.7rem;
      border-bottom: 1px solid #e8eef2;
      font-weight: 650;
    }

    .mobile-nav a[aria-current="page"] {
      color: var(--teal-dark);
    }

    .mobile-nav .mobile-newsletter {
      margin-top: 0.6rem;
      padding-inline: 0.9rem;
      border: 1px solid var(--ink);
      border-radius: var(--control-radius);
      text-align: center;
    }

    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-art {
      display: none;
    }
  }

  @media (max-width: 720px) {
    :root {
      --header-height: 62px;
    }

    body {
      font-size: 16px;
    }

    .page-shell {
      width: min(100% - 2rem, 1320px);
    }

    .brand-mark {
      width: 39px;
    }

    .brand strong {
      font-size: 1.2rem;
    }

    .brand small {
      margin-top: 0.25rem;
      font-size: 0.66rem;
    }

    .footer-links {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
