---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AnalyticsCollector from "@/components/AnalyticsCollector.astro";
import GlobalSearchModal from "@/components/GlobalSearchModal.astro";
import { author } from "@/lib/books";
import {
  physician,
  physicianCredentials,
  portalMedicalConditions,
} from "@/lib/seo";
import { normalizeBasePath, withBasePath } from "@/lib/site-path";
import { themeBootScript } from "@/lib/theme";
import { alternateFeedsForPath } from "@/lib/feeds";
import "@/styles/fonts.css";
import "@/styles/tokens.css";
import "@/styles/touch-targets.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageType?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  schemaType?: "WebPage" | "MedicalWebPage" | "CollectionPage" | "Article";
  datePublished?: string;
  dateModified?: string;
  breadcrumbs?: { name: string; url: string }[];
  extraSchema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Olho seco: sintomas, causas e cuidados",
  description = "Informação clara, independente e baseada em evidências sobre sintomas, causas, autocuidado e tratamentos do olho seco.",
  image = "/og-image.png",
  imageAlt = "Olho Seco — Portal do paciente",
  imageType = "image/png",
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  schemaType = "WebPage",
  datePublished,
  dateModified = "2026-07-25",
  breadcrumbs,
  extraSchema,
} = Astro.props;

const basePath = normalizeBasePath(import.meta.env.BASE_URL);
const siteUrl = new URL(basePath || "/", "https://olhossecos.com.br");
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(withBasePath(image, basePath), siteUrl);
const isHome = canonical.pathname.replace(/\/$/u, "") === (basePath || "");
const canonicalHref = isHome ? `${siteUrl.origin}${basePath}` : canonical.href;
const shouldNoindex = noindex || Boolean(basePath);
const fullTitle = isHome
  ? title
  : title.toLocaleLowerCase("pt-BR").includes("olho seco")
    ? title
    : `${title} | Olho Seco`;
const breadcrumbItems =
  breadcrumbs ??
  (isHome
    ? []
    : [
        { name: "Início", url: withBasePath("/", basePath) },
        { name: title, url: canonical.pathname },
      ]);

const organization = {
  "@type": "Organization",
  "@id": `${siteUrl.href}#organization`,
  name: "Olhos Secos",
  url: siteUrl.href,
  logo: {
    "@type": "ImageObject",
    url: new URL(withBasePath("/favicon.svg", basePath), siteUrl).href,
  },
  sameAs: ["https://drphilipesaraiva.com.br/"],
};

// Conteúdo médico é YMYL: quem assina importa tanto quanto o que está escrito.
// Os guias declaravam a organização como autora, o que não carrega credencial
// nenhuma. O nó aponta para a mesma Person de /autor/philipe-saraiva-cruz e
// leva CRM e RQE em identifier.
const person = {
  "@type": "Person",
  "@id": new URL(
    withBasePath(`/autor/${author.slug}#person`, basePath),
    siteUrl,
  ).href,
  name: author.name,
  jobTitle: author.role,
  identifier: author.registration,
  url: new URL(withBasePath(`/autor/${author.slug}`, basePath), siteUrl).href,
  sameAs: [...physician.sameAs],
  hasCredential: [...physicianCredentials],
};

const website = {
  "@type": "WebSite",
  "@id": `${siteUrl.href}#website`,
  url: siteUrl.href,
  name: "Olhos Secos",
  alternateName: "olhossecos.com.br",
  description,
  inLanguage: "pt-BR",
  publisher: { "@id": organization["@id"] },
};

const page = {
  "@type": schemaType,
  "@id": `${canonicalHref}#webpage`,
  url: canonicalHref,
  name: fullTitle,
  headline: title,
  description,
  inLanguage: "pt-BR",
  isPartOf: { "@id": website["@id"] },
  primaryImageOfPage: { "@id": `${imageUrl.href}#primaryimage` },
  breadcrumb:
    breadcrumbItems.length > 0
      ? { "@id": `${canonicalHref}#breadcrumb` }
      : undefined,
  datePublished,
  dateModified,
  lastReviewed: schemaType === "MedicalWebPage" ? dateModified : undefined,
  reviewedBy:
    schemaType === "MedicalWebPage" ? { "@id": person["@id"] } : undefined,
  about:
    schemaType === "MedicalWebPage" || schemaType === "Article"
      ? [...portalMedicalConditions]
      : undefined,
  author: schemaType === "Article" ? { "@id": person["@id"] } : undefined,
  publisher:
    schemaType === "Article" ? { "@id": organization["@id"] } : undefined,
};

const imageObject = {
  "@type": "ImageObject",
  "@id": `${imageUrl.href}#primaryimage`,
  url: imageUrl.href,
  contentUrl: imageUrl.href,
  width: imageWidth,
  height: imageHeight,
  caption: imageAlt,
};

const breadcrumbSchema =
  breadcrumbItems.length > 0
    ? {
        "@type": "BreadcrumbList",
        "@id": `${canonicalHref}#breadcrumb`,
        itemListElement: breadcrumbItems.map((item, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: item.name,
          item: new URL(withBasePath(item.url, basePath), siteUrl).href,
        })),
      }
    : undefined;

const alternateFeeds = alternateFeedsForPath(Astro.url.pathname);

const extraSchemas = extraSchema
  ? Array.isArray(extraSchema)
    ? extraSchema
    : [extraSchema]
  : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    website,
    imageObject,
    // A Person só entra no grafo quando algo aponta para ela; nas páginas que
    // não são Article o nó seria órfão.
    ...(schemaType === "Article" || schemaType === "MedicalWebPage"
      ? [person]
      : []),
    page,
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...extraSchemas,
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline set:html={themeBootScript} />
    <meta name="theme-color" content="#071D45" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={shouldNoindex
        ? "noindex,follow"
        : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"}
    />
    <link rel="canonical" href={canonicalHref} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBasePath("/favicon.svg", basePath)}
    />
    <link
      rel="icon"
      type="image/x-icon"
      href={withBasePath("/favicon.ico", basePath)}
      sizes="48x48"
    />
    <link
      rel="apple-touch-icon"
      href={withBasePath("/apple-touch-icon.png", basePath)}
    />
    <link
      rel="manifest"
      href={withBasePath("/manifest.webmanifest", basePath)}
    />
    {
      alternateFeeds.map((feed) => (
        <link
          rel="alternate"
          type={feed.type}
          title={feed.title}
          href={withBasePath(feed.href, basePath)}
        />
      ))
    }
    <link
      rel="preload"
      href={withBasePath("/fonts/source-serif-4-subset.woff2", basePath)}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Olhos Secos" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{fullTitle}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <AnalyticsCollector />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <GlobalSearchModal />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    color-scheme: light;
    overflow-x: clip;
  }

  :target,
  [id] {
    scroll-margin-top: calc(var(--header-height) + 1.25rem);
  }

  body {
    margin: 0;
    overflow-x: clip;
    background: var(--paper-50);
    color: var(--ink);
    font-family: var(--sans);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    font-optical-sizing: auto;
  }

  /* Parágrafo sem órfã na última linha; títulos já usam balance. */
  p,
  li,
  figcaption,
  blockquote {
    text-wrap: pretty;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input {
    font: inherit;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  summary:focus-visible,
  [tabindex]:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
    box-shadow: 0 0 0 2px rgb(8 127 149 / 18%);
  }

  ::selection {
    background: var(--selection-bg);
    color: var(--ink);
  }

  .skip-link {
    position: fixed;
    z-index: 100;
    left: 1rem;
    top: 1rem;
    transform: translateY(-160%);
    background: var(--surface-inverse);
    color: var(--on-inverse);
    padding: 0.7rem 1rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-shell {
    min-width: 0;
    width: min(100% - 4rem, 1340px);
    margin-inline: auto;
  }

  /* Header em vidro: transparente sobre o conteúdo, ficando mais opaco
     conforme a página rola. O brilho de topo é um único gradiente de 1px —
     é o que dá leitura de material óptico sem virar glassmorphism. */
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    min-width: 0;
    overflow-x: clip;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-slow) var(--ease-out-soft),
      border-color var(--duration-slow) var(--ease-out-soft),
      box-shadow var(--duration-slow) var(--ease-out-soft);
  }

  .site-header::after {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--header-highlight) 22%,
      var(--header-highlight) 78%,
      transparent
    );
    content: "";
    pointer-events: none;
  }

  .site-header[data-scrolled="true"] {
    background: var(--glass-bg-strong);
    border-bottom-color: var(--glass-edge);
    box-shadow: 0 1px 20px rgb(7 29 69 / 6%);
  }

  /* Orçamento apertado: marca 220 + seis links + quatro ações precisam caber
     em 1340px. A busca fica só com o ícone e os gaps são curtos por isso —
     com rótulo e atalho a navegação transbordava sobre as ações em qualquer
     largura. Abaixo de 1360px o menu vira hambúrguer. */
  .header-inner {
    min-width: 0;
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: minmax(0, 220px) minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    max-width: 100%;
  }

  .brand-mark {
    width: 48px;
    color: var(--ink);
  }

  .brand span {
    display: grid;
    line-height: 1.05;
  }

  .brand strong {
    font-family: var(--serif);
    font-size: 1.45rem;
    letter-spacing: -0.03em;
  }

  .brand small {
    margin-top: 0.35rem;
    color: var(--ink-soft);
    font-size: 0.875rem;
    font-weight: 750;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    min-width: 0;
    gap: clamp(0.5rem, 1.4vw, 1.6rem);
  }

  .desktop-nav a,
  .header-cta {
    position: relative;
    font-size: 0.91rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -0.65rem;
    left: 0;
    height: 2px;
    background: var(--teal);
    content: "";
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .desktop-nav a:hover::after,
  .desktop-nav a:focus-visible::after,
  .desktop-nav a[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    justify-content: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--ink);
    border-radius: var(--control-radius);
    color: var(--ink);
    transition:
      background 180ms ease,
      color 180ms ease;
  }

  .header-cta:hover {
    background: var(--surface-inverse);
    border-color: var(--surface-inverse);
    color: var(--on-inverse);
  }

  .header-cta:active {
    background: var(--surface-inverse-strong);
    border-color: var(--surface-inverse-strong);
    color: var(--on-inverse);
  }

  .menu-button,
  .mobile-nav {
    display: none;
  }

  .section-heading,
  .page-title,
  .article-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .section-heading {
    font-size: var(--text-h2);
  }

  .page-title {
    max-width: 18ch;
    font-size: var(--text-h1);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 100%;
    padding-bottom: 0.18rem;
    border-bottom: 1px solid currentColor;
    color: var(--teal-dark);
    font-weight: 700;
    line-height: 1.35;
  }

  .text-link svg {
    width: 21px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 180ms ease;
  }

  .text-link:hover svg {
    transform: translateX(4px);
  }

  /* Botão cheio. Usa --teal-700 cru, não --teal-dark: o apelido clareia no
     tema escuro e o texto branco perderia contraste. O brilho de topo é
     background-image, não box-shadow — o anel de foco ocupa o box-shadow. */
  .button-primary {
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.5rem;
    border: 1px solid var(--teal-700);
    border-radius: var(--control-radius);
    background-color: var(--teal-700);
    background-image: linear-gradient(
      180deg,
      rgb(255 255 255 / 12%),
      rgb(255 255 255 / 0%) 55%
    );
    color: var(--on-inverse);
    font-size: 0.98rem;
    font-weight: 750;
    transition:
      background-color var(--duration-base) var(--ease-out-soft),
      border-color var(--duration-base) var(--ease-out-soft),
      transform var(--duration-base) var(--ease-out-soft),
      filter var(--duration-base) var(--ease-out-soft);
  }

  .button-primary:hover {
    background-color: var(--surface-inverse);
    border-color: var(--surface-inverse);
    transform: translateY(-2px);
    filter: var(--lift-hover);
  }

  .button-primary:active {
    background-color: var(--surface-inverse-strong);
    border-color: var(--surface-inverse-strong);
    transform: translateY(0);
    filter: none;
  }

  .button-primary:disabled {
    cursor: wait;
    opacity: 0.65;
    transform: none;
    filter: none;
  }

  .eyebrow {
    margin: 0 0 1.1rem;
    color: var(--copper-700);
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }

  .page-intro {
    padding-block: clamp(3.5rem, 6vw, 6rem);
    border-bottom: 1px solid var(--line);
  }

  .page-intro p {
    max-width: 760px;
    margin: 2rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }

  .content-section {
    padding-block: var(--space-section);
  }

  .prose {
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .prose h2 {
    margin: 3.25rem 0 1.15rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .prose h3 {
    margin: 2.4rem 0 0.7rem;
    color: var(--ink);
    font-family: var(--serif);
    font-size: var(--text-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .prose p,
  .prose ul {
    margin: 0 0 1.3rem;
  }

  .prose li + li {
    margin-top: 0.55rem;
  }

  .prose a {
    color: var(--teal-dark);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Mesma família visual dos blocos de ScienceCallout: fio de 3px à esquerda,
     canto arredondado só do lado aberto e rótulo em versalete. */
  .info-note,
  .alert-note {
    position: relative;
    margin-block: var(--space-block);
    padding: 1.4rem 1.6rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink);
  }

  .info-note {
    border-left: 3px solid var(--teal-600);
    background: var(--teal-50);
  }

  .alert-note {
    border-left: 3px solid var(--alert-500);
    background: var(--alert-50);
  }

  .info-note::before,
  .alert-note::before {
    display: block;
    margin-bottom: 0.4rem;
    font-size: var(--text-meta);
    font-weight: 800;
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }

  .info-note::before {
    color: var(--teal-700);
    content: "Nota";
  }

  .alert-note::before {
    color: var(--alert-600);
    content: "Atenção";
  }

  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--surface-inverse);
    color: var(--on-inverse);
  }

  /* Fio luminoso no topo do rodapé: separa o navy do papel sem borda dura. */
  .site-footer::before {
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--on-inverse-accent) 30%,
      var(--on-inverse-accent) 70%,
      transparent
    );
    opacity: 0.55;
    content: "";
    pointer-events: none;
  }

  .footer-main {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 2fr 0.8fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-block: 4.5rem 3.2rem;
  }

  .brand-inverse .brand-mark {
    color: var(--on-inverse);
  }

  .brand-inverse small {
    color: var(--on-inverse-accent);
  }

  .footer-brand > p {
    max-width: 380px;
    margin: 1.6rem 0 0;
    color: var(--on-inverse-soft);
    font-size: 0.91rem;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.8rem;
  }

  .footer-links > div {
    display: grid;
    align-content: start;
    gap: 0.62rem;
  }

  .footer-links h2 {
    margin: 0 0 0.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--on-inverse-line);
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .footer-links a {
    color: var(--on-inverse-soft);
    font-size: 0.875rem;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .footer-links a:hover {
    color: var(--on-inverse);
  }

  .footer-art {
    position: relative;
    min-height: 180px;
  }

  .footer-orbit {
    position: absolute;
    width: 150px;
    height: 150px;
    border: 1px solid var(--on-inverse-line);
    border-radius: 50%;
  }

  .footer-wave {
    position: absolute;
    right: -90px;
    bottom: 30px;
    width: 360px;
    height: 95px;
    border-top: 3px solid var(--on-inverse-accent);
    border-radius: 50%;
    transform: rotate(6deg);
  }

  .footer-dots {
    position: absolute;
    right: -10px;
    bottom: 0;
    width: 130px;
    height: 100px;
    background-image: radial-gradient(
      var(--on-inverse-accent) 1.5px,
      transparent 1.5px
    );
    background-size: 14px 14px;
  }

  /* Registro do responsável técnico: exigido pelo CFM, então fica acima da
     linha de créditos e com contraste próprio, não na fonte reduzida do
     rodapé inferior. */
  .footer-imprint {
    padding-block: 1.15rem;
    border-top: 1px solid var(--on-inverse-line);
  }

