---
import SuperficieFooter from "@/components/superficie/SuperficieFooter.astro";
import SuperficieHeader from "@/components/superficie/SuperficieHeader.astro";
import AnalyticsCollector from "@/components/AnalyticsCollector.astro";

interface Props {
  title: string;
  description: string;
  home?: boolean;
  image?: string;
  imageAlt?: string;
  schemaType?: "WebPage" | "CollectionPage";
  datePublished?: string;
  dateModified?: string;
  robots?: string;
  ogType?: "website" | "article";
  authorName?: string;
  compactHeader?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  extraSchema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  home = false,
  image = "/images/superficie/og-superficie.png",
  imageAlt = "SUPERFÍCIE — Revista de Olho Seco e Superfície Ocular",
  schemaType = "WebPage",
  datePublished = "2026-08-07",
  dateModified = "2026-08-08",
  robots = "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1",
  ogType = "website",
  authorName,
  compactHeader = false,
  breadcrumbs = [],
  extraSchema,
} = Astro.props;

const siteUrl = new URL("/", Astro.site);
const canonical = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const publisherId = new URL("/#organization", siteUrl).href;
const periodicalId = new URL("/superficie#periodical", siteUrl).href;

const page = {
  "@type": schemaType,
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  headline: title,
  description,
  inLanguage: "pt-BR",
  datePublished,
  dateModified,
  isPartOf: { "@id": new URL("/#website", siteUrl).href },
  publisher: { "@id": publisherId },
  primaryImageOfPage: { "@id": `${imageUrl.href}#primaryimage` },
  breadcrumb:
    breadcrumbs.length > 0
      ? { "@id": `${canonical.href}#breadcrumb` }
      : undefined,
};

const baseGraph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": publisherId,
    name: "Olho Seco — Portal do paciente",
    url: siteUrl.href,
  },
  {
    "@type": "Periodical",
    "@id": periodicalId,
    name: "SUPERFÍCIE",
    alternateName: "Revista de Olho Seco e Superfície Ocular",
    description,
    inLanguage: "pt-BR",
    publisher: { "@id": publisherId },
    url: new URL("/superficie", siteUrl).href,
  },
  {
    "@type": "ImageObject",
    "@id": `${imageUrl.href}#primaryimage`,
    url: imageUrl.href,
    contentUrl: imageUrl.href,
    width: 1200,
    height: 630,
    caption: imageAlt,
  },
  page,
];

if (breadcrumbs.length > 0) {
  baseGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.url, siteUrl).href,
    })),
  });
}

const extras = Array.isArray(extraSchema)
  ? extraSchema
  : extraSchema
    ? [extraSchema]
    : [];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...baseGraph, ...extras],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#001a33" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="SUPERFÍCIE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      ogType === "article" && (
        <>
          <meta property="article:published_time" content={datePublished} />
          <meta property="article:modified_time" content={dateModified} />
          {authorName && (
            <meta property="article:author" content={authorName} />
          )}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class="superficie-document">
    <AnalyticsCollector />
    <a class="surface-skip-link" href="#conteudo-superficie">
      Pular para o conteúdo
    </a>
    <SuperficieHeader {home} compact={compactHeader} />
    <main id="conteudo-superficie">
      <slot />
    </main>
    <SuperficieFooter />
  </body>
</html>

<script>
  // Inclinação 3D + brilho especular para qualquer elemento data-tilt.
  // Só ativa com mouse de precisão e sem prefers-reduced-motion — em touch
  // as variáveis CSS ficam nos valores neutros definidos no estilo global,
  // então o elemento permanece estático sem nenhum ramo extra de fallback.
  const canTilt =
    window.matchMedia("(hover: hover) and (pointer: fine)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (canTilt) {
    const maxTiltDeg = 6;
    const elements = document.querySelectorAll<HTMLElement>("[data-tilt]");

    elements.forEach((el) => {
      let frame = 0;

      const update = (clientX: number, clientY: number) => {
        const rect = el.getBoundingClientRect();
        const px = (clientX - rect.left) / rect.width;
        const py = (clientY - rect.top) / rect.height;
        const rotateX = (0.5 - py) * maxTiltDeg * 2;
        const rotateY = (px - 0.5) * maxTiltDeg * 2;
        el.style.setProperty("--tilt-x", `${rotateX.toFixed(2)}deg`);
        el.style.setProperty("--tilt-y", `${rotateY.toFixed(2)}deg`);
        el.style.setProperty("--glow-x", `${(px * 100).toFixed(1)}%`);
        el.style.setProperty("--glow-y", `${(py * 100).toFixed(1)}%`);
      };

      el.addEventListener("pointermove", (event) => {
        if (event.pointerType !== "mouse") return;
        el.classList.add("is-tilting");
        if (frame) return;
        frame = requestAnimationFrame(() => {
          update(event.clientX, event.clientY);
          frame = 0;
        });
      });

      el.addEventListener("pointerleave", () => {
        el.classList.remove("is-tilting");
        el.style.setProperty("--tilt-x", "0deg");
        el.style.setProperty("--tilt-y", "0deg");
      });
    });
  }
</script>

<style is:global>
  :root {
    --surface-navy: #001a33;
    --surface-navy-deep: #001326;
    --surface-paper: #f7f4ed;
    --surface-white: #fffdf8;
    --surface-ink: #09223c;
    --surface-copy: #263c50;
    --surface-muted: #5b7081;
    --surface-muted-on-dark: #b9c5ce;
    --surface-teal: #0b827f;
    --surface-teal-dark: #066765;
    --surface-gold: #b98a36;
    --surface-gold-light: #d9b665;
    --surface-line: #d8d3c7;
    --surface-serif:
      "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --surface-sans:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;

    /* Movimento e profundidade. drop-shadow (não box-shadow) para que a
       elevação no hover nunca dispute com o anel de foco de dois tons, que
       usa box-shadow — as duas camadas ficam em propriedades diferentes e
       sempre coexistem sem um sobrescrever o outro. */
    --surface-ease: cubic-bezier(0.22, 1, 0.36, 1);
    --surface-lift-sm: drop-shadow(0 10px 18px rgb(4 12 22 / 22%))
      drop-shadow(0 3px 6px rgb(4 12 22 / 16%));
    --surface-lift-md: drop-shadow(0 22px 38px rgb(4 12 22 / 30%))
      drop-shadow(0 6px 14px rgb(4 12 22 / 20%));
    --surface-lift-gold: drop-shadow(0 16px 30px rgb(185 138 54 / 42%))
      drop-shadow(0 4px 10px rgb(4 12 22 / 24%));
    /* box-shadow, não filter: reservado a contêineres que não recebem foco
       (painel do menu móvel, chip de vidro do hero). Em elementos focáveis
       o box-shadow é do anel de foco de dois tons — usar aqui criaria
       disputa entre as duas camadas quando hover e foco coincidem. */
    --surface-shadow-lg:
      0 30px 60px -18px rgb(4 12 22 / 45%), 0 10px 24px -8px rgb(4 12 22 / 28%);

    /* Vidro fosco: só onde há conteúdo variado por trás para desfocar
       (fotos, seções sobrepostas). Sempre com fallback opaco via @supports. */
    --surface-glass-navy: rgb(0 22 43 / 78%);
    --surface-glass-border: rgb(255 255 255 / 16%);

    /* Arredondamento suave. Escala contida: a identidade é de publicação
       impressa, então o raio amacia a aresta sem virar linguagem de app.
       sm = controles (botões, campos, selos), md = cards e painéis,
       lg = superfícies grandes (formulários, grades de card). */
    --surface-radius-sm: 6px;
    --surface-radius-md: 10px;
    --surface-radius-lg: 16px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    color-scheme: light;
  }

  body.superficie-document {
    margin: 0;
    background: var(--surface-paper);
    color: var(--surface-ink);
    font-family: var(--surface-sans);
    font-size: clamp(1rem, 0.98rem + 0.1vw, 1.0625rem);
    line-height: 1.65;
    text-rendering: optimizeLegibility;
  }

  .superficie-document img,
  .superficie-document svg {
    display: block;
    max-width: 100%;
  }

  .superficie-document a {
    color: inherit;
    text-decoration: none;
  }

  .superficie-document button,
  .superficie-document input {
    font: inherit;
  }

  /* Anel de foco de dois tons. O ouro sozinho ficava em 1.77:1 sobre o papel,
     abaixo dos 3:1 exigidos pela WCAG 2.2 SC 1.4.11. O anel interno navy
     resolve os fundos claros (15.99:1 sobre o papel) e o externo dourado
     resolve os escuros (9.06:1 sobre o navy), então o indicador permanece
     visível em qualquer seção da revista. */
  /* Sem border-radius aqui: outline e box-shadow já acompanham o raio
     próprio do elemento focado. Fixar um valor nesta regra sobrescreveria
     o raio real de botões e cards no exato momento do foco, fazendo o
     canto "pular" ao navegar por teclado. */
  .superficie-document :focus-visible {
    outline: 3px solid var(--surface-gold-light);
    outline-offset: 3px;
    box-shadow: 0 0 0 3px var(--surface-navy);
  }

  .superficie-document ::selection {
    background: #c5e4df;
    color: var(--surface-navy);
  }

  .surface-shell {
    width: min(100% - 4rem, 1340px);
    margin-inline: auto;
  }

  .surface-skip-link {
    position: fixed;
    z-index: 100;
    top: 1rem;
    left: 1rem;
    padding: 0.7rem 1rem;
    transform: translateY(-170%);
    background: var(--surface-paper);
    color: var(--surface-navy);
  }

  .surface-skip-link:focus {
    transform: translateY(0);
  }

  @media (max-width: 720px) {
    .surface-shell {
      width: min(100% - 2rem, 1340px);
    }
  }

  /* ==========================================================
     Sistema de botões — antes duplicado com três convenções de
     classe diferentes (button-primary/button-outline-light,
     button.primary/button.quiet, button/button.quiet) e três cores
     de "primário" (ouro em duas páginas, teal em outra) nascidas de
     copiar-e-colar entre páginas. Uma definição única aqui resolve
     as duas coisas: consistência visual E menos CSS duplicado.
     ========================================================== */
  /* .superficie-document prefixado no seletor de cor: .superficie-document
     a { color: inherit } (especificidade 0,1,1) tem prioridade maior que
     uma única classe (0,1,0) — nas páginas antes o .button ficava dentro
     de <style> com escopo do Astro, que soma um atributo de escopo à
     especificidade; centralizado aqui como estilo global, essa vantagem
     desaparece e o texto do botão herdava a cor do fundo em vez da cor
     pretendida. */
  .superficie-document .button {
    color: var(--surface-paper);
  }

  .button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.78rem 1.35rem;
    border: 1px solid var(--surface-gold-light);
    border-radius: var(--surface-radius-sm);
    background: transparent;
    font-family: var(--surface-sans);
    font-size: 0.77rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      filter 380ms var(--surface-ease),
      transform 380ms var(--surface-ease),
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease;
  }

  /* Brilho diagonal que varre o botão no hover — sutil (16% de branco no
     pico) para nunca comprometer a leitura do rótulo em maiúsculas. */
  .button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      115deg,
      transparent 24%,
      rgb(255 255 255 / 16%) 48%,
      transparent 70%
    );
    transform: translateX(-130%);
    transition: transform 640ms var(--surface-ease);
    pointer-events: none;
  }

  .button:hover::before {
    transform: translateX(130%);
  }

  .button:hover {
    filter: var(--surface-lift-sm);
    transform: translateY(-3px);
  }

  .button:active {
    filter: none;
    transform: translateY(-1px);
    transition-duration: 120ms;
  }

  .button-primary {
    border-color: var(--surface-gold-light);
    background: var(--surface-gold-light);
  }

  .superficie-document .button-primary {
    color: var(--surface-navy);
  }

  .button-primary:hover {
    background: color-mix(in srgb, var(--surface-gold-light) 85%, white 15%);
    filter: var(--surface-lift-gold);
  }

  .button-quiet {
    background: transparent;
  }

  .button-quiet:hover {
    background: rgb(217 182 101 / 14%);
  }

  .button-outline-light {
    border-color: rgb(255 255 255 / 45%);
    background: transparent;
  }

  .button-outline-light:hover {
    border-color: var(--surface-paper);
    background: rgb(255 255 255 / 8%);
  }

  @media (max-width: 520px) {
    .button {
      width: 100%;
    }
  }

  /* ==========================================================
     Inclinação 3D sob o cursor + brilho especular. Aplicado via
     atributo data-tilt (ver script mais abaixo) a superfícies de
     destaque — capas, cards de artigo, cards do RADAR. O ângulo é
     contido (6°) e as variáveis partem neutras, então qualquer
     elemento com data-tilt permanece estático até o JS assumir; em
     touch e prefers-reduced-motion o script nunca assume, e o
     bloco de redução de movimento abaixo zera a transição.
     ========================================================== */
  [data-tilt] {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    /* Vazia, não "none": "none" não é uma <transform-function> válida
       dentro de uma lista — "transform: perspective(...) none rotateX(...)"
       é uma declaração inválida inteira, e o navegador a descarta por
       completo (volta a transform:none), quebrando o tilt em qualquer
       elemento que não redefina --tilt-base localmente. Vazia, var()
       simplesmente não contribui nenhum token nesse ponto da lista. */
    --tilt-base: ;
    --glow-x: 50%;
    --glow-y: 50%;
    transform: perspective(1000px) var(--tilt-base) rotateX(var(--tilt-x))
      rotateY(var(--tilt-y));
    transition: transform 500ms var(--surface-ease);
  }

  [data-tilt].is-tilting {
    transition: transform 60ms linear;
  }

  .tilt-glow {
    position: relative;
  }

  .tilt-glow::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: radial-gradient(
      circle at var(--glow-x) var(--glow-y),
      rgb(255 255 255 / 24%),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 320ms ease;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  .tilt-glow:hover::after,
  .tilt-glow.is-tilting::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
