---
import AnalyticsCollector from "@/components/AnalyticsCollector.astro";
import { normalizeBasePath, withBasePath } from "@/lib/site-path";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const basePath = normalizeBasePath(import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-GJGLLWV2KS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      // `anonymize_ip` é herança do Universal Analytics: o GA4 descarta o IP
      // antes de gravar e ignora o parâmetro. Fica declarado como registro da
      // intenção, não como controle — ele não fecha o buraco de LGPD. O que
      // falta é consentimento antes do disparo e /privacidade nomeando o
      // Google como operador.
      gtag("config", "G-GJGLLWV2KS", { anonymize_ip: true });
    </script>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#061821" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={withBasePath("/favicon.svg", basePath)}
    />
    <title>{title}</title>
  </head>
  <body>
    <AnalyticsCollector />
    <a class="reader-skip-link" href="#superficie-reader">Pular para o leitor</a
    >
    <slot />
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }

  html,
  body {
    min-height: 100%;
    margin: 0;
    background: #061821;
  }

  /* Ver a nota em Layout.astro: nenhuma fonte web é hospedada, então Inter
     sai da pilha para que o reader renderize igual em toda máquina. */
  body {
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
  }

  .reader-skip-link {
    position: fixed;
    z-index: 1000;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.7rem 1rem;
    transform: translateY(-160%);
    border-radius: 0.35rem;
    background: #f5f0e7;
    color: #061821;
  }

  .reader-skip-link:focus {
    transform: translateY(0);
  }
</style>
