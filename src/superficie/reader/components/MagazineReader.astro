---
import "../reader.css";
import { normalizeBasePath, withBasePath } from "@/lib/site-path";
import { pageRatioFromSize } from "../fit-page.ts";
import type { PageSize } from "../types.ts";
import PageViewport from "./PageViewport.astro";
import ReaderPanels from "./ReaderPanels.astro";
import ReaderToolbar from "./ReaderToolbar.astro";

interface Props {
  manifestUrl: string;
  issueLabel?: string;
  pageCount?: number;
  /** Proporção correta já no primeiro quadro, antes do manifest chegar. */
  pageSize?: PageSize;
  pdfHref?: string;
  coverSrc?: string;
  coverAlt?: string;
}

const {
  manifestUrl,
  issueLabel,
  pageCount,
  pageSize,
  pdfHref,
  coverSrc,
  coverAlt,
} = Astro.props;
const basePath = normalizeBasePath(import.meta.env.BASE_URL);
const pageRatio = pageSize
  ? Number((1 / pageRatioFromSize(pageSize)).toFixed(4))
  : null;
---

<div
  class="magazine-reader"
  data-magazine-reader
  data-manifest-url={manifestUrl}
  data-base-path={basePath}
  style={pageRatio ? `--reader-page-ratio: ${pageRatio};` : undefined}
>
  <header class="reader-header">
    <a
      href={withBasePath("/superficie", basePath)}
      class="reader-brand"
      aria-label="Sair do laboratório e voltar para SUPERFÍCIE"
    >
      <span>SUPERFÍCIE</span>
      <small data-reader-brand-line hidden={!issueLabel}>{issueLabel}</small>
    </a>
    <div class="reader-page-nav" aria-label="Navegação de páginas">
      <button type="button" data-action="previous" aria-label="Página anterior"
        >←</button
      >
      <form data-page-form>
        <label class="visually-hidden" for="reader-page-input"
          >Ir para a página</label
        >
        <input
          id="reader-page-input"
          data-page-input
          type="number"
          min="1"
          value="1"
          inputmode="numeric"
        />
        <span data-page-total hidden={!pageCount}>
          <span aria-hidden="true">/</span>
          <span data-page-count>{pageCount ?? ""}</span>
        </span>
      </form>
      <button type="button" data-action="next" aria-label="Próxima página"
        >→</button
      >
    </div>
    <button
      type="button"
      class="reader-close"
      data-action="close"
      aria-label="Sair do leitor">×</button
    >
  </header>

  <div
    class="reader-progress"
    data-progress
    role="progressbar"
    aria-label="Progresso de leitura"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="13"
  >
    <span data-progress-bar></span>
  </div>

  <div class="reader-chrome-restore" data-chrome-restore hidden>
    <button
      type="button"
      class="reader-chrome-restore-nav"
      data-action="previous"
      aria-label="Página anterior">←</button
    >
    <span class="reader-chrome-restore-nav" data-chrome-page-label>1</span>
    <button
      type="button"
      class="reader-chrome-restore-nav"
      data-action="next"
      aria-label="Próxima página">→</button
    >
    <button
      type="button"
      data-action="show-chrome"
      aria-label="Mostrar barras de leitura"
    >
      Mostrar barras
    </button>
  </div>

  <PageViewport {pdfHref} {coverSrc} {coverAlt} />
  <ReaderPanels />
  <ReaderToolbar />
</div>

<script>
  import { initMagazineReader } from "../reader-app";

  document
    .querySelectorAll<HTMLElement>("[data-magazine-reader]")
    .forEach((element) => {
      void initMagazineReader(element);
    });
</script>
