[Unit]
Description=Backup consistente dos bancos privados do olhossecos.com.br
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/olhossecos/olhossecos.env
Environment=OLHOSSECOS_BACKUP_ROOT=/var/backups/olhossecos/private-data
ExecStart=/usr/bin/node /usr/local/libexec/olhossecos/backup-private-data.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/olhossecos
ReadWritePaths=/var/backups/olhossecos

[Install]
WantedBy=multi-user.target
