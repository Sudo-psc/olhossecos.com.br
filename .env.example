# Configuração do Sanity CMS
PUBLIC_SANITY_PROJECT_ID=seu_project_id
PUBLIC_SANITY_DATASET=production

# Configuração do Site
SITE_URL=https://olhossecos.com
SITE_NAME=Olho Seco Caratinga
SITE_DESCRIPTION=Clínica oftalmológica especializada em tratamento de olho seco em Caratinga, MG

# Aplicação (Opcional)
NODE_ENV=development
PORT=4321

# Google Analytics (Opcional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Newsletter editorial (endpoint interno e armazenamento privado no servidor)
PUBLIC_NEWSLETTER_ENDPOINT=/api/newsletter
NEWSLETTER_DATABASE_PATH=/var/lib/olhossecos/newsletter.sqlite
NEWSLETTER_ALLOWED_ORIGIN=https://olhossecos.com.br
