# Aplicação local
NODE_ENV=development
HOST=127.0.0.1
PORT=4321

# Analytics editorial first-party, sem cookies ou identificadores pessoais
PUBLIC_ANALYTICS_ENDPOINT=/api/analytics
ANALYTICS_DATABASE_PATH=./var/analytics.sqlite
ANALYTICS_ALLOWED_ORIGIN=http://localhost:4321

# Newsletter editorial
PUBLIC_NEWSLETTER_ENDPOINT=/api/newsletter
PUBLIC_NEWSLETTER_UNSUBSCRIBE_ENDPOINT=/api/newsletter-unsubscribe
NEWSLETTER_DATABASE_PATH=./var/newsletter.sqlite
NEWSLETTER_ALLOWED_ORIGIN=http://localhost:4321
NEWSLETTER_TOKEN_SECRET=change-me-with-at-least-32-random-characters
# Em produção, configure um sendmail root/local para confirmações de retorno.
# NEWSLETTER_CONFIRMATION_SENDMAIL=/usr/sbin/sendmail

# Contatos de parceiros da SUPERFÍCIE
PUBLIC_PARTNER_INQUIRY_ENDPOINT=/api/superficie-parceiros
PARTNER_INQUIRY_DATABASE_PATH=./var/superficie-partner-inquiries.sqlite
PARTNER_INQUIRY_ALLOWED_ORIGIN=http://localhost:4321

# Em produção, sobrescrever os caminhos e origens com:
# NEWSLETTER_DATABASE_PATH=/var/lib/olhossecos/newsletter.sqlite
# NEWSLETTER_ALLOWED_ORIGIN=https://olhossecos.com.br
# NEWSLETTER_CONFIRMATION_SENDMAIL=/usr/sbin/sendmail
# ANALYTICS_DATABASE_PATH=/var/lib/olhossecos/analytics.sqlite
# ANALYTICS_ALLOWED_ORIGIN=https://olhossecos.com.br
# PARTNER_INQUIRY_DATABASE_PATH=/var/lib/olhossecos/superficie-partner-inquiries.sqlite
# PARTNER_INQUIRY_ALLOWED_ORIGIN=https://olhossecos.com.br
