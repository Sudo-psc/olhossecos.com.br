{
  "name": "olhossecos-astro",
  "type": "module",
  "version": "1.0.0",
  "description": "Portal brasileiro sobre olho seco e superfície ocular",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/build-release.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{astro,js,ts}\"",
    "test": "node --test src/lib/*.test.ts scripts/*.test.mjs",
    "test:routes": "node scripts/verify-release-routes.mjs",
    "test:newsletter": "node --test src/lib/newsletter.test.ts",
    "test:partners": "node --test src/lib/partner-inquiries.test.ts",
    "test:gate5": "node --test src/lib/newsletter.test.ts src/lib/partner-inquiries.test.ts",
    "test:superficie": "node --test src/lib/superficie.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.{astro,js,ts}\" \"scripts/**/*.mjs\" \"ops/**/*.mjs\" \".github/workflows/*.yml\" \"astro.config.mjs\" \"eslint.config.js\" \"prettier.config.mjs\" \"package*.json\" \"README.md\" \"TESTING.md\" \"docs/VPS-DEPLOY.md\"",
    "check": "npm test && npm run lint && npm run format:check && npm run build && npm run test:routes",
    "newsletter:export": "node scripts/export-newsletter-recipients.mjs",
    "analytics:report": "node scripts/analytics-report.mjs",
    "ops:deploy": "node scripts/deploy-atomic-release.mjs",
    "ops:backup": "node scripts/backup-private-data.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
